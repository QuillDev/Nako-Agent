+def test_cancellation_during_popen_construction_unwinds(cli, monkeypatch):
+    entered, release = threading.Event(), threading.Event()
+    client = cli.make('no_read')
+    original = ds.subprocess.Popen
+    errors = []
+    def delayed(*a, **kw):
+        if kw.get('stdin') is not ds.subprocess.PIPE:
+            # Only the native spawn: an earlier helper Popen would let the cancel land before it.
+            return original(*a, **kw)
+        p = original(*a, **kw)
+        entered.set()
+        assert release.wait(3)
+        # Popen runs under the request lock, so cancel() can't kill yet: stand in for its kill
+        # here so the first stdin write always hits a dead pipe (CI raced into this; the close
+        # in cleanup then re-raised BrokenPipe over the cancellation).
+        p.kill()
+        p.wait()
+        return p
+    monkeypatch.setattr(ds.subprocess, 'Popen', delayed)
+    def work():
+        try:
+            client._create(**query())
+        except BaseException as e:
+            errors.append(e)
+    owner = threading.Thread(target=work)
+    canceller = threading.Thread(target=client.cancel)
+    owner.start()
+    try:
+        eventually(entered.is_set)
+        canceller.start()
+        eventually(lambda: any(r.cancelled.is_set() for r in client._requests))
+    finally:
+        release.set()
+        if canceller.ident:
+            canceller.join(2)
+        owner.join(2)
+    assert not owner.is_alive() and not canceller.is_alive()
+    assert len(errors) == 1 and str(errors[0]) == 'Claude request cancelled'
