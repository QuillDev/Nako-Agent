@@ -0,0 +1,26 @@
+"""Inventory only. No host imports, effects or executable tool implementations."""
+import json
+from pathlib import Path
+import sys
+
+
+def main():
+    manifest = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8-sig"))
+    # A client loaded before this file was updated starts it without the name.
+    host = sys.argv[2] if len(sys.argv) > 2 else 'hermes'
+    for line in sys.stdin:
+        row = json.loads(line)
+        method = row.get('method')
+        result = {}
+        if method == 'initialize':
+            result = {'protocolVersion': '2024-11-05', 'capabilities': {'tools': {}}, 'serverInfo': {'name': f'{host}-inert-inventory', 'version': '1'}}
+        elif method == 'tools/list':
+            result = {'tools': manifest}
+        elif method == 'tools/call':
+            result = {'isError': True, 'content': [{'type': 'text', 'text': f'Denied: native tools are inert; only {host.capitalize()} executes tools.'}]}
+        if 'id' in row:
+            print(json.dumps({'jsonrpc': '2.0', 'id': row['id'], 'result': result}), flush=True)
+
+
+if __name__ == '__main__':
+    main()
