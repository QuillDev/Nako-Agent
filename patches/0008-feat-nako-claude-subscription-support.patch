+                    gate.capture.feed(chunk)
+                elif len(gate.error_body) < 65536:
+                    gate.error_body += chunk  # The rejection reason ("prompt is too long", "adaptive thinking is not supported"), bounded.
+                self.wfile.write(chunk)
