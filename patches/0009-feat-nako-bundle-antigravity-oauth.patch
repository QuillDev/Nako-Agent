+        # A stream still holding session A's baseline deltas against that
+        # session and cannot corrupt session B's accounting.
+        stale_stream = AntigravityStream(
+            proc=session_a,
+            client=client,
+            model=MODEL,
+            timeout=30.0,
+            is_worker=True,
+            messages=MESSAGES_TURN_1,
+            usage_baseline=stale_baseline,
