index 0000000000000000000000000000000000000000..e456cff9ffbfbe98de4e0db82220c34ede3dcf64
--- /dev/null
+++ b/plugins/model-providers/antigravity-oauth/package.json
@@ -0,0 +1,33 @@
+{
+  "name": "hermes-antigravity-oauth",
+  "version": "0.1.0",
