+        self.assertEqual(stale_baseline, {"input_tokens": 13000, "output_tokens": 200})
+        self.assertIsNot(session_b_baseline, stale_baseline)
+        self.assertEqual(session_b_baseline, {"input_tokens": 800, "output_tokens": 90})
+
