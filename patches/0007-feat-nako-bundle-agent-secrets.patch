diff --git a/plugins/agent-secrets/README.md b/plugins/agent-secrets/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..1e3186ae40f9e493ee702e3aecb816dc07decda2
--- /dev/null
+++ b/plugins/agent-secrets/README.md
@@ -0,0 +1,63 @@
+# agent-secrets
+
+A [Hermes Agent](https://github.com/NousResearch/hermes-agent) plugin that lets the agent work with secrets (API keys, passwords, tokens) without the values ever entering the conversation.
+
+Models tend to refuse or stall on work that needs credentials, because the only way they have to get one is to ask you to paste it into the chat. This plugin gives them a safe path instead.
+
+## What the agent gets
+
+- `secret_request(name, why)` asks you for a secret. Your chat app shows a masked field, the value goes into an encrypted store on this machine, and the agent gets back only "stored" and the name.
+- `secret_share(name, from_file)` hands you a value the agent made (a generated password, a new key) without the agent reading it. Your chat app shows it behind a reveal button.
+- `secret_list()` lists the names and notes, never values.
+- `hermes secret get NAME` and `hermes secret run NAME [NAME...] -- <command>` let the agent's commands use a value by name.
+- Any tool result that still contains a stored value (6+ characters, raw or JSON-escaped) is masked as `«secret:NAME»` before the model reads it.
+
+The tool descriptions tell the agent to use these for any secret instead of asking in chat or refusing.
+
+## Where you type and see secrets
+
+This plugin has no UI of its own. A chat app plugin registers itself as the *surface* for its platform and draws the request and share cards; [Nako Portal](https://github.com/QuillDev/nako-portal) does. Without a surface, the agent tells you to store the value yourself:
+
+```sh
+hermes secret set STRIPE_KEY          # reads the value from stdin
+hermes secret list
+hermes secret rm STRIPE_KEY
+```
+
+## Writing a surface
+
+Other plugins reach the API as `sys.modules["agent_secrets"]` once this plugin has loaded (check at call time). See `api.py` for the full contract:
+
+```python
+secrets = sys.modules.get("agent_secrets")
+if secrets is not None:
+    secrets.register_surface("myplatform", MySurface())
+
+class MySurface:
+    def ask(self, session_id, request):   # {id, name, note, replace}; show it, return True
+        ...
+    def show_line(self, name):            # what the agent writes in a reply to show one
+        return f"SECRET:{name}"
+
+# when the person answers:
+secrets.answer(request_id, value)       # or answer(request_id, declined=True)
+```
+
+`names()`, `about()`, `get()`, `put()`, `remove()` act on the current Hermes profile, for a settings page.
+
+## Storage
+
+One SQLite file per Hermes profile at `<HERMES_HOME>/agent-secrets/vault.db`, values encrypted with Fernet under `vault.key` (0600, in a 0700 folder). That protects copies of the file, such as backups. It doesn't protect against anything already running as your account, which can read both. That's by design, since the agent's commands need the values.
+
+## Install
+
+```sh
+hermes plugins install https://github.com/QuillDev/hermes-agent-secrets
+hermes gateway restart
+```
+
+## Tests
+
+```sh
+python -m pytest tests   # needs pytest and cryptography
+```
diff --git a/plugins/agent-secrets/__init__.py b/plugins/agent-secrets/__init__.py
new file mode 100644
index 0000000000000000000000000000000000000000..769428b26e2be3c9a3b0a0dccee7959e02f77b6b
--- /dev/null
+++ b/plugins/agent-secrets/__init__.py
@@ -0,0 +1,295 @@
+"""Secrets for the agent without the values entering the conversation.
+
+The person types a secret into whatever chat surface supports it (a plugin registers itself as
+the surface for its platform, see `api.py`), or stores one with `hermes secret set`. The agent
+only ever sees names: commands read values with `hermes secret get NAME` or
+`hermes secret run NAME -- <command>`, and any tool result that still contains a stored value
+is masked before the model reads it. The other way, the agent stores a value it made (from a
+file or a command's output) and the surface shows it to the person.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+from . import api
+from .host import CLI
+from .vault import check_name
+
+TOOLSET = "secrets"
+# Other plugins find the API here (see api.py).
+API_MODULE = "agent_secrets"
+# The tool waits this long for the person, in short polls so a /stop gets through.
+WAIT = 300
+POLL = 5
+# Shorter values would mask ordinary words and numbers all over tool output.
+MASK_MIN = 6
+
+USE = (
+    f"Use it by name and never print it: `{CLI} secret run {{name}} -- <command>` runs a command with "
+    f"${{name}} set, and `$({CLI} secret get {{name}})` gives the value inline. Tool output that contains it "
+    "shows «secret:{name}» instead."
+)
+
+GUIDANCE = (
+    "Whenever work needs a secret value (password, API key, token, private key, recovery code), use the "
+    "secret_* tools: never ask the person to paste one into the chat, never write one into a reply, and don't "
+    "refuse or stall on work just because it needs credentials. "
+)
+
+
+def _shared_api():
+    # A gateway loads each profile as a distinct package. Surfaces are process-wide,
+    # while the API resolves the vault from the current profile at call time.
+    return sys.modules.get(API_MODULE, api)
+
+
+def _platform():
+    try:
+        from gateway.session_context import get_session_env
+
+        platform = get_session_env("HERMES_SESSION_PLATFORM", "")
+    except Exception:
+        platform = ""
+    return platform or os.environ.get("HERMES_SESSION_PLATFORM", "")
+
+
+def _interrupted():
+    try:
+        from tools.interrupt import is_interrupted
+    except ImportError:
+        return False
+    return is_interrupted()
+
+
+# Tools
+
+
+def request(args, session):
+    name = check_name(args.get("name"))
+    asked = _shared_api().ask(session, _platform(), name, str(args.get("why") or ""), bool(args.get("replace")))
+    if asked.get("status") == "exists":
+        return {"status": "exists", "name": name, "note": asked["secret"].get("note") or "", "use": USE.format(name=name)}
+    deadline = time.monotonic() + WAIT
+    while time.monotonic() < deadline:
+        if _interrupted():
+            return {"status": "interrupted", "name": name, "note": "The request stays open in the chat; a value typed later is still stored."}
+        outcome = _shared_api().wait(asked["id"], min(POLL, max(0.0, deadline - time.monotonic())))
+        if outcome == "stored":
+            return {"status": "stored", "name": name, "use": USE.format(name=name)}
+        if outcome == "declined":
+            return {"status": "declined", "name": name, "note": "They chose not to give it. Carry on without it, or ask in the chat what they'd prefer."}
+        if outcome != "waiting":
+            return {"status": "closed", "name": name, "note": "The request closed without an answer."}
+    return {
+        "status": "waiting",
+        "name": name,
+        "note": "No answer yet. The request stays open in the chat; call secret_request again with the same name to keep waiting.",
+    }
+
+
+def share(args, _session):
+    name = check_name(args.get("name"))
+    path = args.get("from_file")
+    if path:
+        file = Path(str(path)).expanduser()
+        value = file.read_text(encoding="utf-8-sig")
+        # A file written by `echo`/`openssl ... >` ends in one newline that isn't part of the value.
+        value = value[:-1] if value.endswith("\n") else value
+        _shared_api().put(name, value, note=args.get("note"), origin="agent")
+        if args.get("delete_file"):
+            file.unlink()
+    elif _shared_api().about(name) is None:
+        raise ValueError(f"no secret named {name}: store it first (from_file, or `<command> | {CLI} secret set {name}`)")
+    surface = _shared_api().surface_for(_platform())
+    line = surface.show_line(name) if surface is not None else None
+    if line:
+        return {"status": "ready", "name": name, "show": line, "note": f"Put {line} on a line of its own in your reply; the person sees it there behind a reveal button."}
+    return {"status": "ready", "name": name, "note": f"This chat can't show secrets. Tell the person to run `{CLI} secret get {name}` on this machine."}
+
+
+def listing(_args, _session):
+    return {"secrets": [{k: s[k] for k in ("name", "note", "origin", "updated_at")} for s in _shared_api().names()]}
+
+
+TOOLS = [
+    (
+        "secret_request",
+        request,
+        GUIDANCE + "Ask the person for a secret without it entering this conversation: their chat shows a "
+        "masked field, the value is stored encrypted on this machine, and you get back only its name and how to use "
+        "it in commands. If one by that name is already stored you get that at once (pass replace to ask for a new "
+        "value). Waits up to a few minutes for them.",
+        {
+            "name": {"type": "string", "description": "Env-var style name, e.g. STRIPE_TEST_KEY. Reuse an existing name for the same secret."},
+            "why": {"type": "string", "description": "One short line the person sees: what it's for and where to find it."},
+            "replace": {"type": "boolean", "description": "Ask for a new value even though one is stored (it's wrong or expired)."},
+        },
+        ["name", "why"],
+    ),
+    (
+        "secret_share",
+        share,
+        GUIDANCE + "Give the person a secret value (a password you generated, a key you created) without it entering "
+        "this conversation. Write the value to a file with a command (e.g. `openssl rand -base64 24 > /tmp/pw`) "
+        f"and pass from_file, or pipe it into `{CLI} secret set NAME` and pass just the name. The result says how to "
+        "show it to them in your reply.",
+        {
+            "name": {"type": "string", "description": "Env-var style name, e.g. DB_ADMIN_PASSWORD."},
+            "note": {"type": "string", "description": "One short line about what it is, shown with it."},
+            "from_file": {"type": "string", "description": "Path of a file holding the value (one trailing newline is dropped)."},
+            "delete_file": {"type": "boolean", "description": "Delete that file once it's stored."},
+        },
+        ["name"],
+    ),
+    (
+        "secret_list",
+        listing,
+        "The secrets stored for you on this machine: names, notes and who added them, never values. "
+        "Check here before asking the person for one.",
+        {},
+        [],
+    ),
+]
+
+
+def _wrap(fn):
+    def handler(args, **kwargs):
+        try:
+            return json.dumps(fn(args or {}, kwargs.get("session_id") or os.environ.get("HERMES_SESSION_ID") or None))
+        except Exception as error:
+            return json.dumps({"error": str(error)})
+
+    return handler
+
+
+# Masking stored values in what tools hand back to the model.
+
+_KNOWN = {}
+
+
+def _values():
+    """Stored (name, value) pairs for the current home, longest value first, reread only after a change."""
+    try:
+        store = _shared_api().vault()
+    except Exception:
+        return []
+    revision = store.revision()
+    known = _KNOWN.get(str(store.dir))
+    if known is None or known[0] != revision:
+        known = (revision, sorted(store.values(), key=lambda pair: len(pair[1]), reverse=True))
+        _KNOWN[str(store.dir)] = known
+    return known[1]
+
+
+def mask(text):
+    if not isinstance(text, str) or not text:
+        return text
+    for name, value in _values():
+        if len(value) < MASK_MIN:
+            continue
+        # The value as written, and as it reads inside a JSON string (tool results usually are).
+        for form in {value, json.dumps(value)[1:-1]}:
+            if form in text:
+                text = text.replace(form, f"«secret:{name}»")
+    return text
+
+
+def _mask_tool_result(result=None, **_):
+    masked = mask(result)
+    return masked if isinstance(result, str) and masked != result else None
+
+
+def _mask_terminal_output(output=None, **_):
+    masked = mask(output)
+    return masked if isinstance(output, str) and masked != output else None
+
+
+# `hermes secret ...`
+
+
+def _setup_cli(parser):
+    sub = parser.add_subparsers(dest="secret_action", required=True)
+    sub.add_parser("list", help="Stored secrets: names and notes, no values")
+    get = sub.add_parser("get", help="Print a secret's value (for $(...) in a command)")
+    get.add_argument("name")
+    put = sub.add_parser("set", help="Store a value read from stdin or a file")
+    put.add_argument("name")
+    put.add_argument("--file", help="Read the value from this file instead of stdin")
+    put.add_argument("--note", help="One line about what it is")
+    rm = sub.add_parser("rm", help="Delete a secret")
+    rm.add_argument("name")
+    run = sub.add_parser("run", help=f"Run a command with secrets as env vars: {CLI} secret run NAME [NAME...] -- cmd")
+    run.add_argument("rest", nargs=argparse.REMAINDER, help="NAME [NAME...] -- command")
+
+
+def _cli(args):
+    try:
+        if args.secret_action == "list":
+            for s in _shared_api().names():
+                print(f"{s['name']:32} {s['origin']:5} {s.get('note') or ''}".rstrip())
+        elif args.secret_action == "get":
+            value = _shared_api().get(args.name)
+            if value is None:
+                raise ValueError(f"no secret named {args.name}")
+            sys.stdout.write(value + ("\n" if sys.stdout.isatty() else ""))
+        elif args.secret_action == "set":
+            value = Path(args.file).expanduser().read_text(encoding="utf-8-sig") if args.file else sys.stdin.read()
+            value = value[:-1] if value.endswith("\n") else value
+            # A value piped in from a command is the agent's; one typed at a terminal is the person's.
+            _shared_api().put(args.name, value, note=args.note, origin="you" if sys.stdin.isatty() and not args.file else "agent")
+            print(f"stored {args.name}", file=sys.stderr)
+        elif args.secret_action == "rm":
+            print("removed" if _shared_api().remove(args.name) else f"no secret named {args.name}", file=sys.stderr)
+        elif args.secret_action == "run":
+            _run(args.rest)
+    except (ValueError, OSError) as error:
+        raise SystemExit(f"{CLI} secret: {error}")
+
+
+def run_env(rest):
+    """`NAME [NAME...] -- command` as (command, env with those secrets set)."""
+    rest = list(rest)
+    if "--" not in rest or rest.index("--") == 0 or rest.index("--") == len(rest) - 1:
+        raise ValueError(f"give names, then the command after --, e.g. {CLI} secret run API_KEY -- curl ...")
+    split = rest.index("--")
+    env = dict(os.environ)
+    for name in rest[:split]:
+        value = _shared_api().get(name)
+        if value is None:
+            raise ValueError(f"no secret named {name}")
+        env[check_name(name)] = value
+    return rest[split + 1 :], env
+
+
+def _run(rest):
+    command, env = run_env(rest)
+    os.execvpe(command[0], command, env)
+
+
+def register(ctx):
+    sys.modules.setdefault(API_MODULE, api)
+    for name, fn, description, properties, required in TOOLS:
+        ctx.register_tool(
+            name=name,
+            toolset=TOOLSET,
+            schema={"name": name, "description": description, "parameters": {"type": "object", "properties": properties, "required": required}},
+            handler=_wrap(fn),
+            description=description,
+            emoji="🔑",
+        )
+    ctx.register_hook("transform_tool_result", _mask_tool_result)
+    ctx.register_hook("transform_terminal_output", _mask_terminal_output)
+    if hasattr(ctx, "register_cli_command"):
+        ctx.register_cli_command(
+            name="secret",
+            help="Secrets the agent can use by name",
+            setup_fn=_setup_cli,
+            handler_fn=_cli,
+            description="Read and store the agent's secrets, so commands can use them without printing them.",
+        )
diff --git a/plugins/agent-secrets/api.py b/plugins/agent-secrets/api.py
new file mode 100644
index 0000000000000000000000000000000000000000..db7c29b8c8a8814039adbffa27b6f08528857980
--- /dev/null
+++ b/plugins/agent-secrets/api.py
@@ -0,0 +1,194 @@
+"""What other plugins use: the vault, and a way to be the place a person types a secret in.
+
+Another plugin reaches this module as `sys.modules["agent_secrets"]` (set when this plugin
+registers; check it at call time, since plugins load in any order):
+
+    secrets = sys.modules.get("agent_secrets")
+    if secrets is not None:
+        secrets.register_surface("myplatform", MySurface())
+
+A surface is the UI for one platform. It shows a request and reports the answer:
+
+    class MySurface:
+        def ask(self, session_id, request) -> bool:
+            '''Show {id, name, note, replace} in that chat; False if it can't (not one of yours).
+            Called on the agent's tool thread.'''
+        def show_line(self, name) -> str | None:
+            '''Text the agent puts in a reply to show a stored secret there, e.g. "SECRET:NAME".'''
+
+When the person answers, the surface calls `answer(request_id, value)` (or `declined=True`),
+from any thread. The value goes straight into the vault of the profile that asked; the agent
+only learns that it was stored. `close(request_id)` ends one nobody will answer. `ask` can come
+again with an id already shown (the agent asked again); show it once.
+
+Reads and writes (`names`, `about`, `get`, `put`, `remove`) act on the current Hermes home, so
+call them inside the profile scope you mean. `on_change(fn)` hears this process's changes.
+"""
+
+from __future__ import annotations
+
+import threading
+import uuid
+
+from .host import CLI
+from .vault import Vault, check_name
+
+_VAULTS = {}
+_VAULTS_LOCK = threading.Lock()
+SURFACES = {}
+_LISTENERS = []
+# Open requests: id -> {home, session, name, note, done (Event), outcome}
+_PENDING = {}
+# How requests ended, for a wait() that comes after.
+_ENDED = {}
+ENDED_KEPT = 200
+_PENDING_LOCK = threading.Lock()
+
+
+def _home():
+    from hermes_constants import get_hermes_home
+
+    return str(get_hermes_home())
+
+
+def vault(home=None):
+    home = str(home or _home())
+    with _VAULTS_LOCK:
+        if home not in _VAULTS:
+            _VAULTS[home] = Vault(home)
+        return _VAULTS[home]
+
+
+def _changed(home):
+    for listener in list(_LISTENERS):
+        try:
+            listener(home)
+        except Exception:
+            pass
+
+
+def on_change(listener):
+    """listener(home) runs after this process stores or deletes a secret."""
+    _LISTENERS.append(listener)
+
+
+# The vault, for surfaces (Settings pages) and the CLI.
+
+
+def names():
+    return vault().names()
+
+
+def about(name):
+    return vault().about(name)
+
+
+def get(name):
+    return vault().get(name)
+
+
+def put(name, value, *, note=None, origin="you"):
+    home = _home()
+    stored = vault(home).put(name, value, note=note, origin=origin)
+    _changed(home)
+    return stored
+
+
+def remove(name):
+    home = _home()
+    removed = vault(home).remove(name)
+    if removed:
+        _changed(home)
+    return removed
+
+
+# Surfaces
+
+
+def register_surface(platform, surface):
+    SURFACES[str(platform)] = surface
+
+
+def unregister_surface(platform, surface=None):
+    if surface is None or SURFACES.get(str(platform)) is surface:
+        SURFACES.pop(str(platform), None)
+
+
+def surface_for(platform):
+    return SURFACES.get(str(platform or ""))
+
+
+def ask(session_id, platform, name, note="", replace=False):
+    """Open a request in the person's chat. {id} to wait on, {status: "exists", secret} when one by
+    that name is stored and not being replaced. ValueError when nowhere can show it."""
+    name = check_name(name)
+    home = _home()
+    known = vault(home).about(name)
+    if known is not None and not replace:
+        return {"status": "exists", "secret": known}
+    surface = surface_for(platform)
+    if surface is None:
+        raise ValueError(f"Nowhere in this chat can take a secret. Ask the person to store it with `{CLI} secret set {name}` on this machine, then use it by that name.")
+    with _PENDING_LOCK:
+        # Asking again after a wait ran out picks up the request that's still open. The surface is
+        # asked again with the same id, so a chat app that restarted meanwhile shows it again.
+        entry = next(
+            ((rid, e) for rid, e in _PENDING.items() if (e["home"], e["session"], e["name"]) == (home, session_id, name)),
+            None,
+        )
+    if entry is not None:
+        request_id, entry = entry
+    else:
+        request_id = uuid.uuid4().hex
+        entry = {"home": home, "session": session_id, "name": name, "note": str(note or "").strip()[:500], "done": threading.Event(), "outcome": None}
+        with _PENDING_LOCK:
+            _PENDING[request_id] = entry
+    shown = surface.ask(session_id, {"id": request_id, "name": name, "note": entry["note"], "replace": known is not None})
+    if not shown:
+        with _PENDING_LOCK:
+            _PENDING.pop(request_id, None)
+        raise ValueError(f"This chat can't show a secret field. Ask the person to store it with `{CLI} secret set {name}`, then use it by that name.")
+    return {"id": request_id}
+
+
+def _finish(request_id, outcome):
+    with _PENDING_LOCK:
+        entry = _PENDING.pop(request_id, None)
+        if entry is None:
+            return None
+        # Kept a while, for a tool that looks after the request already ended.
+        _ENDED[request_id] = outcome
+        while len(_ENDED) > ENDED_KEPT:
+            _ENDED.pop(next(iter(_ENDED)))
+    entry["outcome"] = outcome
+    entry["done"].set()
+    return entry
+
+
+def answer(request_id, value=None, *, declined=False):
+    """The person answered a request: store the value in the vault that asked. False if it's gone."""
+    with _PENDING_LOCK:
+        entry = _PENDING.get(str(request_id))
+    if entry is None:
+        return False
+    if not declined:
+        vault(entry["home"]).put(entry["name"], value, note=entry["note"] or None, origin="you")
+        _changed(entry["home"])
+    _finish(str(request_id), "declined" if declined else "stored")
+    return True
+
+
+def close(request_id):
+    """Nobody will answer this one (its chat went away)."""
+    _finish(str(request_id), "closed")
+
+
+def wait(request_id, timeout):
+    """How a request ended (stored, declined, closed), or "waiting" after `timeout` seconds."""
+    with _PENDING_LOCK:
+        entry = _PENDING.get(str(request_id))
+    if entry is None:
+        return _ENDED.get(str(request_id), "closed")
+    if not entry["done"].wait(timeout):
+        return "waiting"
+    return entry["outcome"]
