diff --git a/plugins/nako-portal/desktop/ui/connect.js b/plugins/nako-portal/desktop/ui/connect.js
new file mode 100644
index 0000000000000000000000000000000000000000..ce73243f76cb7598b6d3df63c33105dc68aa5b51
--- /dev/null
+++ b/plugins/nako-portal/desktop/ui/connect.js
@@ -0,0 +1,50 @@
+// The app's own first screen: ask for the portal's address, or say it can't be reached.
+const { invoke } = window.nakoDesktop
+const $ = id => document.getElementById(id)
+
+function ask(origin, error) {
+  $("unreachable").hidden = true
+  $("ask").hidden = false
+  $("message").textContent = error || "Portal address"
+  $("message").className = error ? "error" : ""
+  if (origin && !$("address").value) $("address").value = origin
+  $("address").focus()
+}
+
+function unreachable(origin, error) {
+  $("ask").hidden = true
+  $("unreachable").hidden = false
+  $("reason").textContent = error
+  $("retry").onclick = () => connect(origin)
+  $("change").onclick = () => ask(origin)
+}
+
+async function connect(address) {
+  for (const button of document.querySelectorAll("main button")) button.disabled = true
+  try {
+    await invoke("connect", { address })
+  } catch (error) {
+    if ($("unreachable").hidden) ask(null, String(error))
+    else unreachable(address, String(error))
+  } finally {
+    for (const button of document.querySelectorAll("main button")) button.disabled = false
+  }
+}
+
+$("ask").addEventListener("submit", event => {
+  event.preventDefault()
+  connect($("address").value)
+})
+
+if (window.nakoWindow?.controls) {
+  $("titlebar").hidden = false
+  for (const button of document.querySelectorAll("[data-window]")) {
+    button.onclick = () => invoke(`plugin:window|${button.dataset.window}`, { label: "main" })
+  }
+}
+
+const change = new URLSearchParams(location.search).has("change")
+const state = await invoke("start", { change })
+document.querySelector("main").hidden = state.kind === "open"
+if (state.kind === "ask") ask(state.origin)
+if (state.kind === "unreachable") unreachable(state.origin, state.error)
diff --git a/plugins/nako-portal/desktop/ui/divider.css b/plugins/nako-portal/desktop/ui/divider.css
new file mode 100644
index 0000000000000000000000000000000000000000..ad8b18b401d205b67515e8fc85e8e3972628e384
--- /dev/null
+++ b/plugins/nako-portal/desktop/ui/divider.css
@@ -0,0 +1,26 @@
+/* The browser toolbar's palette (browser.css), following the system. */
+:root {
+  color-scheme: dark;
+  --background: #09090b;
+  --muted: #8e8e99;
+  --border: rgb(255 255 255 / 7%);
+}
+@media (prefers-color-scheme: light) {
+  :root {
+    color-scheme: light;
+    --background: #fbfbfc;
+    --muted: #6b6b76;
+    --border: rgb(0 0 0 / 8%);
+  }
+}
+html, body { margin: 0; height: 100%; overflow: hidden; background: transparent; user-select: none; }
+/* A line between the chat and the page, with a grip in the middle. */
+#strip { position: absolute; top: 0; bottom: 0; left: 0; width: 8px; display: grid; place-items: center; background: var(--background); cursor: col-resize; }
+#strip::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 1px; transform: translateX(-50%); background: var(--border); }
+.grip { position: relative; width: 4px; height: 36px; border-radius: 2px; background: var(--muted); opacity: 0.6; }
+#strip:hover .grip, .dragging .grip { opacity: 1; }
+/* Fills the divider's old place while it's dragged, until the portal and the page take it. */
+#gap { position: absolute; top: 0; bottom: 0; width: 8px; background: var(--background); }
+[hidden] { display: none !important; }
+/* While dragged the page covers the window, so the cursor holds anywhere the line goes. */
+.dragging, .dragging * { cursor: col-resize; }
