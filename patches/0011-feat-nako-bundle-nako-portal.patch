+    _skill(mesh.skills, "tools/DESCRIPTION.md", "tool skills")
+    _skill(mesh.skills, "work-only/SKILL.md")
+    _skill(mesh.skills, "jobs/work-only/SKILL.md")
+    _skill(mesh.skills, ".hub/cache.json", "{}")
