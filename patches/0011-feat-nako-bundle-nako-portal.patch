diff --git a/plugins/nako-portal/tests/test_process_wake.py b/plugins/nako-portal/tests/test_process_wake.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a84aa11a36364c811a0e2f5601f298b58c1c23b
--- /dev/null
+++ b/plugins/nako-portal/tests/test_process_wake.py
@@ -0,0 +1,202 @@
+"""A background process that finishes in a portal thread wakes that thread's agent, and a turn
+Hermes runs from its queue shows as working in the portal like a typed one.
+
+Runs against the real gateway where Hermes is installed; CI has no Hermes and skips.
+"""
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def load_plugin():
+    spec = importlib.util.spec_from_file_location("nako_portal_wake_test", ROOT / "__init__.py")
+    plugin = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(plugin)
+    return plugin
+
+
+class Ctx:
+    def register_hook(self, name, callback):
+        pass
+
+    def register_platform(self, **entry):
+        self.entry = entry
+
+
+async def gateway(tmp_path, monkeypatch):
+    """A real gateway runner and session authority with the portal platform registered."""
+    pytest.importorskip("gateway.session_authority")
+    from gateway.config import GatewayConfig, Platform, PlatformConfig
+    from gateway.platform_registry import PlatformEntry, platform_registry
+    from gateway.run import GatewayRunner
+    from gateway.session_authority import SessionAuthority, initialize_session_authority
+    from gateway.session_ingress_context import register_transport_home
+    import inspect
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(SessionAuthority, "_schedule", lambda self, ref: None)
+    plugin = load_plugin()
+    ctx = Ctx()
+    plugin.register(ctx)
+    entry = {k: v for k, v in ctx.entry.items() if k in PlatformEntry.__dataclass_fields__}
+    platform_registry.register(PlatformEntry(source="plugin", **entry))
+    runner = GatewayRunner(GatewayConfig(sessions_dir=tmp_path / "sessions"))
+    if "persistence" in inspect.signature(initialize_session_authority).parameters:
+        from persistence_assembly import open_persistence, profile_scope
+
+        store = open_persistence(profile_scope(home=tmp_path))
+        runner.session_store._db = store
+        authority = await initialize_session_authority(runner, profile_id="default", instance_id="wake-test", persistence=store)
+    else:
+        from hermes_state import SessionDB
+
+        db = SessionDB(tmp_path / "state.db")
+        runner.session_store._db = db
+        runner._session_db = db
+        authority = await initialize_session_authority(runner, profile_id="default", instance_id="wake-test", db=db)
+    adapter = ctx.entry["adapter_factory"](PlatformConfig(enabled=True))
+    runner.adapters = {Platform("portal"): adapter}
+    runner._wire_adapter_handlers(adapter)
+    register_transport_home(runner, None, tmp_path)
+    return plugin, runner, authority, adapter
+
+
+async def say(runner, authority, adapter, chat, text):
+    """What the portal's inbound path hands the gateway when its person types in ``chat``."""
+    from gateway.platforms.event import MessageEvent
+    from gateway.session_ingress_context import native_callback
+
+    # The portal's own inbound identity, as of the releases before PERSON existed.
+    source = adapter.build_source(chat_id=chat, chat_name="Nako", chat_type="dm", user_id="owner", user_name="you")
+    event = MessageEvent(text=text, source=source, message_id="m-" + text)
+    with native_callback(runner, event, runner.session_store.sessions_dir.parent):
+        await authority.admit_native(event)
+
+
+async def wake(runner, authority, adapter, plugin, chat, process="proc_1"):
+    """Admit what the process watcher sends when a background process in ``chat`` finishes: it
+    rebuilds the thread's source from the stored session, as it does after a gateway restart."""
+    from gateway.platforms.event import MessageEvent
+
+    key = runner.session_store._generate_session_key(plugin._source(chat))
+    source = runner._build_process_event_source({"session_key": key})
+    metadata = {"gateway_session_key": key, "gateway_session_id": runner.session_store.peek_session_id(key)}
+    event = MessageEvent(text=f"[IMPORTANT: Background process {process} completed]", source=source,
+                         internal=True, metadata=metadata)
+    return await authority.admit_automation(adapter, event, process)
+
+
+@pytest.mark.asyncio
+async def test_a_finished_background_process_wakes_a_thread_opened_before_its_first_message(tmp_path, monkeypatch):
+    plugin, runner, authority, adapter = await gateway(tmp_path, monkeypatch)
+    try:
+        # A new portal chat, nako-spawn thread or Notifications exists before anything is said in it.
+        plugin._ensure_chat(runner.session_store, "thread1", "watch ci")
+        await say(runner, authority, adapter, "thread1", "watch ci for me")
+        assert (await wake(runner, authority, adapter, plugin, "thread1")).admission_id
+    finally:
+        (getattr(authority, "persistence", None) or authority.db).close()
+
+
+@pytest.mark.asyncio
+async def test_a_thread_stored_by_an_older_release_is_woken_after_the_portal_connects(tmp_path, monkeypatch):
+    plugin, runner, authority, adapter = await gateway(tmp_path, monkeypatch)
+    from gateway.session import SessionSource
+
+    try:
+        old = SessionSource(platform=plugin._source("old").platform, chat_id="old", chat_type="dm", chat_name="Nako")
+        runner.session_store.get_or_create_session(old, touch_activity=False)
+        await say(runner, authority, adapter, "old", "watch ci for me")
+        plugin._own_origins(runner.session_store)
+        assert (await wake(runner, authority, adapter, plugin, "old")).admission_id
+        # The repair is saved, so a restarted gateway reads the same thread back.
+        runner.session_store._entries.clear()
+        runner.session_store._loaded = False
+        assert (await wake(runner, authority, adapter, plugin, "old", "proc_2")).admission_id
+    finally:
+        (getattr(authority, "persistence", None) or authority.db).close()
+
+
+class Heard:
+    """The portal server's end of the link: what the gateway half told the hub, in order."""
+
+    def __init__(self):
+        self.calls = []
+
+    async def call(self, method, *args):
+        self.calls.append((method, *args))
+
+    async def until(self, *call, timeout=3):
+        import asyncio
+
+        deadline = asyncio.get_running_loop().time() + timeout
+        while call not in self.calls:
+            assert asyncio.get_running_loop().time() < deadline, f"never heard {call}: {self.calls}"
+            await asyncio.sleep(0.02)
+
+
+@pytest.mark.asyncio
+async def test_a_turn_hermes_runs_from_its_queue_shows_working_then_done(tmp_path, monkeypatch):
+    import asyncio
+    from types import SimpleNamespace
+
+    plugin, runner, authority, adapter = await gateway(tmp_path, monkeypatch)
+    store = getattr(authority, "persistence", None)
+    if store is None:
+        from hermes_state_runtime import claim_session_input, settle_session_input
+
+    def claim(session):
+        if store is not None:
+            turn = store.admissions.claim(epoch=authority.epoch, session_id=session)
+            return turn.admission_id, turn.generation
+        turn = claim_session_input(authority.db, epoch=authority.epoch, session_id=session)
+        return turn["admission_id"], turn["generation"]
+
+    def settle(turn, outcome):
+        args = dict(epoch=authority.epoch, admission_id=turn[0], generation=turn[1], outcome=outcome)
+        if store is not None:
+            store.admissions.settle(**args)
+        else:
+            settle_session_input(authority.db, **args)
+
+    monkeypatch.setattr(plugin, "TURN_SWEEP", 0.05)
+    adapter.backend = plugin.HermesBackend(adapter, tmp_path)
+    adapter.link = heard = Heard()
+    sweep = asyncio.get_running_loop().create_task(adapter._sweep_turns())
+    try:
+        # A message that waited in the queue (behind a busy turn, or over a restart) starts running
+        # with no processing hook: the portal still hears the turn start and, once it ends, finish.
+        queued = plugin._ensure_chat(runner.session_store, "queued", "queued")
+        await say(runner, authority, adapter, "queued", "please continue")
+        turn = claim(queued)
+        await heard.until("turn_started", "queued")
+        settle(turn, "completed")
+        await heard.until("turn_finished", "queued", "success")
+
+        # A failed one finishes as a failure.
+        heard.calls.clear()
+        await say(runner, authority, adapter, "queued", "and the next one")
+        turn = claim(queued)
+        await heard.until("turn_started", "queued")
+        settle(turn, "failed")
+        await heard.until("turn_finished", "queued", "failure")
+
+        # A typed turn the hooks report is told once, also while its record outlives the hook.
+        typed = plugin._ensure_chat(runner.session_store, "typed", "typed")
+        await say(runner, authority, adapter, "typed", "hi")
+        turn = claim(typed)
+        event = SimpleNamespace(source=plugin._source("typed"))
+        await adapter.on_processing_start(event)
+        await asyncio.sleep(0.3)
+        await adapter.on_processing_complete(event, SimpleNamespace(value="success"))
+        await asyncio.sleep(0.3)
+        settle(turn, "completed")
+        await asyncio.sleep(0.3)
+        assert [c for c in heard.calls if c[1] == "typed"] == [("turn_started", "typed"), ("turn_finished", "typed", "success")]
+    finally:
+        sweep.cancel()
+        (getattr(authority, "persistence", None) or authority.db).close()
diff --git a/plugins/nako-portal/tests/test_profile_routing.py b/plugins/nako-portal/tests/test_profile_routing.py
new file mode 100644
index 0000000000000000000000000000000000000000..7858e92bc3e6b9ee801274fb18b115d0163ae595
--- /dev/null
+++ b/plugins/nako-portal/tests/test_profile_routing.py
@@ -0,0 +1,233 @@
+"""A message typed in another profile's chat reaches that profile's agent, and its reply comes back.
+
+The gateway only accepts a turn in a profile from the portal adapter that profile owns, so the
+default adapter (the one linked to the server) hands such messages to the other profile's adapter,
+which sends its replies back through the link. Runs against the real gateway where Hermes is
+installed; CI has no Hermes and skips.
+"""
+
+import importlib.util
+import weakref
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+pytest.importorskip("gateway.session_ingress_context")
+
+
+def load_plugin():
+    spec = importlib.util.spec_from_file_location("nako_portal_routing_test", ROOT / "__init__.py")
+    plugin = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(plugin)
+    return plugin
+
+
+class Ctx:
+    def register_hook(self, name, callback):
+        pass
+
+    def register_platform(self, **entry):
+        self.entry = entry
+
+
+class Link:
+    """The server's end, as the gateway half sees it: what was told, in order."""
+
+    peer = object()
+
+    def __init__(self):
+        self.told = []
+
+    def tell(self, *args):
+        self.told.append(args)
+
+    async def call(self, *args):
+        self.told.append(args)
+
+
+def _homes(tmp_path, monkeypatch):
+    root = tmp_path / ".hermes"
+    root.mkdir(mode=0o700)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    import hermes_state
+
+    if hasattr(hermes_state, "_IMPORT_DEFAULT_DB_PATH"):
+        monkeypatch.setattr(hermes_state, "DEFAULT_DB_PATH", hermes_state._IMPORT_DEFAULT_DB_PATH)
+    work = root / "profiles" / "work"
+    work.mkdir(parents=True, mode=0o700)
+    (work / "config.yaml").write_text("{}", encoding="utf-8")
+    return root, [("default", root), ("work", work)]
+
+
+async def _gateway(tmp_path, monkeypatch):
+    """A multiplexed gateway serving `default` and `work`, each with its own portal adapter."""
+    from gateway.config import GatewayConfig, Platform, PlatformConfig
+    from gateway.platform_registry import PlatformEntry, platform_registry
+    from gateway.run import GatewayRunner
+    from gateway.run_runtime import initialize_gateway_runtime
+    from gateway.runtime_ownership import process_ownership
+    from gateway.session_ingress_context import register_transport_home
+
+    root, homes = _homes(tmp_path, monkeypatch)
+    plugin = load_plugin()
+    ctx = Ctx()
+    plugin.register(ctx)
+    entry = {k: v for k, v in ctx.entry.items() if k in PlatformEntry.__dataclass_fields__}
+    platform_registry.register(PlatformEntry(source="plugin", **entry))
+    config = GatewayConfig()
+    config.multiplex_profiles = True
+    config._runtime_profile_homes = tuple(homes)
+    runner = GatewayRunner(config)
+    process_ownership.reserve([home for _, home in homes])
+    await initialize_gateway_runtime(runner)
+    primary = ctx.entry["adapter_factory"](PlatformConfig(enabled=True))
+    secondary = ctx.entry["adapter_factory"](PlatformConfig(enabled=True))
+    secondary.set_owner_profile("work")
+    for adapter in (primary, secondary):
+        adapter.gateway_runner = runner
+    portal = Platform("portal")
+    runner.adapters = {portal: primary}
+    runner._profile_adapters = {"work": {portal: secondary}}
+    register_transport_home(runner, None, root)
+    register_transport_home(runner, "work", dict(homes)["work"])
+
+    def close():
+        for authority in list(getattr(runner, "session_authorities", []) or []):
+            (getattr(authority, "persistence", None) or authority.db).close()
+        for _, home in homes:
+            process_ownership.release(home)
+
+    return plugin, runner, primary, secondary, dict(homes), close
+
+
+def _event(plugin, adapter, chat, profile):
+    """The event `HermesBackend.inbound` builds for a message typed in ``profile``'s ``chat``."""
+    import dataclasses
+
+    from gateway.platforms.event import MessageEvent
+
+    source = adapter.build_source(chat_id=chat, chat_type="dm", **plugin.PERSON)
+    source = dataclasses.replace(source, profile=plugin._named(profile))
+    source._transport_adapter_ref = weakref.ref(adapter)
+    return MessageEvent(text="hi", source=source, message_id="m-1")
+
+
+def _provenance(runner, event, adapter, homes):
+    from gateway.session_ingress_context import capture_provenance, native_callback
+
+    owner = getattr(adapter, "_owner_profile", None)
+    with native_callback(runner, event, homes[owner or "default"], owner):
+        return capture_provenance(runner, event)
+
+
+@pytest.mark.asyncio
+async def test_a_message_in_another_profile_goes_through_that_profiles_adapter(tmp_path, monkeypatch):
+    plugin, runner, primary, secondary, homes, close = await _gateway(tmp_path, monkeypatch)
+    try:
+        backend = plugin.HermesBackend(primary, homes["default"])
+        carrier = backend._carrier("work")
+        assert carrier is secondary
+
+        provenance = _provenance(runner, _event(plugin, carrier, "chat-w", "work"), carrier, homes)
+        assert provenance["runtime_home"] == str(homes["work"])
+    finally:
+        close()
+
+
+@pytest.mark.asyncio
+async def test_the_linked_adapter_alone_is_refused_for_another_profile(tmp_path, monkeypatch):
+    """Why the hand-off exists: the gateway won't take another profile's turn from the default adapter."""
+    try:
+        from persistence.core.errors import AuthorityRefusal as RuntimeStoreError
+    except ImportError:
+        from hermes_state_runtime import RuntimeStoreError
+
+    plugin, runner, primary, secondary, homes, close = await _gateway(tmp_path, monkeypatch)
+    try:
+        with pytest.raises(RuntimeStoreError, match="profile_mismatch"):
+            _provenance(runner, _event(plugin, primary, "chat-w", "work"), primary, homes)
+    finally:
+        close()
+
+
+@pytest.mark.asyncio
+async def test_the_default_profile_stays_on_the_linked_adapter(tmp_path, monkeypatch):
+    plugin, runner, primary, secondary, homes, close = await _gateway(tmp_path, monkeypatch)
+    try:
+        backend = plugin.HermesBackend(primary, homes["default"])
+        assert backend._carrier(None) is primary
+        provenance = _provenance(runner, _event(plugin, primary, "chat-d", None), primary, homes)
+        assert provenance["runtime_home"] == str(homes["default"])
+    finally:
+        close()
+
+
+@pytest.mark.asyncio
+async def test_the_other_profiles_adapter_never_dials_and_its_replies_reach_the_server(tmp_path, monkeypatch):
+    plugin, runner, primary, secondary, homes, close = await _gateway(tmp_path, monkeypatch)
+    try:
+        assert await secondary.connect() is True
+        assert secondary.link is None  # no second link to the server, so no refused handshake
+
+        primary.link = Link()
+        sent = await secondary.send("chat-w", "here you go")
+        assert sent.success
+        assert [(kind, chat, text) for kind, chat, _id, text in primary.link.told] == [("outgoing", "chat-w", "here you go")]
+
+        await secondary.edit_message("chat-w", "msg-1", "here you go, edited")
+        assert primary.link.told[-1] == ("outgoing", "chat-w", "msg-1", "here you go, edited")
+
+        # Closing the other profile's adapter leaves the link in place for everyone else.
+        await secondary.disconnect()
+        assert primary.link is not None
+    finally:
+        close()
+
+
+def test_portal_reads_and_updates_sessions_through_the_active_profile_store(tmp_path, monkeypatch):
+    from contextlib import ExitStack
+    from types import SimpleNamespace
+
+    persistence = pytest.importorskip("persistence_assembly")
+    from hermes_constants import get_hermes_home
+    from persistence.conversation.messages import NewMessage
+    from persistence.conversation.sessions import NewSession
+
+    root, named_homes = _homes(tmp_path, monkeypatch)
+    homes = dict(named_homes)
+    plugin = load_plugin()
+    with ExitStack() as stack:
+        stores = {
+            home: stack.enter_context(persistence.open_persistence(persistence.profile_scope(home=home)))
+            for home in homes.values()
+        }
+        adapter = SimpleNamespace(_session_store=SimpleNamespace(
+            _db=None, _scoped_persistence=lambda: stores[Path(get_hermes_home())]
+        ))
+        backend = plugin.HermesBackend(adapter, root)
+        monkeypatch.setattr(backend, "homes", lambda: homes)
+        stores[root].sessions.create(NewSession("main-chat", "portal", chat_id="main-chat"))
+        work = stores[homes["work"]]
+        work.sessions.create(NewSession("work-chat", "portal", chat_id="work-chat"))
+
+        assert [row["id"] for row in backend.sessions()] == ["main-chat"]
+        backend.profile = "work"
+        assert [row["id"] for row in backend.sessions()] == ["work-chat"]
+        assert backend.thread("main-chat") is None
+
+        work.messages.append("work-chat", NewMessage(role="user", content="First message"))
+        assert backend.thread("work-chat")["messages"][0]["text"] == "First message"
+        work.messages.append("work-chat", NewMessage(role="assistant", content="Second message"))
+        assert [row["text"] for row in backend.thread("work-chat")["messages"]] == [
+            "First message", "Second message",
+        ]
