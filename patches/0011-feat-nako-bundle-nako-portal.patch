diff --git a/plugins/nako-portal/dashboard/portal/attachments.py b/plugins/nako-portal/dashboard/portal/attachments.py
new file mode 100644
index 0000000000000000000000000000000000000000..4ec41c9ecc126d70a9e23fedd22cd8728a708c03
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/attachments.py
@@ -0,0 +1,135 @@
+"""Durable mesh deliveries, scoped to the transcript that explicitly attached them."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+import re
+import secrets
+import stat
+from pathlib import Path, PureWindowsPath
+
+from .media import shown_files
+
+MAX_FILE = 25 * 1024 * 1024
+SESSION = re.compile(r"^[\w.-]{1,120}$")
+MAX_FILES = 32
+
+
+def valid_path(raw):
+    if not isinstance(raw, str) or not raw or len(raw) > 4096 or any(ord(c) < 32 for c in raw):
+        return False
+    win = PureWindowsPath(raw)
+    # No device paths, UNC shares, traversal or NTFS alternate streams.
+    if raw.startswith(("\\\\", "//")) or ".." in raw.replace("\\", "/").split("/"):
+        return False
+    if win.drive:
+        return bool(re.match(r"^[A-Za-z]:[\\/]", raw)) and ":" not in raw[2:]
+    return raw.startswith(("/", "~/")) and ":" not in raw
+
+
+def read_attachment(raw):
+    """Read an explicit local delivery, never a symlink, device or unbounded stream."""
+    if not valid_path(raw):
+        raise ValueError("Invalid attachment path")
+    path = Path(raw).expanduser()
+    if not path.is_absolute() or any(p.is_symlink() or getattr(p, "is_junction", lambda: False)() for p in (path, *path.parents)):
+        raise ValueError("Attachments must be regular local files, not links")
+    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_BINARY", 0)
+    with os.fdopen(os.open(path, flags), "rb") as source:  # windows-footgun: ok -- binary read
+        info = os.fstat(source.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_FILE:
+            raise ValueError("Attachments must be regular files under 25 MiB")
+        data = source.read(MAX_FILE + 1)
+    if len(data) > MAX_FILE:
+        raise ValueError("Attachments must be under 25 MiB")
+    return {"path": raw, "data": base64.b64encode(data).decode()}
+
+
+def decode_attachment(item):
+    if not isinstance(item, dict) or not valid_path(item.get("path")):
+        raise ValueError("Invalid attachment path")
+    encoded = item.get("data")
+    if not isinstance(encoded, str) or len(encoded) > ((MAX_FILE + 2) // 3) * 4:
+        raise ValueError("Attachments must be under 25 MiB")
+    try:
+        data = base64.b64decode(encoded, validate=True)
+    except (ValueError, TypeError) as error:
+        raise ValueError("Invalid attachment data") from error
+    if len(data) > MAX_FILE:
+        raise ValueError("Attachments must be under 25 MiB")
+    return item["path"], data
+
+
+class Attachments:
+    def __init__(self, root):
+        self.root = Path(root).resolve()
+        self.root.mkdir(parents=True, exist_ok=True, mode=0o700)
+
+    def _key(self, session):
+        if not SESSION.fullmatch(session):
+            raise ValueError("Invalid attachment session")
+        return self.root / (hashlib.sha256(session.encode()).hexdigest() + ".json")
+
+    def view(self, session):
+        try:
+            return json.loads(self._key(session).read_text(encoding="utf-8-sig"))
+        except (FileNotFoundError, ValueError):
+            return {"files": {}}
+
+    def sessions(self):
+        for path in self.root.glob("*.json"):
+            view = json.loads(path.read_text(encoding="utf-8-sig"))
+            opened = view.get("opened") or {}
+            if opened.get("session") and view.get("files"):
+                yield opened
+
+    def _write(self, path, data):
+        temp = path.with_name(path.name + "." + secrets.token_hex(8))
+        try:
+            with temp.open("xb") as target:
+                target.write(data)
+            temp.chmod(0o600)
+            os.replace(temp, path)
+        finally:
+            temp.unlink(missing_ok=True)
+
+    def save(self, session, opened=None, item=None):
+        view = self.view(session)
+        if opened is not None:
+            if "archived" not in opened and "archived" in (view.get("opened") or {}):
+                opened = {**opened, "archived": view["opened"]["archived"]}
+            view["opened"] = opened
+        if item is not None:
+            raw, data = decode_attachment(item)
+            allowed = shown_files((view.get("opened") or {}).get("messages") or [])
+            if raw not in allowed:
+                raise ValueError("That file wasn't attached in this chat")
+            name = re.sub(r"[^\w. -]", "_", PureWindowsPath(raw).name)[:160] or "file"
+            key = hashlib.sha256(data).hexdigest() + "/" + name
+            (self.root / key).parent.mkdir(exist_ok=True, mode=0o700)
+            self._write(self.root / key, data)
+            view["files"][raw] = key
+        self._write(self._key(session), json.dumps(view).encode())
+
+    def file(self, session, raw):
+        view = self.view(session)
+        key = view.get("files", {}).get(raw)
+        if raw not in shown_files((view.get("opened") or {}).get("messages") or []):
+            return None
+        return self._blob(key)
+
+    def delivered(self, session):
+        """Only bytes received for this destination may appear in an attributed user row.
+
+        The attribution line alone is not authority: a person can type that text too.
+        """
+        return {str(path) for key in self.view(session).get("files", {}).values() if (path := self._blob(key)) is not None}
+
+    def _blob(self, key):
+        if not isinstance(key, str) or not re.fullmatch(r"[a-f0-9]{64}/[^/\\]+", key):
+            return None
+        path = self.root / key
+        return path if path.is_file() and not path.is_symlink() else None
diff --git a/plugins/nako-portal/dashboard/portal/cbor.py b/plugins/nako-portal/dashboard/portal/cbor.py
new file mode 100644
index 0000000000000000000000000000000000000000..01baf5c27c54214f7ee2b1ab1fb3f6fe2822fffd
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/cbor.py
@@ -0,0 +1,80 @@
+"""The small CBOR subset WebAuthn uses: ints, byte/text strings, arrays, maps, simple values."""
+
+from __future__ import annotations
+
+import struct
+
+
+class CborError(ValueError):
+    pass
+
+
+def decode(data: bytes, offset: int = 0):
+    """Decode one item at ``offset``. Returns (value, offset just past it)."""
+    if offset >= len(data):
+        raise CborError("truncated CBOR")
+    initial = data[offset]
+    major, info = initial >> 5, initial & 0x1F
+    offset += 1
+    if major == 7:
+        return _simple(data, offset, info)
+    length, offset = _argument(data, offset, info)
+    if major == 0:
+        return length, offset
+    if major == 1:
+        return -1 - length, offset
+    if major in (2, 3):
+        end = offset + length
+        if end > len(data):
+            raise CborError("truncated CBOR string")
+        raw = data[offset:end]
+        return (raw if major == 2 else raw.decode("utf-8")), end
+    if major == 4:
+        items = []
+        for _ in range(length):
+            item, offset = decode(data, offset)
+            items.append(item)
+        return items, offset
+    if major == 5:
+        mapping = {}
+        for _ in range(length):
+            key, offset = decode(data, offset)
+            value, offset = decode(data, offset)
+            mapping[key] = value
+        return mapping, offset
+    raise CborError(f"unsupported CBOR major type {major}")
+
+
+def _argument(data, offset, info):
+    if info < 24:
+        return info, offset
+    sizes = {24: 1, 25: 2, 26: 4, 27: 8}
+    if info not in sizes:
+        raise CborError("indefinite or reserved CBOR length")
+    size = sizes[info]
+    if offset + size > len(data):
+        raise CborError("truncated CBOR length")
+    return int.from_bytes(data[offset : offset + size], "big"), offset + size
+
+
+def _simple(data, offset, info):
+    if info == 20:
+        return False, offset
+    if info == 21:
+        return True, offset
+    if info in (22, 23):
+        return None, offset
+    if info == 25:
+        return struct.unpack(">e", data[offset : offset + 2])[0], offset + 2
+    if info == 26:
+        return struct.unpack(">f", data[offset : offset + 4])[0], offset + 4
+    if info == 27:
+        return struct.unpack(">d", data[offset : offset + 8])[0], offset + 8
+    raise CborError("unsupported CBOR simple value")
+
+
+def loads(data: bytes):
+    value, end = decode(data)
+    if end != len(data):
+        raise CborError("trailing bytes after CBOR item")
+    return value
diff --git a/plugins/nako-portal/dashboard/portal/environments.py b/plugins/nako-portal/dashboard/portal/environments.py
new file mode 100644
index 0000000000000000000000000000000000000000..93790606976a49a7ccaae429af5e03f2f2b4c9e3
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/environments.py
@@ -0,0 +1,165 @@
+"""Environments: an optional page listing whatever a local command says is running here.
+
+The owner points `environments_command` at any program that prints JSON like
+
+    {"title": "Stacks",
+     "environments": [{"name": "feature-x", "status": "running", "detail": "...", "session": "<chat id>",
+                       "links": [{"label": "app", "url": "https://..."}]}],
+     "links": [{"label": "sign in", "url": "https://..."}]}
+
+`status` is running, partial or stopped; `title`, `detail`, both `links` lists and `session` (the
+Hermes chat an environment belongs to; the chat's header then offers its links) are optional, and
+so is `memory`, the bytes it holds (the page shows it, and the high-load warning lists the biggest).
+The page keeps the command's order for what's running, so the command decides what comes first.
+Unset, the portal shows no Environments page at all.
+
+With `environments_stop_command` set too, each running environment gets a Stop button that runs
+that command with the environment's name as its last argument.
+"""
+
+import asyncio
+import json
+import logging
+import os
+import re
+import shlex
+import time
+from urllib.parse import urlparse
+
+log = logging.getLogger(__name__)
+
+STATUSES = ("running", "partial", "stopped")
+MAX_ITEMS = 200
+MAX_LINKS = 20
+SESSION = re.compile(r"[\w.-]{1,120}")
+
+
+class EnvironmentsError(Exception):
+    """The command failed, timed out or printed something that isn't the expected JSON."""
+
+
+def _text(value, limit):
+    return " ".join(str(value).split())[:limit] if isinstance(value, (str, int, float)) else ""
+
+
+def _links(raw):
+    out = []
+    for link in raw if isinstance(raw, list) else []:
+        if not isinstance(link, dict):
+            continue
+        url = str(link.get("url") or "").strip()
+        # Only web links: the page renders them as anchors.
+        if urlparse(url).scheme not in ("http", "https"):
+            continue
+        out.append({"label": _text(link.get("label"), 60) or urlparse(url).hostname or url, "url": url})
+        if len(out) == MAX_LINKS:
+            break
+    return out
+
+
+def parse(raw):
+    """The command's output, kept to the fields and shapes the page draws."""
+    try:
+        data = json.loads(raw)
+    except ValueError as error:
+        raise EnvironmentsError(f"output isn't JSON: {error}") from None
+    if not isinstance(data, dict) or not isinstance(data.get("environments"), list):
+        raise EnvironmentsError('output needs an "environments" list')
+    items = []
+    for item in data["environments"][:MAX_ITEMS]:
+        if not isinstance(item, dict) or not _text(item.get("name"), 120):
+            continue
+        status = item.get("status")
+        entry = {
+            "name": _text(item["name"], 120),
+            "status": status if status in STATUSES else "stopped",
+            "links": _links(item.get("links")),
+        }
+        memory = item.get("memory")
+        if isinstance(memory, int) and not isinstance(memory, bool) and memory >= 0:
+            entry["memory"] = memory
+        if _text(item.get("detail"), 200):
+            entry["detail"] = _text(item["detail"], 200)
+        # The chat it belongs to, when the command knows (a Hermes session id).
+        session = item.get("session")
+        if isinstance(session, str) and SESSION.fullmatch(session):
+            entry["session"] = session
+        items.append(entry)
+    return {"title": _text(data.get("title"), 40) or "Environments", "environments": items, "links": _links(data.get("links"))}
+
+
+def _args(command, setting):
+    args = shlex.split(command) if isinstance(command, str) else [str(part) for part in command]
+    if not args:
+        raise ValueError(f"{setting} is empty")
+    args[0] = os.path.expanduser(args[0])
+    return args
+
+
+class Environments:
+    """Runs the command on demand, sharing one run between callers and reusing it for `ttl` seconds."""
+
+    def __init__(self, command, *, stop_command=None, ttl=5.0, timeout=20.0, stop_timeout=60.0, clock=time.monotonic):
+        self.args = _args(command, "environments_command")
+        self.stop_args = _args(stop_command, "environments_stop_command") if stop_command else None
+        self.stop_timeout = stop_timeout
+        self.ttl = ttl
+        self.timeout = timeout
+        self.clock = clock
+        self.cached = None
+        self.at = 0.0
+        self.running = None
+        self.generation = 0
+
+    async def read(self):
+        if self.cached is not None and self.clock() - self.at < self.ttl:
+            return self.cached
+        run = self.running
+        if run is None or run.done():
+            run = self.running = asyncio.ensure_future(self._run(self.generation))
+        try:
+            result = await asyncio.shield(run)
+        finally:
+            if self.running is run and run.done():
+                self.running = None
+        return result
+
+    async def stop(self, name):
+        """Run the stop command for one environment the list shows as running or partial."""
+        if self.stop_args is None:
+            raise EnvironmentsError("no stop command is set")
+        listed = await self.read()
+        if not any(env["name"] == name and env["status"] != "stopped" for env in listed["environments"]):
+            raise LookupError(name)
+        await _exec([*self.stop_args, name], self.stop_timeout)
+        # Drop both the cache and any read that started before this stop finished.
+        self.generation += 1
+        self.cached = None
+        self.running = None
+
+    async def _run(self, generation):
+        out = await _exec(self.args, self.timeout)
+        result = parse(out)
+        if generation == self.generation:
+            self.cached, self.at = result, self.clock()
+        return result
+
+
+async def _exec(args, timeout):
+    """Run a command; its stdout, or EnvironmentsError naming what went wrong."""
+    try:
+        proc = await asyncio.create_subprocess_exec(
+            *args, stdin=asyncio.subprocess.DEVNULL, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
+        )
+    except OSError as error:
+        raise EnvironmentsError(f"can't run {args[0]}: {error.strerror or error}") from None
+    try:
+        out, err = await asyncio.wait_for(proc.communicate(), timeout)
+    except asyncio.TimeoutError:
+        proc.kill()
+        await proc.wait()
+        raise EnvironmentsError(f"{args[0]} took longer than {timeout:g}s") from None
+    if proc.returncode != 0:
+        tail = err.decode(errors="replace").strip().splitlines()[-1:] or [f"exit {proc.returncode}"]
+        raise EnvironmentsError(f"{os.path.basename(args[0])} failed: {tail[0][:200]}")
+    return out.decode(errors="replace")
diff --git a/plugins/nako-portal/dashboard/portal/hub.py b/plugins/nako-portal/dashboard/portal/hub.py
new file mode 100644
index 0000000000000000000000000000000000000000..029a851bd0aea003b17ec99cc859d67417aefa8f
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/hub.py
@@ -0,0 +1,880 @@
+"""The portal as a Hermes messaging platform, like Discord or Slack.
+
+Every portal chat is a gateway thread (`portal:<chat id>`). Prompts go in as
+gateway messages, replies come back through the adapter's sends and edits, and
+transcripts are read from Hermes's own session store. The hub and the
+web server run in their own process (`dashboard/serve.py`), so the site stays up
+while the gateway restarts; the `backend` is the gateway's adapter on the other
+end of the link (`link.py`), the only part that touches Hermes, so tests use a fake.
+
+backend:
+  sessions() -> [{id, title, preview, started_at, message_count, pinned, chat_id}]
+  thread(session) -> {title, messages}      transcript in Hermes's display projection
+  chat_of(session) / session_of(chat) -> id or None
+  title_of(session) -> str or None          any session's title (the thread a message came from)
+  new_thread(chat, title) -> session id     (async)
+  adopt(chat, session) -> session id        (async) move another surface's chat into a new thread
+  inbound(chat, text, files)                (async) a message from the person, as the gateway sees it
+  resolve(request, result)                  (async) answer an approval or question
+  set_title / set_archived / set_pinned(session, value)
+  is_archived(session) -> bool
+  set_yolo(chat)                            approvals off for one thread
+  commands() -> [{name, description, skill}]
+  processes(session) -> [{id, command, cwd, running, started_at, exited_at, exit_code, ended, notify}]   background processes the chat started
+  process_log(session, id, lines) -> {lines, total_chars} or None   one of them's latest output
+  sign_off(reply) -> str or None            a short line Nako says once a turn's reply is in
+  sign_off_models() -> [{provider, label, models}]   what the sign-off can run on
+  sign_off_model() -> {provider, model}     / set_sign_off_model(provider, model)
+  profiles() -> {profile, profiles}         the Hermes profile shown, and the ones served
+  use_profile(name) -> profiles()           show another profile's chats (ValueError if not served)
+  models() / model() / set_model(provider, model)   the shown profile's own model (ValueError if refused)
+  usage() -> [{provider, label, accounts: [{label, windows: [{label, used_percent, resets_at}], note}]}] or None
+                                            plan limits per account; None: model-controls can't report them
+  secrets() -> [{name, note, origin, created_at, updated_at}] or None   None: no secrets plugin
+  secret(name) -> value or None / set_secret(name, value, note) / remove_secret(name) -> bool
+
+A `secret` request is the agent-secrets plugin asking the person for a value. The answer goes
+to the backend like any other (`resolve`), which hands it to that plugin's vault; nothing here
+keeps it.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import re
+import uuid
+
+from .media import MEDIA
+
+log = logging.getLogger("hermes.portal")
+
+# Kinds of row a person wrote or should read; everything else is host traffic.
+PUBLISHED_KINDS = {None, "steer", "failed_turn"}
+ANSWERABLE = {"approval", "clarify", "secret"}
+WORKING = "working"
+NEEDS_YOU = "needs you"
+DONE = "done"
+FAILED = "failed"
+MAX_FILE = 25 * 1024 * 1024
+PREVIEW_CHARS = 280
+# The thread cron posts and other deliveries to `portal` land in, like a bot's DM elsewhere.
+INBOX = "inbox"
+# A second thread like it, for code-review status posts (`portal:reviews`).
+REVIEWS = "reviews"
+CHANNELS = {INBOX, REVIEWS}
+# Hermes labels every cron post it mirrors into a chat with this.
+CRON_DELIVERY = re.compile(r"^\[Cron delivery: ([^\]\n]+)\]?\n?")
+# A message sent while a turn runs is steered into it with a note for the model saying where it
+# came from; Hermes keeps that note in the saved text, but the user never typed it. Several messages
+# sent during one turn arrive joined, each with its own note at the start of a line.
+STEER_ORIGIN = re.compile(r"^Gateway message origin \([^)\n]*\):\n\{[^\n]*\}\n(?:Do not guess[^\n]*\n)?\n*", re.M)
+# When Hermes compacts a chat mid-turn it restates the unfinished request after the summary, under
+# this header, so the model carries on. The person sent that message once, earlier in the turn.
+RESTATED = re.compile(r"^\[STILL IN PROGRESS\b[^\]]*\]\s*")
+# A message another thread sent in (`nako-spawn --to`, or the brief of a thread one started). The
+# model reads this line, so it knows the text came from another thread and isn't the person's own
+# instruction; the app draws the message as that thread's, not the person's.
+FROM_THREAD = re.compile(r'^\[From another thread, not typed by the user: "([^"\n]*)" \(session ([\w.-]{1,120})\)\]\n+')
+# Hermes cuts a chat's preview short, often inside that line, so a cut-off line goes too.
+FROM_THREAD_PREVIEW = re.compile(r"^\[From another thread, not typed by the user: [^\]]*(?:\]\s*|$)")
+SESSION_ID = re.compile(r"^[\w.-]{1,120}$")
+# Prompts and replies in one page of a transcript; tool rows between them come along.
+PAGE_MESSAGES = 30
+# What the app draws from a transcript row. Hermes's rows also carry reasoning signatures, full
+# tool arguments and display metadata, which made a page of a long chat ~170 KB instead of ~10 KB.
+SHOWN_FIELDS = ("role", "text", "row_id", "timestamp", "reasoning", "label", "post", "ended", "steered", "sender", "name", "context", "tool_call_id")
+# Nako's own one-liner for the end of a reply: the model writes it in the reply, the app shows it
+# beside her and hides the tag. A tag still streaming in (`<sign`, `<signoff>proud of`) is hidden too.
+# A reply that mentions the tag in prose (`<signoff>`) isn't one: a tag holds no other tag.
+SIGN_OFF_TAG = re.compile(r"\s*<signoff>((?:(?!</?signoff>).)*?)</signoff>\s*", re.S | re.I)
+# Only on a line of its own, where the sign-off goes, so a `<signoff>` in prose isn't a tag.
+SIGN_OFF_OPEN = re.compile(r"(?:\A|\n)\s*(?:<signoff>[^<\n]*|<(?:s(?:i(?:g(?:n(?:o(?:f(?:f)?)?)?)?)?)?)?)$", re.I)
+# A post outside a turn is mirrored into the transcript just after the send returns.
+MIRROR_SETTLE = 1.0
+# A reply line that shows the person a stored secret: `SECRET:NAME` (web/src/lib/secrets.ts).
+SECRET_LINE = re.compile(r"^[^\S\n]*SECRET:([A-Za-z_][A-Za-z0-9_]{0,63})[^\S\n]*$", re.M)
