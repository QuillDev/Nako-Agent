+class Backend:
+    """FakeGateway as the hub sees it: its `sessions` dict is the backend's `sessions()` list."""
+
+    def __init__(self, fake):
+        self.fake = fake
+
+    def __getattr__(self, name):
+        return getattr(self.fake, "sessions_list" if name == "sessions" else name)
