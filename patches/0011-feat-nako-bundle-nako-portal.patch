+    async def assetlinks(self, request):
+        if not self.android_cert_sha256:
+            raise web.HTTPNotFound()
+        statement = {
+            "relation": ["delegate_permission/common.handle_all_urls", "delegate_permission/common.get_login_creds"],
+            "target": {"namespace": "android_app", "package_name": ANDROID_PACKAGE, "sha256_cert_fingerprints": [self.android_cert_sha256]},
+        }
+        return web.json_response([statement])
+
+    # Desktop app. It can't use the portal's passkeys (they live in the browser), so the browser signs
+    # in and hands the session over: the app sends the browser here with a PKCE challenge and a
+    # loopback port, the signed-in page approves and passes a one-time code to the loopback, and
+    # the app's webview trades the code plus its secret verifier for its own login cookie.
+
+    async def desktop_link(self, request):
+        credential = self._require(request)
+        body = await request.json()
+        challenge = str(body.get("challenge") or "")
+        if not PKCE_CHALLENGE.match(challenge):
+            raise ValueError("That sign-in request is malformed")
+        now = self.clock()
+        for key in [k for k, v in self.handoffs.items() if v["expires"] < now]:
+            self.handoffs.pop(key, None)
+        code = secrets.token_urlsafe(32)
+        self.handoffs[code] = {"challenge": challenge, "credential": credential, "expires": now + HANDOFF_TTL}
+        return web.json_response({"code": code})
+
+    async def desktop_session(self, request):
+        entry = self.handoffs.pop(request.query.get("code", ""), None)
+        verifier = request.query.get("verifier", "").encode()
+        proof = webauthn.b64url(hashlib.sha256(verifier).digest())
+        valid = (
+            entry is not None
+            and entry["expires"] >= self.clock()
+            and hmac.compare_digest(proof, entry["challenge"])
+            and self.store.credential(entry["credential"]) is not None
+        )
+        if not valid:
+            return web.Response(status=303, headers={"Location": "/#signin=failed"})
+        response = web.Response(status=303, headers={"Location": "/"})
+        self._set_login(response, entry["credential"])
+        return response
+
+    def _published_desktop(self):
+        """The published release: its version and, per platform, the file and its updater signature.
+        A platform whose file is missing or doesn't match the manifest's size is left out."""
+        if self.desktop_release_dir is None:
+            return None
+        try:
+            manifest = json.loads((self.desktop_release_dir / "desktop-release.json").read_text(encoding="utf-8-sig"))
+            version, platforms = manifest["version"], manifest["platforms"]
+        except (OSError, ValueError, KeyError, TypeError):
+            return None
+        if not isinstance(version, str) or not VERSION.match(version) or not isinstance(platforms, dict):
+            return None
+        files = {}
+        for platform, entry in platforms.items():
+            if not DESKTOP_PLATFORM.match(str(platform)) or not isinstance(entry, dict):
+                continue
+            name, signature, size = entry.get("file"), entry.get("signature"), entry.get("sizeBytes")
+            if not isinstance(name, str) or not DESKTOP_FILE.match(name) or not isinstance(signature, str) or not signature:
+                continue
+            path = self.desktop_release_dir / name
+            if isinstance(size, int) and path.is_file() and path.stat().st_size == size:
+                files[platform] = (name, signature)
+        return (version, files) if files else None
+
+    async def desktop_release(self, request):
+        self._require(request)
+        release = self._published_desktop()
+        if release is None:
+            raise web.HTTPNotFound()
+        version, files = release
+        # Tauri's updater format, which the app still reads; it checks the signature against the key built into it.
+        platforms = {p: {"url": f"{self.origin}/desktop/{name}", "signature": sig} for p, (name, sig) in files.items()}
+        return web.json_response({"version": version, "platforms": platforms})
+
+    async def desktop_app(self, request):
+        self._require(request)
+        release = self._published_desktop()
+        name = request.match_info["file"]
+        if release is None or name not in {n for n, _ in release[1].values()}:
+            raise web.HTTPNotFound()
+        return web.FileResponse(
+            self.desktop_release_dir / name,
+            headers={"Content-Type": "application/octet-stream", "Cache-Control": "no-store"},
+        )
+
+    async def socket(self, request):
+        self._require(request)
+        ws = web.WebSocketResponse(heartbeat=25, max_msg_size=1024 * 1024)
+        await ws.prepare(request)
+        client = _Client(ws)
+        self.hub.join(client)
+        try:
+            await ws.send_json(self._gateway_frame())
+            # Where every chat stands now; a socket that joins mid-turn would otherwise wait for the next change.
+            for frame in self.hub.status_frames() + (self.mesh.status_frames() if self.mesh is not None else []):
+                await ws.send_json(frame)
+            # That's all of them: apps from before the sticker frame drop anything else they hold.
+            await ws.send_json({"kind": "status.synced"})
+            await ws.send_json(self.hub.sticker())
+            # What runs elsewhere (Slack, cron...), which the app only watches.
+            await ws.send_json(self.hub.outside_frame())
+            async for message in ws:
+                if message.type != WSMsgType.TEXT:
+                    continue
+                try:
+                    data = json.loads(message.data)
+                except ValueError:
+                    continue
+                if not isinstance(data, dict):
+                    continue
+                if "watch" in data:
+                    session = str(data["watch"] or "")
+                    # No chat open (the new-chat screen) clears what this socket shows.
+                    self.hub.watch(client, session if SESSION_ID.match(session) else None)
+                    if self.mesh is not None and remote(session):
+                        await self.mesh.read(session)
+                if isinstance(data.get("looking"), bool):
+                    self.hub.look(client, data["looking"])
+        finally:
+            self.hub.leave(client)
+        return ws
+
+    async def static(self, request):
+        rel = request.match_info["path"] or "index.html"
+        path = (self.web_root / rel).resolve()
+        if not path.is_relative_to(self.web_root) or not path.is_file():
+            if "." in Path(rel).name:
+                raise web.HTTPNotFound()
+            path = self.web_root / "index.html"
+        if path.parent == self.web_root / "assets":
+            headers = {"Cache-Control": IMMUTABLE}
+        elif path.parent == self.web_root and path.name in HEAD_SCRIPTS:
+            headers = {"Cache-Control": CHECK_IN_BACKGROUND}
+        else:
+            headers = {"Cache-Control": "no-cache"}
+        if path.name == "sw.js":
+            headers["Service-Worker-Allowed"] = "/"
+        return web.FileResponse(path, headers=headers)
+
+
+class _Client:
+    def __init__(self, ws):
+        self.ws = ws
+        self.lock = asyncio.Lock()
+
+    async def send(self, message):
+        async with self.lock:
+            await self.ws.send_json(message)
diff --git a/plugins/nako-portal/dashboard/portal/store.py b/plugins/nako-portal/dashboard/portal/store.py
new file mode 100644
index 0000000000000000000000000000000000000000..f55c34e31ed8351b10358b92ec2ed5d8e59fcec2
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/store.py
@@ -0,0 +1,367 @@
+"""The portal's own data: passkeys, sign-in sessions, setup links, push subscriptions, inbox.
+
+Conversations are NOT stored here: they live in the Hermes session database and
+are read through the backend, so Desktop and the portal show one transcript.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import secrets
+import sqlite3
+import threading
+import time
+from pathlib import Path
+
+LOGIN_TTL = 30 * 24 * 3600
+# The colors a chat group can have, in the order new groups take them.
+GROUP_COLORS = ("blue", "green", "yellow", "orange", "red", "teal", "purple", "grey")
+GROUP_NAME_MAX = 60
+MODEL_PICKS_MAX = 100
+MODEL_PRESET_NAME_MAX = 40
+SETUP_TTL = 3600
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS credentials (
+    id BLOB PRIMARY KEY,
+    cose_key BLOB NOT NULL,
+    sign_count INTEGER NOT NULL,
+    label TEXT NOT NULL,
+    created_at REAL NOT NULL,
+    last_used_at REAL
+);
+CREATE TABLE IF NOT EXISTS logins (
+    token_hash TEXT PRIMARY KEY,
+    credential_id BLOB NOT NULL,
+    created_at REAL NOT NULL,
+    expires_at REAL NOT NULL
+);
+CREATE TABLE IF NOT EXISTS setup_links (
+    token_hash TEXT PRIMARY KEY,
+    expires_at REAL NOT NULL
+);
+CREATE TABLE IF NOT EXISTS meta (
+    key TEXT PRIMARY KEY,
+    value TEXT NOT NULL
+);
+CREATE TABLE IF NOT EXISTS push_subscriptions (
+    endpoint TEXT PRIMARY KEY,
+    keys_json TEXT NOT NULL,
+    created_at REAL NOT NULL
+);
+CREATE TABLE IF NOT EXISTS chat_groups (
+    id TEXT PRIMARY KEY,
+    name TEXT NOT NULL,
+    color TEXT NOT NULL,
+    created_at REAL NOT NULL
+);
+CREATE TABLE IF NOT EXISTS chat_group_members (
+    chat TEXT PRIMARY KEY,
+    group_id TEXT NOT NULL
+);
+CREATE TABLE IF NOT EXISTS inbox (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    chat TEXT NOT NULL,
+    text TEXT NOT NULL,
+    created_at REAL NOT NULL
+);
+"""
+
+
+def _hash(token: str) -> str:
+    return hashlib.sha256(token.encode()).hexdigest()
+
+
+def _text(value, field, *, most=200, required=True):
+    if not isinstance(value, str) or len(value) > most or (required and not value.strip()):
+        raise ValueError(f"A model pick needs a {field}")
+    return value
+
+
+def _model_route(value, *, tuned):
+    """A provider and model, plus the effort and speed when the pick is tuned."""
+    if not isinstance(value, dict):
+        raise ValueError("A model pick needs a provider and model")
+    route = {"provider": _text(value.get("provider"), "provider"), "model": _text(value.get("model"), "model")}
+    if tuned:
+        route["effort"] = _text(value.get("effort", ""), "effort", most=40, required=False)
+        route["speed"] = _text(value.get("speed", ""), "speed", most=40, required=False)
+    return route
+
+
+def _model_preset(value):
+    if not isinstance(value, dict):
+        raise ValueError("A preset needs a name and a model")
+    name = _text(value.get("name"), "name", most=MODEL_PRESET_NAME_MAX).strip()
+    return {
+        "id": _text(value.get("id"), "id", most=64),
+        "name": name,
+        "icon": _text(value.get("icon", ""), "icon", most=32, required=False),
+        "pick": _model_route(value.get("pick"), tuned=True),
+    }
+
+
+class Store:
+    def __init__(self, path: Path, clock=time.time):
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        os.chmod(self.path.parent, 0o700)
+        self.clock = clock
+        self.lock = threading.Lock()
+        self.db = sqlite3.connect(self.path, check_same_thread=False, isolation_level=None)
+        os.chmod(self.path, 0o600)
+        self.db.execute("PRAGMA journal_mode=WAL")
+        self.db.executescript(SCHEMA)
+
+    def _run(self, sql, args=()):
+        with self.lock:
+            return self.db.execute(sql, args).fetchall()
+
+    # Passkeys
+
+    def has_credentials(self) -> bool:
+        return bool(self._run("SELECT 1 FROM credentials LIMIT 1"))
+
+    def add_credential(self, credential_id: bytes, cose_key: bytes, sign_count: int, label: str) -> None:
+        self._run(
+            "INSERT INTO credentials (id, cose_key, sign_count, label, created_at) VALUES (?, ?, ?, ?, ?)",
+            (credential_id, cose_key, sign_count, label, self.clock()),
+        )
+
+    def credential(self, credential_id: bytes):
+        rows = self._run("SELECT id, cose_key, sign_count, label FROM credentials WHERE id=?", (credential_id,))
+        if not rows:
+            return None
+        cid, key, count, label = rows[0]
+        return {"id": cid, "cose_key": key, "sign_count": count, "label": label}
+
+    def credentials(self):
+        rows = self._run("SELECT id, label, created_at, last_used_at FROM credentials ORDER BY created_at")
+        return [{"id": r[0], "label": r[1], "created_at": r[2], "last_used_at": r[3]} for r in rows]
+
+    def used_credential(self, credential_id: bytes, sign_count: int) -> None:
+        self._run(
+            "UPDATE credentials SET sign_count=?, last_used_at=? WHERE id=?", (sign_count, self.clock(), credential_id)
+        )
+
+    def remove_credential(self, credential_id: bytes) -> None:
+        self._run("DELETE FROM credentials WHERE id=?", (credential_id,))
+        self._run("DELETE FROM logins WHERE credential_id=?", (credential_id,))
+
+    # Sign-in sessions
+
+    def start_login(self, credential_id: bytes) -> str:
+        token = secrets.token_urlsafe(32)
+        now = self.clock()
+        self._run(
+            "INSERT INTO logins (token_hash, credential_id, created_at, expires_at) VALUES (?, ?, ?, ?)",
+            (_hash(token), credential_id, now, now + LOGIN_TTL),
+        )
+        return token
+
+    def login(self, token: str | None):
+        """The signed-in passkey for a cookie token, or None. Use renews the session."""
+        if not token:
+            return None
+        now = self.clock()
+        rows = self._run("SELECT credential_id, expires_at FROM logins WHERE token_hash=?", (_hash(token),))
+        if not rows or rows[0][1] < now:
+            return None
+        credential_id = rows[0][0]
+        if self.credential(credential_id) is None:
+            return None
+        self._run("UPDATE logins SET expires_at=? WHERE token_hash=?", (now + LOGIN_TTL, _hash(token)))
+        return credential_id
+
+    def end_login(self, token: str | None) -> None:
+        if token:
+            self._run("DELETE FROM logins WHERE token_hash=?", (_hash(token),))
+
+    # Setup links: the only way to add the first passkey.
+
+    def new_setup_link(self) -> str:
+        token = secrets.token_urlsafe(32)
+        self._run(
+            "INSERT INTO setup_links (token_hash, expires_at) VALUES (?, ?)", (_hash(token), self.clock() + SETUP_TTL)
+        )
+        return token
+
+    def setup_link_valid(self, token: str | None) -> bool:
+        if not token:
+            return False
+        rows = self._run("SELECT expires_at FROM setup_links WHERE token_hash=?", (_hash(token),))
+        return bool(rows) and rows[0][0] >= self.clock()
+
+    def use_setup_link(self, token: str) -> bool:
+        with self.lock:
+            cursor = self.db.execute(
+                "DELETE FROM setup_links WHERE token_hash=? AND expires_at>=?", (_hash(token), self.clock())
+            )
+            return cursor.rowcount == 1
+
+    # Small settings
+
+    def meta(self, key, default=None):
+        rows = self._run("SELECT value FROM meta WHERE key=?", (key,))
+        return json.loads(rows[0][0]) if rows else default
+
+    def set_meta(self, key, value):
+        self._run("INSERT OR REPLACE INTO meta (key, value) VALUES (?, ?)", (key, json.dumps(value)))
+
+    # Model presets and favorites: the owner's picks in the model picker, kept here so every
+    # device sees the same ones and a cleared browser loses none of them.
+
+    def model_picks(self):
+        return {"presets": self.meta("model_presets", []), "favorites": self.meta("model_favorites", [])}
+
+    def put_model_preset(self, preset):
+        """Add a preset, or replace the one with its id."""
+        preset = _model_preset(preset)
+        with self.lock:
+            presets = self._meta_locked("model_presets")
+            ids = [p["id"] for p in presets]
+            if preset["id"] in ids:
+                presets[ids.index(preset["id"])] = preset
+            elif len(presets) >= MODEL_PICKS_MAX:
+                raise ValueError(f"Keep it to {MODEL_PICKS_MAX} presets")
+            else:
+                presets.append(preset)
+            self._set_meta_locked("model_presets", presets)
+        return self.model_picks()
+
+    def remove_model_preset(self, preset_id):
+        with self.lock:
+            presets = self._meta_locked("model_presets")
+            self._set_meta_locked("model_presets", [p for p in presets if p["id"] != preset_id])
+        return self.model_picks()
+
+    def toggle_model_favorite(self, favorite):
+        """Star a model (with or without tuning), or unstar it if it's already starred."""
+        favorite = _model_route(favorite, tuned="effort" in (favorite or {}))
+        with self.lock:
+            favorites = self._meta_locked("model_favorites")
+            kept = [f for f in favorites if f != favorite]
+            if len(kept) == len(favorites):
+                if len(kept) >= MODEL_PICKS_MAX:
+                    raise ValueError(f"Keep it to {MODEL_PICKS_MAX} favorites")
+                kept.append(favorite)
+            self._set_meta_locked("model_favorites", kept)
+        return self.model_picks()
+
+    def _meta_locked(self, key):
+        row = self.db.execute("SELECT value FROM meta WHERE key=?", (key,)).fetchone()
+        return json.loads(row[0]) if row else []
+
+    def _set_meta_locked(self, key, value):
+        self.db.execute("INSERT OR REPLACE INTO meta (key, value) VALUES (?, ?)", (key, json.dumps(value)))
+
+    # Chat groups: named, colored sets of chats, kept by each chat's thread id (it outlives a
+    # session rotating under it). A chat is in at most one group.
+
+    def groups(self):
+        rows = self._run("SELECT id, name, color FROM chat_groups ORDER BY created_at")
+        return [{"id": r[0], "name": r[1], "color": r[2]} for r in rows]
+
+    def group(self, ref):
+        """A group by id, or by name ignoring case."""
+        ref = str(ref or "").strip()
+        rows = self._run(
+            "SELECT id, name, color FROM chat_groups WHERE id=? OR name=? COLLATE NOCASE ORDER BY id=? DESC LIMIT 1", (ref, ref, ref)
+        )
+        if not rows:
+            raise ValueError(f"No group called {ref!r}")
+        return {"id": rows[0][0], "name": rows[0][1], "color": rows[0][2]}
+
+    @staticmethod
+    def _group_name(name):
+        name = " ".join(str(name or "").split())[:GROUP_NAME_MAX]
+        if not name:
+            raise ValueError("Give the group a name")
+        return name
+
+    @staticmethod
+    def _group_color(color):
+        if color not in GROUP_COLORS:
+            raise ValueError(f"Pick a color from {', '.join(GROUP_COLORS)}")
+        return color
+
+    def create_group(self, name, color=None):
+        name = self._group_name(name)
+        with self.lock:
+            if self.db.execute("SELECT 1 FROM chat_groups WHERE name=? COLLATE NOCASE", (name,)).fetchone():
+                raise ValueError(f"There's already a group called {name!r}")
+            if color is None:
+                used = [r[0] for r in self.db.execute("SELECT color FROM chat_groups")]
+                color = min(GROUP_COLORS, key=lambda c: (used.count(c), GROUP_COLORS.index(c)))
+            group = {"id": secrets.token_hex(6), "name": name, "color": self._group_color(color)}
+            self.db.execute(
+                "INSERT INTO chat_groups (id, name, color, created_at) VALUES (?, ?, ?, ?)",
+                (group["id"], name, group["color"], self.clock()),
+            )
+        return group
+
+    def update_group(self, ref, name=None, color=None):
+        group = self.group(ref)
+        if name is not None:
+            name = self._group_name(name)
+            clash = self._run("SELECT 1 FROM chat_groups WHERE name=? COLLATE NOCASE AND id<>?", (name, group["id"]))
+            if clash:
+                raise ValueError(f"There's already a group called {name!r}")
+            group["name"] = name
+        if color is not None:
+            group["color"] = self._group_color(color)
+        self._run("UPDATE chat_groups SET name=?, color=? WHERE id=?", (group["name"], group["color"], group["id"]))
+        return group
+
+    def delete_group(self, ref):
+        """Remove a group. Its chats stay; they're just no longer grouped."""
+        group = self.group(ref)
+        with self.lock:
+            self.db.execute("DELETE FROM chat_group_members WHERE group_id=?", (group["id"],))
+            self.db.execute("DELETE FROM chat_groups WHERE id=?", (group["id"],))
+        return group
+
+    def set_chat_group(self, chat, ref):
+        """Put a chat in a group (moving it out of any other), or take it out with ref None."""
+        if ref is None:
+            self._run("DELETE FROM chat_group_members WHERE chat=?", (chat,))
+            return None
+        group = self.group(ref)
+        self._run("INSERT OR REPLACE INTO chat_group_members (chat, group_id) VALUES (?, ?)", (chat, group["id"]))
+        return group
+
+    def chat_groups(self):
+        """chat -> its group."""
+        groups = {g["id"]: g for g in self.groups()}
+        rows = self._run("SELECT chat, group_id FROM chat_group_members")
+        return {chat: groups[gid] for chat, gid in rows if gid in groups}
+
+    # Push subscriptions
+
+    def add_push(self, endpoint: str, keys: dict) -> None:
+        self._run(
+            "INSERT OR REPLACE INTO push_subscriptions (endpoint, keys_json, created_at) VALUES (?, ?, ?)",
+            (endpoint, json.dumps(keys), self.clock()),
+        )
+
+    def pushes(self):
+        rows = self._run("SELECT endpoint, keys_json FROM push_subscriptions")
+        return [{"endpoint": r[0], "keys": json.loads(r[1])} for r in rows]
+
+    def remove_push(self, endpoint: str) -> None:
+        self._run("DELETE FROM push_subscriptions WHERE endpoint=?", (endpoint,))
+
+    # Inbox: messages the gateway delivers to the portal (cron results, send_message).
+
+    def deliver(self, chat: str, text: str) -> int:
+        with self.lock:
+            cursor = self.db.execute(
+                "INSERT INTO inbox (chat, text, created_at) VALUES (?, ?, ?)", (chat, text, self.clock())
+            )
+            return int(cursor.lastrowid or 0)
+
+    def inbox(self, limit=200):
+        rows = self._run("SELECT id, chat, text, created_at FROM inbox ORDER BY id DESC LIMIT ?", (limit,))
+        return [{"id": r[0], "chat": r[1], "text": r[2], "created_at": r[3]} for r in rows]
diff --git a/plugins/nako-portal/dashboard/portal/webauthn.py b/plugins/nako-portal/dashboard/portal/webauthn.py
new file mode 100644
index 0000000000000000000000000000000000000000..3b2ce212d5d9d0cb98c83b431e5a7a04bc57ac31
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/webauthn.py
@@ -0,0 +1,173 @@
+"""Passkey registration and sign-in checks (WebAuthn level 2, attestation "none").
+
+Only what a single-owner portal needs: ES256 and RS256 keys, user verification
+required, no attestation trust chain. Every check the spec makes the relying
+party responsible for is here: ceremony type, challenge, origin, RP ID hash,
+user presence and verification flags, signature and signature counter.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+from dataclasses import dataclass
+
+from cryptography.exceptions import InvalidSignature
+from cryptography.hazmat.primitives import hashes
+from cryptography.hazmat.primitives.asymmetric import ec, padding, rsa
+
+from . import cbor
+
+ES256 = -7
+RS256 = -257
+FLAG_UP = 0x01
+FLAG_UV = 0x04
+FLAG_AT = 0x40
+
+
+class WebAuthnError(ValueError):
+    pass
+
+
+def android_origin(cert_sha256: str) -> str:
+    """The origin Android's Credential Manager signs for an app, from its signing cert's SHA-256 (AA:BB:...)."""
+    raw = bytes.fromhex(cert_sha256.replace(":", ""))
+    return "android:apk-key-hash:" + b64url(raw)
+
+
+def b64url(data: bytes) -> str:
+    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()
+
+
+def unb64url(text: str) -> bytes:
+    try:
+        return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))
+    except (ValueError, TypeError) as error:
+        raise WebAuthnError("malformed base64url") from error
+
+
+@dataclass
+class AuthData:
+    rp_id_hash: bytes
+    flags: int
+    sign_count: int
+    credential_id: bytes | None = None
+    public_key: dict | None = None
+
+
+def parse_auth_data(raw: bytes) -> AuthData:
+    if len(raw) < 37:
+        raise WebAuthnError("authenticator data too short")
+    data = AuthData(raw[:32], raw[32], int.from_bytes(raw[33:37], "big"))
+    if data.flags & FLAG_AT:
+        if len(raw) < 55:
+            raise WebAuthnError("attested credential data too short")
+        length = int.from_bytes(raw[53:55], "big")
+        data.credential_id = raw[55 : 55 + length]
+        if len(data.credential_id) != length:
+            raise WebAuthnError("credential id truncated")
+        key, _ = cbor.decode(raw, 55 + length)
+        if not isinstance(key, dict):
+            raise WebAuthnError("credential public key is not a COSE map")
+        data.public_key = key
+    return data
+
+
+def _client_data(raw: bytes, ceremony: str, challenge: bytes, origin) -> None:
+    try:
+        client = json.loads(raw)
+    except ValueError as error:
+        raise WebAuthnError("client data is not JSON") from error
+    if client.get("type") != ceremony:
+        raise WebAuthnError("wrong ceremony type")
+    if unb64url(str(client.get("challenge", ""))) != challenge:
+        raise WebAuthnError("challenge mismatch")
+    allowed = {origin} if isinstance(origin, str) else set(origin)
+    if client.get("origin") not in allowed:
+        raise WebAuthnError("origin mismatch")
+    if client.get("crossOrigin"):
+        raise WebAuthnError("cross-origin ceremony")
+
+
+def _check_flags_and_rp(data: AuthData, rp_id: str) -> None:
+    if data.rp_id_hash != hashlib.sha256(rp_id.encode()).digest():
+        raise WebAuthnError("RP ID mismatch")
+    if not data.flags & FLAG_UP:
+        raise WebAuthnError("user not present")
+    if not data.flags & FLAG_UV:
+        raise WebAuthnError("user not verified")
+
+
+def public_key_from_cose(cose: dict):
+    alg = cose.get(3)
+    if alg == ES256 and cose.get(1) == 2 and cose.get(-1) == 1:
+        x, y = cose.get(-2), cose.get(-3)
+        if not (isinstance(x, bytes) and isinstance(y, bytes) and len(x) == len(y) == 32):
+            raise WebAuthnError("bad EC2 key")
+        return ec.EllipticCurvePublicNumbers(int.from_bytes(x, "big"), int.from_bytes(y, "big"), ec.SECP256R1()).public_key()
+    if alg == RS256 and cose.get(1) == 3:
+        n, e = cose.get(-1), cose.get(-2)
+        if not (isinstance(n, bytes) and isinstance(e, bytes)):
+            raise WebAuthnError("bad RSA key")
+        return rsa.RSAPublicNumbers(int.from_bytes(e, "big"), int.from_bytes(n, "big")).public_key()
+    raise WebAuthnError("unsupported key type")
+
+
+@dataclass
+class Registered:
+    credential_id: bytes
+    cose_key: bytes
+    sign_count: int
+
+
+def verify_registration(*, client_data_json: bytes, attestation_object: bytes, challenge: bytes, origin, rp_id: str) -> Registered:
+    _client_data(client_data_json, "webauthn.create", challenge, origin)
+    try:
+        attestation = cbor.loads(attestation_object)
+    except cbor.CborError as error:
+        raise WebAuthnError("attestation object is not CBOR") from error
+    if not isinstance(attestation, dict) or not isinstance(attestation.get("authData"), bytes):
+        raise WebAuthnError("attestation object has no authenticator data")
+    data = parse_auth_data(attestation["authData"])
+    _check_flags_and_rp(data, rp_id)
+    if data.credential_id is None or data.public_key is None:
+        raise WebAuthnError("no attested credential")
+    public_key_from_cose(data.public_key)  # rejects keys we can't verify with later
+    raw = attestation["authData"]
+    key_start = 55 + len(data.credential_id)
+    _, key_end = cbor.decode(raw, key_start)
+    return Registered(data.credential_id, raw[key_start:key_end], data.sign_count)
+
+
+def verify_assertion(
+    *,
+    client_data_json: bytes,
+    authenticator_data: bytes,
+    signature: bytes,
+    challenge: bytes,
+    origin,
+    rp_id: str,
+    cose_key: bytes,
+    stored_sign_count: int,
+) -> int:
+    """Returns the new signature counter."""
+    _client_data(client_data_json, "webauthn.get", challenge, origin)
+    data = parse_auth_data(authenticator_data)
+    _check_flags_and_rp(data, rp_id)
+    cose = cbor.loads(cose_key)
+    if not isinstance(cose, dict):
+        raise WebAuthnError("stored key is not a COSE map")
+    key = public_key_from_cose(cose)
+    signed = authenticator_data + hashlib.sha256(client_data_json).digest()
+    try:
+        if isinstance(key, ec.EllipticCurvePublicKey):
+            key.verify(signature, signed, ec.ECDSA(hashes.SHA256()))
+        else:
+            key.verify(signature, signed, padding.PKCS1v15(), hashes.SHA256())
+    except InvalidSignature as error:
+        raise WebAuthnError("bad signature") from error
+    if (data.sign_count or stored_sign_count) and data.sign_count <= stored_sign_count:
+        # A counter that didn't move forward means a cloned authenticator.
+        raise WebAuthnError("signature counter went backwards")
+    return data.sign_count
