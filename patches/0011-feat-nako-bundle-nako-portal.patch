+class HubOverLink:
+    """What the fake gateway tells the hub, sent over the link like the real adapter does."""
+
+    def __init__(self, client):
+        self.client = client
+
+    def __getattr__(self, name):
+        return lambda *args: self.client.call(name, *args)
+
