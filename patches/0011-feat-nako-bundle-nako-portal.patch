+/* The portal's own palette, following the system like the portal does by default. */
+:root {
+  color-scheme: dark;
+  --background: #09090b;
+  --text: #ececef;
+  --muted: #8e8e99;
+  --hover: #18181c;
+  --border: rgb(255 255 255 / 7%);
+}
+@media (prefers-color-scheme: light) {
+  :root {
+    color-scheme: light;
+    --background: #fbfbfc;
+    --text: #18181b;
+    --muted: #6b6b76;
+    --hover: #ededf0;
+    --border: rgb(0 0 0 / 8%);
+  }
+}
+* { box-sizing: border-box; }
+[hidden] { display: none !important; }
+html, body { margin: 0; height: 100%; overflow: hidden; background: var(--background); color: var(--text); font: 13px Inter, system-ui, sans-serif; user-select: none; }
+/* The pane's toolbar is also the window's title bar while the pane is open. */
+header { height: 40px; display: flex; align-items: center; gap: 2px; padding: 0 6px; border-bottom: 1px solid var(--border); }
+button { width: 32px; height: 28px; flex: none; padding: 0; display: grid; place-items: center; border: 0; border-radius: 8px; background: transparent; color: var(--muted); cursor: pointer; }
+button:hover { background: var(--hover); color: var(--text); }
+button:focus-visible { outline: 2px solid rgb(244 114 182 / 60%); outline-offset: -2px; }
+button.close:hover { background: #e81123; color: white; }
+svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
+svg.caption { width: 10px; height: 10px; stroke-width: 1; stroke-linecap: butt; stroke-linejoin: miter; }
+#go { flex: 1; min-width: 0; margin: 0 6px; }
+#address { width: 100%; height: 28px; padding: 0 10px; border: 1px solid transparent; border-radius: 8px; background: transparent; color: var(--muted); font: inherit; text-overflow: ellipsis; outline: none; user-select: text; }
+#address:hover { background: var(--hover); }
+#address:focus { background: var(--hover); border-color: rgb(244 114 182 / 45%); color: var(--text); }
+#address::placeholder { color: var(--muted); }
+#window { display: flex; gap: 2px; margin-left: 4px; }
+/* One chat's tabs, under the toolbar. */
+header:has(+ #tabs:not([hidden])) { border-bottom: 0; }
+#tabs { height: 32px; display: flex; align-items: center; gap: 2px; padding: 0 6px 4px; border-bottom: 1px solid var(--border); overflow-x: auto; scrollbar-width: none; }
+.tab { flex: 0 1 180px; min-width: 72px; height: 26px; display: flex; align-items: center; border-radius: 8px; color: var(--muted); }
+.tab:hover { background: var(--hover); }
+.tab[aria-current] { background: var(--hover); color: var(--text); }
+.tab .name { flex: 1; width: auto; min-width: 0; height: 26px; padding: 0 4px 0 10px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; font: inherit; color: inherit; }
+.tab .name:hover { background: transparent; color: inherit; }
+.tab .shut { width: 22px; height: 22px; margin-right: 2px; border-radius: 6px; visibility: hidden; }
+.tab:hover .shut, .tab[aria-current] .shut { visibility: visible; }
+.tab .shut svg { width: 12px; height: 12px; }
+/* The window has no system title bar on Windows and Linux: these strips move it. */
+[data-tauri-drag-region] { -webkit-app-region: drag; }
+[data-tauri-drag-region] :is(button, input, a) { -webkit-app-region: no-drag; }
