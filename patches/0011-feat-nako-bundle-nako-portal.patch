@@ -0,0 +1,7 @@
+// Which clicked links leave the app for the system browser.
+
+/**
+ * Cmd-click (Ctrl-click off macOS) or a middle click on an outside web link asks Electron for a
+ * background tab: that one goes to the system browser. `onPortal(url)` tells the portal's own pages apart.
+ */
+export const toSystemBrowser = (url, disposition, onPortal) => disposition === "background-tab" && /^https?:/i.test(url) && !onPortal(url)
diff --git a/plugins/nako-portal/desktop/src/main.js b/plugins/nako-portal/desktop/src/main.js
new file mode 100644
index 0000000000000000000000000000000000000000..f0cbe2d658883de1967f20dc1304e04fead400aa
--- /dev/null
+++ b/plugins/nako-portal/desktop/src/main.js
@@ -0,0 +1,511 @@
+// Nako Portal's desktop app: the portal's own web app in a window, plus the glue a browser tab
+// can't do (a server prompt, browser sign-in, notifications, an in-app browser, self-updates).
+import { mkdirSync, readFileSync, realpathSync, writeFileSync } from "node:fs"
+import { dirname, join } from "node:path"
+import { fileURLToPath } from "node:url"
+
+import { BaseWindow, Menu, Notification, Tray, WebContentsView, app, ipcMain, nativeImage, session, shell } from "electron"
+
+import { GOOGLE_SIGN_IN, browserAgent as agentFrom, signInAgent } from "./agent.js"
+import { listen } from "./alerts.js"
+import { FloatingNako } from "./bubble.js"
+import { toSystemBrowser } from "./links.js"
+import { ServerOrigin } from "./origin.js"
+import { Pane } from "./pane.js"
+import { begin } from "./signin.js"
+import { Updater, announcement, platformKey, readPublicKey } from "./update.js"
+
+const here = dirname(fileURLToPath(import.meta.url))
+const root = join(here, "..")
+const IDENTIFIER = "moe.nakode.portal"
+const MAC = process.platform === "darwin"
+const log = message => console.error(`nako: ${message}`)
+
+// Settings live where the earlier app kept them, so an update keeps the portal address.
+app.setPath("userData", join(app.getPath("appData"), IDENTIFIER))
+if (!app.requestSingleInstanceLock()) app.exit(0)
+
+const hidden = process.argv.includes("--hidden")
+let window = null
+let portal = null
+let pane = null
+let tray = null
+let origin = null
+let listener = null
+let signIn = null
+let floating = null
+let quitting = false
+
+const icon = name => nativeImage.createFromPath(join(root, "icons", name))
+
+// ---- the portal address ----
+
+const settingsPath = () => join(app.getPath("userData"), "settings.json")
+
+function settings() {
+  try {
+    return JSON.parse(readFileSync(settingsPath(), "utf8")) ?? {}
+  } catch {
+    return {}
+  }
+}
+
+function saveSettings(changes) {
+  mkdirSync(dirname(settingsPath()), { recursive: true })
+  writeFileSync(settingsPath(), JSON.stringify({ ...settings(), ...changes }, null, 2))
+}
+
+const savedOrigin = () => ServerOrigin.parse(settings().origin)
+
+const saveOrigin = origin => saveSettings({ origin: origin.value })
+
+async function reachable(origin) {
+  let me
+  try {
+    const response = await fetch(origin.page("/api/me"), { signal: AbortSignal.timeout(10_000) })
+    me = await response.json().catch(() => null)
+  } catch (error) {
+    log(`${origin.value}: ${error.message}`)
+    throw new Error(`Can't reach ${origin.value}`)
+  }
+  if (!me || !("signed_in" in me)) throw new Error(`${origin.value} isn't a Nako portal`)
+}
+
+const localPage = query => portal.webContents.loadFile(join(root, "ui", "index.html"), { search: query })
+
+function openPortal(next) {
+  const changed = origin?.value !== next.value
+  origin = next
+  if (changed || !listener) {
+    listener?.stop()
+    listener = listen({ origin, cookie: cookieHeader, onAlert: showAlert, onFrame: text => floating?.frame(text), log })
+    updater.watch(origin)
+    if (changed) {
+      pane?.reset()
+      floating?.reset()
+    }
+  }
+  portal.webContents.loadURL(origin.url)
+  refreshFloating()
+}
+
+async function cookieHeader() {
+  if (!origin) return null
+  const cookies = await session.defaultSession.cookies.get({ url: origin.url })
+  const header = cookies.map(c => `${c.name}=${c.value}`).join("; ")
+  return header || null
+}
+
+const onPortal = url => Boolean(origin?.opensInApp(url))
+
+// ---- what pages may ask ----
+
+/** Commands, and who may send them: the app's own pages (file://), the portal, or the browser's toolbar. */
+const COMMANDS = {
+  start: ["local"],
+  connect: ["local"],
+  pane: ["bar"],
+  pane_divider: ["divider"],
+  pane_chat: ["portal"],
+  pane_search: ["portal"],
+  pane_toggle: ["portal"],
+  floating: ["portal"],
+  update: ["portal"],
+  "plugin:window|minimize": ["local", "portal", "bar"],
+  "plugin:window|toggle_maximize": ["local", "portal", "bar"],
+  "plugin:window|internal_toggle_maximize": ["local", "portal", "bar"],
+  "plugin:window|close": ["local", "portal", "bar"],
+}
+
+function sender(event) {
+  const url = event.senderFrame?.url ?? ""
+  if (pane?.bar && event.sender === pane.bar.webContents) return url.startsWith("file:") ? "bar" : null
+  if (pane?.divider && event.sender === pane.divider.webContents) return url.startsWith("file:") ? "divider" : null
+  if (event.sender !== portal?.webContents) return null
+  if (url.startsWith("file:")) return "local"
+  return onPortal(url) ? "portal" : null
+}
+
+ipcMain.handle("nako", async (event, command, args = {}) => {
+  if (!COMMANDS[command]?.includes(sender(event))) throw new Error(`${command} not allowed`)
+  switch (command) {
+    case "start": {
+      const saved = savedOrigin()
+      if (!saved) return { kind: "ask", origin: null }
+      if (args.change) return { kind: "ask", origin: saved.value }
+      try {
+        await reachable(saved)
+      } catch (error) {
+        return { kind: "unreachable", origin: saved.value, error: error.message }
+      }
+      openPortal(saved)
+      return { kind: "open" }
+    }
+    case "connect": {
+      const next = ServerOrigin.parse(args.address)
+      if (!next) throw new Error("Enter an address like https://portal.example.com")
+      await reachable(next)
+      saveOrigin(next)
+      openPortal(next)
+      return null
+    }
+    case "pane":
+      return pane.action(String(args.action), args.target == null ? null : String(args.target))
+    case "pane_divider":
+      return pane.drag(String(args.action), args.target == null ? null : String(args.target))
+    case "pane_chat":
+      return pane.chat(typeof args.chat === "string" ? args.chat : null)
+    case "pane_search":
+      return pane.search(String(args.engine))
+    case "pane_toggle":
+      return pane.toggle()
+    case "floating":
+      return setFloating(Boolean(args.on))
+    case "update":
+      if (args.action === "install") return void updater.install(false)
+      return void updater.check()
+    case "plugin:window|minimize":
+      return window.minimize()
+    case "plugin:window|toggle_maximize":
+    case "plugin:window|internal_toggle_maximize":
+      return window.isMaximized() ? window.unmaximize() : window.maximize()
+    case "plugin:window|close":
+      return window.close()
+  }
+})
+
+// ---- the portal's view ----
+
+/** Same-origin pages stay in the app; other web pages open in the in-app browser, everything else goes to the system. */
+function navigate(event, url) {
+  if (url.startsWith("file:")) return
+  if (!onPortal(url)) {
+    event.preventDefault()
+    if (/^https?:/i.test(url)) pane.open(url)
+    else external(url)
+    return
+  }
+  const path = new URL(url).pathname
+  // The sign-in page's button for the desktop app.
+  if (path === "/desktop/sign-in") {
+    event.preventDefault()
+    startSignIn()
+  }
+  // The portal's update button, shown once an update is downloaded.
+  if (path === "/desktop/update") {
+    event.preventDefault()
+    updater.install(false)
+  }
+}
+
+async function startSignIn() {
+  signIn?.cancel()
+  const handoff = await begin(origin)
+  signIn = handoff
+  external(handoff.browserUrl)
+  const finish = await handoff.wait(300_000)
+  if (finish && signIn === handoff) {
+    portal.webContents.loadURL(finish)
+    showMain()
+  }
+}
+
+/** Tells the portal whether its window buttons belong to it (the pane's toolbar has them while open) and whether the browser is open. */
+function tellPortal() {
+  const open = Boolean(pane?.isOpen)
+  const controls = MAC ? "" : `if (window.nakoWindow) { window.nakoWindow.controls = ${!open}; window.dispatchEvent(new Event("nako-window")) }`
+  const browser = `if (window.nakoBrowser) { window.nakoBrowser.open = ${open}; window.dispatchEvent(new Event("nako-browser")) }`
+  // Settings' "Floating Nako" switch reads this.
+  const float = `window.nakoFloating = { on: ${floatingOn()} }; window.dispatchEvent(new Event("nako-floating"))`
+  if (onPortal(portal.webContents.getURL())) portal.webContents.executeJavaScript(controls + browser + float).catch(() => {})
+}
+
+// The portal marks its title bar strips for the earlier app's drag regions; Chromium drags by CSS.
+const DRAG = `[data-tauri-drag-region] { -webkit-app-region: drag }
+[data-tauri-drag-region] :is(button, a, input, select, textarea, [role="button"], [role="menuitem"], [data-radix-collection-item]) { -webkit-app-region: no-drag }`
+
+const browserAgent = () => agentFrom(app.userAgentFallback)
+
+function createWindow() {
+  window = new BaseWindow({
+    title: "Nako",
+    width: 1100,
+    height: 780,
+    minWidth: 380,
+    minHeight: 480,
+    show: !hidden,
+    // Windows and Linux drop the system title bar for the page's own controls (macOS keeps its native one).
+    frame: MAC,
+    backgroundColor: "#0d0a11",
+    icon: MAC ? undefined : icon("icon.png"),
+  })
+  portal = new WebContentsView({ webPreferences: { preload: join(root, "src", "preload.cjs"), sandbox: true, contextIsolation: true } })
+  portal.setBackgroundColor("#0d0a11")
+  window.contentView.addChildView(portal)
+  const page = portal.webContents
+  // Tagged so the portal offers browser sign-in instead of passkeys.
+  page.setUserAgent(`${browserAgent()} NakoDesktop/${app.getVersion()}`)
+  page.on("will-navigate", event => navigate(event, event.url))
+  page.setWindowOpenHandler(({ url, disposition }) => {
+    if (toSystemBrowser(url, disposition, onPortal)) {
+      external(url)
+      return { action: "deny" }
+    }
+    const event = { defaultPrevented: false, preventDefault() { this.defaultPrevented = true } }
+    navigate(event, url)
+    if (!event.defaultPrevented) page.loadURL(url)
+    return { action: "deny" }
+  })
+  page.on("dom-ready", () => {
+    if (!MAC) page.insertCSS(DRAG).catch(() => {})
+  })
+  page.on("did-finish-load", () => {
+    if (!onPortal(page.getURL())) return
+    // Chromium writes cookies to disk every so often; a sign-in shouldn't wait for that.
+    session.defaultSession.cookies.flushStore().catch(() => {})
+    listener?.wake()
+    // Where updating stands; the sidebar's version checks for updates only once this is set.
+    if (updater.enabled) page.executeJavaScript(announcement(updater.status)).catch(() => {})
+    updater.checkIfDue()
+    tellPortal()
+  })
+
+  pane = new Pane({
+    window,
+    portal,
+    opensInPortal: onPortal,
+    toPortal: url => page.loadURL(url),
+    external,
+    barPage: join(root, "ui", "browser.html"),
+    barPreload: join(root, "src", "preload.cjs"),
+    dividerPage: join(root, "ui", "divider.html"),
+    userAgent: browserAgent(),
+    share: settings().paneShare,
+    keepShare: paneShare => saveSettings({ paneShare }),
+    changed: tellPortal,
+  })
+  pane.layout()
+  window.on("resize", () => pane.layout())
+  window.on("close", event => {
+    // Closing hides to the tray, so alerts keep coming.
+    if (!quitting && tray) {
+      event.preventDefault()
+      window.hide()
+    }
+  })
+  window.on("blur", () => {
+    if (updater.pending && updater.automatic) updater.install(!window.isVisible())
+  })
+  window.on("focus", () => updater.checkIfDue())
+  localPage("")
+}
+
+function showMain() {
+  window.show()
+  if (window.isMinimized()) window.restore()
+  window.focus()
+  // Reopened from the tray or the launcher: it may have sat there through a release.
+  updater.checkIfDue()
+}
+
+/** A clicked notification opens its chat, without reloading the page when it's already the portal. */
+function openChat(session) {
+  const page = origin?.chatPage(session)
+  if (!page) return
+  showMain()
+  if (onPortal(portal.webContents.getURL())) portal.webContents.executeJavaScript(`location.hash = ${JSON.stringify(`#/c/${session}`)}`)
+  else portal.webContents.loadURL(page)
+}
+
+// ---- the floating Nako ----
+
+const floatingOn = () => settings().floating === true
+
+/** She floats while she's on and the portal is open, whichever window is in front. */
+function refreshFloating() {
+  if (!floating) return
+  if (floatingOn() && origin) floating.show()
+  else floating.hide()
+}
+
+function setFloating(on) {
+  saveSettings({ floating: on })
+  refreshFloating()
+  tellPortal()
+  tray?.setContextMenu(trayMenu())
+}
+
+function createFloating() {
+  floating = new FloatingNako({
+    page: join(root, "ui", "floating.html"),
+    preload: join(root, "src", "floating-preload.cjs"),
+    panelPreload: join(root, "src", "panel-preload.cjs"),
+    portalUrl: chat => (chat ? origin.chatPage(chat) : origin.url),
+    opensInPortal: onPortal,
+    userAgent: `${browserAgent()} NakoDesktop/${app.getVersion()} NakoBubble/1`,
+    saved: () => settings().floatingSpot,
+    keep: floatingSpot => saveSettings({ floatingSpot }),
+    openInApp: chat => (chat ? openChat(chat) : showMain()),
+    openExternally: external,
+    openLink: url => {
+      showMain()
+      if (/^https?:/i.test(url)) pane.open(url)
+      else external(url)
+    },
+    signIn: () => {
+      showMain()
+      startSignIn()
+    },
+    putAway: () => setFloating(false),
+    quit: () => {
+      quitting = true
+      app.quit()
+    },
+  })
+}
+
+ipcMain.handle("nako-floating", (event, command, args = {}) => {
+  if (floating?.owns(event.sender) !== "sticker" || !event.senderFrame?.url.startsWith("file:")) throw new Error(`${command} not allowed`)
+  return floating.command(String(command), args ?? {})
+})
+
+ipcMain.handle("nako-panel", (event, command) => {
+  if (floating?.owns(event.sender) !== "panel" || !onPortal(event.senderFrame?.url ?? "")) throw new Error(`${command} not allowed`)
+  if (command === "close") return floating.collapse()
+  if (command === "open_in_app") {
+    const chat = floating.panelChat()
+    floating.collapse()
+    return chat ? openChat(chat) : showMain()
+  }
+})
+
+function external(url) {
+  shell.openExternal(url).catch(error => log(`couldn't open ${url}: ${error.message}`))
+}
+
+// ---- notifications ----
+
+/** The notification shown for each chat: a newer alert replaces it. */
+const shown = new Map()
+
+function notify(title, body, onClick) {
+  if (!Notification.isSupported()) return null
+  const note = new Notification({ title, body, icon: icon("128x128.png"), silent: false })
+  if (onClick) note.on("click", onClick)
+  note.show()
+  return note
+}
+
+function showAlert(alert) {
+  // Nothing to tell someone already looking at the app.
+  if (window.isVisible() && window.isFocused()) return
+  if (floating?.isShown) floating.alert(alert.session)
+  if (!alert.session) return void notify(alert.title, alert.body)
+  shown.get(alert.session)?.close()
+  const note = notify(alert.title, alert.body, () => openChat(alert.session))
+  if (note) shown.set(alert.session, note)
+}
+
+// ---- tray, updates, downloads ----
+
+function realPath(path) {
+  try {
+    return realpathSync(path)
+  } catch {
+    return path
+  }
+}
+
+const updater = new Updater({
+  version: app.getVersion(),
+  platform: platformKey(process.env, process.platform, app.isPackaged, realPath(process.execPath)),
+  publicKey: readPublicKey(join(root, "pubkey.txt")),
+  cookie: cookieHeader,
+  onStatus: status => {
+    if (portal && onPortal(portal.webContents.getURL())) portal.webContents.executeJavaScript(announcement(status)).catch(() => {})
+  },
+  onReady: () => {
+    if (updater.automatic && !window.isFocused()) updater.install(!window.isVisible())
+  },
+  notify: (title, body) => notify(title, body),
+  quit: () => {
+    quitting = true
+    app.quit()
+  },
+  log,
+})
+
+// The macOS menu bar wants a one-colour template (it tints it for light/dark), at 16pt with an @2x copy.
+function trayIcon() {
+  if (!MAC) return icon("128x128.png").resize({ width: 32, height: 32 })
+  const image = icon("trayTemplate.png")
+  image.setTemplateImage(true)
+  return image
+}
+
+function trayMenu() {
+  return Menu.buildFromTemplate([
+    { label: "Open Nako", click: showMain },
+    {
+      label: "Change server",
+      click: () => {
+        pane.close()
+        localPage("change=1")
+        showMain()
+      },
+    },
+    { label: "Floating Nako", type: "checkbox", checked: floatingOn(), click: item => setFloating(item.checked) },
+    // Only installs that replace themselves; the .deb and Homebrew update through their package manager.
+    ...(updater.enabled ? [{ label: "Check for updates", click: () => updater.checkNow() }] : []),
+    { type: "separator" },
+    {
+      label: "Quit",
+      click: () => {
+        quitting = true
+        app.quit()
+      },
+    },
+  ])
+}
+
+function createTray() {
+  tray = new Tray(trayIcon())
+  tray.setToolTip("Nako")
+  tray.setContextMenu(trayMenu())
+  tray.on("click", showMain)
+}
+
+app.on("second-instance", () => showMain())
+// Clicking the Dock icon brings back a window that was closed to the menu bar.
+app.on("activate", () => window && showMain())
+app.on("before-quit", () => {
+  quitting = true
+  session.defaultSession.cookies.flushStore().catch(() => {})
+})
+app.on("window-all-closed", () => {})
+
+app.whenReady().then(() => {
+  app.setAppUserModelId(IDENTIFIER)
+  // Downloads from the portal or the in-app browser go to the Downloads folder.
+  const signIn = signInAgent()
+  session.defaultSession.webRequest.onBeforeSendHeaders({ urls: GOOGLE_SIGN_IN }, (details, callback) => {
+    details.requestHeaders["User-Agent"] = signIn
+    callback({ requestHeaders: details.requestHeaders })
+  })
+  session.defaultSession.on("will-download", (_event, item) => {
+    item.setSavePath(join(app.getPath("downloads"), item.getFilename()))
+    item.once("done", (_e, state) => {
+      if (state === "completed") notify(`Saved ${item.getFilename()}`, "In your Downloads folder")
+    })
+  })
+  try {
+    createTray()
+  } catch (error) {
+    log(`no tray: ${error.message}`)
+    tray = null
+  }
+  createWindow()
+  createFloating()
+  if (hidden && !tray) window.show()
+})
+
diff --git a/plugins/nako-portal/desktop/src/minisign.js b/plugins/nako-portal/desktop/src/minisign.js
new file mode 100644
index 0000000000000000000000000000000000000000..c129939e1030ba0ca0b3607132f637f48161824d
--- /dev/null
+++ b/plugins/nako-portal/desktop/src/minisign.js
@@ -0,0 +1,41 @@
+// Checks a download against the updater key built into the app. Releases are signed with the
+// same minisign key the earlier (Tauri) app used, so both read one manifest: the signature is the
+// base64 of a minisign .sig file over the BLAKE2b-512 hash of the file ("ED", prehashed).
+import { createPublicKey, verify } from "node:crypto"
+
+import blake from "blakejs"
+
+/** BLAKE2b-512 of `data`. Electron's crypto library has no BLAKE2, so this one is plain JS. */
+export function blake2b512(data) {
+  const state = blake.blake2bInit(64)
+  // In slices, so a 100+ MB download doesn't sit in one call.
+  for (let i = 0; i < data.length; i += 1 << 20) blake.blake2bUpdate(state, data.subarray(i, i + (1 << 20)))
+  return Buffer.from(blake.blake2bFinal(state))
+}
+
+/** The public key `pubkey.txt` holds: the base64 of a minisign public key file. */
+export function parsePublicKey(encoded) {
+  const lines = Buffer.from(encoded.trim(), "base64").toString("utf8").trim().split("\n")
+  const blob = Buffer.from(lines.at(-1).trim(), "base64")
+  if (blob.length !== 42 || blob.subarray(0, 2).toString() !== "Ed") throw new Error("not a minisign public key")
+  return { keyId: blob.subarray(2, 10), key: createPublicKey({ key: { kty: "OKP", crv: "Ed25519", x: blob.subarray(10).toString("base64url") }, format: "jwk" }) }
+}
+
+/** Whether `signature` (base64 of a minisign .sig file) signs `data` with `publicKey`. */
+export function verifySignature(data, signature, publicKey) {
+  let lines
+  try {
+    lines = Buffer.from(signature.trim(), "base64").toString("utf8").trim().split("\n")
+  } catch {
+    return false
+  }
+  if (lines.length < 4 || !lines[2].startsWith("trusted comment: ")) return false
+  const blob = Buffer.from(lines[1].trim(), "base64")
+  if (blob.length !== 74 || blob.subarray(0, 2).toString() !== "ED" || !blob.subarray(2, 10).equals(publicKey.keyId)) return false
+  const sig = blob.subarray(10)
+  const digest = blake2b512(data)
+  if (!verify(null, digest, publicKey.key, sig)) return false
+  // The trusted comment (file name, timestamp) is signed too, together with the signature.
+  const comment = Buffer.from(lines[2].slice("trusted comment: ".length))
+  return verify(null, Buffer.concat([sig, comment]), publicKey.key, Buffer.from(lines[3].trim(), "base64"))
+}
diff --git a/plugins/nako-portal/desktop/src/origin.js b/plugins/nako-portal/desktop/src/origin.js
new file mode 100644
index 0000000000000000000000000000000000000000..4e7b59b2abed20f6d2cb698d07d0cd331cca8322
--- /dev/null
+++ b/plugins/nako-portal/desktop/src/origin.js
@@ -0,0 +1,64 @@
+// The one portal this install talks to, normalized to `scheme://host[:port]`.
+
+/** `scheme://host[:port]` of an http(s) URL, else null. URL already drops a default port and lowercases the host. */
+export function originOf(link) {
+  let url
+  try {
+    url = link instanceof URL ? link : new URL(link)
+  } catch {
+    return null
+  }
+  if ((url.protocol !== "http:" && url.protocol !== "https:") || !url.hostname) return null
+  return url.origin
+}
+
+export const isSessionId = session => typeof session === "string" && /^[A-Za-z0-9_.-]{1,120}$/.test(session)
+
+export class ServerOrigin {
+  constructor(value) {
+    this.value = value
+  }
+
+  /** Accepts `portal.example.com`, `https://portal.example.com/` or `http://10.0.0.5:8797`; null otherwise. */
+  static parse(input) {
+    const trimmed = String(input ?? "").trim().replace(/\/+$/, "")
+    if (!trimmed) return null
+    const withScheme = trimmed.includes("://") ? trimmed : `https://${trimmed}`
+    let url
+    try {
+      url = new URL(withScheme)
+    } catch {
+      return null
+    }
+    const bare = url.pathname === "/" && !url.search && !url.hash && !url.username && !url.password && !withScheme.endsWith("#") && !withScheme.endsWith("?")
+    const origin = bare ? originOf(url) : null
+    return origin ? new ServerOrigin(origin) : null
+  }
+
+  get url() {
+    return `${this.value}/`
+  }
+
+  page(path) {
+    return new URL(path, this.url).toString()
+  }
+
+  /** Only the portal itself stays in the app; every other link opens elsewhere. */
+  opensInApp(link) {
+    return originOf(link) === this.value
+  }
+
+  /** The portal page for a chat a notification points at; null when the id isn't a session id. */
+  chatPage(session) {
+    return isSessionId(session) ? this.page(`/#/c/${session}`) : null
+  }
+
+  /** The live-event socket alerts arrive on. */
+  get socketUrl() {
+    return `${this.value.replace(/^http/, "ws")}/ws`
+  }
+
+  toJSON() {
+    return this.value
+  }
+}
diff --git a/plugins/nako-portal/desktop/src/pane.js b/plugins/nako-portal/desktop/src/pane.js
new file mode 100644
index 0000000000000000000000000000000000000000..b300a3b79b051cc7e66b2b096bab3eadcf5fd7c6
--- /dev/null
+++ b/plugins/nako-portal/desktop/src/pane.js
@@ -0,0 +1,337 @@
+// The in-app browser: links from the portal open in a pane on the right of the window, a toolbar
+// (the app's own `ui/browser.html`) over the page. The portal keeps the rest of the window.
+//
+// Every chat has a browser of its own, with tabs (tabs.js). Each tab is a view of its own; only the
+// one on screen is shown, the rest are hidden and frozen, and chats left a while ago are unloaded.
+import { WebContentsView } from "electron"
+
+import { addressOrSearch, isEngine } from "./address.js"
+import { DEFAULT_SHARE, DIVIDER_WIDTH, dragRange, shareFor, split } from "./layout.js"
+import { LIVE_CHATS, Tabs, tabName } from "./tabs.js"
+
+const BAR_HEIGHT = 40
+/** The row of tabs under the toolbar, shown once a chat has more than one. */
+const STRIP_HEIGHT = 32
+/** What the toolbar is told: the tab on screen and this chat's tab strip. */
+export function status(shown, strip) {
+  return {
+    url: shown?.url ?? null,
+    title: shown?.title ?? null,
+    active: shown?.id ?? null,
+    tabs: strip.map(t => ({ id: t.id, name: tabName(t) })),
+  }
+}
+
+const PAUSE_MEDIA = "document.querySelectorAll('video, audio').forEach(m => m.pause())"
+
+export class Pane {
+  tabs = new Tabs()
+  /** Tab id → its view. */
+  views = new Map()
+  bar = null
+  /** The strip between the portal and the pane; covers the whole window while it's dragged. */
+  divider = null
+  dragging = false
+  /** The tab last put on screen. */
+  visible = null
+  engine = "google"
+
+  /**
+   * `window` holds the views, `portal` is the portal's view, `opensInPortal(url)` says whether a
+   * link belongs to the portal, `toPortal(url)` / `external(url)` send links there or to the
+   * system, `barPreload` is the toolbar's preload, `changed()` runs after every change.
+   */
+  /**
+   * `share` is how much of the window the pane takes (from the last drag) and `keepShare(share)`
+   * saves a new one; `dividerPage` is the divider's page.
+   */
+  constructor({ window, portal, opensInPortal, toPortal, external, barPage, barPreload, dividerPage, userAgent, share, keepShare, changed }) {
+    Object.assign(this, { window, portal, opensInPortal, toPortal, external, barPage, barPreload, dividerPage, userAgent, keepShare, changed })
+    this.share = Number.isFinite(share) ? share : DEFAULT_SHARE
+  }
+
+  get isOpen() {
+    return this.tabs.isOpen
+  }
+
+  /** The portal moved to another chat (or off chats): the browser beside it follows. */
+  chat(id) {
+    if (this.tabs.switch(id ?? null)) this.sync()
+  }
+
+  /** A link clicked in the chat: a new tab in this chat's browser, or the tab already showing it. */
+  open(url) {
+    this.tabs.openLink(url)
+    this.sync()
+  }
+
+  /** The chat header's browser button. */
+  toggle() {
+    this.tabs.toggle()
+    this.sync()
+    this.#focusAddressIfBlank()
+  }
+
+  /** Puts the browser away; its tabs stay for when it comes back. */
+  close() {
+    this.tabs.hide()
+    this.sync()
+    this.portal.webContents.focus()
+  }
+
+  search(engine) {
+    if (isEngine(engine)) this.engine = engine
+  }
+
+  /**
+   * The divider: `start` when it's grabbed (it then covers the window, so only the line moves
+   * while dragging), `end` with where it was let go, which resizes the portal and the page once.
+   */
+  drag(action, target) {
+    const { width } = this.window.getContentBounds()
+    if (action === "start") {
+      if (!this.divider || !this.#shownView()) return null
+      this.dragging = true
+      this.layout()
+      const [, x] = split(width, true, this.share)
+      const [least, most] = dragRange(width)
+      return { x: x - DIVIDER_WIDTH / 2, least, most }
+    }
+    if (action !== "end" || !this.dragging) return null
+    this.dragging = false
+    const x = Number(target)
+    if (Number.isFinite(x)) {
+      this.share = shareFor(width, x)
+      this.keepShare(this.share)
+    }
+    this.layout()
+    return null
+  }
+
+  /** The toolbar's buttons and tabs. */
+  action(action, target) {
+    const id = Number(target)
+    switch (action) {
+      case "new":
+        this.tabs.newTab()
+        this.sync()
+        this.#focusAddressIfBlank()
+        return
+      case "select":
+        this.tabs.select(id)
+        this.sync()
+        return
+      case "close-tab":
+        if (this.tabs.closeTab(id)) {
+          this.#drop(id)
+          this.sync()
+        }
+        return
+      case "close":
+        this.close()
+        return
+      case "status":
+        this.#report()
+        return
+    }
+    const page = this.#shownView()?.webContents
+    if (!page) return
+    switch (action) {
+      case "back":
+        if (page.navigationHistory.canGoBack()) page.navigationHistory.goBack()
+        break
+      case "forward":
+        if (page.navigationHistory.canGoForward()) page.navigationHistory.goForward()
+        break
+      case "reload":
+        page.reload()
+        break
+      case "external": {
+        const url = page.getURL()
+        if (/^https?:/.test(url)) this.external(url)
+        break
+      }
+      case "go": {
+        const url = addressOrSearch(target, this.engine)
+        if (url) page.loadURL(url)
+        break
+      }
+    }
+  }
+
+  #shownView() {
+    const shown = this.tabs.shown()
+    return shown ? this.views.get(shown.id) : null
+  }
+
+  #drop(id) {
+    const view = this.views.get(id)
+    if (!view) return
+    this.views.delete(id)
+    this.window.contentView.removeChildView(view)
+    view.webContents.close()
+    if (this.visible === id) this.visible = null
+  }
+
+  /** Builds, shows, freezes and drops views to match the tabs. */
+  sync() {
+    for (const id of this.tabs.discard(LIVE_CHATS)) this.#drop(id)
+    const shown = this.tabs.shown()
+    if (shown) {
+      this.#ensureBar()
+      if (!this.views.has(shown.id)) this.views.set(shown.id, this.#page(shown))
+      shown.live = true
+    }
+    const before = this.visible
+    this.visible = shown?.id ?? null
+    for (const [id, view] of this.views) {
+      if (id === this.visible) {
+        view.setVisible(true)
+        thaw(view)
+      } else if (id === before) {
+        view.setVisible(false)
+        freeze(view)
+      }
+    }
+    this.bar?.setVisible(Boolean(shown))
+    this.layout()
+    this.#report()
+    this.changed()
+  }
+
+  #ensureBar() {
+    if (this.bar) return
+    this.bar = new WebContentsView({ webPreferences: { preload: this.barPreload, sandbox: true, contextIsolation: true } })
+    this.bar.setBackgroundColor("#09090b")
+    this.window.contentView.addChildView(this.bar)
+    this.bar.webContents.loadFile(this.barPage)
+    this.divider = new WebContentsView({ webPreferences: { preload: this.barPreload, sandbox: true, contextIsolation: true } })
+    // Clear, so the window shows through while it covers everything during a drag.
+    this.divider.setBackgroundColor("#00000000")
+    this.window.contentView.addChildView(this.divider)
+    this.divider.webContents.loadFile(this.dividerPage)
+  }
+
+  /** A view for `tab`, loading its address (a new tab starts blank). */
+  #page(tab) {
+    const view = new WebContentsView({ webPreferences: { sandbox: true, contextIsolation: true } })
+    view.setBackgroundColor("#ffffff")
+    const page = view.webContents
+    page.setUserAgent(this.userAgent)
+    page.on("will-navigate", event => {
+      if (!this.#staysInPane(event.url)) event.preventDefault()
+    })
+    // Pages that open a window (target=_blank, window.open) get a new tab.
+    page.setWindowOpenHandler(({ url }) => {
+      if (this.#staysInPane(url)) setImmediate(() => this.open(url))
+      return { action: "deny" }
+    })
+    const remember = title => this.#remember(tab.id, page.getURL(), title)
+    page.on("did-navigate", () => remember(null))
+    page.on("did-navigate-in-page", (_event, _url, mainFrame) => mainFrame && remember(null))
+    page.on("page-title-updated", (_event, title) => remember(title))
+    page.on("render-process-gone", () => {
+      // A crashed page closes its tab's view; coming back to it loads it again.
+      this.#drop(tab.id)
+      const crashed = this.tabs.tab(tab.id)
+      if (crashed) crashed.live = false
+      this.sync()
+    })
+    this.window.contentView.addChildView(view)
+    // The divider stays on top of every page, for when it's dragged across one.
+    if (this.divider) this.window.contentView.addChildView(this.divider)
+    view.setVisible(false)
+    page.loadURL(tab.url ?? "about:blank")
+    return view
+  }
+
+  /** Web pages browse on in the pane; the portal's own pages go back to the portal, and anything that isn't a web page goes to the system. */
+  #staysInPane(url) {
+    if (url.startsWith("about:")) return true
+    if (this.opensInPortal(url)) {
+      this.toPortal(url)
+      return false
+    }
+    if (!/^https?:/i.test(url)) {
+      this.external(url)
+      return false
+    }
+    return true
+  }
+
+  /** Keeps a tab's address and title as its page moves on, for the strip and for reloading it after it was unloaded. */
+  #remember(id, url, title) {
+    const tab = this.tabs.tab(id)
+    // A new tab's blank page has no address worth keeping.
+    if (!tab || !url || url.startsWith("about:")) return
+    if (url !== tab.url && title == null) tab.title = null
+    tab.url = url
+    if (title != null) tab.title = title
+    this.#report()
+  }
+
+  #report() {
+    if (!this.bar) return
+    const detail = JSON.stringify(status(this.tabs.shown(), this.tabs.strip()))
+    this.bar.webContents.executeJavaScript(`window.nakoPane && window.nakoPane(${detail})`).catch(() => {})
+    this.layout()
+  }
+
+  #focusAddressIfBlank() {
+    const shown = this.tabs.shown()
+    if (!shown || shown.url || !this.bar) return
+    this.bar.webContents.focus()
+    this.bar.webContents.executeJavaScript("window.nakoFocusAddress && window.nakoFocusAddress()").catch(() => {})
+  }
+
+  /** Puts the portal and the pane where `split` says, for the window's current size. */
+  layout() {
+    const { width, height } = this.window.getContentBounds()
+    // Mid-drag only the divider's line moves; everything resizes once it's let go.
+    if (this.dragging) {
+      this.divider.setBounds({ x: 0, y: 0, width, height })
+      return
+    }
+    const shown = this.#shownView()
+    const [portalWidth, x, paneWidth] = split(width, Boolean(shown), this.share)
+    const bar = this.tabs.strip().length > 1 ? BAR_HEIGHT + STRIP_HEIGHT : BAR_HEIGHT
+    this.portal.setBounds({ x: 0, y: 0, width: portalWidth, height })
+    this.portal.setVisible(portalWidth > 0)
+    if (shown) {
+      this.bar.setBounds({ x, y: 0, width: paneWidth, height: bar })
+      shown.setBounds({ x, y: bar, width: paneWidth, height: Math.max(0, height - bar) })
+    }
+    const side = Boolean(shown) && portalWidth > 0
+    this.divider?.setVisible(side)
+    if (side) this.divider.setBounds({ x: portalWidth, y: 0, width: DIVIDER_WIDTH, height })
+  }
+
+  /** Drops every page, for when the portal changes. */
+  reset() {
+    for (const id of [...this.views.keys()]) this.#drop(id)
+    this.tabs = new Tabs()
+    this.sync()
+  }
+}
+
+// A tab out of sight stops: its videos pause and Chromium freezes the page (no scripts, no timers)
+// until it's shown again.
+function lifecycle(view, state) {
+  const page = view.webContents
+  if (page.isDestroyed()) return
+  try {
+    if (!page.debugger.isAttached()) page.debugger.attach("1.3")
+    page.debugger.sendCommand("Page.setWebLifecycleState", { state }).catch(() => {})
+  } catch {}
+}
+
+function freeze(view) {
+  view.webContents
+    .executeJavaScript(PAUSE_MEDIA)
+    .catch(() => {})
+    .finally(() => lifecycle(view, "frozen"))
+}
+
+function thaw(view) {
+  lifecycle(view, "active")
+}
