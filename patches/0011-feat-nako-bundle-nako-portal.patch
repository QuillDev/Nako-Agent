diff --git a/plugins/nako-portal/web/src/lib/desktop-browser.ts b/plugins/nako-portal/web/src/lib/desktop-browser.ts
new file mode 100644
index 0000000000000000000000000000000000000000..964c5dc2f31cfaf244b538f45aef170425a3aca2
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/desktop-browser.ts
@@ -0,0 +1,58 @@
+// The apps' in-app browser. The desktop app's searches with the engine picked in Settings; both
+// it and the Android app (on a wide screen) can open each chat's browser from the chat header.
+// Apps say what they can do with window.nakoBrowser; browsers and older apps never set it.
+import { useSyncExternalStore } from "react"
+import { desktopApp } from "./desktop-window"
+
+declare global {
+  interface Window {
+    nakoBrowser?: { search?: boolean; toggle?: boolean; open?: boolean }
+    NakoApp?: { toggleBrowser?: () => void }
+  }
+}
+
+// The app fires "nako-browser" when the browser opens or closes, or stops fitting the window.
+const subscribeBrowser = (changed: () => void) => {
+  window.addEventListener("nako-browser", changed)
+  return () => window.removeEventListener("nako-browser", changed)
+}
+
+/** "none" when there's no in-app browser to open from here, else whether it's open. */
+const browserState = () => (!window.nakoBrowser?.toggle ? "none" : window.nakoBrowser.open ? "open" : "closed")
+
+export const useAppBrowser = () => useSyncExternalStore(subscribeBrowser, browserState, () => "none" as const)
+
+export function toggleAppBrowser() {
+  if (window.NakoApp?.toggleBrowser) window.NakoApp.toggleBrowser()
+  else void desktopApp()?.invoke("pane_toggle").catch(() => {})
+}
+
+export const SEARCH_ENGINES = { google: "Google", duckduckgo: "DuckDuckGo", bing: "Bing", brave: "Brave" } as const
+export type SearchEngine = keyof typeof SEARCH_ENGINES
+
+const KEY = "browser:search"
+const listeners = new Set<() => void>()
+
+export const canPickSearch = () => Boolean(window.nakoBrowser?.search)
+
+const stored = (): SearchEngine => {
+  const value = localStorage.getItem(KEY)
+  return value && value in SEARCH_ENGINES ? (value as SearchEngine) : "google"
+}
+
+// The app forgets the pick when it quits, so every page load hands it over again.
+const tellApp = () => void desktopApp()?.invoke("pane_search", { engine: stored() }).catch(() => {})
+if (canPickSearch()) tellApp()
+
+export function setSearchEngine(engine: SearchEngine) {
+  localStorage.setItem(KEY, engine)
+  tellApp()
+  for (const listener of listeners) listener()
+}
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+export const useSearchEngine = () => useSyncExternalStore(subscribe, stored)
diff --git a/plugins/nako-portal/web/src/lib/desktop-update.ts b/plugins/nako-portal/web/src/lib/desktop-update.ts
new file mode 100644
index 0000000000000000000000000000000000000000..84757769b18bdb393aab342cbbfa206c4dc9b1e0
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/desktop-update.ts
@@ -0,0 +1,53 @@
+import { useSyncExternalStore } from "react"
+import { desktopApp } from "./desktop-window"
+
+/**
+ * Where the desktop app's updating stands. Apps that update themselves set window.nakoUpdate on
+ * every portal load and whenever it changes, and fire "nako-update"; browsers never set it.
+ * Apps from before in-app checks set only `{ version }`, once an update is downloaded.
+ */
+export type UpdateStatus = {
+  state: "idle" | "checking" | "latest" | "error" | "ready" | "installing"
+  version?: string
+  error?: string
+  /** Homebrew is building it (macOS), which takes minutes. */
+  brew?: boolean
+}
+
+declare global {
+  interface Window {
+    nakoUpdate?: Partial<UpdateStatus>
+  }
+}
+
+const subscribe = (changed: () => void) => {
+  window.addEventListener("nako-update", changed)
+  return () => window.removeEventListener("nako-update", changed)
+}
+
+const snapshot = () => window.nakoUpdate ?? null
+
+/** The app's update status; null in a browser or an app that doesn't update itself. */
+export function useDesktopUpdate(): UpdateStatus | null {
+  const status = useSyncExternalStore(subscribe, snapshot, () => null)
+  if (!status) return null
+  if (status.state) return status as UpdateStatus
+  return status.version ? { state: "ready", version: status.version } : null
+}
+
+/** Whether the app takes checks from the page; older apps only announce a download. */
+export const canCheck = () => Boolean(window.nakoUpdate?.state && desktopApp())
+
+export function checkForUpdate() {
+  desktopApp()?.invoke("update", { action: "check" }).catch(() => {})
+}
+
+/** The app shows that it's updating, installs the update and restarts. */
+export function installDesktopUpdate() {
+  if (canCheck()) desktopApp()?.invoke("update", { action: "install" }).catch(() => {})
+  // Older apps catch this navigation instead.
+  else window.location.assign("/desktop/update")
+}
+
+/** The installed desktop or Android app's version, from the agent the app tags; null in a browser. */
+export const appVersion = navigator.userAgent.match(/Nako(?:Desktop|Android)\/(\d+\.\d+\.\d+)/)?.[1] ?? null
