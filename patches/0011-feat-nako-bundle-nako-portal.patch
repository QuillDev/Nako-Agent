+  top: 50%;
+  right: 100%;
+  margin: 0 0.25rem 0 0;
+  display: flex;
+  translate: 0 -50%;
+  background: var(--popover);
+  box-shadow: none;
+}
+[data-streamdown="table-wrapper"] > div:first-child .absolute button {
+  white-space: nowrap;
+  padding: 0.25rem 0.625rem;
+  font-size: 0.75rem;
+}
+[data-streamdown="table-wrapper"]:not(.h-full) > div:has(> table) {
+  border-radius: var(--radius);
+  background: transparent;
+}
+[data-streamdown="table-wrapper"].h-full table {
+  outline: 1px solid var(--border);
+  outline-offset: -1px;
+  border-radius: var(--radius);
+}
+[data-streamdown="table-wrapper"] button[data-copied] {
+  color: var(--primary);
+}
+[data-streamdown="table"] thead {
+  background: transparent;
+}
+[data-streamdown="table"] th {
+  padding-top: 0.625rem;
+  padding-bottom: 0.625rem;
+  color: var(--muted-foreground);
+  font-weight: 500;
+  font-size: 0.75rem;
+}
+[data-streamdown="table"] td {
+  padding-top: 0.625rem;
+  padding-bottom: 0.625rem;
+  font-variant-numeric: tabular-nums;
+}
+[data-streamdown="table"] tbody tr {
+  transition: background-color 100ms;
+}
+[data-streamdown="table"] tbody tr:hover {
+  background: var(--muted);
+}
+
+/* Nako's thought bubble swapping lines: the old one rises out as the new one rises in. */
+.presence-in {
+  animation: presence-in 280ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
+}
+.presence-out {
+  animation: presence-out 220ms ease-in both;
+}
+@keyframes presence-in {
+  from {
+    opacity: 0;
+    transform: translateY(70%);
+    filter: blur(2px);
+  }
+}
+@keyframes presence-out {
+  to {
+    opacity: 0;
+    transform: translateY(-70%);
+    filter: blur(2px);
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .presence-in,
+  .presence-out {
+    animation-duration: 1ms;
+  }
+}
+
+/* Cmd+K search growing out of the sidebar's Find row: the row-sized input widens, then the list unfolds. */
+.find-pop[data-state="open"] {
+  animation: find-open 200ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
+}
+.find-pop[data-state="closed"] {
+  animation: find-close 140ms ease-in both;
+}
+@keyframes find-open {
+  from {
+    clip-path: inset(0 calc(100% - var(--find-row)) calc(100% - 2rem) 0 round 0.5rem);
+  }
+  to {
+    clip-path: inset(0 0 0 0 round 0.5rem);
+  }
+}
+@keyframes find-close {
+  from {
+    clip-path: inset(0 0 0 0 round 0.5rem);
+  }
+  to {
+    clip-path: inset(0 calc(100% - var(--find-row)) calc(100% - 2rem) 0 round 0.5rem);
+    opacity: 0;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .find-pop[data-state] {
+    animation-duration: 1ms;
+  }
+}
+
+/* The floating panel (Android and desktop apps): the same page, set a size smaller so more of the chat fits. */
+html.bubble {
+  font-size: 14px;
+}
+
+/* A mesh line to a machine that is working: its dashes run toward the machine. */
+@keyframes mesh-flow {
+  to {
+    stroke-dashoffset: -20;
+  }
+}
+.mesh-flow {
+  animation: mesh-flow 0.8s linear infinite;
+}
+@media (prefers-reduced-motion: reduce) {
+  .mesh-flow {
+    animation: none;
+  }
+}
+
+/* A secret that just saved: the check in its save button draws itself in. */
+.secret-check path {
+  stroke-dasharray: 24;
+  stroke-dashoffset: 24;
+  animation: secret-check 0.35s 0.05s ease-out forwards;
+}
+
+@keyframes secret-check {
+  to {
+    stroke-dashoffset: 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .secret-check path {
+    animation: none;
+    stroke-dashoffset: 0;
+  }
+}
diff --git a/plugins/nako-portal/web/src/lib/api.ts b/plugins/nako-portal/web/src/lib/api.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e16209da9fd2e730f96dad447576fa738b987a63
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/api.ts
@@ -0,0 +1,68 @@
+export class ApiError extends Error {
+  constructor(
+    message: string,
+    readonly status: number,
+  ) {
+    super(message)
+  }
+}
+
+let onSignedOut: () => void = () => {}
+export function whenSignedOut(handler: () => void) {
+  onSignedOut = handler
+}
+
+// Reads public/early.js started from the page's head, before this code had loaded.
+const early: Record<string, Promise<Response | null> | undefined> = (window as { __early?: typeof early }).__early ?? {}
+// After this long the page has moved on from its first load, and a fresh read is the right one.
+const EARLY_MS = 10_000
+
+// The early read of a path, once, when it worked; anything else is read again normally.
+async function takeEarly(path: string) {
+  const pending = early[path]
+  delete early[path]
+  if (!pending || performance.now() > EARLY_MS) return null
+  const response = await pending
+  return response?.ok ? response : null
+}
+
+export async function api<T = unknown>(path: string, { method = "GET", body, form }: { method?: string; body?: unknown; form?: FormData } = {}): Promise<T> {
+  const init: RequestInit = { method, credentials: "same-origin", headers: {} }
+  if (form) {
+    init.body = form
+  } else if (body !== undefined) {
+    init.headers = { "Content-Type": "application/json" }
+    init.body = JSON.stringify(body)
+  }
+  const response = (method === "GET" && (await takeEarly(path))) || (await fetch(path, init))
+  const text = await response.text()
+  const data = text ? JSON.parse(text) : null
+  if (response.status === 401 && path !== "/api/me") onSignedOut()
+  if (!response.ok) throw new ApiError(data?.error || `request failed (${response.status})`, response.status)
+  return data as T
+}
+
+export const sessionPath = (session: string, rest = "") => `/api/sessions/${encodeURIComponent(session)}${rest}`
+
+export function fileUrl(session: string, path: string) {
+  return `/api/file?session=${encodeURIComponent(session)}&path=${encodeURIComponent(path)}`
+}
+
+/** The same file, sent to be saved under its own name rather than shown in place. */
+export const downloadUrl = (session: string, path: string) => `${fileUrl(session, path)}&download=1`
+
+export function b64url(buffer: ArrayBuffer) {
+  return btoa(String.fromCharCode(...new Uint8Array(buffer))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+}
+
+export function unb64url(text: string) {
+  const raw = atob(text.replace(/-/g, "+").replace(/_/g, "/") + "=".repeat((4 - (text.length % 4)) % 4))
+  return Uint8Array.from(raw, c => c.charCodeAt(0))
+}
+
+// PromptInput hands attachments over as data URLs; the portal takes multipart files.
+export function dataUrlToFile(url: string, name: string, type: string) {
+  const comma = url.indexOf(",")
+  const bytes = Uint8Array.from(atob(url.slice(comma + 1)), c => c.charCodeAt(0))
+  return new File([bytes], name, { type })
+}
