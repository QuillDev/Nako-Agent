+
+/** A minisign key pair in the format the release script's signer writes. */
+function minisign() {
+  const { publicKey, privateKey } = generateKeyPairSync("ed25519")
+  const id = Buffer.from("0123456789abcdef", "hex")
+  const raw = Buffer.from(publicKey.export({ format: "jwk" }).x, "base64url")
+  const pub = Buffer.from(`untrusted comment: minisign public key\n${Buffer.concat([Buffer.from("Ed"), id, raw]).toString("base64")}\n`).toString("base64")
+  const signFile = (data, comment = "timestamp:1\tfile:nako.AppImage") => {
+    const sig = sign(null, createHash("blake2b512").update(data).digest(), privateKey)
+    const global = sign(null, Buffer.concat([sig, Buffer.from(comment)]), privateKey)
+    const text = `untrusted comment: signature\n${Buffer.concat([Buffer.from("ED"), id, sig]).toString("base64")}\ntrusted comment: ${comment}\n${global.toString("base64")}\n`
+    return Buffer.from(text).toString("base64")
+  }
+  return { pub, signFile }
+}
+
+test("an update installs only with a signature from the release key", () => {
+  const release = minisign()
+  const other = minisign()
+  const key = parsePublicKey(release.pub)
+  const file = Buffer.from("the new app")
+  assert.ok(verifySignature(file, release.signFile(file), key))
+  assert.ok(!verifySignature(Buffer.from("the new app!"), release.signFile(file), key), "changed file")
+  assert.ok(!verifySignature(file, other.signFile(file), key), "someone else's key")
+  const forged = Buffer.from(release.signFile(file), "base64").toString().replace("file:nako.AppImage", "file:other")
+  assert.ok(!verifySignature(file, Buffer.from(forged).toString("base64"), key), "edited trusted comment")
+  assert.ok(!verifySignature(file, "not a signature", key))
+})
+
+test("the app's own BLAKE2b matches Node's, across slice boundaries", () => {
+  for (const size of [0, 3, 128, (1 << 20) + 7]) {
+    const data = Buffer.alloc(size, 7)
+    assert.ok(blake2b512(data).equals(createHash("blake2b512").update(data).digest()), String(size))
+  }
+})
+
+test("updates go to newer versions, and only on installs that replace themselves", () => {
+  assert.ok(newer("0.3.0", "0.2.11"))
+  assert.ok(newer("0.2.12", "0.2.11"))
+  assert.ok(!newer("0.2.11", "0.2.11"))
+  assert.ok(!newer("0.2.9", "0.2.11"))
+  assert.equal(platformKey({ APPIMAGE: "/x/Nako.AppImage" }, "linux"), "linux-x86_64")
+  assert.equal(platformKey({}, "linux"), null, "the .deb updates through apt")
+  assert.equal(platformKey({}, "win32", true), "windows-x86_64")
+  assert.equal(platformKey({}, "darwin"), null, "Homebrew's app updates through brew")
+})
+
+test("coming back checks again only after a while, and a failed check says what to do", () => {
+  const now = Date.now()
+  assert.ok(due(null, now))
+  assert.ok(!due(now - 60_000, now), "a minute ago")
+  assert.ok(due(now - 10 * 60_000, now), "ten minutes ago")
+  assert.equal(reason("not signed in"), "Sign in to the portal first")
+  assert.equal(reason("no release"), "This portal doesn't offer desktop updates")
+  assert.equal(announcement({ state: "ready", version: '1.2.3"; alert(1); "' }), 'window.nakoUpdate = {"state":"ready","version":"1.2.3\\"; alert(1); \\""}; window.dispatchEvent(new Event("nako-update"))')
+})
+
+test("pages see Chrome without the Electron and app tokens, and Google's sign-in sees Firefox", () => {
+  const fallback = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) nako/0.3.0 Chrome/146.0.0.0 Electron/45.0.0 Safari/537.36"
+  assert.equal(browserAgent(fallback), "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36")
+  assert.match(signInAgent("darwin"), /^Mozilla\/5\.0 \(Macintosh; Intel Mac OS X 10\.15; rv:\d+\.0\) Gecko\/20100101 Firefox\/\d+\.0$/)
+  assert.match(signInAgent("win32"), /\(Windows NT 10\.0; Win64; x64; rv:/)
+  assert.match(signInAgent("linux"), /\(X11; Linux x86_64; rv:/)
+})
+
+test("the browser takes 45% of the window beside the chat until the divider is dragged", () => {
+  const [portal, x, pane] = split(1100, true)
+  assert.equal(pane, 495)
+  assert.equal(x, 1100 - 495)
+  assert.equal(portal + DIVIDER_WIDTH + pane, 1100)
+  assert.deepEqual(split(1100, false), [1100, 1100, 0])
+  // Too narrow to share: the browser gets the window.
+  assert.deepEqual(split(700, true), [0, 0, 700])
+})
+
+test("a dragged divider is kept as a share of the window and survives a resize", () => {
+  const share = shareFor(1200, 400)
+  const [portal, , pane] = split(1200, true, share)
+  assert.equal(portal + DIVIDER_WIDTH / 2, 400)
+  // The same share in a wider window keeps the same proportions.
+  const [, , wider] = split(1800, true, share)
+  assert.equal(wider, Math.round(1800 * share))
+  assert.ok(pane > 700)
+})
+
+test("the divider stops before either side gets too narrow", () => {
+  const [least, most] = dragRange(1200)
+  for (const x of [0, 50, least, most, 1190, 5000]) {
+    const [portal, , pane] = split(1200, true, shareFor(1200, x))
+    assert.ok(portal >= 380, `portal ${portal} at ${x}`)
+    assert.ok(pane >= 360, `pane ${pane} at ${x}`)
+  }
+  // A window just wide enough to share still fits both minimums.
+  const [portal, , pane] = split(760, true, 0.9)
+  assert.ok(portal >= 380 && pane >= 360)
+})
+
+test("cmd/ctrl-clicked outside web links go to the system browser, others stay in the app", () => {
+  const onPortal = url => url.startsWith("https://portal.example.com")
+  assert.equal(toSystemBrowser("https://example.org/a", "background-tab", onPortal), true)
+  assert.equal(toSystemBrowser("https://example.org/a", "foreground-tab", onPortal), false)
+  assert.equal(toSystemBrowser("https://portal.example.com/chat/1", "background-tab", onPortal), false)
+  assert.equal(toSystemBrowser("mailto:me@example.org", "background-tab", onPortal), false)
+})
diff --git a/plugins/nako-portal/desktop/test/update.test.js b/plugins/nako-portal/desktop/test/update.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..539364a09cd377471ab655c4fee98e6643e2f210
--- /dev/null
+++ b/plugins/nako-portal/desktop/test/update.test.js
@@ -0,0 +1,133 @@
+import assert from "node:assert/strict"
+import { createServer } from "node:http"
+import { readFileSync } from "node:fs"
+import { test } from "node:test"
+
+import { ServerOrigin } from "../src/origin.js"
+import { BREW, Updater, brewVersion, findBrew, platformKey } from "../src/update.js"
+
+const publicKey = readFileSync(new URL("../pubkey.txt", import.meta.url), "utf8")
+
+test("Homebrew's Mac app updates through brew; other Mac apps don't update themselves", () => {
+  assert.equal(platformKey({}, "darwin", true, "/opt/homebrew/Cellar/nako/0.3.1/Nako.app/Contents/MacOS/Nako"), BREW)
+  assert.equal(platformKey({}, "darwin", true, "/usr/local/Cellar/nako/0.3.1/Nako.app/Contents/MacOS/Nako"), BREW)
+  assert.equal(platformKey({}, "darwin", true, "/Applications/Nako.app/Contents/MacOS/Nako"), null)
+  assert.equal(platformKey({}, "darwin", false, "/opt/homebrew/Cellar/nako/x/Nako.app"), null, "a dev run")
+  assert.equal(findBrew(path => path === "/usr/local/bin/brew"), "/usr/local/bin/brew")
+  assert.equal(findBrew(path => true), "/opt/homebrew/bin/brew", "Apple silicon first")
+  assert.equal(findBrew(() => false), null)
+  assert.equal(brewVersion("nako 0.3.2\n"), "0.3.2")
+  assert.equal(brewVersion(""), null)
+})
+
+/** A portal publishing desktop `version`, for a signed-in app. */
+async function portal(version) {
+  const server = createServer((request, response) => {
+    if (request.url !== "/api/desktop/release" || request.headers.cookie !== "portal=good") return response.writeHead(401).end()
+    response.writeHead(200, { "Content-Type": "application/json" })
+    response.end(JSON.stringify({ version, platforms: { "linux-x86_64": { url: "x", signature: "y" } } }))
+  })
+  await new Promise(resolve => server.listen(0, "127.0.0.1", resolve))
+  return { origin: ServerOrigin.parse(`http://127.0.0.1:${server.address().port}`), close: () => (server.close(), server.closeAllConnections()) }
+}
+
+function macApp({ brewHas }) {
+  const calls = []
+  const notes = []
+  const events = { ready: [], reopened: [], quit: 0, shown: [] }
+  const updater = new Updater({
+    version: "0.3.0",
+    platform: BREW,
+    publicKey,
+    cookie: async () => "portal=good",
+    onReady: version => events.ready.push(version),
+    onStatus: status => events.shown.push(status),
+    settleAfter: 20,
+    notify: (title, body) => notes.push(`${title}: ${body}`),
+    quit: () => events.quit++,
+    brew: () => "/opt/homebrew/bin/brew",
+    runBrew: async (brew, args) => {
+      calls.push(args.join(" "))
+      if (args[0] === "--repo") return { ok: true, output: "/opt/homebrew/Library/Taps/quilldev/homebrew-tap\n" }
+      return { ok: true, output: args[0] === "list" ? `nako ${brewHas}\n` : "" }
+    },
+    reopen: app => events.reopened.push(app),
+  })
+  return { updater, calls, notes, events }
+}
+
+test("a newer release shows the arrow on the Mac, and clicking it upgrades through brew and reopens", async () => {
+  const server = await portal("0.3.1")
+  const { updater, calls, notes, events } = macApp({ brewHas: "0.3.1" })
+  updater.origin = server.origin
+  assert.equal(updater.automatic, false, "waits for a click, never installs on blur")
+  assert.equal(await updater.run(false), "found")
+  assert.deepEqual(events.ready, ["0.3.1"])
+  assert.deepEqual(calls, [], "nothing downloaded or built before the click")
+  await updater.install(false)
+  assert.deepEqual(calls, [
+    "update --quiet",
+    "--repo quilldev/tap",
+    "-C /opt/homebrew/Library/Taps/quilldev/homebrew-tap pull --ff-only --quiet",
+    "upgrade nako",
+    "list --versions nako",
+  ])
+  assert.deepEqual(events.reopened, ["/opt/homebrew/opt/nako/Nako.app"])
+  assert.equal(events.quit, 1)
+  assert.match(notes[0], /^Updating Nako/)
+  assert.deepEqual(events.shown.at(-1), { state: "installing", version: "0.3.1", brew: true }, "the page shows it's updating until the app reopens")
+  server.close()
+})
+
+test("the Mac app stays up and says so when brew doesn't have the release yet", async () => {
+  const server = await portal("0.3.1")
+  const { updater, notes, events } = macApp({ brewHas: "0.3.0" })
+  updater.origin = server.origin
+  await updater.run(false)
+  await updater.install(false)
+  assert.equal(events.quit, 0)
+  assert.equal(notes.at(-1), "Couldn't update Nako: Homebrew doesn't have 0.3.1 yet")
+  assert.ok(updater.pending, "the arrow stays, to try again later")
+  assert.equal(events.shown.at(-2).state, "installing")
+  assert.deepEqual(events.shown.at(-1), { state: "ready", version: "0.3.1", error: "Homebrew doesn't have 0.3.1 yet" }, "the updating screen goes away")
+  server.close()
+})
+
+test("clicking the version checks: up to date shows briefly, a newer release shows the update button", async () => {
+  const current = await portal("0.3.0")
+  const { updater, events } = macApp({ brewHas: "0.3.0" })
+  updater.origin = current.origin
+  await updater.check()
+  assert.deepEqual(events.shown, [{ state: "checking" }, { state: "latest" }])
+  await new Promise(r => setTimeout(r, 50))
+  assert.deepEqual(events.shown.at(-1), { state: "idle" }, "then the version shows again")
+  current.close()
+
+  const newer = await portal("0.3.1")
+  updater.origin = newer.origin
+  await updater.check()
+  assert.deepEqual(events.shown.slice(-2), [{ state: "checking" }, { state: "ready", version: "0.3.1" }])
+  assert.equal(events.quit, 0, "nothing installs until the update button is clicked")
+  newer.close()
+})
+
+test("a failed check says why, then goes back to the version", async () => {
+  const server = await portal("0.3.1")
+  const { updater, events } = macApp({ brewHas: "0.3.0" })
+  updater.origin = server.origin
+  updater.cookie = async () => null
+  await updater.check()
+  assert.deepEqual(events.shown, [{ state: "checking" }, { state: "error", error: "Sign in to the portal first" }])
+  await new Promise(r => setTimeout(r, 50))
+  assert.deepEqual(events.shown.at(-1), { state: "idle" })
+  server.close()
+})
+
+test("the Mac app finds nothing when it's already on the release", async () => {
+  const server = await portal("0.3.0")
+  const { updater, events } = macApp({ brewHas: "0.3.0" })
+  updater.origin = server.origin
+  assert.equal(await updater.run(false), "none")
+  assert.deepEqual(events.ready, [])
+  server.close()
+})
