--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/presence.ts
@@ -0,0 +1,20 @@
+// Whether Nako's animated sticker shows what she's doing during a turn. On unless turned off here.
+import { useSyncExternalStore } from "react"
+
+const KEY = "presence"
+const listeners = new Set<() => void>()
+
+const stored = () => localStorage.getItem(KEY) !== "off"
+
+export function setPresence(on: boolean) {
+  if (on) localStorage.removeItem(KEY)
+  else localStorage.setItem(KEY, "off")
+  for (const listener of listeners) listener()
+}
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+export const usePresence = () => useSyncExternalStore(subscribe, stored)
diff --git a/plugins/nako-portal/web/src/lib/providers.ts b/plugins/nako-portal/web/src/lib/providers.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3308e167cc2e09c839f9d17eecd915814a8082e5
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/providers.ts
@@ -0,0 +1,83 @@
+// Providers: the accounts and API keys Hermes can run on, as `hermes model` lists them. The
+// gateway reads and writes them; the portal only shows the list and takes a key. A saved key
+// never comes back, so this file has no way to read one.
+import { useSyncExternalStore } from "react"
+import { api, ApiError } from "@/lib/api"
+
+export type Provider = {
+  slug: string
+  label: string
+  description: string
+  kind: "key" | "signin" | "cli"
+  command: string
+  connected: boolean
+  source: string
+  env_var: string
+  env_vars: string[]
+  signup_url: string
+  /** Set when the provider can hold several accounts: each one, and how a sign-in goes. */
+  accounts?: Account[]
+  login?: "paste" | "code"
+}
+
+export type Account = { id: string; label: string; email: string; plan: string; signed_in: boolean; removable?: boolean }
+export type AccountSignIn = { attempt: string; mode: "paste" | "code"; url?: string; user_code?: string; verification_url?: string; poll_interval?: number }
+export type AccountResult = { outcome: "added" | "refreshed"; label: string; email: string; plan: string }
+export type AccountSignInStatus = { status: "pending" | "done" | "error" | "expired" | "cancelled"; result?: AccountResult; error?: string }
+
+export type SignIn = { session_id: string; user_code: string; verification_url: string; expires_in: number; poll_interval: number }
+export type SignInStatus = { status: "pending" | "approved" | "denied" | "expired" | "error" | "cancelled"; error: string | null }
+
+export const providerPath = (slug: string) => `/api/providers/${encodeURIComponent(slug)}`
+
+let list: Provider[] | null = null
+let loading: Promise<void> | null = null
+const listeners = new Set<() => void>()
+
+export function reloadProviders() {
+  loading = api<Provider[]>("/api/providers").then(
+    rows => {
+      list = rows
+      for (const l of listeners) l()
+    },
+    e => {
+      // An install that can't list providers (or a gateway that went away): no page, no error.
+      if (e instanceof ApiError) list = list ?? []
+      for (const l of listeners) l()
+    },
+  )
+  return loading
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener)
+  if (!loading) void reloadProviders()
+  return () => listeners.delete(listener)
+}
+
+/** null until the first read; the rows after. */
+export const useProviders = () => useSyncExternalStore(subscribe, () => list)
+
+export const setProviderKey = (slug: string, value: string) => api(`${providerPath(slug)}/key`, { method: "POST", body: { value } })
+
+export const removeProviderKey = (slug: string) => api(`${providerPath(slug)}/remove`, { method: "POST" })
+
+export const startSignIn = (slug: string) => api<SignIn>(`${providerPath(slug)}/signin`, { method: "POST" })
+
+export const pollSignIn = (slug: string, session: string) => api<SignInStatus>(`${providerPath(slug)}/signin/${encodeURIComponent(session)}`)
+
+const attemptPath = (slug: string, attempt: string) => `${providerPath(slug)}/accounts/signin/${encodeURIComponent(attempt)}`
+
+/** Sign in to one more account, or again to `target`; who signs in decides whether it's added or refreshed. */
+export const startAccountSignIn = (slug: string, target?: string) =>
+  api<AccountSignIn>(`${providerPath(slug)}/accounts/signin`, { method: "POST", body: { target: target ?? null } })
+
+export const finishAccountSignIn = (slug: string, attempt: string, code: string) =>
+  api<AccountResult>(`${attemptPath(slug, attempt)}/code`, { method: "POST", body: { code } })
+
+export const pollAccountSignIn = (slug: string, attempt: string) => api<AccountSignInStatus>(attemptPath(slug, attempt))
+
+export const cancelAccountSignIn = (slug: string, attempt: string) => api(`${attemptPath(slug, attempt)}/cancel`, { method: "POST" })
+
+export const removeAccount = (slug: string, account: string) =>
+  api(`${providerPath(slug)}/accounts/${encodeURIComponent(account)}/remove`, { method: "POST" })
diff --git a/plugins/nako-portal/web/src/lib/push.ts b/plugins/nako-portal/web/src/lib/push.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9f808ad70c6af319421f08f11b6088c4b0294a71
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/push.ts
@@ -0,0 +1,58 @@
+import { api, unb64url } from "./api"
+import { desktopApp } from "./desktop-window"
+
+// The Android app's own alerts (a native notification service), exposed by its shell.
+type AppBridge = {
+  notifications(): "on" | "off"
+  openNotificationSettings(): void
+  bubble?(): "on" | "off"
+  setBubble?(on: boolean): void
+}
+const appBridge = (): AppBridge | undefined => (window as unknown as { NakoApp?: AppBridge }).NakoApp
+
+/** Inside the Android app: "on"/"off" from the app, "app" from a shell too old to say. Else null. */
+export function appAlerts(): "on" | "off" | "app" | null {
+  const bridge = appBridge()
+  if (bridge) return bridge.notifications()
+  return /NakoAndroid\//.test(navigator.userAgent) ? "app" : null
+}
+
+export const openAppNotificationSettings = () => appBridge()?.openNotificationSettings()
+
+// The desktop app's floating Nako: it says whether she's on, and takes the switch as a command.
+const desktopFloating = () => (window as unknown as { nakoFloating?: { on: boolean } }).nakoFloating
+
+/** Nako's floating sticker over other apps, in an Android or desktop app new enough to have one. Else null. */
+export function appBubble(): "on" | "off" | null {
+  const android = appBridge()?.bubble?.()
+  if (android) return android
+  const desktop = desktopFloating()
+  return desktop ? (desktop.on ? "on" : "off") : null
+}
+
+export function setAppBubble(on: boolean) {
+  const desktop = desktopFloating()
+  if (!appBridge()?.setBubble && desktop) {
+    desktop.on = on
+    void desktopApp()?.invoke("floating", { on }).catch(() => {})
+    return
+  }
+  appBridge()?.setBubble?.(on)
+}
+
+export function pushState(): "unsupported" | "on" | "blocked" | "off" {
+  if (!("Notification" in window) || !("serviceWorker" in navigator)) return "unsupported"
+  if (Notification.permission === "granted") return "on"
+  if (Notification.permission === "denied") return "blocked"
+  return "off"
+}
+
+export async function enablePush() {
+  const registration = await navigator.serviceWorker.ready
+  const { key } = await api<{ key: string | null }>("/api/push/key")
+  if (!key) throw new Error("notifications are not set up on the server")
+  const permission = await Notification.requestPermission()
+  if (permission !== "granted") throw new Error("notifications were not allowed")
+  const subscription = await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: unb64url(key) })
+  await api("/api/push/subscribe", { method: "POST", body: subscription.toJSON() })
+}
diff --git a/plugins/nako-portal/web/src/lib/secrets.ts b/plugins/nako-portal/web/src/lib/secrets.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0ac7aceba0c955c1803b70cdb291925fdc9a3837
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/secrets.ts
@@ -0,0 +1,74 @@
+// Secrets the agent and you hand each other by name. The agent-secrets plugin keeps them; the
+// portal is where you type and reveal them. A reply shows one with a `SECRET:NAME` line; hub.py's
+// SECRET_LINE matches the same shape for notifications.
+import { useSyncExternalStore } from "react"
+import { api, ApiError } from "@/lib/api"
+
+export type SecretInfo = { name: string; note: string; origin: "you" | "agent"; created_at: number; updated_at: number }
+
+const LINE = /^[^\S\n]*SECRET:([A-Za-z_][A-Za-z0-9_]{0,63})[^\S\n]*$/gm
+const CODE = /```[\s\S]*?(?:```|$)|`[^`\n]*`/g
+
+export type ReplyPart = { text: string; secret?: undefined } | { secret: string; text?: undefined }
+
+/** A reply cut at its SECRET: lines, so each secret shows where the line was. Lines inside code
+ * stay text, and so does a last line still streaming in (its name may not be complete yet). */
+export function splitSecrets(text: string, streaming = false): ReplyPart[] {
+  const masked = text.replace(CODE, m => " ".repeat(m.length))
+  const found = [...masked.matchAll(LINE)].filter(m => !streaming || m.index + m[0].length < text.trimEnd().length)
+  if (!found.length) return [{ text }]
+  const parts: ReplyPart[] = []
+  let at = 0
+  for (const m of found) {
+    const before = text.slice(at, m.index).trim()
+    if (before) parts.push({ text: before })
+    parts.push({ secret: m[1] })
+    at = m.index + m[0].length
+  }
+  const after = text.slice(at).trim()
+  if (after) parts.push({ text: after })
+  return parts
+}
+
+export const secretPath = (name: string) => `/api/secrets/${encodeURIComponent(name)}`
+
+export const revealSecret = (name: string) => api<SecretInfo & { value: string }>(secretPath(name)).then(s => s.value)
+
+// The stored names and notes, shared by every card and Settings; reloaded on `secrets.changed`.
+// null until the first read; false when the server has no secrets plugin.
+let list: SecretInfo[] | false | null = null
+let loading: Promise<void> | null = null
+const listeners = new Set<() => void>()
+
+export function reloadSecrets() {
+  loading = api<SecretInfo[]>("/api/secrets").then(
+    rows => {
+      list = rows
+      for (const l of listeners) l()
+    },
+    e => {
+      if (e instanceof ApiError && e.status === 404) {
+        list = false
+        for (const l of listeners) l()
+      }
+    },
+  )
+  return loading
+}
+
+// A name a reply shows that the list doesn't have yet (stored by a command just now): read again
+// once before calling it gone.
+const rechecked = new Set<string>()
+export function recheckSecret(name: string) {
+  if (rechecked.has(name)) return null
+  rechecked.add(name)
+  return reloadSecrets()
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener)
+  if (!loading) void reloadSecrets()
+  return () => listeners.delete(listener)
+}
+
+export const useSecrets = () => useSyncExternalStore(subscribe, () => list)
diff --git a/plugins/nako-portal/web/src/lib/session-refs.ts b/plugins/nako-portal/web/src/lib/session-refs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5fe494c6deb6f58729ef6368b38368ac1779e52c
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/session-refs.ts
@@ -0,0 +1,61 @@
+// `@session:<profile>/<id>` references, the form Hermes's session search tells Nako to cite a past
+// chat in. Hermes Desktop draws them as links to the chat; here they become links to the chat's
+// page in the portal, labelled with its title once the chat list knows it.
+import { useSyncExternalStore } from "react"
+
+// Same match as Hermes Desktop (`apps/desktop/src/lib/session-refs.ts`): a bare value or one
+// fenced in backticks/quotes, not inside a word, a path or a markdown link a reply already wrote.
+const SESSION_REF = /(?<![\w/])(?<!]\()@session:(`[^`\n]+`|"[^"\n]+"|'[^'\n]+'|\S+)/g
+const TRAILING = /[,.;:!?)\]}]+$/
+// What the portal's chat route accepts (`parseRoute`).
+const SESSION_ID = /^[\w.-]+$/
+// Code fences and inline code spans, which show references as typed.
+const CODE = /(```[\s\S]*?(?:```|$)|`[^`\n]*`)/g
+
+export const CHAT_HREF = "#/c/"
+
+/** The chat a reference points at, or null when it isn't one the portal can open. */
+export function sessionOf(value: string): string | null {
+  const id = value.slice(value.indexOf("/") + 1).trim()
+  return SESSION_ID.test(id) ? id : null
+}
+
+/** A chat id short enough to read, for a chat the list doesn't know the title of. */
+export const shortId = (id: string) => (id.length > 10 ? `${id.slice(0, 8)}…` : id)
+
+function linkify(text: string) {
+  return text.replace(SESSION_REF, (match, raw: string) => {
+    const fenced = /^([`"']).*\1$/.test(raw) && raw.length > 1
+    const value = fenced ? raw.slice(1, -1) : raw.replace(TRAILING, "")
+    const session = sessionOf(value)
+    if (!session) return match
+    const trailing = fenced ? "" : raw.slice(value.length)
+    return `[${shortId(session).replace(/[[\]\\]/g, "\\$&")}](${CHAT_HREF}${session})${trailing}`
+  })
+}
+
+/** The reply with each reference outside code turned into a markdown link to its chat. */
+export function linkSessionRefs(text: string): string {
+  if (!text.includes("@session:")) return text
+  return text
+    .split(CODE)
+    .map((part, i) => (i % 2 ? part : linkify(part)))
+    .join("")
+}
+
+// Chat titles from the sidebar's list, so a link can read as the chat's name.
+let titles = new Map<string, string>()
+const listeners = new Set<() => void>()
+
+export function rememberTitles(rows: { id: string; title: string }[]) {
+  titles = new Map(rows.filter(row => row.title).map(row => [row.id, row.title]))
+  for (const listener of listeners) listener()
+}
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+/** The chat's title, or an empty string while the list doesn't have it. */
+export const useChatTitle = (session: string) => useSyncExternalStore(subscribe, () => titles.get(session) ?? "")
diff --git a/plugins/nako-portal/web/src/lib/table-copy.ts b/plugins/nako-portal/web/src/lib/table-copy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6a79975c3eef6717ccd53e7c883c7abf8bbd9cb5
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/table-copy.ts
@@ -0,0 +1,29 @@
+// Streamdown's table copy button opens a Markdown/CSV/TSV menu. We only want TSV (it pastes
+// straight into a spreadsheet), so catch the click before Streamdown sees it and copy at once.
+// The HTML copy goes along too, so rich editors keep the rows and columns.
+import { loadedMarkdown } from "./markdown"
+
+const FLASH_MS = 1500
+
+document.addEventListener(
+  "click",
+  async e => {
+    const button = (e.target as Element | null)?.closest<HTMLButtonElement>('button[title="Copy table"]')
+    const table = button?.closest('[data-streamdown="table-wrapper"]')?.querySelector("table")
+    // A table on screen means the renderer that drew it is loaded.
+    const markdown = loadedMarkdown()
+    if (!button || !table || !markdown) return
+    e.preventDefault()
+    e.stopPropagation()
+    const tsv = markdown.tableDataToTSV(markdown.extractTableDataFromElement(table))
+    await navigator.clipboard.write([
+      new ClipboardItem({
+        "text/plain": new Blob([tsv], { type: "text/plain" }),
+        "text/html": new Blob([table.outerHTML], { type: "text/html" }),
+      }),
+    ])
+    button.dataset.copied = ""
+    setTimeout(() => delete button.dataset.copied, FLASH_MS)
+  },
+  true,
+)
diff --git a/plugins/nako-portal/web/src/lib/theme.ts b/plugins/nako-portal/web/src/lib/theme.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3cec45fedc8d5eee22b3c844121384380b6b1443
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/theme.ts
@@ -0,0 +1,38 @@
+// Light, dark, or follow the device. public/theme.js applies the same choice before first paint.
+import { useSyncExternalStore } from "react"
+
+export type Theme = "system" | "light" | "dark"
+
+const KEY = "theme"
+const LIGHT = "(prefers-color-scheme: light)"
+const listeners = new Set<() => void>()
+
+function stored(): Theme {
+  const value = localStorage.getItem(KEY)
+  return value === "light" || value === "dark" ? value : "system"
+}
+
+function apply() {
+  const theme = stored()
+  const light = theme === "light" || (theme === "system" && matchMedia(LIGHT).matches)
+  const root = document.documentElement
+  root.classList.toggle("light", light)
+  root.classList.toggle("dark", !light)
+  document.querySelector('meta[name="theme-color"]')?.setAttribute("content", light ? "#fbfbfc" : "#09090b")
+}
+
+matchMedia(LIGHT).addEventListener("change", apply)
+
+export function setTheme(theme: Theme) {
+  if (theme === "system") localStorage.removeItem(KEY)
+  else localStorage.setItem(KEY, theme)
+  apply()
+  for (const listener of listeners) listener()
+}
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+export const useTheme = () => useSyncExternalStore(subscribe, stored)
diff --git a/plugins/nako-portal/web/src/lib/times.ts b/plugins/nako-portal/web/src/lib/times.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d33ddc9b3328d6ac5c943f8acf84f036338b0d9a
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/times.ts
@@ -0,0 +1,32 @@
+// When a message was written, as the chat shows it. `at` is Unix seconds.
+
+const clock = (d: Date) => d.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })
+
+const midnight = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime()
+
+// Whole days between `at` and today: 0 today, 1 yesterday.
+function daysAgo(at: number, now: Date) {
+  return Math.round((midnight(now) - midnight(new Date(at * 1000))) / 86_400_000)
+}
+
+export const dayOf = (at: number) => midnight(new Date(at * 1000))
+
+// The line between days: "Today", "Yesterday", else "Thu, Nov 12" (with the year when it isn't this one).
+export function dayLabel(at: number, now = new Date()) {
+  const ago = daysAgo(at, now)
+  if (ago === 0) return "Today"
+  if (ago === 1) return "Yesterday"
+  const d = new Date(at * 1000)
+  return d.toLocaleDateString([], { weekday: "short", month: "short", day: "numeric", ...(d.getFullYear() === now.getFullYear() ? {} : { year: "numeric" }) })
+}
+
+export const timeOf = (at: number) => clock(new Date(at * 1000))
+
+// On hover: "Today at 9:14 AM", "Yesterday at 11:52 PM", else "14/11/26 at 11:52 PM".
+export function fullTime(at: number, now = new Date()) {
+  const ago = daysAgo(at, now)
+  const d = new Date(at * 1000)
+  const pad = (n: number) => String(n).padStart(2, "0")
+  const day = ago === 0 ? "Today" : ago === 1 ? "Yesterday" : `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${pad(d.getFullYear() % 100)}`
+  return `${day} at ${clock(d)}`
+}
diff --git a/plugins/nako-portal/web/src/lib/types.ts b/plugins/nako-portal/web/src/lib/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c205e27a9fd9f6f73546facd0a1037d6552e3f77
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/types.ts
@@ -0,0 +1,151 @@
+import { z } from "zod"
+
+export type Me = { signed_in: boolean; has_passkeys: boolean; connected: boolean; name?: string; environments?: boolean; machine_load?: boolean }
+
+// A named, colored set of chats the sidebar shows together (`/api/groups`); a chat is in one at most.
+export const GROUP_COLORS = ["blue", "green", "yellow", "orange", "red", "teal", "purple", "grey"] as const
+export type GroupColor = (typeof GROUP_COLORS)[number]
+export const ChatGroup = z.object({ id: z.string(), name: z.string(), color: z.enum(GROUP_COLORS) })
+export type ChatGroup = z.infer<typeof ChatGroup>
+
+export type SessionRow = {
+  id: string
+  title: string
+  started_at: number
+  pinned?: boolean
+  // The one chat posts to the portal (cron deliveries) land in; it sits above every other chat.
+  notifications?: boolean
+  // Where review threads post their status; it sits under Notifications.
+  reviews?: boolean
+  // A post landed in the Notifications or Reviews chat since it was last opened.
+  unread?: boolean
+  status?: Status | null
+  // A turn ended here that you haven't opened the chat for since: the sidebar marks it.
+  finished?: boolean
+  // Another machine's chat, reached through this portal's mesh: that machine's name.
+  machine?: string
+  group?: ChatGroup | null
+}
+
+// A slash command a portal chat can run (`/api/commands`).
+export type Command = { name: string; description: string; skill: boolean }
+
+// What a command printed, shown in the chat where it ran. Only this browser keeps it, like Desktop.
+// `at` is the transcript index it follows.
+export type CommandNote = { session: string; at: number; text: string; key: string }
+
+// A background process a chat's turn started (terminal background=true), from Hermes's process registry.
+export type BackgroundProcess = {
+  id: string
+  command: string
+  label: string
+  cwd?: string
+  running: boolean
+  // How it ended: exited, killed, lost, ...
+  ended?: string | null
+  started_at: number
+  exited_at: number | null
+  exit_code: number | null
+  notify: boolean
+}
+
+export type Status = "working" | "needs you" | "done" | "failed"
+
+// Another machine in this portal's mesh (`/api/mesh`).
+export type Machine = {
+  name: string
+  online: boolean
+  // Its Hermes gateway is up, so it can run tasks (only while online).
+  gateway: boolean
+  os: string | null
+  hostname: string | null
+  last_seen: number | null
+  working: number
+}
+
+// Where new machines install the portal plugin from: saved on the Mesh page, else detected.
+export type PluginSource = { source: string | null; detected: string | null; saved: boolean }
+
+export type Mesh = { hub: boolean; name?: string; address?: string | null; plugin?: PluginSource; machines: Machine[] }
+
+export type Sender = { session: string; title: string }
+
+export type HistoryMessage =
+  // images: local previews for a turn that is still being sent
+  // steered: sent while a turn was running, so Hermes fed it into that turn
+  // sender: the thread that sent it in (a report back, a brief), when it isn't the person's own
+  // timestamp: when it was written, Unix seconds
+  | { role: "user"; text: string; row_id?: string | number; timestamp?: number; images?: string[]; steered?: boolean; sender?: Sender }
+  // label: the cron job that posted it, when it's a cron post
+  // post: a message no prompt asked for, in a chat posts land in (a review's status)
+  // ended: the reply that ended its turn, counting turns the app never sees start
+  | { role: "assistant"; text: string; timestamp?: number; reasoning?: string; label?: string; post?: boolean; ended?: boolean; row_id?: string | number }
+  | { role: "tool"; name: string; context?: string; tool_call_id?: string }
+
+export type PortalRequest = {
+  id: string
+  method: string
+  answerable: boolean
+  params: {
+    description?: string
+    command?: string
+    choices?: string[]
+    questions?: { qid: string; question: string; choices?: string[] }[]
+    // A secret request: the name it'll be stored under, why it's needed, and whether one exists.
+    name?: string
+    note?: string
+    replace?: boolean
+  }
+}
+
+export type OpenSession = {
+  session: string
+  // Where it came in: "portal", or another way in (slack, cron...), which opens read-only.
+  source?: string
+  title: string
+  messages: HistoryMessage[]
+  // Where messages[0] sits in the whole transcript; above 0, older pages are left to load.
+  start: number
+  running: boolean
+  status?: Status | null
+  requests: PortalRequest[]
+  // What the running turn has shown so far, for a chat opened mid-turn.
+  live?: Live
+}
+
+// What the gateway has sent in a chat and not saved yet: a reply streaming in (each edit
+// replaces its text), tool progress, a post. The transcript replaces it once saved.
+// after: how many tools the turn had started when the message was last written to, so a message
+// followed by more tool calls reads as her working, not her reply.
+export type LiveMessage = { id: string; text: string; after?: number }
+
+// A tool call in the running turn, as it starts and ends.
+export type LiveTool = { id: string; name: string; context: string; state: "running" | "done" | "failed" }
+
+export type Live = { messages: LiveMessage[]; tools: LiveTool[] }
+
+export type Passkey = { id: string; label: string; current?: boolean }
+
+// A session that came in another way (Slack, Discord, cron, the CLI), from `/api/outside`.
+// source: Hermes's name for the way in; last_active: Unix seconds.
+export type OutsideRow = { id: string; title: string; source: string; last_active: number; running: boolean }
+
+// The ways in other than the portal that have sessions, and which of those sessions run a turn now.
+export type Outside = { sources: string[]; running: string[] }
+export type HermesBuild = { version: string; build: string }
+
+export type Frame =
+  | { kind: "hub.connected"; hermes?: HermesBuild | null }
+  | { kind: "hub.disconnected" | "sessions.changed" | "status.synced" }
+  | { kind: "status"; session: string; status: Status | null; unread?: boolean }
+  | { kind: "sticker"; mood: "idle" | "working" | "needs-you"; working: number; finished: number }
+  | { kind: "request"; session: string; request: PortalRequest }
+  | { kind: "request.closed"; session: string; id: string }
+  | { kind: "alert"; session: string | null; title: string; body: string }
+  | { kind: "profile.changed"; profile: string }
+  | ({ kind: "outside" } & Outside)
+  | { kind: "machines.changed" }
+  | { kind: "secrets.changed" }
+  | { kind: "providers.changed" }
+  | { kind: "mcp.changed" }
+  | { kind: "event"; session: string; type: string; payload: Record<string, unknown> }
