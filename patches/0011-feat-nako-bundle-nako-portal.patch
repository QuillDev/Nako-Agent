+import { useSyncExternalStore } from "react"
+
+type DesktopBridge = { invoke: (command: string, args?: Record<string, unknown>) => Promise<unknown> }
+
+/** How the page asks the desktop app for things; undefined in a browser. */
+export const desktopApp = () => window.nakoDesktop ?? window.__TAURI_INTERNALS__
+
+// The desktop app on Windows and Linux has no system title bar: it sets window.nakoWindow and
+// lets the portal move, resize and close the window. Browsers and older apps never set it.
+declare global {
+  interface Window {
+    nakoWindow?: { controls: boolean }
+    nakoDesktop?: DesktopBridge
+    /** The earlier (Tauri) desktop app's bridge, until every install has updated. */
+    __TAURI_INTERNALS__?: DesktopBridge
+  }
+}
+
+// While the app's in-app browser is open, its toolbar holds the window buttons: the app sets
+// controls to false and fires "nako-window", and back again when the browser closes.
+const subscribe = (changed: () => void) => {
+  window.addEventListener("nako-window", changed)
+  return () => window.removeEventListener("nako-window", changed)
+}
+
+const controls = () => Boolean(window.nakoWindow?.controls)
+
+export function useWindowControls() {
+  return useSyncExternalStore(subscribe, controls, () => false)
+}
+
+export function windowAction(action: "minimize" | "toggle_maximize" | "close") {
+  void desktopApp()?.invoke(`plugin:window|${action}`, { label: "main" })
+}
diff --git a/plugins/nako-portal/web/src/lib/environments.ts b/plugins/nako-portal/web/src/lib/environments.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5d8d8e636237f5880ae0765fb60e110575325e0c
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/environments.ts
@@ -0,0 +1,111 @@
+import { useEffect, useSyncExternalStore } from "react"
+import { z } from "zod"
+import { api } from "@/lib/api"
+
+// What the owner's environments command reports (dashboard/portal/environments.py), shared by the
+// sidebar row and the page.
+const Link = z.object({ label: z.string(), url: z.string() })
+const Environment = z.object({
+  name: z.string(),
+  status: z.enum(["running", "partial", "stopped"]),
+  detail: z.string().optional(),
+  session: z.string().optional(),
+  memory: z.number().optional(),
+  links: z.array(Link),
+})
+export const Environments = z.object({
+  title: z.string(),
+  environments: z.array(Environment),
+  links: z.array(Link),
+  can_stop: z.boolean().default(false),
+})
+export type Environment = z.infer<typeof Environment>
+export type Environments = z.infer<typeof Environments>
+
+export const STATUS_DOT: Record<Environment["status"], string> = {
+  running: "bg-emerald-500",
+  partial: "bg-amber-500",
+  stopped: "bg-muted-foreground/40",
+}
+
+type State = {
+  data: Environments | null
+  error: string
+  stopping: ReadonlySet<string>
+  stopErrors: Readonly<Record<string, string>>
+}
+
+let current: State = { data: null, error: "", stopping: new Set(), stopErrors: {} }
+const listeners = new Set<() => void>()
+let loading: Promise<void> | null = null
+let fetchSeq = 0
+
+function set(next: State) {
+  current = next
+  for (const listener of listeners) listener()
+}
+
+export function loadEnvironments(fresh = false): Promise<void> {
+  if (!fresh && loading) return loading
+  const seq = ++fetchSeq
+  const promise = api<unknown>("/api/environments")
+    .then(
+      raw => {
+        if (seq < fetchSeq) return
+        const data = Environments.parse(raw)
+        const live = new Set(data.environments.filter(env => env.status !== "stopped").map(env => env.name))
+        const stopErrors = Object.fromEntries(Object.entries(current.stopErrors).filter(([name]) => live.has(name)))
+        set({ ...current, data, error: "", stopErrors })
+      },
+      (error: unknown) => {
+        if (seq < fetchSeq) return
+        set({ ...current, error: error instanceof Error ? error.message : String(error) })
+      },
+    )
+    .finally(() => {
+      if (loading === promise) loading = null
+    })
+  loading = promise
+  return promise
+}
+
+/** Run the owner's stop command for one environment in the background, then refresh the list. */
+export async function stopEnvironment(name: string): Promise<void> {
+  if (current.stopping.has(name)) return
+  const next = new Set(current.stopping)
+  next.add(name)
+  const { [name]: _, ...restErrors } = current.stopErrors
+  set({ ...current, stopping: next, stopErrors: restErrors })
+  try {
+    await api(`/api/environments/${encodeURIComponent(name)}/stop`, { method: "POST" })
+    await loadEnvironments(true)
+    while (loading) await loading
+  } catch (error: unknown) {
+    const message = error instanceof Error ? error.message : String(error)
+    set({ ...current, stopErrors: { ...current.stopErrors, [name]: message } })
+  } finally {
+    const after = new Set(current.stopping)
+    after.delete(name)
+    set({ ...current, stopping: after })
+  }
+}
+
+/** The last read, refreshed on mount and every `every` ms while something shows it. */
+export function useEnvironments(enabled: boolean, every = 30_000): State {
+  const state = useSyncExternalStore(
+    listener => {
+      listeners.add(listener)
+      return () => listeners.delete(listener)
+    },
+    () => current,
+  )
+  useEffect(() => {
+    if (!enabled) return
+    void loadEnvironments()
+    const timer = setInterval(() => {
+      if (document.visibilityState === "visible") void loadEnvironments()
+    }, every)
+    return () => clearInterval(timer)
+  }, [enabled, every])
+  return state
+}
diff --git a/plugins/nako-portal/web/src/lib/fresh-build.ts b/plugins/nako-portal/web/src/lib/fresh-build.ts
new file mode 100644
index 0000000000000000000000000000000000000000..098c3bf9cabf36584c2a73ff947a18e435dec200
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/fresh-build.ts
@@ -0,0 +1,53 @@
+// Long-lived pages (the apps' floating panels, a tab left open for days) keep the bundle they first
+// loaded, so a deploy never reaches them and new kinds of cards show as unanswerable. Whenever the
+// page comes back into view, and now and then while it's up, compare our bundle with the one the
+// server hands out and reload onto the new one. Drafts live in localStorage, so a reload loses
+// nothing; it only waits while a secret is half-typed, the one value deliberately never saved.
+
+const BUNDLE = /\/assets\/index-[\w-]+\.js/
+/** Don't ask the server more often than this, however many triggers fire. */
+const QUIET = 30_000
+const EVERY = 5 * 60_000
+
+/** The bundle this page runs, or null in the dev server (no hashed bundle, nothing to compare). */
+export function loadedBundle(doc: Document = document): string | null {
+  for (const script of doc.querySelectorAll<HTMLScriptElement>("script[type=module][src]")) {
+    const match = new URL(script.src, location.href).pathname.match(BUNDLE)
+    if (match) return match[0]
+  }
+  return null
+}
+
+/** The bundle named in a served index.html, or null when it names none. */
+export const servedBundle = (html: string): string | null => html.match(BUNDLE)?.[0] ?? null
+
+/** A secret typed into a request card isn't saved anywhere, so a reload would throw it away. */
+function typingSecret(): boolean {
+  return [...document.querySelectorAll<HTMLInputElement>("[data-secret-request] input")].some(input => input.value)
+}
+
+let last = 0
+
+/** Reload onto the server's current bundle if ours is older. `now` skips the quiet period. */
+export async function checkBuild(now = false): Promise<void> {
+  const ours = loadedBundle()
+  if (!ours || (!now && Date.now() - last < QUIET)) return
+  last = Date.now()
+  try {
+    const response = await fetch("/", { cache: "no-store", credentials: "same-origin" })
+    if (!response.ok) return
+    const theirs = servedBundle(await response.text())
+    if (theirs && theirs !== ours && !typingSecret()) location.reload()
+  } catch {
+    // Offline or mid-restart: the next trigger tries again.
+  }
+}
+
+if (loadedBundle()) {
+  const check = () => document.visibilityState === "visible" && void checkBuild()
+  document.addEventListener("visibilitychange", check)
+  window.addEventListener("focus", check)
+  // The Android panel reopens by moving the hash to the chat it shows.
+  window.addEventListener("hashchange", check)
+  setInterval(check, EVERY)
+}
diff --git a/plugins/nako-portal/web/src/lib/hearts.ts b/plugins/nako-portal/web/src/lib/hearts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..89f6170ccda0e4e6d50e4952319956bd2596d7ff
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/hearts.ts
@@ -0,0 +1,47 @@
+const THANKS = /\b(thanks|thank\s*you)\b/i
+
+export function saysThanks(text: string): boolean {
+  return THANKS.test(text)
+}
+
+const HEART =
+  '<svg viewBox="0 0 24 24" width="100%" height="100%" aria-hidden="true"><path fill="currentColor" d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.1 0 3.6 1.2 4.4 2.6.8-1.4 2.3-2.6 4.4-2.6 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z"/></svg>'
+
+// A short burst of hearts floating up from the composer.
+export function burstHearts(origin?: Element | null) {
+  if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return
+  const box = origin?.getBoundingClientRect()
+  const left = box ? box.left : 0
+  const width = box ? box.width : window.innerWidth
+  const y = box ? box.top : window.innerHeight - 80
+  // One heart per ~32px, spaced evenly across the composer with a little jitter.
+  const count = Math.max(8, Math.min(28, Math.round(width / 32)))
+  const slot = width / count
+
+  const layer = document.createElement("div")
+  layer.className = "hearts-layer"
+  let longest = 0
+  for (let i = 0; i < count; i++) {
+    const heart = document.createElement("span")
+    heart.className = "heart"
+    heart.innerHTML = HEART
+    const size = 14 + Math.random() * 14
+    const duration = 1400 + Math.random() * 1000
+    const delay = Math.random() * 400
+    longest = Math.max(longest, duration + delay)
+    Object.assign(heart.style, {
+      left: `${Math.min(Math.max(left + slot * (i + 0.2 + Math.random() * 0.6) - size / 2, left), left + width - size)}px`,
+      top: `${y - size}px`,
+      width: `${size}px`,
+      height: `${size}px`,
+      animationDuration: `${duration}ms`,
+      animationDelay: `${delay}ms`,
+    })
+    heart.style.setProperty("--dx", `${(Math.random() - 0.5) * 40}px`)
+    heart.style.setProperty("--rise", `${-(120 + Math.random() * 180)}px`)
+    heart.style.setProperty("--rot", `${(Math.random() - 0.5) * 40}deg`)
+    layer.appendChild(heart)
+  }
+  document.body.appendChild(layer)
+  window.setTimeout(() => layer.remove(), longest + 100)
+}
diff --git a/plugins/nako-portal/web/src/lib/machine-load.ts b/plugins/nako-portal/web/src/lib/machine-load.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1d5dcf9063d8e13a5a1d41307e33b8991132ce6b
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/machine-load.ts
@@ -0,0 +1,71 @@
+import { useEffect, useSyncExternalStore } from "react"
+import { z } from "zod"
+import { api } from "@/lib/api"
+
+// Memory and CPU use of the machine the portal runs on (dashboard/portal/machine_load.py).
+export const MachineLoad = z.object({
+  memory: z.object({ used: z.number(), total: z.number(), percent: z.number() }),
+  cpu: z.object({ percent: z.number().nullable() }),
+  warn_at: z.number(),
+})
+export type MachineLoad = z.infer<typeof MachineLoad>
+
+// Past this, the warning turns from amber to red.
+export const CRITICAL_AT = 90
+
+let current: MachineLoad | null = null
+const listeners = new Set<() => void>()
+let loading: Promise<void> | null = null
+
+function load(): Promise<void> {
+  loading ??= api<unknown>("/api/machine-load")
+    .then(
+      raw => {
+        current = MachineLoad.parse(raw)
+        for (const listener of listeners) listener()
+      },
+      () => {},
+    )
+    .finally(() => {
+      loading = null
+    })
+  return loading
+}
+
+/** The latest reading, refreshed every `every` ms while the page is visible. */
+export function useMachineLoad(enabled: boolean, every = 15_000): MachineLoad | null {
+  const state = useSyncExternalStore(
+    listener => {
+      listeners.add(listener)
+      return () => listeners.delete(listener)
+    },
+    () => current,
+  )
+  useEffect(() => {
+    if (!enabled) return
+    void load()
+    const timer = setInterval(() => {
+      if (document.visibilityState === "visible") void load()
+    }, every)
+    const visible = () => document.visibilityState === "visible" && void load()
+    document.addEventListener("visibilitychange", visible)
+    return () => {
+      clearInterval(timer)
+      document.removeEventListener("visibilitychange", visible)
+    }
+  }, [enabled, every])
+  return enabled ? state : null
+}
+
+/** The higher of memory and CPU when it's at or past the warning line, else null. */
+export function loadWarning(load: MachineLoad | null): { label: string; percent: number } | null {
+  if (!load) return null
+  const memory = { label: "RAM", percent: load.memory.percent }
+  const cpu = { label: "CPU", percent: load.cpu.percent ?? 0 }
+  const high = cpu.percent > memory.percent ? cpu : memory
+  return high.percent >= load.warn_at ? high : null
+}
+
+export function gigabytes(bytes: number): string {
+  return `${(bytes / 1024 ** 3).toFixed(1)} GB`
+}
diff --git a/plugins/nako-portal/web/src/lib/markdown.ts b/plugins/nako-portal/web/src/lib/markdown.ts
new file mode 100644
index 0000000000000000000000000000000000000000..60f86f566519c6bebe0b5c5384717c26f46c4758
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/markdown.ts
@@ -0,0 +1,26 @@
+// The Markdown renderer (Streamdown and its parsers) is about half the app, and nothing needs it
+// before a chat's history arrives. Loading it as its own chunk, started as soon as the app runs,
+// lets the page and the history requests start while it downloads and compiles.
+import { useSyncExternalStore } from "react"
+
+type Markdown = typeof import("streamdown")
+
+let loaded: Markdown | null = null
+const listeners = new Set<() => void>()
+
+export const markdown: Promise<Markdown> = import("streamdown").then(module => {
+  loaded = module
+  for (const listener of listeners) listener()
+  return module
+})
+
+/** The renderer once it's in, for code that only runs on rendered Markdown (a table's copy button). */
+export const loadedMarkdown = () => loaded
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+/** The renderer, or null for the moment it's still loading. */
+export const useMarkdown = () => useSyncExternalStore(subscribe, loadedMarkdown)
diff --git a/plugins/nako-portal/web/src/lib/mcp.ts b/plugins/nako-portal/web/src/lib/mcp.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1d6649ca3297689dc0767c7877c911035122b708
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/mcp.ts
@@ -0,0 +1,93 @@
+// MCP servers: the list `hermes mcp` keeps for the shown profile. The gateway reads and writes
+// it with Hermes's own helpers; header and env values never come back, only their names.
+import { useSyncExternalStore } from "react"
+import { api, ApiError } from "@/lib/api"
+
+export type McpServer = {
+  name: string
+  url: string
+  command: string
+  args: string[]
+  env: string[]
+  auth: "none" | "header" | "oauth"
+  enabled: boolean
+  plugin: string
+  status: "connected" | "connecting" | "failed" | "disabled" | "lazy" | "configured" | "installing"
+  error: string
+  signed_in: boolean
+  picked: boolean
+  codex: string
+  installing: boolean
+}
+
+export type McpList = { servers: McpServer[]; codex: boolean }
+
+export type McpCatalogEntry = {
+  name: string
+  description: string
+  transport: string
+  url: string
+  command: string
+  args: string[]
+  auth: string
+  env: { name: string; prompt: string; required: boolean; secret: boolean; saved: boolean }[]
+  source: string
+  post_install: string
+  installed: boolean
+}
+
+export type McpTool = { name: string; description: string; on: boolean }
+export type McpTest = { ok: boolean; error: string; tools: McpTool[] }
+export type McpSignIn = { flow_id: string; status: string; authorization_url: string | null; error: string | null }
+
+export type McpCustom = { name: string; url?: string; command?: string; args?: string[]; env?: Record<string, string>; auth?: "oauth"; token?: string }
+
+const serverPath = (name: string) => `/api/mcp/servers/${encodeURIComponent(name)}`
+
+let list: McpList | false | null = null
+let loading: Promise<void> | null = null
+const listeners = new Set<() => void>()
+
+export function reloadMcp() {
+  loading = api<McpList>("/api/mcp").then(
+    rows => {
+      list = rows
+      for (const l of listeners) l()
+    },
+    e => {
+      // A Hermes that can't run MCP servers (or a gateway that went away): no page.
+      if (e instanceof ApiError) list = list || false
+      for (const l of listeners) l()
+    },
+  )
+  return loading
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener)
+  if (!loading) void reloadMcp()
+  return () => listeners.delete(listener)
+}
+
+/** null until the first read; false when this install has no MCP; the list after. */
+export const useMcp = () => useSyncExternalStore(subscribe, () => list)
+
+export const mcpCatalog = () => api<McpCatalogEntry[]>("/api/mcp/catalog")
+
+export const installMcp = (name: string, env: Record<string, string>) => api(`/api/mcp/catalog/${encodeURIComponent(name)}/install`, { method: "POST", body: { env } })
+
+export const addMcp = (server: McpCustom) => api<{ name: string }>("/api/mcp/servers", { method: "POST", body: server })
+
+export const setMcpEnabled = (name: string, enabled: boolean) => api(`${serverPath(name)}/enabled`, { method: "POST", body: { enabled } })
+
+export const removeMcp = (name: string) => api(`${serverPath(name)}/remove`, { method: "POST" })
+
+export const testMcp = (name: string) => api<McpTest>(`${serverPath(name)}/test`, { method: "POST" })
+
+export const setMcpTools = (name: string, tools: string[], on: string[]) => api(`${serverPath(name)}/tools`, { method: "POST", body: { tools, on } })
+
+export const startMcpSignIn = (name: string) => api<McpSignIn>(`${serverPath(name)}/signin`, { method: "POST" })
+
+export const pollMcpSignIn = (flow: string) => api<McpSignIn>(`/api/mcp/signin/${encodeURIComponent(flow)}`)
+
+export const cancelMcpSignIn = (flow: string) => api(`/api/mcp/signin/${encodeURIComponent(flow)}/cancel`, { method: "POST" })
diff --git a/plugins/nako-portal/web/src/lib/media.ts b/plugins/nako-portal/web/src/lib/media.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a472a3218389269ebb5eaab0075558963fcf7d30
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/media.ts
@@ -0,0 +1,68 @@
+// Files a transcript points at: MEDIA: tags in replies and image refs in user turns.
+// dashboard/portal/media.py parses the same shapes for /api/file; keep the two in step.
+
+const EXTS = (
+  "png jpg jpeg gif webp bmp tiff svg mp4 mov avi mkv webm 3gp mp3 m2a wav ogg opus m4a flac " +
+  "pdf docx doc odt rtf txt md epub xlsx xls ods csv tsv json xml yaml yml kmz kml geojson gpx " +
+  "pptx ppt odp key zip tar gz tgz bz2 xz 7z rar apk ipa html htm"
+)
+  .split(" ")
+  .sort((a, b) => b.length - a.length)
+  .join("|")
+
+const QUOTED = "`[^`\\n]+`|\"[^\"\\n]+\"|'[^'\\n]+'"
+const MEDIA = new RegExp(
+  `MEDIA:[^\\S\\n]*(?<path>${QUOTED}|(?:~/|/|[A-Za-z]:[\\\\/])[^\\n]*?\\.(?:${EXTS}))(?=[\\s\`"'*_,;:)\\]}\\[]|MEDIA:|\\.(?:\\s|$)|$)` +
+    `|^MEDIA:(?<line>(?:~/|/|[A-Za-z]:[\\\\/])[^\\n]+?)[^\\S\\n]*$`,
+  "gim",
+)
+const USER_IMAGE = new RegExp(`\\[Image attached at: (?<hint>[^\\n\\]]+)\\]|^@image:(?<ref>${QUOTED}|\\S+)[^\\S\\n]*$`, "gm")
+const CODE = /```[\s\S]*?(?:```|$)|(?<!MEDIA:)(?<!@image:)`[^`\n]*`/g
+// The session store's stand-in for each attached image.
+const PLACEHOLDER = /^\[(?:screenshot|image)\][^\S\n]*$/gm
+
+const unquote = (v: string) => (v.length > 1 && v[0] === v.at(-1) && "`\"'".includes(v[0]) ? v.slice(1, -1) : v)
+const masked = (text: string) => text.replace(CODE, m => " ".repeat(m.length))
+
+type Found = { start: number; end: number; path: string }
+
+function find(text: string, pattern: RegExp, group: (g: Record<string, string | undefined>) => string | undefined): Found[] {
+  return [...masked(text).matchAll(pattern)].map(m => ({ start: m.index, end: m.index + m[0].length, path: unquote(group(m.groups || {}) || "") }))
+}
+
+function cut(text: string, found: Found[]) {
+  let out = text
+  for (const f of [...found].reverse()) {
+    const after = out.slice(f.end)
+    // "see MEDIA:/a.png, then" reads "see, then" rather than "see , then"
+    const before = /^[,.;:)]/.test(after) ? out.slice(0, f.start).replace(/[^\S\n]+$/, "") : out.slice(0, f.start)
+    out = before + after
+  }
+  return out.replace(/[^\S\n]+$/gm, "").replace(/\n{3,}/g, "\n\n").trim()
+}
+
+export const isImage = (path: string) => /\.(png|jpe?g|gif|webp|bmp|svg)$/i.test(path)
+
+/** A reply without its MEDIA: tags, and the files they deliver. */
+export function splitReply(text: string) {
+  const found = find(text, MEDIA, g => g.path || g.line)
+  return { body: cut(text, found), files: [...new Set(found.map(f => f.path))] }
+}
+
+/** A user turn without Hermes's image hints and placeholders, and the images they name. */
+// An image turn is stored as [your text, image parts..., turn context]. Flattened, the image
+// parts become hints plus one placeholder each, so whatever follows the last placeholder is
+// context Hermes added for the model (plugin notes, memory recall), not something you typed.
+function withoutTurnContext(text: string) {
+  const placeholders = [...text.matchAll(PLACEHOLDER)]
+  const last = placeholders.at(-1)
+  return last ? text.slice(0, last.index + last[0].length) : text
+}
+
+export function splitUserTurn(text: string) {
+  const found = find(text, USER_IMAGE, g => g.hint || g.ref).filter(f => isImage(f.path))
+  if (!found.length) return { body: text, images: [] as string[] }
+  const typed = withoutTurnContext(text)
+  const body = cut(typed, found.filter(f => f.end <= typed.length)).replace(PLACEHOLDER, "").replace(/\n{3,}/g, "\n\n").trim()
+  return { body, images: [...new Set(found.map(f => f.path))] }
+}
