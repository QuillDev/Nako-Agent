+import asyncio
+import base64
+import importlib.util
+import struct
+import sys
+from pathlib import Path
+
+import pytest
+from aiohttp import web
+from aiohttp.test_utils import TestServer
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import ec
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+from cryptography.hazmat.primitives.kdf.hkdf import HKDF
+
+from portal import push
+from portal.store import Store
+
+pytestmark = pytest.mark.asyncio
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def b64(data):
+    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()
+
+
+def decrypt_like_a_browser(body, receiver, auth):
+    """RFC 8291 from the receiving side, written from the spec rather than the sender."""
+    salt, record_size, key_len = body[:16], struct.unpack(">I", body[16:20])[0], body[20]
+    sender_public = body[21 : 21 + key_len]
+    ciphertext = body[21 + key_len :]
+    assert record_size == 4096
+    shared = receiver.exchange(ec.ECDH(), ec.EllipticCurvePublicKey.from_encoded_point(ec.SECP256R1(), sender_public))
+    receiver_public = receiver.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
+
+    def hkdf(s, ikm, info, n):
+        return HKDF(algorithm=hashes.SHA256(), length=n, salt=s, info=info).derive(ikm)
+
+    ikm = hkdf(auth, shared, b"WebPush: info\x00" + receiver_public + sender_public, 32)
+    plain = AESGCM(hkdf(salt, ikm, b"Content-Encoding: aes128gcm\x00", 16)).decrypt(hkdf(salt, ikm, b"Content-Encoding: nonce\x00", 12), ciphertext, None)
+    assert plain.endswith(b"\x02")
+    return plain[:-1]
+
+
+async def test_a_push_reaches_the_browser_encrypted_and_dead_subscriptions_are_dropped(tmp_path):
+    receiver = ec.generate_private_key(ec.SECP256R1())
+    auth = b"0123456789abcdef"
+    received = []
+
+    async def service(request):
+        received.append((request.match_info["id"], dict(request.headers), await request.read()))
+        return web.Response(status=201 if request.match_info["id"] == "live" else 410)
+
+    app = web.Application()
+    app.router.add_post("/push/{id}", service)
+    server = TestServer(app)
+    await server.start_server()
+    store = Store(tmp_path / "portal.db")
+    keys = {"p256dh": b64(receiver.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)), "auth": b64(auth)}
+    live_url = str(server.make_url("/push/live"))
+    store.add_push(live_url, keys)
+    store.add_push(str(server.make_url("/push/gone")), keys)
+    vapid = push.Vapid(tmp_path / "vapid.pem", "mailto:owner@example.test")
+
+    import aiohttp
+
+    async with aiohttp.ClientSession() as http:
+        delivered = await push.Pusher(http, store, vapid).notify("fix the build", "done", "20261024_020202_bbbbbb")
+    await server.close()
+
+    assert delivered == 1
+    live = next(r for r in received if r[0] == "live")
+    assert live[1]["Content-Encoding"] == "aes128gcm"
+    assert live[1]["Authorization"].startswith("vapid t=") and f"k={vapid.public_key}" in live[1]["Authorization"]
+    assert b"fix the build" not in live[2]
+    assert decrypt_like_a_browser(live[2], receiver, auth) == b'{"title": "fix the build", "body": "done", "session": "20261024_020202_bbbbbb"}'
+    assert [s["endpoint"] for s in store.pushes()] == [live_url]
+    # The same identity survives a restart, or every existing subscription would break.
+    assert push.Vapid(tmp_path / "vapid.pem", "mailto:x").public_key == vapid.public_key
+
+
+async def test_cron_deliveries_to_the_portal_platform_land_in_its_inbox(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    fake_constants = type(sys)("hermes_constants")
+    fake_constants.get_hermes_home = lambda: home
+    monkeypatch.setitem(sys.modules, "hermes_constants", fake_constants)
+    spec = importlib.util.spec_from_file_location("nako_portal_plugin", ROOT / "__init__.py")
+    plugin = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(plugin)
+
+    registered = {}
+
+    class Ctx:
+        def register_hook(self, name, callback):
+            pass
+
+        def register_platform(self, **entry):
+            registered.update(entry)
+
+    plugin.register(Ctx())
+    assert registered["name"] == "portal"
+    sent = await registered["standalone_sender_fn"](None, "inbox", "daily digest: 3 new emails")
+    assert sent["success"]
+    rows = Store(home / "nako-portal" / "portal.db").inbox()
+    assert [(r["chat"], r["text"]) for r in rows] == [("inbox", "daily digest: 3 new emails")]
+    await asyncio.sleep(0)
+
+
+async def test_hermes_send_can_address_the_reviews_chat_and_waits_for_it_to_open(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    fake_constants = type(sys)("hermes_constants")
+    fake_constants.get_hermes_home = lambda: home
+    monkeypatch.setitem(sys.modules, "hermes_constants", fake_constants)
+    spec = importlib.util.spec_from_file_location("nako_portal_plugin_send", ROOT / "__init__.py")
+    plugin = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(plugin)
+    registered = {}
+
+    class Ctx:
+        def register_hook(self, name, callback):
+            pass
+
+        def register_platform(self, **entry):
+            registered.update(entry)
+
+    plugin.register(Ctx())
+    parse = registered["parse_target_ref_fn"]
+    assert [parse(ref) for ref in ("reviews", "inbox", "new", "a467018aadf64780")] == [
+        ("reviews", None), ("inbox", None), ("new", None), ("a467018aadf64780", None)
+    ]
+    # Names it doesn't own go on to Hermes's channel directory.
+    assert parse("Nako") is None and parse("reviews; rm") is None
+
+    # The gateway opens the thread once the post reaches it; the mirror runs right after the send.
+    import sqlite3
+
+    db = sqlite3.connect(home / "state.db")
+    db.execute("CREATE TABLE sessions (id TEXT, source TEXT, chat_id TEXT, ended_at REAL)")
+    db.commit()
+
+    async def gateway_opens_it():
+        await asyncio.sleep(0.4)
+        db.execute("INSERT INTO sessions VALUES ('s1', 'portal', 'reviews', NULL)")
+        db.commit()
+
+    opening = asyncio.get_running_loop().create_task(gateway_opens_it())
+    started = asyncio.get_running_loop().time()
+    sent = await registered["standalone_sender_fn"](None, "reviews", "web#12 · approved · sam")
+    assert sent["success"] and asyncio.get_running_loop().time() - started >= 0.4
+    await opening
+    rows = Store(home / "nako-portal" / "portal.db").inbox()
+    assert [(r["chat"], r["text"]) for r in rows] == [("reviews", "web#12 · approved · sam")]
+
+
+async def test_the_portal_keeps_one_titled_chat_for_its_posts(monkeypatch):
+    # Hermes's cron mirror appends each post to the open gateway session for portal:inbox, so
+    # that session must exist before the first post, and every post must find the same one.
+    gateway, config, session = (type(sys)(name) for name in ("gateway", "gateway.config", "gateway.session"))
+    config.Platform = lambda name: f"platform:{name}"
+    session.SessionSource = lambda **fields: tuple(sorted(fields.items()))
+    for module in (gateway, config, session):
+        monkeypatch.setitem(sys.modules, module.__name__, module)
+    spec = importlib.util.spec_from_file_location("nako_portal_plugin_chat", ROOT / "__init__.py")
+    plugin = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(plugin)
+
+    class Db:
+        titles = {}
+        archived = set()
+
+        def get_session(self, sid):
+            return {"id": sid, "archived": int(sid in self.archived)}
+
+        def set_session_archived(self, sid, archived):
+            (self.archived.add if archived else self.archived.discard)(sid)
+
+        def get_session_title(self, sid):
+            return self.titles.get(sid)
+
+        def set_session_title(self, sid, title):
+            self.titles[sid] = title
+
+    class Store:
+        _db = Db()
+        sessions = {}
+
+        def get_or_create_session(self, source, touch_activity=True):
+            entry = self.sessions.setdefault(source, type("Entry", (), {"session_id": f"s{len(self.sessions)}"})())
+            return entry
+
+    store = Store()
+    first = plugin._ensure_chat(store)
+    store._db.titles[first] = "renamed by hand"
+    assert plugin._ensure_chat(store) == first
+    (source,) = store.sessions
+    assert dict(source)["platform"] == "platform:portal" and dict(source)["chat_id"] == "inbox"
+    assert store._db.titles == {first: "renamed by hand"}
+    # Archived from another surface, it comes back the next time the portal reaches for it.
+    store._db.archived.add(first)
+    assert plugin._ensure_chat(store) == first
+    assert store._db.archived == set()
+    # The Reviews chat comes back the same way, titled on its first post.
+    reviews = plugin._ensure_chat(store, "reviews", "Reviews")
+    store._db.archived.add(reviews)
+    assert plugin._ensure_chat(store, "reviews", "Reviews") == reviews
+    assert store._db.archived == set() and store._db.titles[reviews] == "Reviews"
+    assert plugin._ensure_chat(None) is None
diff --git a/plugins/nako-portal/tests/test_desktop.py b/plugins/nako-portal/tests/test_desktop.py
new file mode 100644
index 0000000000000000000000000000000000000000..88bbefe30f0cc300f3524582991e7a6f9bebc101
--- /dev/null
+++ b/plugins/nako-portal/tests/test_desktop.py
@@ -0,0 +1,149 @@
+import base64
+import hashlib
+import json
+import secrets
+
+import aiohttp
+import pytest
+from aiohttp.test_utils import TestServer
+
+from conftest import ORIGIN, ROOT
+from portal.server import Portal
+
+pytestmark = pytest.mark.asyncio
+
+
+def pkce():
+    verifier = secrets.token_urlsafe(32)
+    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
+    return verifier, challenge
+
+
+class Clock:
+    def __init__(self):
+        self.now = 1_800_000_000.0
+
+    def __call__(self):
+        return self.now
+
+
+@pytest.fixture
+async def desktop(world, tmp_path):
+    """The portal with a controllable clock and a desktop release dir, plus a cookie-less client playing the app."""
+    clock = Clock()
+    portal = Portal(world.hub, world.store, origin=ORIGIN, web_root=ROOT / "dashboard" / "web", desktop_release_dir=tmp_path, clock=clock)
+    server = TestServer(portal.app())
+    await server.start_server()
+    async with aiohttp.ClientSession(cookie_jar=aiohttp.CookieJar(unsafe=True)) as app:
+        yield server, clock, app
+    await server.close()
+
+
+async def link(world, url, challenge):
+    """The signed-in browser approves the desktop app's sign-in."""
+    return await world.http.post(url("/api/desktop/link"), json={"challenge": challenge}, headers={"Origin": ORIGIN})
+
+
+async def test_the_desktop_app_signs_in_through_the_browser_and_keeps_the_session(world, desktop):
+    server, clock, app = desktop
+    url = lambda path: str(server.make_url(path))  # noqa: E731
+    sid = world.hermes.add_session("20261024_070707_abcdef", "deploy")
+    await world.sign_up()
+    verifier, challenge = pkce()
+
+    approved = await link(world, url, challenge)
+    assert approved.status == 200
+    code = (await approved.json())["code"]
+
+    # The app's webview opens the hand-off with the code and its secret, and comes back signed in.
+    finished = await app.get(url("/api/desktop/session"), params={"code": code, "verifier": verifier}, allow_redirects=False)
+    assert (finished.status, finished.headers["Location"]) == (303, "/")
+    listed = await app.get(url("/api/sessions"))
+    assert listed.status == 200
+    assert [s["id"] for s in await listed.json()] == [sid]
+
+    # The code works once.
+    other = aiohttp.CookieJar(unsafe=True)
+    async with aiohttp.ClientSession(cookie_jar=other) as replay:
+        again = await replay.get(url("/api/desktop/session"), params={"code": code, "verifier": verifier}, allow_redirects=False)
+        assert (again.status, again.headers["Location"]) == (303, "/#signin=failed")
+        assert (await replay.get(url("/api/sessions"))).status == 401
+
+
+async def test_a_hand_off_is_refused_without_the_apps_secret_a_signed_in_browser_or_in_time(world, desktop):
+    server, clock, app = desktop
+    url = lambda path: str(server.make_url(path))  # noqa: E731
+
+    async def signed_in_after(code, verifier):
+        response = await app.get(url("/api/desktop/session"), params={"code": code, "verifier": verifier}, allow_redirects=False)
+        assert response.status == 303
+        return (await app.get(url("/api/sessions"))).status == 200
+
+    verifier, challenge = pkce()
+    # A browser that isn't signed in, or a page on another site, can't approve anything.
+    assert (await link(world, url, challenge)).status == 401
+    await world.sign_up()
+    cross = await world.http.post(url("/api/desktop/link"), json={"challenge": challenge}, headers={"Origin": "https://evil.example"})
+    assert cross.status == 403
+    assert (await link(world, url, "not a challenge")).status == 400
+
+    # Someone who saw the code but not the app's secret gets nothing, and the code is spent.
+    code = (await (await link(world, url, challenge)).json())["code"]
+    assert not await signed_in_after(code, pkce()[0])
+    assert not await signed_in_after(code, verifier)
+
+    # Codes expire after two minutes.
+    code = (await (await link(world, url, challenge)).json())["code"]
+    clock.now += 121
+    assert not await signed_in_after(code, verifier)
+
+    code = (await (await link(world, url, challenge)).json())["code"]
+    clock.now += 119
+    assert await signed_in_after(code, verifier)
+
+
+async def test_the_desktop_app_updates_from_the_release_the_server_publishes(world, desktop, tmp_path):
+    server, clock, app = desktop
+    url = lambda path: str(server.make_url(path))  # noqa: E731
+    await world.sign_up()
+
+    def publish(manifest):
+        (tmp_path / "desktop-release.json").write_text(json.dumps(manifest), encoding="utf-8")
+
+    assert (await world.http.get(url("/api/desktop/release"))).status == 404
+    linux, windows = b"\x7fELF fake appimage", b"MZ fake installer"
+    (tmp_path / "nako.AppImage").write_bytes(linux)
+    (tmp_path / "nako-setup.exe").write_bytes(windows)
+    (tmp_path / "secret.txt").write_text("not a release file", encoding="utf-8")
+    platforms = {
+        "linux-x86_64": {"file": "nako.AppImage", "signature": "c2lnLWxpbnV4", "sizeBytes": len(linux)},
+        "windows-x86_64": {"file": "nako-setup.exe", "signature": "c2lnLXdpbmRvd3M=", "sizeBytes": len(windows) + 1},
+    }
+    # A version the updater can't compare is no release at all.
+    publish({"version": "latest", "platforms": platforms})
+    assert (await world.http.get(url("/api/desktop/release"))).status == 404
+
+    # A platform whose file doesn't match its manifest is left out; the others are still offered.
+    publish({"version": "0.2.0", "platforms": platforms})
+    release = await (await world.http.get(url("/api/desktop/release"))).json()
+    assert release == {"version": "0.2.0", "platforms": {"linux-x86_64": {"url": f"{ORIGIN}/desktop/nako.AppImage", "signature": "c2lnLWxpbnV4"}}}
+    assert (await world.http.get(url("/desktop/nako-setup.exe"))).status == 404
+
+    platforms["windows-x86_64"]["sizeBytes"] = len(windows)
+    # Entries naming paths or other files are ignored.
+    platforms["darwin-aarch64"] = {"file": "../portal/portal.db", "signature": "eA==", "sizeBytes": 1}
+    platforms["linux-aarch64"] = {"file": "secret.txt", "signature": "eA==", "sizeBytes": len("not a release file")}
+    publish({"version": "0.2.0", "platforms": platforms})
+    release = await (await world.http.get(url("/api/desktop/release"))).json()
+    assert release["platforms"] == {
+        "linux-x86_64": {"url": f"{ORIGIN}/desktop/nako.AppImage", "signature": "c2lnLWxpbnV4"},
+        "windows-x86_64": {"url": f"{ORIGIN}/desktop/nako-setup.exe", "signature": "c2lnLXdpbmRvd3M="},
+    }
+    assert await (await world.http.get(url("/desktop/nako.AppImage"))).read() == linux
+    assert await (await world.http.get(url("/desktop/nako-setup.exe"))).read() == windows
+    for other in ("secret.txt", "desktop-release.json", "..%2Fportal%2Fportal.db"):
+        assert (await world.http.get(url(f"/desktop/{other}"))).status == 404
+
+    # Only for the signed-in owner.
+    assert (await app.get(url("/api/desktop/release"))).status == 401
+    assert (await app.get(url("/desktop/nako.AppImage"))).status == 401
