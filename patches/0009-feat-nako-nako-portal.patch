index 0000000000000000000000000000000000000000..dc23dbcad4ea837e4c5ce94d765ecaa4c063f777
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/mcp.ts
@@ -0,0 +1,93 @@
+// MCP servers: the list `hermes mcp` keeps for the shown profile. The gateway reads and writes
+// it with Hermes's own helpers; header and env values never come back, only their names.
+import { useSyncExternalStore } from "react"
+import { api, ApiError } from "@/lib/api"
+
+export type McpServer = {
+  name: string
+  url: string
+  command: string
+  args: string[]
+  env: string[]
+  auth: "none" | "header" | "oauth"
+  enabled: boolean
+  plugin: string
+  status: "connected" | "connecting" | "failed" | "disabled" | "lazy" | "configured" | "installing"
+  error: string
+  signed_in: boolean
+  picked: boolean
+  codex: string
+  installing: boolean
+}
+
+export type McpList = { servers: McpServer[]; codex: boolean }
+
+export type McpCatalogEntry = {
+  name: string
+  description: string
+  transport: string
+  url: string
+  command: string
+  args: string[]
+  auth: string
+  env: { name: string; prompt: string; required: boolean; secret: boolean; saved: boolean }[]
+  source: string
+  post_install: string
+  installed: boolean
+}
+
+export type McpTool = { name: string; description: string; on: boolean }
+export type McpTest = { ok: boolean; error: string; tools: McpTool[] }
+export type McpSignIn = { flow_id: string; status: string; authorization_url: string | null; error: string | null }
+
+export type McpCustom = { name: string; url?: string; command?: string; args?: string[]; env?: Record<string, string>; auth?: "oauth"; token?: string }
+
+const serverPath = (name: string) => `/api/mcp/servers/${encodeURIComponent(name)}`
+
+let list: McpList | false | null = null
+let loading: Promise<void> | null = null
+const listeners = new Set<() => void>()
+
+export function reloadMcp() {
+  loading = api<McpList>("/api/mcp").then(
+    rows => {
+      list = rows
+      for (const l of listeners) l()
+    },
+    e => {
+      // A Hermes that can't run MCP servers (or a gateway that went away): no page.
+      list = e instanceof ApiError && e.status === 404 ? false : list || false
+      for (const l of listeners) l()
+    },
+  )
+  return loading
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener)
+  if (!loading) void reloadMcp()
+  return () => listeners.delete(listener)
+}
+
+/** null until the first read; false when this install has no MCP; the list after. */
+export const useMcp = () => useSyncExternalStore(subscribe, () => list)
+
+export const mcpCatalog = () => api<McpCatalogEntry[]>("/api/mcp/catalog")
+
+export const installMcp = (name: string, env: Record<string, string>) => api(`/api/mcp/catalog/${encodeURIComponent(name)}/install`, { method: "POST", body: { env } })
+
+export const addMcp = (server: McpCustom) => api<{ name: string }>("/api/mcp/servers", { method: "POST", body: server })
+
+export const setMcpEnabled = (name: string, enabled: boolean) => api(`${serverPath(name)}/enabled`, { method: "POST", body: { enabled } })
+
+export const removeMcp = (name: string) => api(`${serverPath(name)}/remove`, { method: "POST" })
+
+export const testMcp = (name: string) => api<McpTest>(`${serverPath(name)}/test`, { method: "POST" })
+
+export const setMcpTools = (name: string, tools: string[], on: string[]) => api(`${serverPath(name)}/tools`, { method: "POST", body: { tools, on } })
+
+export const startMcpSignIn = (name: string) => api<McpSignIn>(`${serverPath(name)}/signin`, { method: "POST" })
+
+export const pollMcpSignIn = (flow: string) => api<McpSignIn>(`/api/mcp/signin/${encodeURIComponent(flow)}`)
+
+export const cancelMcpSignIn = (flow: string) => api(`/api/mcp/signin/${encodeURIComponent(flow)}/cancel`, { method: "POST" })
diff --git a/plugins/nako-portal/web/src/lib/media.ts b/plugins/nako-portal/web/src/lib/media.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5419d7646790c597142ef7329c1301e0ce9964a9
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/media.ts
@@ -0,0 +1,75 @@
+// Files a transcript points at: MEDIA: tags in replies and image refs in user turns.
+// dashboard/portal/media.py parses the same shapes for /api/file; keep the two in step.
+
+const EXTS = (
+  "png jpg jpeg gif webp bmp tiff svg mp4 mov avi mkv webm 3gp mp3 m2a wav ogg opus m4a flac " +
+  "pdf docx doc odt rtf txt md epub xlsx xls ods csv tsv json xml yaml yml kmz kml geojson gpx " +
+  "pptx ppt odp key zip tar gz tgz bz2 xz 7z rar apk ipa html htm"
+)
+  .split(" ")
+  .sort((a, b) => b.length - a.length)
+  .join("|")
+
+const QUOTED = "`[^`\\n]+`|\"[^\"\\n]+\"|'[^'\\n]+'"
+const MEDIA = new RegExp(
+  `MEDIA:[^\\S\\n]*(?<path>${QUOTED}|(?:~/|/|[A-Za-z]:[\\\\/])[^\\n]*?\\.(?:${EXTS}))(?=[\\s\`"'*_,;:)\\]}\\[]|MEDIA:|\\.(?:\\s|$)|$)` +
+    `|^MEDIA:(?<line>(?:~/|/|[A-Za-z]:[\\\\/])[^\\n]+?)[^\\S\\n]*$`,
+  "gim",
+)
+const USER_IMAGE = new RegExp(`\\[Image attached at: (?<hint>[^\\n\\]]+)\\]|^@image:(?<ref>${QUOTED}|\\S+)[^\\S\\n]*$`, "gm")
+const CODE = /```[\s\S]*?(?:```|$)|(?<!MEDIA:)(?<!@image:)`[^`\n]*`/g
+// The session store's stand-in for each attached image.
+const PLACEHOLDER = /^\[(?:screenshot|image)\][^\S\n]*$/gm
+
+const unquote = (v: string) => (v.length > 1 && v[0] === v.at(-1) && "`\"'".includes(v[0]) ? v.slice(1, -1) : v)
+const masked = (text: string) => text.replace(CODE, m => " ".repeat(m.length))
+
+type Found = { start: number; end: number; path: string }
+
+function find(text: string, pattern: RegExp, group: (g: Record<string, string | undefined>) => string | undefined): Found[] {
+  return [...masked(text).matchAll(pattern)].map(m => ({ start: m.index, end: m.index + m[0].length, path: unquote(group(m.groups || {}) || "") }))
+}
+
+function cut(text: string, found: Found[]) {
+  let out = text
+  for (const f of [...found].reverse()) {
+    const after = out.slice(f.end)
+    // "see MEDIA:/a.png, then" reads "see, then" rather than "see , then"
+    const before = /^[,.;:)]/.test(after) ? out.slice(0, f.start).replace(/[^\S\n]+$/, "") : out.slice(0, f.start)
+    out = before + after
+  }
+  return out.replace(/[^\S\n]+$/gm, "").replace(/\n{3,}/g, "\n\n").trim()
+}
+
+export const isImage = (path: string) => /\.(png|jpe?g|gif|webp|bmp|svg)$/i.test(path)
+export const isHtml = (path: string) => /\.html?$/i.test(path)
+
+/** A reply without its MEDIA: tags, and the files they deliver. */
+export function splitReply(text: string) {
+  const found = find(text, MEDIA, g => g.path || g.line)
+  return { body: cut(text, found), files: [...new Set(found.map(f => f.path))] }
+}
+
+/** Clipboard text never contains secret placeholders or media control lines, even in code. */
+export function copyReplyText(text: string): string {
+  const clean = text.replace(/^[^\S\n]*(?:SECRET|MEDIA):[^\n]*(?:\n|$)/gim, "")
+  return splitReply(clean).body.replace(/\n{3,}/g, "\n\n").trim()
+}
+
+/** A user turn without Hermes's image hints and placeholders, and the images they name. */
+// An image turn is stored as [your text, image parts..., turn context]. Flattened, the image
+// parts become hints plus one placeholder each, so whatever follows the last placeholder is
+// context Hermes added for the model (plugin notes, memory recall), not something you typed.
+function withoutTurnContext(text: string) {
+  const placeholders = [...text.matchAll(PLACEHOLDER)]
+  const last = placeholders.at(-1)
+  return last ? text.slice(0, last.index + last[0].length) : text
+}
+
+export function splitUserTurn(text: string) {
+  const found = find(text, USER_IMAGE, g => g.hint || g.ref).filter(f => isImage(f.path))
+  if (!found.length) return { body: text, images: [] as string[] }
+  const typed = withoutTurnContext(text)
+  const body = cut(typed, found.filter(f => f.end <= typed.length)).replace(PLACEHOLDER, "").replace(/\n{3,}/g, "\n\n").trim()
+  return { body, images: [...new Set(found.map(f => f.path))] }
+}
