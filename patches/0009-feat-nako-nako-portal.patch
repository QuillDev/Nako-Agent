@@ -0,0 +1,27 @@
+package moe.nakode.portal.shell
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class FileDownloadsTest {
+    private val url = "https://portal.example.test/api/file?session=s1&path=%2Fhome%2Fme%2Fwhim%20logo%2B640.png&download=1"
+
+    @Test
+    fun savesUnderTheNameThePortalSends() {
+        val header = "attachment; filename=\"caf_ logo.png\"; filename*=UTF-8''caf%C3%A9%20logo.png"
+        assertEquals("café logo.png", FileDownloads.fileName(url, header))
+        assertEquals("caf_ logo.png", FileDownloads.fileName(url, "attachment; filename=\"caf_ logo.png\""))
+    }
+
+    @Test
+    fun fallsBackToTheFilesOwnName() {
+        assertEquals("whim logo+640.png", FileDownloads.fileName(url, null))
+        assertEquals("download", FileDownloads.fileName("https://portal.example.test/api/file", ""))
+    }
+
+    @Test
+    fun neverSavesOutsideDownloads() {
+        assertEquals("passwd", FileDownloads.fileName(url, "attachment; filename*=UTF-8''..%2F..%2Fetc%2Fpasswd"))
+        assertEquals("hidden", FileDownloads.fileName(url, "attachment; filename=\"..hidden\""))
+    }
+}
diff --git a/plugins/nako-portal/android/app/src/test/kotlin/moe/nakode/portal/update/ReleaseDownloadTest.kt b/plugins/nako-portal/android/app/src/test/kotlin/moe/nakode/portal/update/ReleaseDownloadTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..80efa57519d1a841c941a85321c6d5e9809fb01f
--- /dev/null
+++ b/plugins/nako-portal/android/app/src/test/kotlin/moe/nakode/portal/update/ReleaseDownloadTest.kt
@@ -0,0 +1,84 @@
+package moe.nakode.portal.update
+
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import okio.Buffer
+import org.junit.After
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertThrows
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.security.MessageDigest
+
+class ReleaseDownloadTest {
+    @get:Rule
+    val folder = TemporaryFolder()
+    private val server = MockWebServer()
+    private val apk = ByteArray(200_000) { (it % 251).toByte() }
+    private val sha256 = MessageDigest.getInstance("SHA-256").digest(apk).joinToString("") { "%02x".format(it) }
+    private val origin get() = server.url("/").toString().trimEnd('/')
+
+    @Before
+    fun setUp() = server.start()
+
+    @After
+    fun tearDown() = server.close()
+
+    private fun release(sha: String = sha256) =
+        AndroidRelease(versionCode = 9, versionName = "0.1.9", sha256 = sha, sizeBytes = apk.size.toLong(), apkUrl = "/android/nako.apk")
+
+    @Test
+    fun readsThePublishedReleaseWithTheSessionCookie() {
+        server.enqueue(
+            MockResponse.Builder()
+                .body("""{"versionCode":9,"versionName":"0.1.9","sha256":"$sha256","sizeBytes":200000,"apkUrl":"/android/nako.apk"}""")
+                .build(),
+        )
+
+        assertEquals(release(), fetchRelease(origin, "__Host-portal=abc"))
+        assertEquals("__Host-portal=abc", server.takeRequest().headers["Cookie"])
+    }
+
+    @Test
+    fun reportsNoReleaseWhenSignedOutOrUnpublished() {
+        server.enqueue(MockResponse.Builder().code(401).build())
+        server.enqueue(MockResponse.Builder().code(404).build())
+
+        assertNull(fetchRelease(origin, null))
+        assertNull(fetchRelease(origin, "__Host-portal=abc"))
+    }
+
+    @Test
+    fun keepsADownloadThatMatchesTheManifest() {
+        server.enqueue(MockResponse.Builder().body(Buffer().write(apk)).build())
+        val destination = folder.root.resolve("nako.apk")
+
+        downloadRelease(origin, "__Host-portal=abc", release(), destination)
+
+        assertArrayEquals(apk, destination.readBytes())
+        assertEquals("/android/nako.apk", server.takeRequest().url.encodedPath)
+    }
+
+    @Test
+    fun discardsADownloadThatDoesNotMatch() {
+        server.enqueue(MockResponse.Builder().body(Buffer().write(apk)).build())
+        val destination = folder.root.resolve("nako.apk")
+
+        assertThrows(ReleaseVerificationException::class.java) {
+            downloadRelease(origin, null, release(sha = "0".repeat(64)), destination)
+        }
+        assertFalse(destination.exists())
+        assertEquals(emptyList<String>(), folder.root.list()!!.toList())
+    }
+
+    @Test
+    fun upgradesOnlyToNewerBuilds() {
+        assertEquals(true, isUpgrade(8, release()))
+        assertEquals(false, isUpgrade(9, release()))
+    }
+}
