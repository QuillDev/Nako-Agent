+import { useState } from "react"
+import { AuthButton, AuthScreen } from "@/components/portal/auth-screen"
+import { navigate } from "@/hooks/use-portal"
+import { api } from "@/lib/api"
+
+// The desktop app can't use passkeys in its webview, so it opens this page in the browser.
+// Approving hands a one-time code to the app's loopback listener; only the app can redeem it.
+export function DesktopLink({ query }: { query: string }) {
+  const params = new URLSearchParams(query)
+  const port = Number(params.get("port"))
+  const state = params.get("state") || ""
+  const challenge = params.get("challenge") || ""
+  const valid = Number.isInteger(port) && port >= 1024 && port <= 65535 && /^[\w-]{16,128}$/.test(state) && /^[\w-]{43}$/.test(challenge)
+  const [error, setError] = useState(valid ? "" : "This sign-in link is broken. Start again from the app.")
+  const [busy, setBusy] = useState(false)
+
+  async function approve() {
+    setError("")
+    setBusy(true)
+    try {
+      const { code } = await api<{ code: string }>("/api/desktop/link", { method: "POST", body: { challenge } })
+      location.href = `http://127.0.0.1:${port}/callback?${new URLSearchParams({ code, state })}`
+    } catch (e) {
+      setError((e as Error).message)
+      setBusy(false)
+    }
+  }
+
+  return (
+    <AuthScreen error={error} note="Only if you just asked the Nako app on this computer to sign in." title="Sign in the desktop app?">
+      <AuthButton disabled={busy || !valid} onClick={approve}>
+        Sign in
+      </AuthButton>
+      <AuthButton onClick={() => navigate("#/")} variant="ghost">
+        Cancel
+      </AuthButton>
+    </AuthScreen>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/drawer.tsx b/plugins/nako-portal/web/src/components/portal/drawer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b6a1d2786590ae1df70e301ef0ce73c75ebbdd27
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/drawer.tsx
@@ -0,0 +1,336 @@
+// On a phone the chat list is a drawer over the open page: swipe right anywhere to pull
+// it in, swipe left or tap outside to put it away. From md up the list sits beside the page,
+// where its edge drags to resize and it collapses (Ctrl/Cmd+B, or dragging it nearly shut).
+import {
+  createContext,
+  type PointerEvent as ReactPointerEvent,
+  type KeyboardEvent as ReactKeyboardEvent,
+  type ReactNode,
+  useCallback,
+  useContext,
+  useEffect,
+  useLayoutEffect,
+  useMemo,
+  useRef,
+  useState,
+} from "react"
+import { navigate } from "@/hooks/use-portal"
+import { cn } from "@/lib/utils"
+
+const PHONE = "(max-width: 767.98px)"
+// Movement before a touch counts as a swipe or a scroll.
+const SLOP = 10
+// A flick this fast (px/ms) settles the drawer whichever way it was going.
+const FLICK = 0.3
+
+const WIDTH = { min: 220, max: 480, initial: 288, collapseBelow: 160 }
+
+type Drawer = { phone: boolean; collapsed: boolean; toggle: () => void; show: () => void; go: (hash: string) => void }
+
+const DrawerContext = createContext<Drawer>({ phone: false, collapsed: false, toggle: () => {}, show: () => {}, go: navigate })
+
+export const useDrawer = () => useContext(DrawerContext)
+
+function usePhone() {
+  const [phone, setPhone] = useState(() => matchMedia(PHONE).matches)
+  useEffect(() => {
+    const query = matchMedia(PHONE)
+    const onChange = () => setPhone(query.matches)
+    query.addEventListener("change", onChange)
+    return () => query.removeEventListener("change", onChange)
+  }, [])
+  return phone
+}
+
+// True when something under the finger can still scroll the way the swipe is going,
+// so code blocks and tables keep scrolling sideways instead of moving the drawer.
+function scrollsSideways(target: EventTarget | null, root: HTMLElement, dx: number) {
+  for (let el = target instanceof Element ? target : null; el && el !== root; el = el.parentElement) {
+    if (el.scrollWidth <= el.clientWidth) continue
+    const overflow = getComputedStyle(el).overflowX
+    if (overflow !== "auto" && overflow !== "scroll") continue
+    if (dx > 0 ? el.scrollLeft > 0 : el.scrollLeft + el.clientWidth < el.scrollWidth - 1) return true
+  }
+  return false
+}
+
+const clamp = (width: number) => Math.min(WIDTH.max, Math.max(WIDTH.min, width))
+
+function useDesktopSidebar() {
+  const [width, setWidth] = useState(() => clamp(Number(localStorage.getItem("sidebar:width")) || WIDTH.initial))
+  const [collapsed, setCollapsed] = useState(() => localStorage.getItem("sidebar:collapsed") === "1")
+  const [dragging, setDragging] = useState(false)
+  useEffect(() => localStorage.setItem("sidebar:width", String(width)), [width])
+  useEffect(() => localStorage.setItem("sidebar:collapsed", collapsed ? "1" : "0"), [collapsed])
+  const toggle = useCallback(() => setCollapsed(c => !c), [])
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === "b") {
+        e.preventDefault()
+        toggle()
+      }
+    }
+    window.addEventListener("keydown", onKey)
+    return () => window.removeEventListener("keydown", onKey)
+  }, [toggle])
+
+  const startResize = (e: ReactPointerEvent<HTMLDivElement>) => {
+    const handle = e.currentTarget
+    const left = handle.parentElement!.getBoundingClientRect().left
+    handle.setPointerCapture(e.pointerId)
+    setDragging(true)
+    const move = (ev: PointerEvent) => {
+      const next = ev.clientX - left
+      if (next < WIDTH.collapseBelow) setCollapsed(true)
+      else {
+        setCollapsed(false)
+        setWidth(clamp(next))
+      }
+    }
+    const end = () => {
+      setDragging(false)
+      handle.removeEventListener("pointermove", move)
+      handle.removeEventListener("pointerup", end)
+      handle.removeEventListener("pointercancel", end)
+    }
+    handle.addEventListener("pointermove", move)
+    handle.addEventListener("pointerup", end)
+    handle.addEventListener("pointercancel", end)
+  }
+
+  const resizeWithKeyboard = (e: ReactKeyboardEvent<HTMLDivElement>) => {
+    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return
+    e.preventDefault()
+    setWidth(value => clamp(value + (e.key === "ArrowLeft" ? -16 : 16)))
+  }
+
+  return { width, collapsed, dragging, toggle, startResize, resizeWithKeyboard, reset: () => setWidth(WIDTH.initial) }
+}
+
+const pushedDrawer = () => (history.state as { drawer?: boolean } | null)?.drawer === true
+
+/**
+ * The list is open on the list route, or after `show()` pushed a history entry for it,
+ * so Back (Android's included) closes the drawer before it leaves the chat.
+ */
+export function DrawerLayout({ list, sidebar, children }: { list: boolean; sidebar: ReactNode; children: ReactNode }) {
+  const phone = usePhone()
+  const desk = useDesktopSidebar()
+  const collapsed = !phone && desk.collapsed
+  const [pushed, setPushed] = useState(pushedDrawer)
+  const open = list || pushed
+  const rootRef = useRef<HTMLDivElement>(null)
+  const panelRef = useRef<HTMLDivElement>(null)
+  const shadeRef = useRef<HTMLDivElement>(null)
+  const contentRef = useRef<HTMLDivElement>(null)
+  const focusBeforeOpen = useRef<HTMLElement | null>(null)
+
+  useEffect(() => {
+    const sync = () => setPushed(pushedDrawer())
+    window.addEventListener("popstate", sync)
+    window.addEventListener("hashchange", sync)
+    return () => {
+      window.removeEventListener("popstate", sync)
+      window.removeEventListener("hashchange", sync)
+    }
+  }, [])
+
+  const show = useCallback(() => {
+    if (open) return
+    history.pushState({ drawer: true }, "")
+    setPushed(true)
+  }, [open])
+
+  const hide = useCallback(() => {
+    if (pushed) history.back()
+    else if (list) navigate("#/new")
+  }, [pushed, list])
+
+  // Picking something in the drawer takes the drawer's place in history.
+  const go = useCallback(
+    (hash: string) => {
+      if (!pushed) return navigate(hash)
+      if (location.hash === hash) return history.back()
+      location.replace(hash)
+    },
+    [pushed],
+  )
+
+  const state = useRef({ open, show, hide })
+  state.current = { open, show, hide }
+
+  // Remember the trigger before React makes the underlying content inert.
+  useEffect(() => {
+    if (!phone || open) return
+    const remember = () => { focusBeforeOpen.current = document.activeElement instanceof HTMLElement ? document.activeElement : null }
+    remember()
+    document.addEventListener("focusin", remember)
+    return () => document.removeEventListener("focusin", remember)
+  }, [phone, open])
+
+  useLayoutEffect(() => {
+    const panel = panelRef.current
+    const content = contentRef.current
+    if (!phone || !open || !panel || !content) return
+    const previous = focusBeforeOpen.current ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null)
+    const focusable = () => [...panel.querySelectorAll<HTMLElement>('a[href], button, input, textarea, select, [tabindex]:not([tabindex="-1"])')]
+      .filter(el => !el.matches(':disabled') && !el.closest('[inert]') && el.getClientRects().length)
+    ;(focusable()[0] ?? panel).focus()
+    const keydown = (e: KeyboardEvent) => {
+      if (e.defaultPrevented) return
+      if (e.key === "Escape") {
+        e.preventDefault()
+        state.current.hide()
+      } else if (e.key === "Tab") {
+        const items = focusable()
+        const first = items[0] ?? panel
+        const last = items.at(-1) ?? panel
+        if (!panel.contains(document.activeElement) || (e.shiftKey ? document.activeElement === first : document.activeElement === last)) {
+          e.preventDefault()
+          ;(e.shiftKey ? last : first).focus()
+        }
+      }
+    }
+    document.addEventListener("keydown", keydown)
+    return () => {
+      document.removeEventListener("keydown", keydown)
+      // React may still be committing the inert change during cleanup.
+      queueMicrotask(() => {
+        if (previous?.isConnected && !previous.closest('[inert]')) previous.focus()
+      })
+    }
+  }, [phone, open])
+
+  useEffect(() => {
+    const root = rootRef.current
+    const panel = panelRef.current
+    const shade = shadeRef.current
+    if (!phone || !root || !panel || !shade) return
+    let touch: { x: number; y: number; dragging: boolean; offset: number; at: number; speed: number } | null = null
+
+    const paint = (offset: number) => {
+      const width = panel.offsetWidth
+      panel.dataset.dragging = ""
+      panel.style.transition = shade.style.transition = "none"
+      panel.style.translate = `${offset - width}px 0`
+      shade.style.opacity = String(offset / width)
+    }
+    const release = () => {
+      delete panel.dataset.dragging
+      panel.style.transition = shade.style.transition = panel.style.translate = shade.style.opacity = ""
+    }
+    // Animate to where the drawer ends up, then hand back to the class that matches the state.
+    const settle = (opening: boolean) => {
+      panel.style.transition = shade.style.transition = ""
+      panel.style.translate = opening ? "0 0" : "-100% 0"
+      shade.style.opacity = opening ? "1" : "0"
+      panel.addEventListener("transitionend", release, { once: true })
+      setTimeout(release, 400)
+      if (opening !== state.current.open) (opening ? state.current.show : state.current.hide)()
+    }
+
+    const onStart = (e: TouchEvent) => {
+      const target = e.target as Element
+      touch = null
+      if (e.touches.length !== 1 || target.closest("input, textarea, [contenteditable]")) return
+      const { clientX: x, clientY: y } = e.touches[0]
+      touch = { x, y, dragging: false, offset: 0, at: e.timeStamp, speed: 0 }
+    }
+    const onMove = (e: TouchEvent) => {
+      if (!touch) return
+      const dx = e.touches[0].clientX - touch.x
+      const dy = e.touches[0].clientY - touch.y
+      const opened = state.current.open
+      if (!touch.dragging) {
+        if (Math.abs(dx) < SLOP && Math.abs(dy) < SLOP) return
+        const toward = opened ? dx < 0 : dx > 0
+        if (Math.abs(dx) <= Math.abs(dy) || !toward || scrollsSideways(e.target, root, dx)) {
+          touch = null
+          return
+        }
+        touch.dragging = true
+      }
+      e.preventDefault()
+      const width = panel.offsetWidth
+      const offset = Math.min(width, Math.max(0, (opened ? width : 0) + dx))
+      const elapsed = e.timeStamp - touch.at
+      if (elapsed > 0) touch.speed = (offset - touch.offset) / elapsed
+      touch.offset = offset
+      touch.at = e.timeStamp
+      paint(offset)
+    }
+    const onEnd = (e: TouchEvent) => {
+      const done = touch
+      touch = null
+      if (!done?.dragging) return
+      // A finger that stopped before lifting isn't flicking.
+      const speed = e.timeStamp - done.at > 100 ? 0 : done.speed
+      const half = done.offset > panel.offsetWidth / 2
+      settle(speed > FLICK ? true : speed < -FLICK ? false : half)
+    }
+
+    root.addEventListener("touchstart", onStart, { passive: true })
+    root.addEventListener("touchmove", onMove, { passive: false })
+    root.addEventListener("touchend", onEnd)
+    root.addEventListener("touchcancel", onEnd)
+    return () => {
+      root.removeEventListener("touchstart", onStart)
+      root.removeEventListener("touchmove", onMove)
+      root.removeEventListener("touchend", onEnd)
+      root.removeEventListener("touchcancel", onEnd)
+      release()
+    }
+  }, [phone])
+
+  const drawer = useMemo(() => ({ phone, collapsed, toggle: desk.toggle, show, go }), [phone, collapsed, desk.toggle, show, go])
+
+  return (
+    <DrawerContext.Provider value={drawer}>
+      <div className="relative flex h-dvh overflow-hidden" ref={rootRef}>
+        <div
+          className={cn(
+            "relative flex max-md:fixed max-md:inset-y-0 max-md:left-0 max-md:z-40 max-md:w-[85vw] max-md:max-w-sm max-md:transition-[translate] max-md:duration-200 max-md:ease-out max-md:motion-reduce:transition-none max-md:data-dragging:shadow-xl",
+            "md:shrink-0 md:overflow-hidden md:transition-[width] md:duration-200 md:ease-out md:motion-reduce:transition-none",
+            desk.dragging && "md:transition-none",
+            open ? "max-md:shadow-xl" : "max-md:-translate-x-full",
+          )}
+          role={phone && open ? "dialog" : undefined}
+          aria-modal={phone && open ? true : undefined}
+          aria-label={phone && open ? "Chat list" : undefined}
+          tabIndex={-1}
+          inert={phone ? !open : collapsed}
+          ref={panelRef}
+          style={phone ? undefined : { width: collapsed ? 0 : desk.width }}
+        >
+          <div className="flex w-full md:shrink-0" style={phone ? undefined : { width: desk.width }}>
+            {sidebar}
+          </div>
+          {!phone && (
+            <div
+              aria-label="Resize chat list"
+              aria-orientation="vertical"
+              aria-valuemin={WIDTH.min}
+              aria-valuemax={WIDTH.max}
+              aria-valuenow={desk.width}
+              tabIndex={collapsed ? -1 : 0}
+              onKeyDown={desk.resizeWithKeyboard}
+              className="absolute inset-y-0 right-0 z-10 w-1.5 cursor-col-resize touch-none transition-colors hover:bg-border data-dragging:bg-border"
+              data-dragging={desk.dragging ? "" : undefined}
+              onDoubleClick={desk.reset}
+              onPointerDown={desk.startResize}
+              role="separator"
+            />
+          )}
+        </div>
+        <div
+          aria-hidden
+          className={cn("fixed inset-0 z-30 bg-black/50 transition-opacity duration-200 motion-reduce:transition-none md:hidden", open ? "opacity-100" : "pointer-events-none opacity-0")}
+          onClick={hide}
+          ref={shadeRef}
+        />
+        <div className="contents" inert={phone && open} ref={contentRef}>{children}</div>
+      </div>
+    </DrawerContext.Provider>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/elsewhere.tsx b/plugins/nako-portal/web/src/components/portal/elsewhere.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b29016bd32a1102efcb58237f778eb05cb59e855
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/elsewhere.tsx
@@ -0,0 +1,175 @@
+// Elsewhere: sessions that came in another way (Slack, Discord, cron, the CLI), latest first.
+// Each opens read-only; the portal only watches them.
+import { useCallback, useEffect, useRef, useState } from "react"
+import type { Portal } from "@/hooks/use-portal"
+import { api } from "@/lib/api"
+import { sourceName } from "@/lib/outside"
+import { age, timeOf } from "@/lib/times"
+import type { OutsideRow } from "@/lib/types"
+import { cn } from "@/lib/utils"
+import { useDrawer } from "./drawer"
+import { LoadingRows } from "./screen-loading"
+import { PageHeader } from "./header"
+import { appendPage, isCurrentRequest } from "@/lib/portal-state"
+
+// What the server sends a page of; a shorter page is the last one.
+const PAGE = 50
+
+// "9:41 AM" today, "Yesterday", "Fri" this week, else "Nov 10"; the same days the list's labels count.
+function when(at: number) {
+  const label = age(at)
+  if (label === "today") return timeOf(at)
+  if (label === "yesterday") return "Yesterday"
+  return new Date(at * 1000).toLocaleDateString([], label === "this week" ? { weekday: "short" } : { month: "short", day: "numeric" })
+}
+
+function query(source: string | null, offset: number) {
+  const params = new URLSearchParams()
+  if (source) params.set("source", source)
+  if (offset) params.set("offset", String(offset))
+  const text = params.toString()
+  return `/api/outside${text ? `?${text}` : ""}`
+}
+
+export function Elsewhere({ portal }: { portal: Portal }) {
+  const { go } = useDrawer()
+  const { sources, running } = portal.outside
+  const [source, setSource] = useState<string | null>(null)
+  const [rows, setRows] = useState<OutsideRow[] | null>(null)
+  const [more, setMore] = useState(false)
+  const loading = useRef(false)
+  const generation = useRef({ request: 0, turn: 0 })
+  const [pending, setPending] = useState(true)
+  const [error, setError] = useState<{ message: string; page: boolean } | null>(null)
+  const [retry, setRetry] = useState(0)
+  const end = useRef<HTMLDivElement>(null)
+  const shown = source && sources.includes(source) ? source : null
+
+  // The first page again (on open, on a filter, when something starts or stops running), keeping
+  // any later pages already loaded below it.
+  const runningKey = running.join(" ")
+  useEffect(() => {
+    const ticket = { ...generation.current, request: ++generation.current.request }
+    const valid = () => isCurrentRequest(ticket, generation.current)
+    loading.current = true
+    setPending(true)
+    setError(null)
+    api<OutsideRow[]>(query(shown, 0)).then(
+      page => {
+        if (!valid()) return
+        setRows(old => {
+          const kept = old && old.length > PAGE ? old.slice(PAGE).filter(r => !shown || r.source === shown) : []
+          return appendPage(page, kept)
+        })
+        setMore(page.length === PAGE)
+      },
+      e => { if (valid()) setError({ message: (e as Error).message, page: false }) },
+    ).finally(() => {
+      if (!valid()) return
+      loading.current = false
+      setPending(false)
+    })
+    return () => { generation.current.request += 1 }
+  }, [shown, runningKey, retry])
+
+  const loadMore = useCallback(async () => {
+    if (loading.current || !rows || !more) return
+    const ticket = { ...generation.current }
+    const valid = () => isCurrentRequest(ticket, generation.current)
+    loading.current = true
+    setPending(true)
+    setError(null)
+    try {
+      const page = await api<OutsideRow[]>(query(shown, rows.length))
+      if (!valid()) return
+      setRows(old => appendPage(old || [], page))
+      setMore(page.length === PAGE)
+    } catch (e) {
+      if (valid()) setError({ message: (e as Error).message, page: true })
+    } finally {
+      if (valid()) {
+        loading.current = false
+        setPending(false)
+      }
+    }
+  }, [rows, shown, more])
+
+  // The next page loads as the end of the list scrolls into view.
+  useEffect(() => {
+    const el = end.current
+    if (!el || !more || pending || error) return
+    const observer = new IntersectionObserver(entries => entries.some(e => e.isIntersecting) && loadMore(), { rootMargin: "400px" })
+    observer.observe(el)
+    return () => observer.disconnect()
+  }, [more, loadMore, pending, error])
+
+  const pick = (next: string | null) => {
+    if (next === shown) return
+    generation.current.request += 1
+    setError(null)
+    setPending(true)
+    setRows(null)
+    setMore(false)
+    setSource(next)
+  }
+
+  const live = new Set(running)
+  let bucket = ""
+  return (
+    <>
+      <PageHeader title="Elsewhere" />
+      <div className="min-h-0 flex-1 overflow-y-auto">
+        <div className="mx-auto w-full max-w-3xl px-2 pb-6 md:px-4">
+          <div className="min-h-10">{sources.length > 1 && (
+            <div className="flex overflow-x-auto gap-1.5 px-2 pt-1 pb-2">
+              {[null, ...sources].map(s => (
+                <button
+                  aria-pressed={shown === s}
+                  className={cn(
+                    "shrink-0 rounded-full border px-2.5 py-1 text-muted-foreground text-xs hover:text-foreground",
+                    shown === s && "border-input bg-accent text-foreground",
+                  )}
+                  key={s ?? ""}
+                  onClick={() => pick(s)}
+                  type="button"
+                >
+                  {s ? sourceName(s) : "All"}
+                </button>
+              ))}
+            </div>
+          )}</div>
+          {pending && !rows && <div aria-hidden="true" className="h-8" />}
+          {rows?.length === 0 && <p className="px-2 py-1 text-muted-foreground text-xs">nothing here yet</p>}
+          {rows?.map(row => {
+            const label = age(row.last_active)
+            const head = label !== bucket
+            bucket = label
+            return (
+              <div key={row.id}>
+                {head && <p className="px-2 pt-3 pb-1 text-muted-foreground text-xs">{label}</p>}
+                <button
+                  className="flex w-full select-none items-center gap-2 rounded-md px-2 py-2 text-left text-sm hover:bg-accent"
+                  onClick={() => go(`#/c/${row.id}`)}
+                  onFocus={() => portal.prefetch(row.id)}
+                  onPointerDown={() => portal.prefetch(row.id)}
+                  type="button"
+                >
+                  <span className="min-w-0 flex-1 truncate">{row.title}</span>
+                  <span className="w-16 shrink-0 truncate text-muted-foreground text-xs">{sourceName(row.source)}</span>
+                  <span className="w-16 shrink-0 text-right text-muted-foreground text-xs tabular-nums">{when(row.last_active)}</span>
+                  <span className={cn("size-2 shrink-0 rounded-full", live.has(row.id) && "animate-pulse bg-primary")} title={live.has(row.id) ? "working" : undefined} />
+                </button>
+              </div>
+            )
+          })}
+          {pending && (!rows || more) && <LoadingRows label="Loading sessions…" columns count={rows ? 2 : 6} />}
+          {error && <div className="flex items-center gap-2 px-2 py-2 text-sm" role="alert">
+            <span>{error.message}</span>
+            <button className="underline" type="button" onClick={() => error.page ? void loadMore() : setRetry(n => n + 1)}>Retry</button>
+          </div>}
+          <div aria-hidden ref={end} />
+        </div>
+      </div>
+    </>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/environments.tsx b/plugins/nako-portal/web/src/components/portal/environments.tsx
