+export type MessageMatch = { id: string; title: string; snippet: string; archived: boolean; at: number }
+
+/** Keep server order and show each chat once across all search groups. */
+export function mergeMessageMatches(rows: MessageMatch[], shown: { id: string }[]): MessageMatch[] {
+  const seen = new Set(shown.map(row => row.id))
+  return rows.filter(row => {
+    if (seen.has(row.id)) return false
+    seen.add(row.id)
+    return true
+  })
+}
diff --git a/plugins/nako-portal/web/src/lib/decode.ts b/plugins/nako-portal/web/src/lib/decode.ts
new file mode 100644
index 0000000000000000000000000000000000000000..91b88be558abb6468deec291bccc9b6f712c101f
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/decode.ts
@@ -0,0 +1,95 @@
+/** Small runtime decoders for the portal's JSON boundaries. Objects strip unknown keys. */
+type Path = readonly (string | number)[]
+export class DecodeError extends Error {
+  constructor(readonly path: Path, expected: string) {
+    super(`${path.length ? path.join(".") : "value"}: expected ${expected}`)
+    this.name = "DecodeError"
+  }
+}
+const fail = (path: Path, expected: string): never => { throw new DecodeError(path, expected) }
+export type Infer<D extends Decoder<unknown>> = D extends Decoder<infer T> ? T : never
+
+type Result<T> = { success: true; data: T } | { success: false; error: DecodeError }
+export class Decoder<T> {
+  constructor(readonly read: (input: unknown, path: Path) => T) {}
+  parse(input: unknown): T { return this.read(input, []) }
+  safeParse(input: unknown): Result<T> {
+    try { return { success: true, data: this.parse(input) } } catch (error) {
+      if (!(error instanceof DecodeError)) throw error
+      return { success: false, error }
+    }
+  }
+  optional(): Decoder<T | undefined> {
+    return new Decoder((input, path) => input === undefined ? undefined : this.read(input, path))
+  }
+  array(): Decoder<T[]> { return d.array(this) }
+  nullable(): Decoder<T | null> {
+    return new Decoder((input, path) => input === null ? null : this.read(input, path))
+  }
+  default(value: Exclude<T, undefined>): Decoder<Exclude<T, undefined>> {
+    return new Decoder((input, path) => input === undefined ? value : this.read(input, path) as Exclude<T, undefined>)
+  }
+}
+
+class StringDecoder extends Decoder<string> {
+  constructor(read = (input: unknown, path: Path): string => typeof input === "string" ? input : fail(path, "string")) { super(read) }
+  trim(): StringDecoder { return new StringDecoder((input, path) => this.read(input, path).trim()) }
+  min(length: number): StringDecoder {
+    return new StringDecoder((input, path) => {
+      const value = this.read(input, path)
+      return value.length >= length ? value : fail(path, `at least ${length} characters`)
+    })
+  }
+  max(length: number): StringDecoder {
+    return new StringDecoder((input, path) => {
+      const value = this.read(input, path)
+      return value.length <= length ? value : fail(path, `at most ${length} characters`)
+    })
+  }
+}
+
+type Shape = Record<string, Decoder<unknown>>
+type OptionalKeys<S extends Shape> = { [K in keyof S]: undefined extends Infer<S[K]> ? K : never }[keyof S]
+type Fields<T> = { [K in keyof T]: T[K] }
+type ObjectValue<S extends Shape> = Fields<{ [K in Exclude<keyof S, OptionalKeys<S>>]: Infer<S[K]> } &
+  { [K in OptionalKeys<S>]?: Infer<S[K]> }>
+class ObjectDecoder<S extends Shape> extends Decoder<ObjectValue<S>> {
+  constructor(readonly shape: S) {
+    super((input, path) => {
+      if (typeof input !== "object" || input === null || Array.isArray(input)) return fail(path, "object")
+      const source = input as Record<string, unknown>
+      const entries = Object.entries(shape).flatMap(([key, decoder]) => {
+        const value = decoder.read(source[key], [...path, key])
+        return value !== undefined || key in source ? [[key, value]] : []
+      })
+      return Object.fromEntries(entries) as ObjectValue<S>
+    })
+  }
+  extend<E extends Shape>(extra: E): ObjectDecoder<Omit<S, keyof E> & E> {
+    return new ObjectDecoder({ ...this.shape, ...extra } as Omit<S, keyof E> & E)
+  }
+}
+
+export const d = {
+  string: () => new StringDecoder(),
+  number: () => new Decoder<number>((input, path) =>
+    typeof input === "number" && Number.isFinite(input) ? input : fail(path, "finite number")),
+  boolean: () => new Decoder<boolean>((input, path) => typeof input === "boolean" ? input : fail(path, "boolean")),
+  unknown: () => new Decoder<unknown>(input => input),
+  enum: <const T extends readonly [string, ...string[]]>(values: T) => new Decoder<T[number]>((input, path) =>
+    typeof input === "string" && values.includes(input) ? input : fail(path, values.join(" | "))),
+  array: <T>(item: Decoder<T>) => new Decoder<T[]>((input, path) => {
+    if (!Array.isArray(input)) return fail(path, "array")
+    return Array.from(input, (value, index) => item.read(value, [...path, index]))
+  }),
+  object: <S extends Shape>(shape: S) => new ObjectDecoder(shape),
+  union: <const D extends readonly [Decoder<unknown>, ...Decoder<unknown>[]]>(choices: D) =>
+    new Decoder<Infer<D[number]>>((input, path) => {
+      for (const choice of choices) {
+        try { return choice.read(input, path) as Infer<D[number]> } catch (error) {
+          if (!(error instanceof DecodeError)) throw error
+        }
+      }
+      return fail(path, "a union member")
+    }),
+}
diff --git a/plugins/nako-portal/web/src/lib/desktop-update.ts b/plugins/nako-portal/web/src/lib/desktop-update.ts
new file mode 100644
index 0000000000000000000000000000000000000000..84757769b18bdb393aab342cbbfa206c4dc9b1e0
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/desktop-update.ts
@@ -0,0 +1,53 @@
+import { useSyncExternalStore } from "react"
+import { desktopApp } from "./desktop-window"
+
+/**
+ * Where the desktop app's updating stands. Apps that update themselves set window.nakoUpdate on
+ * every portal load and whenever it changes, and fire "nako-update"; browsers never set it.
+ * Apps from before in-app checks set only `{ version }`, once an update is downloaded.
+ */
+export type UpdateStatus = {
+  state: "idle" | "checking" | "latest" | "error" | "ready" | "installing"
+  version?: string
+  error?: string
+  /** Homebrew is building it (macOS), which takes minutes. */
+  brew?: boolean
+}
+
+declare global {
+  interface Window {
+    nakoUpdate?: Partial<UpdateStatus>
+  }
+}
+
+const subscribe = (changed: () => void) => {
+  window.addEventListener("nako-update", changed)
+  return () => window.removeEventListener("nako-update", changed)
+}
+
+const snapshot = () => window.nakoUpdate ?? null
+
+/** The app's update status; null in a browser or an app that doesn't update itself. */
+export function useDesktopUpdate(): UpdateStatus | null {
+  const status = useSyncExternalStore(subscribe, snapshot, () => null)
+  if (!status) return null
+  if (status.state) return status as UpdateStatus
+  return status.version ? { state: "ready", version: status.version } : null
+}
+
+/** Whether the app takes checks from the page; older apps only announce a download. */
+export const canCheck = () => Boolean(window.nakoUpdate?.state && desktopApp())
+
+export function checkForUpdate() {
+  desktopApp()?.invoke("update", { action: "check" }).catch(() => {})
+}
+
+/** The app shows that it's updating, installs the update and restarts. */
+export function installDesktopUpdate() {
+  if (canCheck()) desktopApp()?.invoke("update", { action: "install" }).catch(() => {})
+  // Older apps catch this navigation instead.
+  else window.location.assign("/desktop/update")
+}
+
+/** The installed desktop or Android app's version, from the agent the app tags; null in a browser. */
+export const appVersion = navigator.userAgent.match(/Nako(?:Desktop|Android)\/(\d+\.\d+\.\d+)/)?.[1] ?? null
diff --git a/plugins/nako-portal/web/src/lib/desktop-window.ts b/plugins/nako-portal/web/src/lib/desktop-window.ts
new file mode 100644
index 0000000000000000000000000000000000000000..158b696f5a181a59b0b2f1028cf40f446bba8b8b
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/desktop-window.ts
@@ -0,0 +1,33 @@
+import { useSyncExternalStore } from "react"
+
+type DesktopBridge = { invoke: (command: string, args?: Record<string, unknown>) => Promise<unknown> }
+
+/** How the page asks the desktop app for things; undefined in a browser. */
+export const desktopApp = () => window.nakoDesktop ?? window.__TAURI_INTERNALS__
+
+// The desktop app on Windows and Linux has no system title bar: it sets window.nakoWindow and
+// lets the portal move, resize and close the window. Browsers and older apps never set it.
+declare global {
+  interface Window {
+    nakoWindow?: { controls: boolean }
+    nakoDesktop?: DesktopBridge
+    /** The earlier (Tauri) desktop app's bridge, until every install has updated. */
+    __TAURI_INTERNALS__?: DesktopBridge
+  }
+}
+
+// The app fires "nako-window" if window control visibility changes.
+const subscribe = (changed: () => void) => {
+  window.addEventListener("nako-window", changed)
+  return () => window.removeEventListener("nako-window", changed)
+}
+
+const controls = () => Boolean(window.nakoWindow?.controls)
+
+export function useWindowControls() {
+  return useSyncExternalStore(subscribe, controls, () => false)
+}
+
+export function windowAction(action: "minimize" | "toggle_maximize" | "close") {
+  void desktopApp()?.invoke(`plugin:window|${action}`, { label: "main" })
+}
