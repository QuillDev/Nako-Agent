diff --git a/plugins/nako-portal/dashboard/web/sw.js b/plugins/nako-portal/dashboard/web/sw.js
new file mode 100644
index 0000000000000000000000000000000000000000..45d3cfc5a694cfdf39eb4aa29bcfa75736a7a769
--- /dev/null
+++ b/plugins/nako-portal/dashboard/web/sw.js
@@ -0,0 +1,40 @@
+// Shows push notifications and opens the chat they belong to. No offline cache:
+// every page load comes fresh from this machine.
+self.addEventListener('install', () => self.skipWaiting())
+self.addEventListener('activate', event => event.waitUntil(self.clients.claim()))
+
+self.addEventListener('push', event => {
+  let data = {}
+  try {
+    data = event.data ? event.data.json() : {}
+  } catch {}
+  const title = data.title || 'Nako'
+  event.waitUntil(
+    self.registration.showNotification(title, {
+      body: data.body || '',
+      tag: data.session || 'nako',
+      renotify: true,
+      icon: '/icon-192.png',
+      badge: '/icon-192.png',
+      data: { session: data.session || null }
+    })
+  )
+})
+
+self.addEventListener('notificationclick', event => {
+  event.notification.close()
+  const session = event.notification.data?.session
+  const target = session ? `/#/c/${session}` : '/'
+  event.waitUntil(
+    (async () => {
+      const windows = await self.clients.matchAll({ type: 'window', includeUncontrolled: true })
+      for (const client of windows) {
+        if (new URL(client.url).origin === self.location.origin) {
+          await client.focus()
+          return client.navigate(target)
+        }
+      }
+      return self.clients.openWindow(target)
+    })()
+  )
+})
diff --git a/plugins/nako-portal/dashboard/web/theme.js b/plugins/nako-portal/dashboard/web/theme.js
new file mode 100644
index 0000000000000000000000000000000000000000..acfe4f3ccf1d95d9feeb25b8ea5b9f67ccfd574f
--- /dev/null
+++ b/plugins/nako-portal/dashboard/web/theme.js
@@ -0,0 +1,19 @@
+// Runs before first paint so a light-mode page never flashes dark. Keep in step with src/lib/theme.ts.
+;(() => {
+  let choice = "system"
+  try {
+    choice = localStorage.getItem("theme") || "system"
+  } catch {}
+  let seenSession = false
+  try {
+    seenSession = sessionStorage.getItem("portal-seen-session") === "1"
+    const width = Math.min(480, Math.max(220, Number(localStorage.getItem("sidebar:width")) || 288))
+    document.documentElement.style.setProperty("--opening-rail", `${localStorage.getItem("sidebar:collapsed") === "1" ? 0 : width}px`)
+  } catch {}
+  const list = !location.hash || location.hash === "#/"
+  document.documentElement.dataset.opening = list && !seenSession || /^#(?:setup=|signin=|\/desktop)/.test(location.hash) ? "auth" : list ? "list" : "page"
+  const light = choice === "light" || (choice === "system" && matchMedia("(prefers-color-scheme: light)").matches)
+  document.documentElement.classList.toggle("light", light)
+  document.documentElement.classList.toggle("dark", !light)
+  document.querySelector('meta[name="theme-color"]')?.setAttribute("content", light ? "#fbfbfc" : "#09090b")
+})()
