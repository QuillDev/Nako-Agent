@@ -0,0 +1,78 @@
+import { SmileIcon } from "lucide-react"
+import { useEffect, useRef, useState } from "react"
+import { Popover } from "radix-ui"
+import { Button } from "@/components/ui/button"
+import { Input } from "@/components/ui/input"
+import emojiData from "emoji-picker-element-data/en/emojibase/data.json?url"
+
+const segmenter = new Intl.Segmenter()
+const firstEmoji = (text: string) => {
+  const first = segmenter.segment(text.trim())[Symbol.iterator]().next().value?.segment ?? ""
+  return /[\p{Extended_Pictographic}\p{Regional_Indicator}\u20E3]/u.test(first) ? first : ""
+}
+
+export function PresetEmoji({ value, onPick }: { value: string; onPick: (icon: string) => void }) {
+  const [open, setOpen] = useState(false)
+  const [composition, setComposition] = useState<string | null>(null)
+  const content = useRef<HTMLDivElement>(null)
+  return <Popover.Root open={open} onOpenChange={next => { setOpen(next); if (!next) setComposition(null) }}>
+    <Popover.Trigger asChild>
+      <Button type="button" variant="outline" size="icon" className="shrink-0" aria-label={value ? `Change emoji: ${value}` : "Choose emoji"}>
+        {value ? <span aria-hidden="true" className="grid size-5 place-items-center overflow-hidden text-base leading-none">{value}</span> : <SmileIcon />}
+      </Button>
+    </Popover.Trigger>
+    <Popover.Portal><Popover.Content ref={content} tabIndex={-1} aria-label="Choose emoji" sideOffset={6} align="start" collisionPadding={8}
+      onOpenAutoFocus={e => { e.preventDefault(); content.current?.focus() }}
+      className="z-[60] w-80 max-w-[calc(100vw-1rem)] overflow-hidden rounded-xl border bg-popover shadow-lg outline-none">
+      {open && <EmojiGrid onPick={icon => { onPick(icon); setOpen(false) }} />}
+      <div className="flex gap-2 border-t p-2">
+        <Input aria-label="Type or paste an emoji" value={composition ?? value} maxLength={32} placeholder="Type or paste an emoji" inputMode="text" autoComplete="off" autoCapitalize="off" spellCheck={false}
+          onKeyDown={e => { if (e.key === "Enter" && !e.nativeEvent.isComposing) { e.preventDefault(); setOpen(false) } }}
+          onCompositionStart={e => setComposition(e.currentTarget.value)}
+          onCompositionEnd={e => { setComposition(null); onPick(firstEmoji(e.currentTarget.value)) }}
+          onChange={e => composition === null ? onPick(firstEmoji(e.target.value)) : setComposition(e.target.value)} />
+        {value && <Button type="button" variant="ghost" className="shrink-0" onClick={() => { onPick(""); setOpen(false) }}>Clear</Button>}
+      </div>
+    </Popover.Content></Popover.Portal>
+  </Popover.Root>
+}
+
+function EmojiGrid({ onPick }: { onPick: (icon: string) => void }) {
+  const host = useRef<HTMLDivElement>(null)
+  const pick = useRef(onPick)
+  const [status, setStatus] = useState<"loading" | "ready" | "failed">("loading")
+  useEffect(() => { pick.current = onPick }, [onPick])
+  useEffect(() => {
+    const mount = host.current
+    if (!mount) return
+    let active = true
+    void import("emoji-picker-element").then(({ Picker }) => {
+      if (!active) return
+      const picker = new Picker({ dataSource: emojiData })
+      picker.classList.add(document.documentElement.classList.contains("dark") ? "dark" : "light")
+      Object.assign(picker.style, { width: "100%", height: "clamp(8rem, calc(var(--radix-popover-content-available-height) - 3.5rem), 22rem)" })
+      for (const [name, value] of Object.entries({
+        background: "var(--popover)", "border-size": "0", "input-border-color": "var(--input)",
+        "button-hover-background": "var(--accent)", "button-active-background": "var(--accent)",
+        "indicator-color": "var(--primary)",
+        "category-emoji-size": "1.125rem", "category-emoji-padding": "0.375rem",
+      })) picker.style.setProperty(`--${name}`, value)
+      picker.addEventListener("emoji-click", ({ detail }) => { if (detail.unicode) pick.current(detail.unicode) })
+      mount.replaceChildren(picker)
+      // The picker lives in a shadow root, outside the portal's focus styles.
+      const focus = document.createElement("style")
+      focus.textContent = `@media (forced-colors: none) {
+        :host :focus-visible { outline: none; }
+        :host :focus-visible:not(input) { background-image: linear-gradient(var(--focus-fill), var(--focus-fill)); }
+      }`
+      picker.shadowRoot?.append(focus)
+      setStatus("ready")
+    }).catch(() => { if (active) setStatus("failed") })
+    return () => { active = false; mount.replaceChildren() }
+  }, [])
+  return <>
+    <div ref={host} />
+    {status === "failed" && <p role="alert" className="p-3 text-sm">Couldn’t open the picker. You can still type or paste an emoji.</p>}
+    {status === "loading" && <p role="status" className="p-3 text-sm text-muted-foreground">Loading emoji…</p>}
+  </>
+}
diff --git a/plugins/nako-portal/web/src/components/portal/process-log.tsx b/plugins/nako-portal/web/src/components/portal/process-log.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f1a5e1675c132cf005618d64ec947e3d9e8223c0
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/process-log.tsx
@@ -0,0 +1,86 @@
+import { useEffect, useLayoutEffect, useRef, useState } from "react"
+import { Skullet } from "@/components/ui/skeleton"
+import { Dialog, DialogContent, DialogTitle } from "@/components/ui/dialog"
+import { api } from "@/lib/api"
+import type { BackgroundProcess } from "@/lib/types"
+import { since } from "./processes"
+
+// How often an open log re-reads a running process.
+const TAIL_MS = 2000
+
+type Log = { lines: string[]; total_chars: number }
+
+function useTail(session: string, proc: BackgroundProcess | null) {
+  const [log, setLog] = useState<Log | null>(null)
+  const [gone, setGone] = useState(false)
+  // Keyed on id and state, not the object: the chat's list re-reads every few seconds.
+  const id = proc?.id
+  const running = proc?.running
+  useEffect(() => {
+    setLog(null)
+    setGone(false)
+    if (!id) return
+    let live = true
+    const read = () =>
+      api<Log>(`/api/sessions/${session}/processes/${id}/log`)
+        .then(l => live && setLog(l))
+        .catch(() => live && setGone(true))
+    read()
+    const timer = running ? setInterval(read, TAIL_MS) : undefined
+    return () => {
+      live = false
+      clearInterval(timer)
+    }
+  }, [session, id, running])
+  return { log, gone }
+}
+
+function state(p: BackgroundProcess) {
+  const now = Date.now() / 1000
+  if (p.running) return `running ${since(now - p.started_at)}`
+  if (p.ended === "killed") return "stopped"
+  if (p.exit_code) return `failed (${p.exit_code})`
+  return p.exited_at ? `exited ${since(now - p.exited_at)} ago` : "exited"
+}
+
+// One background process's latest output, kept at the bottom as it grows.
+export function ProcessLog({ session, proc, onClose }: { session: string; proc: BackgroundProcess | null; onClose: () => void }) {
+  const { log, gone } = useTail(session, proc)
+  const box = useRef<HTMLPreElement>(null)
+  const pinned = useRef(true)
+  useLayoutEffect(() => {
+    const el = box.current
+    if (el && pinned.current) el.scrollTop = el.scrollHeight
+  }, [log])
+  return (
+    <Dialog onOpenChange={open => !open && onClose()} open={Boolean(proc)}>
+      {proc && (
+        <DialogContent className="flex h-[min(28rem,80dvh)] max-h-[85dvh] flex-col gap-3 sm:max-w-2xl" data-process-log onOpenAutoFocus={e => e.preventDefault()}>
+          <div className="flex min-w-0 flex-col gap-1 pr-8">
+            <DialogTitle className="truncate font-medium text-sm leading-6">{proc.label}</DialogTitle>
+            <p className="text-muted-foreground text-xs">
+              {state(proc)}
+              {proc.notify && proc.running && " · nako hears when it ends"}
+              {proc.cwd && ` · ${proc.cwd}`}
+            </p>
+          </div>
+          {proc.command !== proc.label && <p className="break-all text-muted-foreground text-xs">{proc.command}</p>}
+          <pre
+            className="min-h-0 flex-1 overflow-auto whitespace-pre-wrap wrap-anywhere rounded-lg bg-muted p-3 font-mono text-[11px] leading-relaxed"
+            onScroll={e => {
+              const el = e.currentTarget
+              pinned.current = el.scrollHeight - el.scrollTop - el.clientHeight < 8
+            }}
+            ref={box}
+          >
+            {gone ? "this process is no longer tracked" : log ? log.lines.join("\n") || "no output yet" : (
+              <Skullet label="Loading output…" loading>
+                {"starting worker process...\nconnecting to local endpoint\nlistening on 127.0.0.1:8080"}
+              </Skullet>
+            )}
+          </pre>
+        </DialogContent>
+      )}
+    </Dialog>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/processes.tsx b/plugins/nako-portal/web/src/components/portal/processes.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..04c11c5ddef21cfb294f4c35cac779e6867f2453
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/processes.tsx
@@ -0,0 +1,67 @@
+import { useEffect, useState } from "react"
+import { Button } from "@/components/ui/button"
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from "@/components/ui/dropdown-menu"
+import { api } from "@/lib/api"
+import type { BackgroundProcess } from "@/lib/types"
+import { ProcessLog } from "./process-log"
+
+// How often an open chat re-reads its processes; also how often uptimes move.
+const REFRESH_MS = 10_000
+
+export function since(seconds: number) {
+  const m = Math.floor(seconds / 60)
+  if (m < 1) return "<1m"
+  if (m < 60) return `${m}m`
+  return `${Math.floor(m / 60)}h ${m % 60}m`
+}
+
+// The chat's background processes: read on open, when a turn starts or ends, and on a timer while it's open.
+function useProcesses(session: string, running: boolean) {
+  const [procs, setProcs] = useState<BackgroundProcess[]>([])
+  useEffect(() => {
+    let live = true
+    const read = () =>
+      api<BackgroundProcess[]>(`/api/sessions/${session}/processes`)
+        .then(p => live && setProcs(p))
+        .catch(() => {})
+    read()
+    const timer = setInterval(read, REFRESH_MS)
+    return () => {
+      live = false
+      clearInterval(timer)
+    }
+  }, [session, running])
+  return procs
+}
+
+// A quiet "● 2" in the chat header while the chat has background processes running. It opens a
+// list of them, and each opens its latest output.
+export function Processes({ session, running }: { session: string; running: boolean }) {
+  const procs = useProcesses(session, running)
+  const [shown, setShown] = useState<string | null>(null)
+  const busy = procs.filter(p => p.running).length
+  const now = Date.now() / 1000
+  if (!busy) return null
+  return (
+    <>
+      <ProcessLog onClose={() => setShown(null)} proc={procs.find(p => p.id === shown) ?? null} session={session} />
+      <DropdownMenu>
+        <DropdownMenuTrigger asChild>
+          <Button aria-label={`${busy} running in the background`} className="gap-1.5 px-2.5 text-muted-foreground text-xs" data-processes size="sm" variant="ghost">
+            <span aria-hidden className="size-1.5 animate-pulse rounded-full bg-emerald-500" />
+            {busy}
+          </Button>
+        </DropdownMenuTrigger>
+        <DropdownMenuContent align="end" className="w-[min(22rem,calc(100vw-1rem))] p-1.5 pt-2">
+          <p className="px-2 pb-1 text-muted-foreground text-xs">{busy} running in the background</p>
+          {procs.map(p => (
+            <DropdownMenuItem className="gap-3 text-xs" key={p.id} onSelect={() => setShown(p.id)} title={p.command}>
+              <span className={`min-w-0 flex-1 truncate ${p.running ? "" : "text-muted-foreground"}`}>{p.label}</span>
+              <span className="shrink-0 text-muted-foreground tabular-nums">{p.running ? since(now - p.started_at) : p.exit_code ? `failed (${p.exit_code})` : "exited"}</span>
+            </DropdownMenuItem>
+          ))}
+        </DropdownMenuContent>
+      </DropdownMenu>
+    </>
+  )
+}
