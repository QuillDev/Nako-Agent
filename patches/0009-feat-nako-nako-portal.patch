index 0000000000000000000000000000000000000000..3e9163626758a4fa1336a2e40e136cc7ffd32c86
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/presence.ts
@@ -0,0 +1,20 @@
+// Whether Nako's animated sticker shows what she's doing during a turn. On unless turned off here.
+import { useSyncExternalStore } from "react"
+
+const KEY = "presence"
+const listeners = new Set<() => void>()
+
+const stored = () => localStorage.getItem(KEY) !== "off"
+
+export function setPresence(on: boolean) {
+  if (on) localStorage.removeItem(KEY)
+  else localStorage.setItem(KEY, "off")
+  for (const listener of listeners) listener()
+}
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+export const usePresence = () => useSyncExternalStore(subscribe, stored)
diff --git a/plugins/nako-portal/web/src/lib/providers.ts b/plugins/nako-portal/web/src/lib/providers.ts
new file mode 100644
index 0000000000000000000000000000000000000000..597b508189c6e0e86c27b311dafbbec74f38ed99
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/providers.ts
@@ -0,0 +1,83 @@
+// Providers: the accounts and API keys Hermes can run on, as `hermes model` lists them. The
+// gateway reads and writes them; the portal only shows the list and takes a key. A saved key
+// never comes back, so this file has no way to read one.
+import { useSyncExternalStore } from "react"
+import { api } from "@/lib/api"
+
+export type Provider = {
+  slug: string
+  label: string
+  description: string
+  kind: "key" | "signin" | "cli"
+  command: string
+  connected: boolean
+  source: string
+  env_var: string
+  env_vars: string[]
+  signup_url: string
+  /** Set when the provider can hold several accounts: each one, and how a sign-in goes. */
+  accounts?: Account[]
+  login?: "paste" | "code"
+}
+
+export type Account = { id: string; label: string; email: string; plan: string; signed_in: boolean; removable?: boolean }
+export type AccountSignIn = { attempt: string; mode: "paste" | "code"; url?: string; user_code?: string; verification_url?: string; poll_interval?: number }
+export type AccountResult = { outcome: "added" | "refreshed"; label: string; email: string; plan: string }
+export type AccountSignInStatus = { status: "pending" | "done" | "error" | "expired" | "cancelled"; result?: AccountResult; error?: string }
+
+export type SignIn = { session_id: string; user_code: string; verification_url: string; expires_in: number; poll_interval: number }
+export type SignInStatus = { status: "pending" | "approved" | "denied" | "expired" | "error" | "cancelled"; error: string | null }
+
+export const providerPath = (slug: string) => `/api/providers/${encodeURIComponent(slug)}`
+
+let list: Provider[] | false | null = null
+let loading: Promise<void> | null = null
+const listeners = new Set<() => void>()
+
+export function reloadProviders() {
+  loading = api<Provider[]>("/api/providers").then(
+    rows => {
+      list = rows
+      for (const l of listeners) l()
+    },
+    () => {
+      // An install that can't list providers (or a gateway that went away): no page, no error.
+      list = list || false
+      for (const l of listeners) l()
+    },
+  )
+  return loading
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener)
+  if (!loading) void reloadProviders()
+  return () => listeners.delete(listener)
+}
+
+/** null until the first read; the rows after. */
+export const useProviders = () => useSyncExternalStore(subscribe, () => list)
+
+export const setProviderKey = (slug: string, value: string) => api(`${providerPath(slug)}/key`, { method: "POST", body: { value } })
+
+export const removeProviderKey = (slug: string) => api(`${providerPath(slug)}/remove`, { method: "POST" })
+
+export const startSignIn = (slug: string) => api<SignIn>(`${providerPath(slug)}/signin`, { method: "POST" })
+
+export const pollSignIn = (slug: string, session: string) => api<SignInStatus>(`${providerPath(slug)}/signin/${encodeURIComponent(session)}`)
+
+const attemptPath = (slug: string, attempt: string) => `${providerPath(slug)}/accounts/signin/${encodeURIComponent(attempt)}`
+
+/** Sign in to one more account, or again to `target`; who signs in decides whether it's added or refreshed. */
+export const startAccountSignIn = (slug: string, target?: string) =>
+  api<AccountSignIn>(`${providerPath(slug)}/accounts/signin`, { method: "POST", body: { target: target ?? null } })
+
+export const finishAccountSignIn = (slug: string, attempt: string, code: string) =>
+  api<AccountResult>(`${attemptPath(slug, attempt)}/code`, { method: "POST", body: { code } })
+
+export const pollAccountSignIn = (slug: string, attempt: string) => api<AccountSignInStatus>(attemptPath(slug, attempt))
+
+export const cancelAccountSignIn = (slug: string, attempt: string) => api(`${attemptPath(slug, attempt)}/cancel`, { method: "POST" })
+
+export const removeAccount = (slug: string, account: string) =>
+  api(`${providerPath(slug)}/accounts/${encodeURIComponent(account)}/remove`, { method: "POST" })
diff --git a/plugins/nako-portal/web/src/lib/push.ts b/plugins/nako-portal/web/src/lib/push.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9f808ad70c6af319421f08f11b6088c4b0294a71
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/push.ts
@@ -0,0 +1,58 @@
+import { api, unb64url } from "./api"
+import { desktopApp } from "./desktop-window"
+
+// The Android app's own alerts (a native notification service), exposed by its shell.
+type AppBridge = {
+  notifications(): "on" | "off"
+  openNotificationSettings(): void
+  bubble?(): "on" | "off"
+  setBubble?(on: boolean): void
+}
+const appBridge = (): AppBridge | undefined => (window as unknown as { NakoApp?: AppBridge }).NakoApp
+
+/** Inside the Android app: "on"/"off" from the app, "app" from a shell too old to say. Else null. */
+export function appAlerts(): "on" | "off" | "app" | null {
+  const bridge = appBridge()
+  if (bridge) return bridge.notifications()
+  return /NakoAndroid\//.test(navigator.userAgent) ? "app" : null
+}
+
+export const openAppNotificationSettings = () => appBridge()?.openNotificationSettings()
+
+// The desktop app's floating Nako: it says whether she's on, and takes the switch as a command.
+const desktopFloating = () => (window as unknown as { nakoFloating?: { on: boolean } }).nakoFloating
+
+/** Nako's floating sticker over other apps, in an Android or desktop app new enough to have one. Else null. */
+export function appBubble(): "on" | "off" | null {
+  const android = appBridge()?.bubble?.()
+  if (android) return android
+  const desktop = desktopFloating()
+  return desktop ? (desktop.on ? "on" : "off") : null
+}
+
+export function setAppBubble(on: boolean) {
+  const desktop = desktopFloating()
+  if (!appBridge()?.setBubble && desktop) {
+    desktop.on = on
+    void desktopApp()?.invoke("floating", { on }).catch(() => {})
+    return
+  }
+  appBridge()?.setBubble?.(on)
+}
+
+export function pushState(): "unsupported" | "on" | "blocked" | "off" {
+  if (!("Notification" in window) || !("serviceWorker" in navigator)) return "unsupported"
+  if (Notification.permission === "granted") return "on"
+  if (Notification.permission === "denied") return "blocked"
+  return "off"
+}
+
+export async function enablePush() {
+  const registration = await navigator.serviceWorker.ready
+  const { key } = await api<{ key: string | null }>("/api/push/key")
+  if (!key) throw new Error("notifications are not set up on the server")
+  const permission = await Notification.requestPermission()
+  if (permission !== "granted") throw new Error("notifications were not allowed")
+  const subscription = await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: unb64url(key) })
+  await api("/api/push/subscribe", { method: "POST", body: subscription.toJSON() })
+}
