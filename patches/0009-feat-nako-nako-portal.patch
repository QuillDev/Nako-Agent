--- /dev/null
+++ b/plugins/nako-portal/desktop/src/floating-preload.cjs
@@ -0,0 +1,7 @@
+// The floating Nako's sticker page: tells the app about presses and hears what she should show.
+const { contextBridge, ipcRenderer } = require("electron")
+
+contextBridge.exposeInMainWorld("nakoFloating", {
+  invoke: (command, args) => ipcRenderer.invoke("nako-floating", command, args ?? {}),
+  on: show => ipcRenderer.on("nako-floating-state", (_event, state) => show(state)),
+})
diff --git a/plugins/nako-portal/desktop/src/floating.js b/plugins/nako-portal/desktop/src/floating.js
new file mode 100644
index 0000000000000000000000000000000000000000..b73ed2e9db07776ea0dbfc563d566435a71b52fb
--- /dev/null
+++ b/plugins/nako-portal/desktop/src/floating.js
@@ -0,0 +1,77 @@
+// Where the floating Nako rests on screen, where her panel opens, and what she shows. All in
+// screen points (Electron's DIPs); areas are a display's work area {x, y, width, height}.
+
+/** The sticker's window: a little bigger than her, so the unread dot and the count pill under her fit. */
+export const STICKER = { width: 76, height: 84 }
+/** The panel's size until the screen is too small for it. */
+export const PANEL = { width: 400, height: 640 }
+/** Space between her and the panel, and between the panel and the screen edge. */
+export const GAP = 8
+
+const clamp = (value, least, most) => Math.min(Math.max(value, least), Math.max(least, most))
+
+/** Keeps a sticker at (`x`, `y`) wholly inside `area`. */
+export function inside(x, y, area, size = STICKER) {
+  return {
+    x: Math.round(clamp(x, area.x, area.x + area.width - size.width)),
+    y: Math.round(clamp(y, area.y, area.y + area.height - size.height)),
+  }
+}
+
+/** The area whose middle is nearest the sticker's middle at (`x`, `y`). */
+export function nearest(x, y, areas, size = STICKER) {
+  const cx = x + size.width / 2
+  const cy = y + size.height / 2
+  const distance = a => Math.hypot(clamp(cx, a.x, a.x + a.width) - cx, clamp(cy, a.y, a.y + a.height) - cy)
+  return areas.reduce((best, a) => (distance(a) < distance(best) ? a : best))
+}
+
+/**
+ * Where she starts: where she was left (`saved` {x, y}), pulled onto the nearest screen if that one
+ * is gone or smaller now; with nothing saved, on the right edge of the main screen, a third down.
+ */
+export function rest(saved, areas, size = STICKER) {
+  if (Number.isFinite(saved?.x) && Number.isFinite(saved?.y)) return inside(saved.x, saved.y, nearest(saved.x, saved.y, areas, size), size)
+  const main = areas[0]
+  return inside(main.x + main.width - size.width - GAP, main.y + main.height * 0.3, main, size)
+}
+
+/**
+ * Where the panel opens for a sticker at (`x`, `y`) in `area`: beside her on the roomier side, level
+ * with her top in the top half of the screen and with her bottom in the bottom half. She never moves.
+ */
+export function panelSpot(x, y, area, size = STICKER, panel = PANEL, gap = GAP) {
+  const width = Math.min(panel.width, area.width - gap * 2)
+  const height = Math.min(panel.height, area.height - gap * 2)
+  const right = x + size.width / 2 < area.x + area.width / 2
+  const left = right ? x + size.width + gap : x - gap - width
+  const top = y + size.height / 2 < area.y + area.height / 2 ? y : y + size.height - height
+  return {
+    x: Math.round(clamp(left, area.x + gap, area.x + area.width - gap - width)),
+    y: Math.round(clamp(top, area.y + gap, area.y + area.height - gap - height)),
+    width,
+    height,
+  }
+}
+
+const MOODS = new Set(["idle", "working", "needs-you"])
+const count = value => (Number.isInteger(value) && value >= 0 ? value : null)
+
+/**
+ * What she shows, from the portal's `{"kind":"sticker"}` frame: her mood and the counts under her
+ * (chats working, and chats finished that you haven't opened since). The portal does the counting;
+ * null for any other frame.
+ */
+export function sticker(frame) {
+  let value
+  try {
+    value = JSON.parse(frame)
+  } catch {
+    return null
+  }
+  if (value?.kind !== "sticker" || !MOODS.has(value.mood)) return null
+  const working = count(value.working)
+  const finished = count(value.finished)
+  if (working === null || finished === null) return null
+  return { mood: value.mood, working, finished }
+}
diff --git a/plugins/nako-portal/desktop/src/main.js b/plugins/nako-portal/desktop/src/main.js
new file mode 100644
index 0000000000000000000000000000000000000000..e313893d8e41445685810ad4a9942d9c80868347
--- /dev/null
+++ b/plugins/nako-portal/desktop/src/main.js
@@ -0,0 +1,459 @@
+// Nako Portal's desktop app: the portal's own web app in a window, plus the glue a browser tab
+// can't do (a server prompt, browser sign-in, notifications, self-updates).
+import { mkdirSync, readFileSync, realpathSync, writeFileSync } from "node:fs"
+import { dirname, join } from "node:path"
+import { fileURLToPath } from "node:url"
+
+import { BaseWindow, Menu, Notification, Tray, WebContentsView, app, ipcMain, nativeImage, session, shell } from "electron"
+
+import { browserAgent as agentFrom } from "./agent.js"
+import { listen } from "./alerts.js"
+import { FloatingNako } from "./bubble.js"
+import { ServerOrigin } from "./origin.js"
+import { trackNotification } from "./notifications.js"
+import { begin } from "./signin.js"
+import { Updater, announcement, platformKey, readPublicKey } from "./update.js"
+
+const here = dirname(fileURLToPath(import.meta.url))
+const root = join(here, "..")
+const IDENTIFIER = "moe.nakode.portal"
+const MAC = process.platform === "darwin"
+const log = message => console.error(`nako: ${message}`)
+
+// Settings live where the earlier app kept them, so an update keeps the portal address.
+app.setPath("userData", join(app.getPath("appData"), IDENTIFIER))
+if (!app.requestSingleInstanceLock()) app.exit(0)
+
+const hidden = process.argv.includes("--hidden")
+let window = null
+let portal = null
+let tray = null
+let origin = null
+let listener = null
+let signIn = null
+let floating = null
+let quitting = false
+
+const icon = name => nativeImage.createFromPath(join(root, "icons", name))
+
+// ---- the portal address ----
+
+const settingsPath = () => join(app.getPath("userData"), "settings.json")
+
+function settings() {
+  try {
+    return JSON.parse(readFileSync(settingsPath(), "utf8")) ?? {}
+  } catch {
+    return {}
+  }
+}
+
+function saveSettings(changes) {
+  mkdirSync(dirname(settingsPath()), { recursive: true })
+  writeFileSync(settingsPath(), JSON.stringify({ ...settings(), ...changes }, null, 2))
+}
+
+const savedOrigin = () => ServerOrigin.parse(settings().origin)
+
+const saveOrigin = origin => saveSettings({ origin: origin.value })
+
+async function reachable(origin) {
+  let me
+  try {
+    const response = await fetch(origin.page("/api/me"), { signal: AbortSignal.timeout(10_000) })
+    me = await response.json().catch(() => null)
+  } catch (error) {
+    log(`${origin.value}: ${error.message}`)
+    throw new Error(`Can't reach ${origin.value}`)
+  }
+  if (!me || !("signed_in" in me)) throw new Error(`${origin.value} isn't a Nako portal`)
+}
+
+const localPage = query => portal.webContents.loadFile(join(root, "ui", "index.html"), { search: query })
+
+function openPortal(next) {
+  const changed = origin?.value !== next.value
+  origin = next
+  if (changed || !listener) {
+    listener?.stop()
+    listener = listen({ origin, cookie: cookieHeader, onAlert: showAlert, onFrame: text => floating?.frame(text), log })
+    updater.watch(origin)
+    if (changed) floating?.reset()
+  }
+  portal.webContents.loadURL(origin.url)
+  refreshFloating()
+}
+
+async function cookieHeader() {
+  if (!origin) return null
+  const cookies = await session.defaultSession.cookies.get({ url: origin.url })
+  const header = cookies.map(c => `${c.name}=${c.value}`).join("; ")
+  return header || null
+}
+
+const onPortal = url => Boolean(origin?.opensInApp(url))
+
+// ---- what pages may ask ----
+
+/** Commands, and who may send them: the app's own pages (file://) or the portal. */
+const COMMANDS = {
+  start: ["local"],
+  connect: ["local"],
+  floating: ["portal"],
+  update: ["portal"],
+  "plugin:window|minimize": ["local", "portal"],
+  "plugin:window|toggle_maximize": ["local", "portal"],
+  "plugin:window|internal_toggle_maximize": ["local", "portal"],
+  "plugin:window|close": ["local", "portal"],
+}
+
+function sender(event) {
+  const url = event.senderFrame?.url ?? ""
+  if (event.sender !== portal?.webContents) return null
+  if (url.startsWith("file:")) return "local"
+  return onPortal(url) ? "portal" : null
+}
+
+ipcMain.handle("nako", async (event, command, args = {}) => {
+  if (!COMMANDS[command]?.includes(sender(event))) throw new Error(`${command} not allowed`)
+  switch (command) {
+    case "start": {
+      const saved = savedOrigin()
+      if (!saved) return { kind: "ask", origin: null }
+      if (args.change) return { kind: "ask", origin: saved.value }
+      try {
+        await reachable(saved)
+      } catch (error) {
+        return { kind: "unreachable", origin: saved.value, error: error.message }
+      }
+      openPortal(saved)
+      return { kind: "open" }
+    }
+    case "connect": {
+      const next = ServerOrigin.parse(args.address)
+      if (!next) throw new Error("Enter an address like https://portal.example.com")
+      await reachable(next)
+      saveOrigin(next)
+      openPortal(next)
+      return null
+    }
+    case "floating":
+      return setFloating(Boolean(args.on))
+    case "update":
+      if (args.action === "install") return void updater.install(false)
+      return void updater.check()
+    case "plugin:window|minimize":
+      return window.minimize()
+    case "plugin:window|toggle_maximize":
+    case "plugin:window|internal_toggle_maximize":
+      return window.isMaximized() ? window.unmaximize() : window.maximize()
+    case "plugin:window|close":
+      return window.close()
+  }
+})
+
+// ---- the portal's view ----
+
+/** Same-origin pages stay in the app; everything else goes to the system browser. */
+function navigate(event, url) {
+  if (url.startsWith("file:")) return
+  if (!onPortal(url)) {
+    event.preventDefault()
+    external(url)
+    return
+  }
+  const path = new URL(url).pathname
+  // The sign-in page's button for the desktop app.
+  if (path === "/desktop/sign-in") {
+    event.preventDefault()
+    startSignIn()
+  }
+  // The portal's update button, shown once an update is downloaded.
+  if (path === "/desktop/update") {
+    event.preventDefault()
+    updater.install(false)
+  }
+}
+
+async function startSignIn() {
+  signIn?.cancel()
+  const handoff = await begin(origin)
+  signIn = handoff
+  external(handoff.browserUrl)
+  const finish = await handoff.wait(300_000)
+  if (finish && signIn === handoff) {
+    portal.webContents.loadURL(finish)
+    showMain()
+  }
+}
+
+/** Tells the portal whether the floating companion is on. */
+function tellPortal() {
+  // Settings' "Floating Nako" switch reads this.
+  const float = `window.nakoFloating = { on: ${floatingOn()} }; window.dispatchEvent(new Event("nako-floating"))`
+  if (onPortal(portal.webContents.getURL())) portal.webContents.executeJavaScript(float).catch(() => {})
+}
+
+// The portal marks its title bar strips for the earlier app's drag regions; Chromium drags by CSS.
+const DRAG = `[data-tauri-drag-region] { -webkit-app-region: drag }
+[data-tauri-drag-region] :is(button, a, input, select, textarea, [role="button"], [role="menuitem"], [data-radix-collection-item]) { -webkit-app-region: no-drag }`
+
+const browserAgent = () => agentFrom(app.userAgentFallback)
+
+function createWindow() {
+  window = new BaseWindow({
+    title: "Nako",
+    width: 1100,
+    height: 780,
+    minWidth: 380,
+    minHeight: 480,
+    show: !hidden,
+    // Windows and Linux drop the system title bar for the page's own controls (macOS keeps its native one).
+    frame: MAC,
+    backgroundColor: "#0d0a11",
+    icon: MAC ? undefined : icon("icon.png"),
+  })
+  portal = new WebContentsView({ webPreferences: { preload: join(root, "src", "preload.cjs"), sandbox: true, contextIsolation: true } })
+  portal.setBackgroundColor("#0d0a11")
+  window.contentView.addChildView(portal)
+  const page = portal.webContents
+  // Tagged so the portal offers browser sign-in instead of passkeys.
+  page.setUserAgent(`${browserAgent()} NakoDesktop/${app.getVersion()}`)
+  page.on("will-navigate", event => navigate(event, event.url))
+  page.setWindowOpenHandler(({ url }) => {
+    const event = { defaultPrevented: false, preventDefault() { this.defaultPrevented = true } }
+    navigate(event, url)
+    if (!event.defaultPrevented) page.loadURL(url)
+    return { action: "deny" }
+  })
+  page.on("dom-ready", () => {
+    if (!MAC) page.insertCSS(DRAG).catch(() => {})
+  })
+  page.on("did-finish-load", () => {
+    if (!onPortal(page.getURL())) return
+    // Chromium writes cookies to disk every so often; a sign-in shouldn't wait for that.
+    session.defaultSession.cookies.flushStore().catch(() => {})
+    listener?.wake()
+    // Where updating stands; the sidebar's version checks for updates only once this is set.
+    if (updater.enabled) page.executeJavaScript(announcement(updater.status)).catch(() => {})
+    updater.checkIfDue()
+    tellPortal()
+  })
+
+  const fitPortal = () => {
+    const { width, height } = window.getContentBounds()
+    portal.setBounds({ x: 0, y: 0, width, height })
+  }
+  fitPortal()
+  window.on("resize", fitPortal)
+  window.on("close", event => {
+    // Closing hides to the tray, so alerts keep coming.
+    if (!quitting && tray) {
+      event.preventDefault()
+      window.hide()
+    }
+  })
+  window.on("blur", () => {
+    if (updater.pending && updater.automatic) updater.install(!window.isVisible())
+  })
+  window.on("focus", () => updater.checkIfDue())
+  localPage("")
+}
+
+function showMain() {
+  window.show()
+  if (window.isMinimized()) window.restore()
+  window.focus()
+  // Reopened from the tray or the launcher: it may have sat there through a release.
+  updater.checkIfDue()
+}
+
+/** A clicked notification opens its chat, without reloading the page when it's already the portal. */
+function openChat(session) {
+  const page = origin?.chatPage(session)
+  if (!page) return
+  showMain()
+  if (onPortal(portal.webContents.getURL())) portal.webContents.executeJavaScript(`location.hash = ${JSON.stringify(`#/c/${session}`)}`)
+  else portal.webContents.loadURL(page)
+}
+
+// ---- the floating Nako ----
+
+const floatingOn = () => settings().floating === true
+
+/** She floats while she's on and the portal is open, whichever window is in front. */
+function refreshFloating() {
+  if (!floating) return
+  if (floatingOn() && origin) floating.show()
+  else floating.hide()
+}
+
+function setFloating(on) {
+  saveSettings({ floating: on })
+  refreshFloating()
+  tellPortal()
+  tray?.setContextMenu(trayMenu())
+}
+
+function createFloating() {
+  floating = new FloatingNako({
+    page: join(root, "ui", "floating.html"),
+    preload: join(root, "src", "floating-preload.cjs"),
+    panelPreload: join(root, "src", "panel-preload.cjs"),
+    portalUrl: chat => (chat ? origin.chatPage(chat) : origin.url),
+    opensInPortal: onPortal,
+    userAgent: `${browserAgent()} NakoDesktop/${app.getVersion()} NakoBubble/1`,
+    saved: () => settings().floatingSpot,
+    keep: floatingSpot => saveSettings({ floatingSpot }),
+    openInApp: chat => (chat ? openChat(chat) : showMain()),
+    openLink: external,
+    signIn: () => {
+      showMain()
+      startSignIn()
+    },
+    putAway: () => setFloating(false),
+    quit: () => {
+      quitting = true
+      app.quit()
+    },
+  })
+}
+
+ipcMain.handle("nako-floating", (event, command, args = {}) => {
+  if (floating?.owns(event.sender) !== "sticker" || !event.senderFrame?.url.startsWith("file:")) throw new Error(`${command} not allowed`)
+  return floating.command(String(command), args ?? {})
+})
+
+ipcMain.handle("nako-panel", (event, command) => {
+  if (floating?.owns(event.sender) !== "panel" || !onPortal(event.senderFrame?.url ?? "")) throw new Error(`${command} not allowed`)
+  if (command === "close") return floating.collapse()
+  if (command === "open_in_app") {
+    const chat = floating.panelChat()
+    floating.collapse()
+    return chat ? openChat(chat) : showMain()
+  }
+})
+
+function external(url) {
+  shell.openExternal(url).catch(error => log(`couldn't open ${url}: ${error.message}`))
+}
+
+// ---- notifications ----
+
+/** The notification shown for each chat: a newer alert replaces it. */
+const shown = new Map()
+
+function notify(title, body, onClick) {
+  if (!Notification.isSupported()) return null
+  const note = new Notification({ title, body, icon: icon("128x128.png"), silent: false })
+  if (onClick) note.on("click", onClick)
+  note.show()
+  return note
+}
+
+function showAlert(alert) {
+  // Nothing to tell someone already looking at the app.
+  if (window.isVisible() && window.isFocused()) return
+  if (floating?.isShown) floating.alert(alert.session)
+  if (!alert.session) return void notify(alert.title, alert.body)
+  const note = notify(alert.title, alert.body, () => openChat(alert.session))
+  if (note) trackNotification(shown, alert.session, note)
+}
+
+// ---- tray, updates, downloads ----
+
+function realPath(path) {
+  try {
+    return realpathSync(path)
+  } catch {
+    return path
+  }
+}
+
+const updater = new Updater({
+  version: app.getVersion(),
+  platform: platformKey(process.env, process.platform, app.isPackaged, realPath(process.execPath)),
+  publicKey: readPublicKey(join(root, "pubkey.txt")),
+  cookie: cookieHeader,
+  onStatus: status => {
+    if (portal && onPortal(portal.webContents.getURL())) portal.webContents.executeJavaScript(announcement(status)).catch(() => {})
+  },
+  onReady: () => {
+    if (updater.automatic && !window.isFocused()) updater.install(!window.isVisible())
+  },
+  notify: (title, body) => notify(title, body),
+  quit: () => {
+    quitting = true
+    app.quit()
+  },
+  log,
+})
+
+// The macOS menu bar wants a one-colour template (it tints it for light/dark), at 16pt with an @2x copy.
+function trayIcon() {
+  if (!MAC) return icon("128x128.png").resize({ width: 32, height: 32 })
+  const image = icon("trayTemplate.png")
+  image.setTemplateImage(true)
+  return image
+}
+
+function trayMenu() {
+  return Menu.buildFromTemplate([
+    { label: "Open Nako", click: showMain },
+    {
+      label: "Change server",
+      click: () => {
+        localPage("change=1")
+        showMain()
+      },
+    },
+    { label: "Floating Nako", type: "checkbox", checked: floatingOn(), click: item => setFloating(item.checked) },
+    // Only installs that replace themselves; the .deb and Homebrew update through their package manager.
+    ...(updater.enabled ? [{ label: "Check for updates", click: () => updater.checkNow() }] : []),
+    { type: "separator" },
+    {
+      label: "Quit",
+      click: () => {
+        quitting = true
+        app.quit()
+      },
+    },
+  ])
+}
+
+function createTray() {
+  tray = new Tray(trayIcon())
+  tray.setToolTip("Nako")
+  tray.setContextMenu(trayMenu())
+  tray.on("click", showMain)
+}
+
+app.on("second-instance", () => showMain())
+// Clicking the Dock icon brings back a window that was closed to the menu bar.
+app.on("activate", () => window && showMain())
+app.on("before-quit", () => {
+  quitting = true
+  session.defaultSession.cookies.flushStore().catch(() => {})
+})
+app.on("window-all-closed", () => {})
+
+app.whenReady().then(() => {
+  app.setAppUserModelId(IDENTIFIER)
+  // Downloads from the portal go to the Downloads folder.
+  session.defaultSession.on("will-download", (_event, item) => {
+    item.setSavePath(join(app.getPath("downloads"), item.getFilename()))
+    item.once("done", (_e, state) => {
+      if (state === "completed") notify(`Saved ${item.getFilename()}`, "In your Downloads folder")
+    })
+  })
+  try {
+    createTray()
+  } catch (error) {
+    log(`no tray: ${error.message}`)
+    tray = null
+  }
+  createWindow()
+  createFloating()
+  if (hidden && !tray) window.show()
+})
+
diff --git a/plugins/nako-portal/desktop/src/minisign.js b/plugins/nako-portal/desktop/src/minisign.js
new file mode 100644
index 0000000000000000000000000000000000000000..68716bb34cecdacb70a73d5fe9b3d1afa319bc8a
--- /dev/null
+++ b/plugins/nako-portal/desktop/src/minisign.js
@@ -0,0 +1,74 @@
+// Checks a download against the updater key built into the app. Releases are signed with the
+// same minisign key the earlier (Tauri) app used, so both read one manifest: the signature is the
+// base64 of a minisign .sig file over the BLAKE2b-512 hash of the file ("ED", prehashed).
+import { createPublicKey, verify } from "node:crypto"
+import { createReadStream } from "node:fs"
+import { Worker } from "node:worker_threads"
+
+import blake from "blakejs"
+
+/** BLAKE2b-512 of `data`. Electron's crypto library has no BLAKE2, so this one is plain JS. */
+export function blake2b512(data) {
+  const state = blake.blake2bInit(64)
+  // This synchronous helper is for small inputs. Installer hashing runs in a worker.
+  for (let i = 0; i < data.length; i += 1 << 20) blake.blake2bUpdate(state, data.subarray(i, i + (1 << 20)))
+  return Buffer.from(blake.blake2bFinal(state))
+}
+
+/** The public key `pubkey.txt` holds: the base64 of a minisign public key file. */
+export function parsePublicKey(encoded) {
+  const lines = Buffer.from(encoded.trim(), "base64").toString("utf8").trim().split("\n")
+  const blob = Buffer.from(lines.at(-1).trim(), "base64")
+  if (blob.length !== 42 || blob.subarray(0, 2).toString() !== "Ed") throw new Error("not a minisign public key")
+  return { keyId: blob.subarray(2, 10), key: createPublicKey({ key: { kty: "OKP", crv: "Ed25519", x: blob.subarray(10).toString("base64url") }, format: "jwk" }) }
+}
+
+/** Whether `signature` (base64 of a minisign .sig file) signs `data` with `publicKey`. */
+export function verifySignature(data, signature, publicKey) {
+  return verifyDigest(blake2b512(data), signature, publicKey)
+}
+
+function verifyDigest(digest, signature, publicKey) {
+  let lines
+  try {
+    lines = Buffer.from(signature.trim(), "base64").toString("utf8").trim().split("\n")
+  } catch {
+    return false
+  }
+  if (lines.length < 4 || !lines[2].startsWith("trusted comment: ")) return false
+  const blob = Buffer.from(lines[1].trim(), "base64")
+  if (blob.length !== 74 || blob.subarray(0, 2).toString() !== "ED" || !blob.subarray(2, 10).equals(publicKey.keyId)) return false
+  const sig = blob.subarray(10)
+  if (!verify(null, digest, publicKey.key, sig)) return false
+  // The trusted comment (file name, timestamp) is signed too, together with the signature.
+  const comment = Buffer.from(lines[2].slice("trusted comment: ".length))
+  return verify(null, Buffer.concat([sig, comment]), publicKey.key, Buffer.from(lines[3].trim(), "base64"))
+}
+
+/** Called in the verifier worker: bounded memory, even for large installers. */
+export async function verifyFileSignature(path, signature, publicKey) {
+  const state = blake.blake2bInit(64)
+  for await (const chunk of createReadStream(path)) blake.blake2bUpdate(state, chunk)
+  return verifyDigest(Buffer.from(blake.blake2bFinal(state)), signature, publicKey)
+}
+
+/** Keep hashing and signature verification off Electron's main event loop. */
+export function verifyStagedSignature(path, signature, publicKey, signal) {
+  signal.throwIfAborted()
+  return new Promise((resolve, reject) => {
+    const worker = new Worker(new URL("./verify-worker.js", import.meta.url), { workerData: { path, signature, publicKey } })
+    let settled = false
+    const finish = (error, valid) => {
+      if (settled) return
+      settled = true
+      signal.removeEventListener("abort", abort)
+      // Wait for the file to close before callers remove it (especially on Windows).
+      worker.terminate().then(() => error ? reject(error) : resolve(valid), reject)
+    }
+    const abort = () => finish(signal.reason)
+    signal.addEventListener("abort", abort, { once: true })
+    worker.once("message", valid => finish(null, valid))
+    worker.once("error", finish)
+    worker.once("exit", code => finish(new Error(`Signature worker exited before returning a result (${code})`)))
+  })
+}
diff --git a/plugins/nako-portal/desktop/src/notifications.js b/plugins/nako-portal/desktop/src/notifications.js
