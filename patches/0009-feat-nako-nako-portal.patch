@@ -0,0 +1,59 @@
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def load_plugin():
+    spec = importlib.util.spec_from_file_location("nako_portal_display_test", ROOT / "__init__.py")
+    plugin = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(plugin)
+    return plugin
+
+
+class Ctx:
+    def register_hook(self, name, callback):
+        pass
+
+    def register_platform(self, **entry):
+        self.entry = entry
+
+
+def test_the_portal_gets_no_text_progress_or_interim_bubbles_but_keeps_streaming():
+    # Runs against the real resolver where Hermes is installed; CI has no Hermes and skips.
+    display_config = pytest.importorskip("gateway.display_config")
+    display_config._PLATFORM_DEFAULTS.pop("portal", None)
+    load_plugin().register(Ctx())
+
+    def resolved(setting, config=None):
+        return display_config.resolve_display_setting(config or {}, "portal", setting)
+
+    assert resolved("tool_progress") == "off"
+    assert resolved("interim_assistant_messages") is False
+    high = display_config._TIERS["high"]
+    for setting in ("streaming", "long_running_notifications", "busy_ack_detail"):
+        assert resolved(setting) == high[setting]
+    # An operator's config.yaml still wins.
+    assert resolved("tool_progress", {"display": {"platforms": {"portal": {"tool_progress": "all"}}}}) == "all"
+
+
+def test_the_portal_quiets_hermes_display_defaults_without_dropping_the_rest(monkeypatch):
+    # The same contract against a stand-in shaped like Hermes's display_config, so CI covers it.
+    gateway = type(sys)("gateway")
+    display_config = type(sys)("gateway.display_config")
+    display_config._TIERS = {"high": {"tool_progress": "all", "interim_assistant_messages": True, "streaming": None}}
+    display_config._PLATFORM_DEFAULTS = {}
+    gateway.display_config = display_config
+    monkeypatch.setitem(sys.modules, "gateway", gateway)
+    monkeypatch.setitem(sys.modules, "gateway.display_config", display_config)
+
+    load_plugin().register(Ctx())
+
+    assert display_config._PLATFORM_DEFAULTS["portal"] == {
+        "tool_progress": "off",
+        "interim_assistant_messages": False,
+        "streaming": None,
+    }
diff --git a/plugins/nako-portal/tests/test_environments.py b/plugins/nako-portal/tests/test_environments.py
new file mode 100644
index 0000000000000000000000000000000000000000..88104f11d02cb14e0fd8e380bd66b5ab55becbdd
--- /dev/null
+++ b/plugins/nako-portal/tests/test_environments.py
@@ -0,0 +1,270 @@
+"""Environments: an optional page fed by a command the owner sets; without one the portal has no such page."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import sys
+
+import pytest
+from conftest import until
+from portal.environments import Environments
+
+pytestmark = pytest.mark.asyncio
+
+
+def _command(tmp_path, output, *, exit_code=0, stderr=""):
+    """A command that prints `output`, logs each run to a file, and exits with `exit_code`."""
+    script = tmp_path / "envs.py"
+    runs = tmp_path / "runs"
+    script.write_text(
+        "import sys\n"
+        f"open({str(runs)!r}, 'a').write('x')\n"
+        f"sys.stdout.write({output!r})\n"
+        f"sys.stderr.write({stderr!r})\n"
+        f"sys.exit({exit_code})\n"
+    , encoding="utf-8")
+    return [sys.executable, "-I", str(script)], runs
+
+
+async def _get(world):
+    response = await world.http.get(world.url("/api/environments"))
+    return response.status, await response.json()
+
+
+async def test_without_a_command_there_is_no_environments_page(world):
+    await world.sign_up()
+    me = await (await world.http.get(world.url("/api/me"))).json()
+    assert me["environments"] is False
+    status, _ = await _get(world)
+    assert status == 404
+
+
+async def test_the_page_lists_what_the_command_prints(world, tmp_path):
+    output = json.dumps({
+        "title": "Stacks",
+        "environments": [
+            {"name": "feature-x", "status": "running", "session": "20261104_101500_ab12cd", "links": [
+                {"label": "app", "url": "https://feature-x.example.test/"},
+                {"label": "local file", "url": "file:///etc/passwd"},
+                {"label": "script", "url": "javascript:alert(1)"},
+            ]},
+            {"name": "half-up", "status": "partial", "detail": "3 of 7 running", "session": "../../etc"},
+            {"name": "odd", "status": "exploded"},
+            {"status": "running"},
+        ],
+        "links": [{"label": "sign in", "url": "https://gate.example.test/key"}],
+    })
+    command, _ = _command(tmp_path, output)
+    world.portal.environments = Environments(command)
+    assert (await _get(world))[0] == 401
+    await world.sign_up()
+    assert (await (await world.http.get(world.url("/api/me"))).json())["environments"] is True
+    status, body = await _get(world)
+    assert status == 200
+    assert body == {
+        "title": "Stacks",
+        "environments": [
+            {"name": "feature-x", "status": "running", "session": "20261104_101500_ab12cd", "links": [{"label": "app", "url": "https://feature-x.example.test/"}]},
+            {"name": "half-up", "status": "partial", "detail": "3 of 7 running", "links": []},
+            {"name": "odd", "status": "stopped", "links": []},
+        ],
+        "links": [{"label": "sign in", "url": "https://gate.example.test/key"}],
+        "can_stop": False,
+    }
+
+
+async def test_the_title_defaults_when_the_command_gives_none(world, tmp_path):
+    command, _ = _command(tmp_path, json.dumps({"environments": []}))
+    world.portal.environments = Environments(command)
+    await world.sign_up()
+    assert await _get(world) == (200, {"title": "Environments", "environments": [], "links": [], "can_stop": False})
+
+
+async def test_a_failing_command_says_why(world, tmp_path):
+    command, _ = _command(tmp_path, "", exit_code=3, stderr="warming up\nstate dir missing\n")
+    world.portal.environments = Environments(command)
+    await world.sign_up()
+    status, body = await _get(world)
+    assert status == 502
+    assert "state dir missing" in body["error"]
+
+
+async def test_output_that_isnt_the_expected_json_is_an_error(world, tmp_path):
+    command, _ = _command(tmp_path, "stack-a running\n")
+    world.portal.environments = Environments(command)
+    await world.sign_up()
+    status, body = await _get(world)
+    assert status == 502
+    assert "JSON" in body["error"]
+
+
+async def test_a_missing_program_is_an_error_not_a_crash(world, tmp_path):
+    world.portal.environments = Environments([str(tmp_path / "nope")])
+    await world.sign_up()
+    status, body = await _get(world)
+    assert status == 502
+    assert "can't run" in body["error"]
+
+
+async def test_reads_close_together_run_the_command_once(world, tmp_path):
+    command, runs = _command(tmp_path, json.dumps({"environments": []}))
+    world.portal.environments = Environments(command, ttl=60)
+    await world.sign_up()
+    for _ in range(3):
+        assert (await _get(world))[0] == 200
+    assert runs.read_text(encoding="utf-8-sig") == "x"
+
+
+async def test_a_slow_command_times_out(tmp_path):
+    script = tmp_path / "slow.py"
+    script.write_text("import time\ntime.sleep(5)\n", encoding="utf-8")
+    environments = Environments([sys.executable, "-I", str(script)], timeout=0.3)
+    with pytest.raises(Exception, match="longer than"):
+        await environments.read()
+
+
+async def test_memory_shows_when_the_command_reports_it(world, tmp_path):
+    output = json.dumps({"environments": [
+        {"name": "big", "status": "running", "memory": 6_500_000_000},
+        {"name": "odd", "status": "running", "memory": "lots"},
+        {"name": "negative", "status": "running", "memory": -1},
+    ]})
+    command, _ = _command(tmp_path, output)
+    world.portal.environments = Environments(command)
+    await world.sign_up()
+    _, body = await _get(world)
+    assert [env.get("memory") for env in body["environments"]] == [6_500_000_000, None, None]
+
+
+def _stopper(tmp_path):
+    """A stop command that records the name it was given."""
+    script = tmp_path / "stop.py"
+    stopped = tmp_path / "stopped"
+    script.write_text(f"import sys\nopen({str(stopped)!r}, 'a').write(sys.argv[-1] + '\\n')\n", encoding="utf-8")
+    return [sys.executable, "-I", str(script), "--keep-data"], stopped
+
+
+async def _stop(world, name):
+    response = await world.post(f"/api/environments/{name}/stop")
+    return response.status, await response.json()
+
+
+async def test_stop_runs_the_owners_command_for_a_running_environment(world, tmp_path):
+    listed = json.dumps({"environments": [{"name": "old-feature", "status": "running"}, {"name": "done", "status": "stopped"}]})
+    command, _ = _command(tmp_path, listed)
+    stop, stopped = _stopper(tmp_path)
+    world.portal.environments = Environments(command, stop_command=stop)
+    assert (await _stop(world, "old-feature"))[0] == 401
+    await world.sign_up()
+    assert (await _get(world))[1]["can_stop"] is True
+    assert await _stop(world, "old-feature") == (200, {"stopped": "old-feature"})
+    assert stopped.read_text(encoding="utf-8-sig") == "old-feature\n"
+
+
+async def test_stop_only_runs_for_environments_the_list_shows_running(world, tmp_path):
+    listed = json.dumps({"environments": [{"name": "done", "status": "stopped"}]})
+    command, _ = _command(tmp_path, listed)
+    stop, stopped = _stopper(tmp_path)
+    world.portal.environments = Environments(command, stop_command=stop)
+    await world.sign_up()
+    assert (await _stop(world, "done"))[0] == 404
+    assert (await _stop(world, "made-up"))[0] == 404
+    assert not stopped.exists()
+
+
+async def test_without_a_stop_command_nothing_can_be_stopped(world, tmp_path):
+    command, _ = _command(tmp_path, json.dumps({"environments": [{"name": "a", "status": "running"}]}))
+    world.portal.environments = Environments(command)
+    await world.sign_up()
+    assert (await _stop(world, "a"))[0] == 404
+
+
+async def test_a_failing_stop_says_why(world, tmp_path):
+    command, _ = _command(tmp_path, json.dumps({"environments": [{"name": "a", "status": "running"}]}))
+    script = tmp_path / "fail.py"
+    script.write_text("import sys\nsys.stderr.write('unit is busy\\n')\nsys.exit(1)\n", encoding="utf-8")
+    world.portal.environments = Environments(command, stop_command=[sys.executable, "-I", str(script)])
+    await world.sign_up()
+    status, body = await _stop(world, "a")
+    assert status == 502
+    assert "unit is busy" in body["error"]
+
+
+async def test_two_stops_run_at_once(world, tmp_path):
+    listed = json.dumps({"environments": [{"name": "a", "status": "running"}, {"name": "b", "status": "running"}]})
+    command, _ = _command(tmp_path, listed)
+    # Each stop records itself and waits until the other has also started, so serial stops time out.
+    script = tmp_path / "barrier.py"
+    script.write_text(
+        f"import pathlib, sys, time\n"
+        f"root = pathlib.Path({str(tmp_path)!r})\n"
+        f"(root / f'started-{{sys.argv[-1]}}').write_text('1')\n"
+        f"deadline = time.monotonic() + 3.0\n"
+        f"while not ((root / 'started-a').exists() and (root / 'started-b').exists()):\n"
+        f"    if time.monotonic() > deadline:\n"
+        f"        sys.stderr.write('did not overlap')\n"
+        f"        sys.exit(1)\n"
+        f"    time.sleep(0.02)\n"
+    , encoding="utf-8")
+    world.portal.environments = Environments(command, stop_command=[sys.executable, "-I", str(script)])
+    await world.sign_up()
+    first, second = await asyncio.gather(_stop(world, "a"), _stop(world, "b"))
+    assert first == (200, {"stopped": "a"})
+    assert second == (200, {"stopped": "b"})
+
+
+async def test_stop_ignores_an_in_flight_poll_started_before_it_finished(world, tmp_path):
+    state = tmp_path / "state.json"
+    state.write_text(json.dumps({"environments": [{"name": "a", "status": "running"}]}), encoding="utf-8")
+    poll_started = tmp_path / "poll-started"
+    release_poll = tmp_path / "release-poll"
+    stop_started = tmp_path / "stop-started"
+    release_stop = tmp_path / "release-stop"
+    list_script = tmp_path / "list.py"
+    list_script.write_text(
+        f"import pathlib, sys, time\n"
+        f"state = pathlib.Path({str(state)!r}).read_text()\n"
+        f"if pathlib.Path({str(stop_started)!r}).exists() and not pathlib.Path({str(release_poll)!r}).exists():\n"
+        f"    pathlib.Path({str(poll_started)!r}).write_text('1')\n"
+        f"    deadline = time.monotonic() + 5\n"
+        f"    while not pathlib.Path({str(release_poll)!r}).exists():\n"
+        f"        assert time.monotonic() < deadline, 'poll was never released'\n"
+        f"        time.sleep(0.02)\n"
+        f"sys.stdout.write(state)\n"
+    , encoding="utf-8")
+    stop_script = tmp_path / "stop.py"
+    stop_script.write_text(
+        f"import json, pathlib, time\n"
+        f"pathlib.Path({str(stop_started)!r}).write_text('1')\n"
+        f"deadline = time.monotonic() + 5\n"
+        f"while not pathlib.Path({str(release_stop)!r}).exists():\n"
+        f"    assert time.monotonic() < deadline, 'stop was never released'\n"
+        f"    time.sleep(0.02)\n"
+        f"pathlib.Path({str(state)!r}).write_text(json.dumps({{'environments': [{{'name': 'a', 'status': 'stopped'}}]}}))\n"
+    , encoding="utf-8")
+    now = [0.0]
+    world.portal.environments = Environments(
+        [sys.executable, "-I", str(list_script)],
+        stop_command=[sys.executable, "-I", str(stop_script)],
+        ttl=5.0,
+        clock=lambda: now[0],
+    )
+    await world.sign_up()
+    # Prime the cache, then start a stop that pauses mid-command.
+    assert (await _get(world))[1]["environments"][0]["status"] == "running"
+    stop_task = asyncio.create_task(_stop(world, "a"))
+    await until(stop_started.exists)
+    # Expire the cache and start a poll that reads the pre-stop "running" state and pauses.
+    now[0] = 10.0
+    stale_poll = asyncio.create_task(_get(world))
+    await until(poll_started.exists)
+    # Finish the stop while that pre-stop poll is still in flight.
+    release_stop.write_text("1", encoding="utf-8")
+    assert await stop_task == (200, {"stopped": "a"})
+    # Let the stale poll finish; a read after the stop must still see "stopped", not the stale poll's result.
+    release_poll.write_text("1", encoding="utf-8")
+    await stale_poll
+    status, body = await _get(world)
+    assert status == 200
+    assert body["environments"][0]["status"] == "stopped"
diff --git a/plugins/nako-portal/tests/test_groups.py b/plugins/nako-portal/tests/test_groups.py
new file mode 100644
index 0000000000000000000000000000000000000000..5ffc17c37d7dcf580351d9186a58d3b2b1a498f5
--- /dev/null
+++ b/plugins/nako-portal/tests/test_groups.py
@@ -0,0 +1,120 @@
+"""Chat groups: the agent makes and fills them with its tools, the app's sidebar reads them, and
+they outlive a restart."""
+
+from __future__ import annotations
+
+import asyncio
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+from conftest import LOCAL_TOKEN
+from portal.store import Store
+
+pytestmark = pytest.mark.asyncio
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _load(name, file):
+    spec = importlib.util.spec_from_file_location(name, ROOT / file)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _tools(world):
+    """The agent's group tools, pointed at the portal's loopback API the way the plugin wires them."""
+    mesh = _load("mesh_tools_for_groups", "mesh_tools.py")
+    mesh._api = lambda *_: (str(world.local.make_url("")).rstrip("/"), LOCAL_TOKEN)
+    tools = _load("groups_tools_under_test", "groups_tools.py")
+    tools.CALL = lambda method, path, body=None: mesh._call(method, path, body)
+
+    async def call(name, args=None, session=None):
+        return json.loads(await asyncio.to_thread(tools.TOOL_HANDLERS[name], args or {}, session_id=session))
+
+    return call
+
+
+async def _sidebar(world):
+    rows = await (await world.http.get(world.url("/api/sessions"))).json()
+    return {row["title"]: (row["group"] or {}).get("name") for row in rows}
+
+
+async def test_the_agent_groups_chats_and_the_sidebar_shows_them_after_a_restart(world, tmp_path):
+    await world.sign_up()
+    here = world.hermes.add_session("20261103_090000_aaaaaa", "fix stock check")
+    world.hermes.add_session("20261103_090100_bbbbbb", "picking PR review")
+    world.hermes.add_session("20261103_090200_cccccc", "tax forms")
+    tool = _tools(world)
+
+    # The agent puts the chat it runs in, and another, into a new group.
+    created = await tool("group_add", {"group": "Warehouse app", "create": True}, session=here)
+    assert "error" not in created, created
+    await tool("group_add", {"group": "warehouse APP", "sessions": ["20261103_090100_bbbbbb"]})
+    assert await _sidebar(world) == {"fix stock check": "Warehouse app", "picking PR review": "Warehouse app", "tax forms": None}
+
+    listed = await tool("group_list", session=here)
+    assert listed["this_chat"] == here
+    [group] = listed["groups"]
+    assert (group["name"], group["color"]) == ("Warehouse app", "blue")
+    assert sorted(c["title"] for c in group["chats"]) == ["fix stock check", "picking PR review"]
+
+    # A second group takes the next free color; moving a chat there takes it out of the first.
+    assert (await tool("group_create", {"name": "Billing"}))["color"] == "green"
+    await tool("group_add", {"group": "Billing", "sessions": ["20261103_090100_bbbbbb"]})
+    await tool("group_update", {"group": "Billing", "name": "Billing migration", "color": "teal"})
+    rows = await (await world.http.get(world.url("/api/sessions"))).json()
+    review = next(r for r in rows if r["title"] == "picking PR review")
+    assert (review["group"]["name"], review["group"]["color"]) == ("Billing migration", "teal")
+    assert (await _sidebar(world))["fix stock check"] == "Warehouse app"
+
+    # Groups live in the portal's store: a fresh server on the same file sees the same ones.
+    restarted = Store(world.store.path)
+    assert [(g["name"], g["color"]) for g in restarted.groups()] == [("Warehouse app", "blue"), ("Billing migration", "teal")]
+    assert {g["name"] for g in restarted.chat_groups().values()} == {"Warehouse app", "Billing migration"}
+
+    # Taking a chat out, and deleting a group, leave the chats in the list ungrouped.
+    await tool("group_remove", session=here)
+    await tool("group_delete", {"group": "Billing migration"})
+    assert await _sidebar(world) == {"fix stock check": None, "picking PR review": None, "tax forms": None}
+    assert [g["name"] for g in (await tool("group_list"))["groups"]] == ["Warehouse app"]
+
+
+async def test_bad_group_changes_are_refused_and_change_nothing(world):
+    await world.sign_up()
+    chat = world.hermes.add_session("20261103_100000_dddddd", "assembly labels")
+    tool = _tools(world)
+    await tool("group_create", {"name": "Home server", "color": "orange"})
+    before = (world.store.groups(), world.store.chat_groups())
+
+    for name, args, session in [
+        ("group_create", {"name": "home SERVER"}, None),
+        ("group_create", {"name": "   "}, None),
+        ("group_create", {"name": "Media", "color": "pink"}, None),
+        ("group_update", {"group": "Nope", "name": "x"}, None),
+        ("group_update", {"group": "Home server", "color": "magenta"}, None),
+        ("group_add", {"group": "Nope"}, chat),
+        ("group_add", {"group": "Home server", "sessions": ["20261103_100000_notreal"]}, None),
+        ("group_delete", {"group": "Nope"}, None),
+    ]:
+        result = await tool(name, args, session=session)
+        assert "error" in result, (name, args, result)
+    assert (world.store.groups(), world.store.chat_groups()) == before
+
+
+async def test_group_routes_need_a_signed_in_app_or_the_loopback_token(world):
+    world.hermes.add_session("20261103_110000_eeeeee", "assembly labels")
+    for path in ("/api/groups", "/api/sessions/20261103_110000_eeeeee/group"):
+        refused = await world.post(path, {"name": "x", "group": "x"})
+        assert refused.status == 401
+    refused = await world.http.post(str(world.local.make_url("/groups")), json={"name": "x"}, headers={"Authorization": "Bearer wrong"})
+    assert refused.status == 401
+    assert world.store.groups() == []
+
+    # Signed in, the app makes a group and files a chat in it.
+    await world.sign_up()
+    made = await (await world.post("/api/groups", {"name": "Labels"})).json()
+    filed = await world.post("/api/sessions/20261103_110000_eeeeee/group", {"group": made["id"]})
+    assert filed.status == 200, await filed.text()
+    assert (await _sidebar(world)) == {"assembly labels": "Labels"}
diff --git a/plugins/nako-portal/tests/test_link.py b/plugins/nako-portal/tests/test_link.py
new file mode 100644
index 0000000000000000000000000000000000000000..ddc72f63ddb3535b5c64b13d2d7d9cca415c72e6
--- /dev/null
+++ b/plugins/nako-portal/tests/test_link.py
@@ -0,0 +1,151 @@
+"""The portal server runs on its own; the gateway dials in and can come and go."""
+
+import asyncio
+import json
+import socket
+import sys
+
+import aiohttp
+from conftest import LOCAL_TOKEN, ORIGIN, ROOT, SERVER_CODE, Backend, FakeGateway, next_message, until
+from portal.link import GatewayClient
+
+
+async def test_the_site_stays_up_while_the_gateway_restarts(world):
+    sid = world.hermes.add_session("20261025_141414_aaaaaa", "plans", messages=[("user", "plan the week")])
+    await world.sign_up()
+    ws = await world.http.ws_connect(world.url("/ws"), headers={"Origin": ORIGIN})
+
+    await world.gateway.stop(world.hub)
+    await next_message(ws, lambda m: m.get("kind") == "hub.disconnected")
+    page = await world.http.get(world.url("/"))
+    assert page.status == 200 and "<html" in (await page.text()).lower()
+    assert (await (await world.http.get(world.url("/api/me"))).json())["connected"] is False
+    listed = await world.http.get(world.url("/api/sessions"))
+    assert (listed.status, (await listed.json())["error"]) == (503, "Nako is offline right now")
+    sent = await world.http.post(world.url(f"/api/sessions/{sid}/messages"), data={"text": "hello?"}, headers={"Origin": ORIGIN})
+    assert sent.status == 503
+    assert world.hermes.received == []
+
+    await world.gateway.start(world.hub)
+    await next_message(ws, lambda m: m.get("kind") == "hub.connected")
+    assert [row["id"] for row in await (await world.http.get(world.url("/api/sessions"))).json()] == [sid]
+    await world.http.post(world.url(f"/api/sessions/{sid}/messages"), data={"text": "back"}, headers={"Origin": ORIGIN})
+    assert world.hermes.received[-1][:2] == (f"chat-{sid}", "back")
+    await ws.close()
+
+
+async def test_a_turn_and_its_question_end_when_the_gateway_goes_away(world):
+    sid = world.hermes.add_session("20261025_151515_bbbbbb", "cleanup", messages=[("user", "tidy the build dir")])
+    world.hermes.ask_approval = True
+    await world.sign_up()
+    await world.http.post(world.url(f"/api/sessions/{sid}/messages"), data={"text": "go"}, headers={"Origin": ORIGIN})
+    await until(lambda: world.hub.requests)
+    opened = await (await world.http.get(world.url(f"/api/sessions/{sid}"))).json()
+    assert (opened["running"], len(opened["requests"])) == (True, 1)
+    sticker = await world.http.ws_connect(world.url("/ws"), headers={"Origin": ORIGIN})
+    await next_message(sticker, lambda m: m.get("kind") == "status.synced")
+
+    await world.gateway.stop(world.hub)
+    # Apps already connected hear the chat stopped, or their sticker keeps counting it as running.
+    cleared = await next_message(sticker, lambda m: m.get("kind") == "status")
+    assert (cleared["session"], cleared["status"]) == (sid, None)
+    await world.gateway.start(world.hub)
+    opened = await (await world.http.get(world.url(f"/api/sessions/{sid}"))).json()
+    assert (opened["running"], opened["requests"], opened["status"]) == (False, [], None)
+    await sticker.close()
+
+
+async def test_a_gateway_on_other_code_is_told_to_start_a_fresh_server(world):
+    stale = []
+    world.link.on_stale = lambda: stale.append(True)
+    async with aiohttp.ClientSession() as http:
+        refused = await http.get(world.local.make_url("/gateway"), params={"code": "newer"}, headers={"Authorization": f"Bearer {LOCAL_TOKEN}"})
+        assert refused.status == 409
+    await until(lambda: stale)
+    assert world.hub.connected
+
+
+async def test_only_the_local_token_opens_the_gateway_link(world):
+    async with aiohttp.ClientSession() as http:
+        for token in (None, "wrong"):
+            headers = {"Authorization": f"Bearer {token}"} if token else {}
+            refused = await http.get(world.local.make_url("/gateway"), params={"code": SERVER_CODE}, headers=headers)
+            assert refused.status == 401
+
+
+async def test_the_gateway_starts_the_server_when_nothing_answers():
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        port = probe.getsockname()[1]
+    missing = asyncio.Event()
+
+    async def start_server():
+        missing.set()
+
+    client = GatewayClient(f"http://127.0.0.1:{port}/gateway", LOCAL_TOKEN, SERVER_CODE, Backend(FakeGateway()), on_missing=start_server)
+    async with aiohttp.ClientSession() as http:
+        task = asyncio.get_running_loop().create_task(client.run(http))
+        await asyncio.wait_for(missing.wait(), 5)
+        task.cancel()
+        await asyncio.gather(task, return_exceptions=True)
+
+
+def free_pair():
+    """A free port whose next one is free too: the server listens on both (site, then gateway link)."""
+    while True:
+        with socket.socket() as first, socket.socket() as second:
+            first.bind(("127.0.0.1", 0))
+            port = first.getsockname()[1]
+            try:
+                second.bind(("127.0.0.1", port + 1))
+            except OSError:
+                continue
+            return port
+
+
+async def test_the_standalone_server_serves_and_takes_a_gateway(tmp_path):
+    port = free_pair()
+    data = tmp_path / "nako-portal"
+    data.mkdir()
+    (data / "local-token").write_text(LOCAL_TOKEN + "\n", encoding="utf-8")
+    config = tmp_path / "server.json"
+    origin = f"http://127.0.0.1:{port}"
+    config.write_text(json.dumps({"data": str(data), "origin": origin, "port": port, "contact": "mailto:owner@localhost", "code": SERVER_CODE}), encoding="utf-8")
+    server = await asyncio.create_subprocess_exec(
+        sys.executable, str(ROOT / "dashboard" / "serve.py"), str(config),
+        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT,
+    )
+    try:
+        async with aiohttp.ClientSession() as http:
+
+            async def me():
+                try:
+                    return await (await http.get(f"{origin}/api/me")).json()
+                except aiohttp.ClientError:
+                    return None
+
+            async def wait_for(check):
+                for _ in range(200):
+                    if check(await me()):
+                        return
+                    await asyncio.sleep(0.05)
+                raise AssertionError("the server never got there")
+
+            # It answers as soon as it listens and writes the first setup link just after.
+            link = data / "setup-link"
+            await wait_for(lambda m: m is not None and m["connected"] is False and link.exists() and link.read_text(encoding="utf-8-sig").startswith(f"{origin}/#setup="))
+
+            hermes = FakeGateway()
+            client = GatewayClient(f"http://127.0.0.1:{port + 1}/gateway", LOCAL_TOKEN, SERVER_CODE, Backend(hermes))
+            task = asyncio.get_running_loop().create_task(client.run(http))
+            await wait_for(lambda m: m is not None and m["connected"] is True)
+            task.cancel()
+            await asyncio.gather(task, return_exceptions=True)
+            await wait_for(lambda m: m is not None and m["connected"] is False)
+        server.terminate()
+        await asyncio.wait_for(server.communicate(), 10)
+        assert server.returncode == 0
+    finally:
+        if server.returncode is None:
+            server.kill()
+        await server.communicate()
diff --git a/plugins/nako-portal/tests/test_live_tools.py b/plugins/nako-portal/tests/test_live_tools.py
new file mode 100644
index 0000000000000000000000000000000000000000..0f513719ea9bb69768ef07ca2666f2d02fafb8a8
--- /dev/null
+++ b/plugins/nako-portal/tests/test_live_tools.py
@@ -0,0 +1,229 @@
+import asyncio
+import importlib.util
+from pathlib import Path
+
+from conftest import ORIGIN, next_message
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def plugin_hooks():
+    spec = importlib.util.spec_from_file_location("nako_portal_live_tools_test", ROOT / "__init__.py")
+    plugin = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(plugin)
+
+    class Ctx:
+        def __init__(self):
+            self.hooks = {}
+
+        def register_hook(self, name, callback):
+            self.hooks[name] = callback
+
+        def register_platform(self, **entry):
+            pass
+
+    ctx = Ctx()
+    plugin.register(ctx)
+    return plugin, ctx.hooks
+
+
+async def test_tool_calls_in_a_running_turn_reach_the_open_chat_live(world):
+    sid = world.hermes.add_session("20261025_101010_cccccc", "flaky ci", messages=[("user", "why is shard 3 red")])
+    plugin, hooks = plugin_hooks()
+    plugin._LIVE_TOOLS.update(link=world.client, loop=asyncio.get_running_loop())
+    release = asyncio.Event()
+
+    async def turn(chat, session):
+        await world.hub.turn_started(chat)
+        # The agent runs tools on its own thread, like Hermes does.
+        await asyncio.to_thread(hooks["pre_tool_call"], tool_name="terminal", args={"command": "gh run list"}, session_id=session, tool_call_id="call-1")
+        await asyncio.to_thread(hooks["post_tool_call"], tool_name="terminal", args={"command": "gh run list"}, session_id=session, tool_call_id="call-1", status="error")
+        await release.wait()
+        await world.hub.turn_finished(chat, "success")
+
+    world.hermes._turn = turn
+    await world.sign_up()
+    ws = await world.http.ws_connect(world.url("/ws"), headers={"Origin": ORIGIN})
+    await ws.send_json({"watch": sid})
+    await asyncio.sleep(0.05)
+    await world.http.post(world.url(f"/api/sessions/{sid}/messages"), data={"text": "look again"}, headers={"Origin": ORIGIN})
+
+    started = await next_message(ws, lambda m: m.get("type") == "tool")
+    ended = await next_message(ws, lambda m: m.get("type") == "tool")
+    assert [(e["session"], e["payload"]["id"], e["payload"]["name"], e["payload"]["state"]) for e in (started, ended)] == [
+        (sid, "call-1", "terminal", "running"),
+        (sid, "call-1", "terminal", "failed"),
+    ]
+    release.set()
+    await next_message(ws, lambda m: m.get("type") == "message.complete")
+
+    # Outside a turn (another surface's agent, a finished chat) nothing is sent.
+    await asyncio.to_thread(hooks["pre_tool_call"], tool_name="terminal", args={}, session_id=sid, tool_call_id="call-2")
+    try:
+        stray = await next_message(ws, lambda m: m.get("type") == "tool", timeout=0.3)
+    except TimeoutError:
+        stray = None
+    assert stray is None
+    await ws.close()
+
+
+# What Hermes puts before a request it restates after compacting a chat mid-turn.
+RESTATED = "[STILL IN PROGRESS — this is the active request, restated after the compaction boundary because it was not finished yet. Continue it; do not start over.]"
+
+
+async def test_a_chat_opened_after_a_mid_turn_compaction_keeps_the_conversation_and_the_turns_progress(world):
+    sid = world.hermes.add_session(
+        "20261025_121212_eeeeee", "premio", messages=[("user", "list the sftp folders"), ("assistant", "13 folders, mostly order files")]
+    )
+    plugin, hooks = plugin_hooks()
+    plugin._LIVE_TOOLS.update(link=world.client, loop=asyncio.get_running_loop())
+    compacted, release = asyncio.Event(), asyncio.Event()
+
+    async def turn(chat, session):
+        await world.hub.turn_started(chat)
+        await world.hub.outgoing(chat, "progress-1", "pulling a few samples first")
+        world.hermes._row(session, "assistant", "pulling a few samples first")
+        await asyncio.to_thread(hooks["pre_tool_call"], tool_name="process", args={"action": "wait"}, session_id=session, tool_call_id="call-1")
+        # Hermes compacts the context: the display read keeps every row and adds the restated request.
+        world.hermes._row(session, "user", RESTATED + "\nyes, push it to the wms")
+        compacted.set()
+        await release.wait()
+        await asyncio.to_thread(hooks["post_tool_call"], tool_name="process", args={}, session_id=session, tool_call_id="call-1")
+        await asyncio.to_thread(hooks["pre_tool_call"], tool_name="terminal", args={"command": "bun test"}, session_id=session, tool_call_id="call-2")
+        world.hermes._row(session, "assistant", "pushed")
+        await world.hub.turn_finished(chat, "success")
+
+    world.hermes._turn = turn
+    await world.sign_up()
+    await world.http.post(world.url(f"/api/sessions/{sid}/messages"), data={"text": "yes, push it to the wms"}, headers={"Origin": ORIGIN})
+    await asyncio.wait_for(compacted.wait(), 5)
+
+    # A tab that opens the chat now sees the whole conversation, the request once as sent, and
+    # the turn's progress so far: the line it wrote and the call it's waiting on.
+    async def opened_with_tool():
+        while True:
+            opened = await (await world.http.get(world.url(f"/api/sessions/{sid}"))).json()
+            if opened.get("live", {}).get("tools"):
+                return opened
+            await asyncio.sleep(0.02)
+
+    opened = await asyncio.wait_for(opened_with_tool(), 5)
+    assert [(m["role"], m["text"]) for m in opened["messages"]] == [
+        ("user", "list the sftp folders"),
+        ("assistant", "13 folders, mostly order files"),
+        ("user", "yes, push it to the wms"),
+        ("assistant", "pulling a few samples first"),
+    ]
+    assert opened["running"] is True
+    assert opened["live"]["messages"] == [{"id": "progress-1", "text": "pulling a few samples first", "after": 0}]
+    assert [(t["id"], t["name"], t["state"]) for t in opened["live"]["tools"]] == [("call-1", "process", "running")]
+
+    # And the rest of the turn keeps streaming to it.
+    ws = await world.http.ws_connect(world.url("/ws"), headers={"Origin": ORIGIN})
+    await ws.send_json({"watch": sid})
+    await asyncio.sleep(0.05)
+    release.set()
+    calls = [await next_message(ws, lambda m: m.get("type") == "tool") for _ in range(2)]
+    assert [(c["payload"]["id"], c["payload"]["state"]) for c in calls] == [("call-1", "done"), ("call-2", "running")]
+    await next_message(ws, lambda m: m.get("type") == "message.complete")
+    after = await (await world.http.get(world.url(f"/api/sessions/{sid}"))).json()
+    assert "live" not in after and after["messages"][-1]["text"] == "pushed"
+    await ws.close()
+
+
+async def test_a_finished_reply_gets_nakos_sign_off_and_a_failed_one_is_just_skipped(world):
+    sid = world.hermes.add_session("20261025_111111_dddddd", "rename", messages=[("user", "rename the job")])
+    await world.sign_up()
+    ws = await world.http.ws_connect(world.url("/ws"), headers={"Origin": ORIGIN})
+    await ws.send_json({"watch": sid})
+    await asyncio.sleep(0.05)
+
+    await world.http.post(world.url(f"/api/sessions/{sid}/messages"), data={"text": "go"}, headers={"Origin": ORIGIN})
+    await next_message(ws, lambda m: m.get("type") == "message.complete")
+    said = await next_message(ws, lambda m: m.get("type") == "signoff")
+    assert (said["session"], said["payload"]["text"]) == (sid, "proud of: hello from hermes")
+
+    # The model being down costs only the line; the turn still finishes and nothing else is sent.
+    world.hermes.sign_off_error = RuntimeError("provider down")
+    await world.http.post(world.url(f"/api/sessions/{sid}/messages"), data={"text": "again"}, headers={"Origin": ORIGIN})
+    await next_message(ws, lambda m: m.get("type") == "message.complete")
+    try:
+        stray = await next_message(ws, lambda m: m.get("type") == "signoff", timeout=0.3)
+    except TimeoutError:
+        stray = None
+    assert stray is None
+    await ws.close()
+
+
+async def test_the_sign_off_can_be_turned_off_and_moved_to_another_model_from_settings(world):
+    sid = world.hermes.add_session("20261025_121212_eeeeee", "rename", messages=[("user", "rename the job")])
+    await world.sign_up()
+    shown = await (await world.http.get(world.url("/api/signoff"))).json()
+    assert (shown["on"], shown["provider"], shown["model"]) == (True, "auto", "")
+    assert shown["providers"] == [{"provider": "fast", "label": "Fast Co", "models": ["tiny", "small"]}]
+
+    picked = await world.post("/api/signoff", {"provider": "fast", "model": "small"})
+    assert (await picked.json())["model"] == "small"
+    assert world.hermes.sign_off_route == {"provider": "fast", "model": "small"}
+    refused = await world.post("/api/signoff", {"provider": "fast", "model": "huge"})
+    assert refused.status == 400
+    assert world.hermes.sign_off_route == {"provider": "fast", "model": "small"}
+
+    await world.post("/api/signoff", {"on": False})
+    ws = await world.http.ws_connect(world.url("/ws"), headers={"Origin": ORIGIN})
+    await ws.send_json({"watch": sid})
+    await asyncio.sleep(0.05)
+    await world.http.post(world.url(f"/api/sessions/{sid}/messages"), data={"text": "go"}, headers={"Origin": ORIGIN})
+    await next_message(ws, lambda m: m.get("type") == "message.complete")
+    try:
+        stray = await next_message(ws, lambda m: m.get("type") == "signoff", timeout=0.3)
+    except TimeoutError:
+        stray = None
+    assert stray is None
+    # Off stays off for every device and across restarts: the server keeps it.
+    assert world.store.meta("signoff") == "off"
+    assert (await (await world.http.get(world.url("/api/signoff"))).json())["on"] is False
+    await ws.close()
+
+
+async def test_nakos_own_sign_off_is_shown_beside_her_and_hidden_from_the_reply(world):
+    sid = world.hermes.add_session("20261025_121212_eeeeee", "fix", messages=[("user", "fix the importer")])
+    world.hermes.reply = "fixed the blank-line bug in the importer.\n\n<signoff>one reader for both, finally</signoff>"
+    world.hermes.sign_off_error = AssertionError("the small model must not run when she wrote her own")
+    await world.sign_up()
+    ws = await world.http.ws_connect(world.url("/ws"), headers={"Origin": ORIGIN})
+    await ws.send_json({"watch": sid})
+    await asyncio.sleep(0.05)
+
+    await world.http.post(world.url(f"/api/sessions/{sid}/messages"), data={"text": "go"}, headers={"Origin": ORIGIN})
+    live = await next_message(ws, lambda m: m.get("type") == "gateway.message")
+    assert live["payload"]["text"] == "fixed the blank-line bug in the importer."
+    said = await next_message(ws, lambda m: m.get("type") == "signoff")
+    assert said["payload"]["text"] == "one reader for both, finally"
+    await ws.close()
+
+    opened = await (await world.http.get(world.url(f"/api/sessions/{sid}"))).json()
+    assert opened["messages"][-1]["text"] == "fixed the blank-line bug in the importer."
+    assert world.alerts[-1][2] == "fixed the blank-line bug in the importer."
+
+
+def test_a_sign_off_still_streaming_in_never_shows():
+    from portal.hub import split_sign_off
+
+    for partial in ("done.\n<", "done.\n<sign", "done.\n<signoff>", "done.\n<signoff>quietly pro"):
+        assert split_sign_off(partial) == ("done.", None)
+    assert split_sign_off("a < b and c") == ("a < b and c", None)
+
+
+async def test_the_sign_off_is_about_the_saved_reply_even_when_its_send_lands_late(world):
+    sid = world.hermes.add_session("20261025_131313_ffffff", "late", messages=[("user", "earlier"), ("assistant", "an older reply")])
+    world.hermes.reply = "the new reply"
+    world.hermes.send_late = True
+    await world.sign_up()
+    ws = await world.http.ws_connect(world.url("/ws"), headers={"Origin": ORIGIN})
+    await ws.send_json({"watch": sid})
+    await asyncio.sleep(0.05)
+    await world.http.post(world.url(f"/api/sessions/{sid}/messages"), data={"text": "go"}, headers={"Origin": ORIGIN})
+    said = await next_message(ws, lambda m: m.get("type") == "signoff")
+    assert said["payload"]["text"] == "proud of: the new reply"
+    await ws.close()
diff --git a/plugins/nako-portal/tests/test_local_api.py b/plugins/nako-portal/tests/test_local_api.py
