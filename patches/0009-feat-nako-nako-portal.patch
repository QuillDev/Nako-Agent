diff --git a/plugins/nako-portal/web/src/lib/environments.ts b/plugins/nako-portal/web/src/lib/environments.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0aada612988da3752cccddefc8fbe849ea1f2dad
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/environments.ts
@@ -0,0 +1,111 @@
+import { useEffect, useSyncExternalStore } from "react"
+import { d, type Infer } from "@/lib/decode"
+import { api } from "@/lib/api"
+
+// What the owner's environments command reports (dashboard/portal/environments.py), shared by the
+// sidebar row and the page.
+const Link = d.object({ label: d.string(), url: d.string() })
+const Environment = d.object({
+  name: d.string(),
+  status: d.enum(["running", "partial", "stopped"]),
+  detail: d.string().optional(),
+  session: d.string().optional(),
+  memory: d.number().optional(),
+  links: d.array(Link),
+})
+export const Environments = d.object({
+  title: d.string(),
+  environments: d.array(Environment),
+  links: d.array(Link),
+  can_stop: d.boolean().default(false),
+})
+export type Environment = Infer<typeof Environment>
+export type Environments = Infer<typeof Environments>
+
+export const STATUS_DOT: Record<Environment["status"], string> = {
+  running: "bg-emerald-500",
+  partial: "bg-amber-500",
+  stopped: "bg-muted-foreground/40",
+}
+
+type State = {
+  data: Environments | null
+  error: string
+  stopping: ReadonlySet<string>
+  stopErrors: Readonly<Record<string, string>>
+}
+
+let current: State = { data: null, error: "", stopping: new Set(), stopErrors: {} }
+const listeners = new Set<() => void>()
+let loading: Promise<void> | null = null
+let fetchSeq = 0
+
+function set(next: State) {
+  current = next
+  for (const listener of listeners) listener()
+}
+
+export function loadEnvironments(fresh = false): Promise<void> {
+  if (!fresh && loading) return loading
+  const seq = ++fetchSeq
+  const promise = api<unknown>("/api/environments")
+    .then(
+      raw => {
+        if (seq < fetchSeq) return
+        const data = Environments.parse(raw)
+        const live = new Set(data.environments.filter(env => env.status !== "stopped").map(env => env.name))
+        const stopErrors = Object.fromEntries(Object.entries(current.stopErrors).filter(([name]) => live.has(name)))
+        set({ ...current, data, error: "", stopErrors })
+      },
+      (error: unknown) => {
+        if (seq < fetchSeq) return
+        set({ ...current, error: error instanceof Error ? error.message : String(error) })
+      },
+    )
+    .finally(() => {
+      if (loading === promise) loading = null
+    })
+  loading = promise
+  return promise
+}
+
+/** Run the owner's stop command for one environment in the background, then refresh the list. */
+export async function stopEnvironment(name: string): Promise<void> {
+  if (current.stopping.has(name)) return
+  const next = new Set(current.stopping)
+  next.add(name)
+  const { [name]: _, ...restErrors } = current.stopErrors
+  set({ ...current, stopping: next, stopErrors: restErrors })
+  try {
+    await api(`/api/environments/${encodeURIComponent(name)}/stop`, { method: "POST" })
+    await loadEnvironments(true)
+    while (loading) await loading
+  } catch (error: unknown) {
+    const message = error instanceof Error ? error.message : String(error)
+    set({ ...current, stopErrors: { ...current.stopErrors, [name]: message } })
+  } finally {
+    const after = new Set(current.stopping)
+    after.delete(name)
+    set({ ...current, stopping: after })
+  }
+}
+
+/** The last read, refreshed on mount and every `every` ms while something shows it. */
+export function useEnvironments(enabled: boolean, every = 30_000): State {
+  const state = useSyncExternalStore(
+    listener => {
+      listeners.add(listener)
+      return () => listeners.delete(listener)
+    },
+    () => current,
+  )
+  useEffect(() => {
+    if (!enabled) return
+    void loadEnvironments()
+    const timer = setInterval(() => {
+      if (document.visibilityState === "visible") void loadEnvironments()
+    }, every)
+    return () => clearInterval(timer)
+  }, [enabled, every])
+  return state
+}
diff --git a/plugins/nako-portal/web/src/lib/fresh-build.ts b/plugins/nako-portal/web/src/lib/fresh-build.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e2ad788d1f7e5d268d1e602ee269306b1862b80b
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/fresh-build.ts
@@ -0,0 +1,55 @@
+import { reloadPending } from "./reload-state"
+
+// Long-lived pages (the apps' floating panels, a tab left open for days) keep the bundle they first
+// loaded, so a deploy never reaches them and new kinds of cards show as unanswerable. Whenever the
+// page comes back into view, and now and then while it's up, compare our bundle with the one the
+// server hands out and reload onto the new one. Text drafts live in localStorage; wait for unsaved attachments, submissions,
+// and half-typed secrets before reloading.
+
+const BUNDLE = /\/assets\/index-[\w-]+\.js/
+/** Don't ask the server more often than this, however many triggers fire. */
+const QUIET = 30_000
+const EVERY = 5 * 60_000
+
+/** The bundle this page runs, or null in the dev server (no hashed bundle, nothing to compare). */
+export function loadedBundle(doc: Document = document): string | null {
+  for (const script of doc.querySelectorAll<HTMLScriptElement>("script[type=module][src]")) {
+    const match = new URL(script.src, location.href).pathname.match(BUNDLE)
+    if (match) return match[0]
+  }
+  return null
+}
+
+/** The bundle named in a served index.html, or null when it names none. */
+export const servedBundle = (html: string): string | null => html.match(BUNDLE)?.[0] ?? null
+
+/** A secret typed into a request card isn't saved anywhere, so a reload would throw it away. */
+function typingSecret(): boolean {
+  return [...document.querySelectorAll<HTMLInputElement>("[data-secret-request] input")].some(input => input.value)
+}
+
+let last = 0
+
+/** Reload onto the server's current bundle if ours is older. `now` skips the quiet period. */
+export async function checkBuild(now = false): Promise<void> {
+  const ours = loadedBundle()
+  if (!ours || (!now && Date.now() - last < QUIET)) return
+  last = Date.now()
+  try {
+    const response = await fetch("/", { cache: "no-store", credentials: "same-origin" })
+    if (!response.ok) return
+    const theirs = servedBundle(await response.text())
+    if (theirs && theirs !== ours && !typingSecret() && !reloadPending()) location.reload()
+  } catch {
+    // Offline or mid-restart: the next trigger tries again.
+  }
+}
+
+if (loadedBundle()) {
+  const check = () => document.visibilityState === "visible" && void checkBuild()
+  document.addEventListener("visibilitychange", check)
+  window.addEventListener("focus", check)
+  // The Android panel reopens by moving the hash to the chat it shows.
+  window.addEventListener("hashchange", check)
+  setInterval(check, EVERY)
+}
diff --git a/plugins/nako-portal/web/src/lib/hearts.ts b/plugins/nako-portal/web/src/lib/hearts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..89f6170ccda0e4e6d50e4952319956bd2596d7ff
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/hearts.ts
@@ -0,0 +1,47 @@
+const THANKS = /\b(thanks|thank\s*you)\b/i
+
+export function saysThanks(text: string): boolean {
+  return THANKS.test(text)
+}
+
+const HEART =
+  '<svg viewBox="0 0 24 24" width="100%" height="100%" aria-hidden="true"><path fill="currentColor" d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.1 0 3.6 1.2 4.4 2.6.8-1.4 2.3-2.6 4.4-2.6 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z"/></svg>'
+
+// A short burst of hearts floating up from the composer.
+export function burstHearts(origin?: Element | null) {
+  if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return
+  const box = origin?.getBoundingClientRect()
+  const left = box ? box.left : 0
+  const width = box ? box.width : window.innerWidth
+  const y = box ? box.top : window.innerHeight - 80
+  // One heart per ~32px, spaced evenly across the composer with a little jitter.
+  const count = Math.max(8, Math.min(28, Math.round(width / 32)))
+  const slot = width / count
+
+  const layer = document.createElement("div")
+  layer.className = "hearts-layer"
+  let longest = 0
+  for (let i = 0; i < count; i++) {
+    const heart = document.createElement("span")
+    heart.className = "heart"
+    heart.innerHTML = HEART
+    const size = 14 + Math.random() * 14
+    const duration = 1400 + Math.random() * 1000
+    const delay = Math.random() * 400
+    longest = Math.max(longest, duration + delay)
+    Object.assign(heart.style, {
+      left: `${Math.min(Math.max(left + slot * (i + 0.2 + Math.random() * 0.6) - size / 2, left), left + width - size)}px`,
+      top: `${y - size}px`,
+      width: `${size}px`,
+      height: `${size}px`,
+      animationDuration: `${duration}ms`,
+      animationDelay: `${delay}ms`,
+    })
+    heart.style.setProperty("--dx", `${(Math.random() - 0.5) * 40}px`)
+    heart.style.setProperty("--rise", `${-(120 + Math.random() * 180)}px`)
+    heart.style.setProperty("--rot", `${(Math.random() - 0.5) * 40}deg`)
+    layer.appendChild(heart)
+  }
+  document.body.appendChild(layer)
+  window.setTimeout(() => layer.remove(), longest + 100)
+}
diff --git a/plugins/nako-portal/web/src/lib/id.ts b/plugins/nako-portal/web/src/lib/id.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b49d5bffd6a7787cbe2e7f98697c89cf521a8b61
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/id.ts
@@ -0,0 +1,11 @@
+/** Opaque client IDs for attachments and presets, including older/insecure webviews. */
+export function id(): string {
+  if (globalThis.crypto?.randomUUID) return globalThis.crypto.randomUUID()
+  const bytes = new Uint8Array(16)
+  if (globalThis.crypto?.getRandomValues) globalThis.crypto.getRandomValues(bytes)
+  else for (let i = 0; i < bytes.length; i++) bytes[i] = Math.floor(Math.random() * 256)
+  bytes[6] = (bytes[6] & 0x0f) | 0x40
+  bytes[8] = (bytes[8] & 0x3f) | 0x80
+  const hex = Array.from(bytes, byte => byte.toString(16).padStart(2, "0")).join("")
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`
+}
diff --git a/plugins/nako-portal/web/src/lib/machine-load.ts b/plugins/nako-portal/web/src/lib/machine-load.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0e114ff2be0ae9d4b660e318fab53dee1324cb4d
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/machine-load.ts
@@ -0,0 +1,71 @@
+import { useEffect, useSyncExternalStore } from "react"
+import { d, type Infer } from "@/lib/decode"
+import { api } from "@/lib/api"
+
+// Memory and CPU use of the machine the portal runs on (dashboard/portal/machine_load.py).
+export const MachineLoad = d.object({
+  memory: d.object({ used: d.number(), total: d.number(), percent: d.number() }),
+  cpu: d.object({ percent: d.number().nullable() }),
+  warn_at: d.number(),
+})
+export type MachineLoad = Infer<typeof MachineLoad>
+
+// Past this, the warning turns from amber to red.
+export const CRITICAL_AT = 90
+
+let current: MachineLoad | null = null
+const listeners = new Set<() => void>()
+let loading: Promise<void> | null = null
+
+function load(): Promise<void> {
+  loading ??= api<unknown>("/api/machine-load")
+    .then(
+      raw => {
+        current = MachineLoad.parse(raw)
+        for (const listener of listeners) listener()
+      },
+      () => {},
+    )
+    .finally(() => {
+      loading = null
+    })
+  return loading
+}
+
+/** The latest reading, refreshed every `every` ms while the page is visible. */
+export function useMachineLoad(enabled: boolean, every = 15_000): MachineLoad | null {
+  const state = useSyncExternalStore(
+    listener => {
+      listeners.add(listener)
+      return () => listeners.delete(listener)
+    },
+    () => current,
+  )
+  useEffect(() => {
+    if (!enabled) return
+    void load()
+    const timer = setInterval(() => {
+      if (document.visibilityState === "visible") void load()
+    }, every)
+    const visible = () => document.visibilityState === "visible" && void load()
+    document.addEventListener("visibilitychange", visible)
+    return () => {
+      clearInterval(timer)
+      document.removeEventListener("visibilitychange", visible)
+    }
+  }, [enabled, every])
+  return enabled ? state : null
+}
+
+/** The higher of memory and CPU when it's at or past the warning line, else null. */
+export function loadWarning(load: MachineLoad | null): { label: string; percent: number } | null {
+  if (!load) return null
+  const memory = { label: "RAM", percent: load.memory.percent }
+  const cpu = { label: "CPU", percent: load.cpu.percent ?? 0 }
+  const high = cpu.percent > memory.percent ? cpu : memory
+  return high.percent >= load.warn_at ? high : null
+}
+
+export function gigabytes(bytes: number): string {
+  return `${(bytes / 1024 ** 3).toFixed(1)} GB`
+}
diff --git a/plugins/nako-portal/web/src/lib/markdown.ts b/plugins/nako-portal/web/src/lib/markdown.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4f99188f1f6025a31c712b56d963eeacfd948c2a
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/markdown.ts
@@ -0,0 +1,25 @@
+import { useEffect, useSyncExternalStore } from "react"
+import { retryableLoader } from "./retryable-loader"
+
+type Markdown = typeof import("streamdown") & { plugins: import("streamdown").PluginConfig }
+
+// Code highlighting rides in the same chunk; Shiki fetches each language's grammar on first use.
+const loader = retryableLoader<Markdown>(async () => {
+  const [markdown, { code }] = await Promise.all([import("streamdown"), import("@streamdown/code")])
+  return { ...markdown, plugins: { code } }
+})
+
+/** Start only after sign-in (or when a Markdown body is actually mounted). */
+export const loadMarkdown = loader.load
+export const retryMarkdown = loader.load
+export const useMarkdownError = () => useSyncExternalStore(loader.subscribe, loader.error)
+
+/** The renderer once it's in, for code that only runs on rendered Markdown (a table's copy button). */
+export const loadedMarkdown = loader.get
+
+/** The renderer, or null for the moment it's still loading. */
+export const useMarkdown = () => {
+  // Newly mounted plain-text replies must not restart a failed import in a loop.
+  useEffect(() => { if (!loader.error()) void loadMarkdown().catch(() => {}) }, [])
+  return useSyncExternalStore(loader.subscribe, loadedMarkdown)
+}
diff --git a/plugins/nako-portal/web/src/lib/mcp.ts b/plugins/nako-portal/web/src/lib/mcp.ts
