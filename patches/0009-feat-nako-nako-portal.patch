+async def test_the_sticker_shows_the_chats_working_and_the_ones_finished_unseen(world):
+    a = world.hermes.add_session("20261101_010000_aaaaaa", "deploy")
+    b = world.hermes.add_session("20261101_020000_bbbbbb", "tests")
