--- /dev/null
+++ b/plugins/nako-portal/tests/test_model_picks.py
@@ -0,0 +1,69 @@
+"""Model presets and starred models are kept by the portal server, so a cleared browser, a
+reinstalled app or a second device still has them."""
+
+import aiohttp
+import pytest
+from conftest import ORIGIN
+from portal.store import Store
+
+FAST = {"id": "p1", "name": "Quick", "icon": "🐇", "pick": {"provider": "fast", "model": "small", "effort": "low", "speed": "fast"}}
+DEEP = {"id": "p2", "name": "Deep", "icon": "", "pick": {"provider": "fast", "model": "small", "effort": "high", "speed": ""}}
+
+
+@pytest.mark.parametrize("path, body", [
+    ("presets", []),
+    ("presets", {**FAST, "pick": []}),
+    ("favorites", []),
+])
+async def test_wrong_json_types_are_validation_errors(world, path, body):
+    await world.sign_up()
+    response = await world.http.post(world.url(f"/api/model-picks/{path}"), json=body, headers={"Origin": ORIGIN})
+    assert response.status == 400
+    assert "error" in await response.json()
+    assert await read(world) == {"presets": [], "favorites": []}
+
+
+async def read(world, http=None):
+    return await (await (http or world.http).get(world.url("/api/model-picks"))).json()
+
+
+async def test_saved_presets_and_stars_outlive_the_browser_and_a_restart(world):
+    await world.sign_up()
+    await world.post("/api/model-picks/presets", FAST)
+    await world.post("/api/model-picks/presets", DEEP)
+    await world.post("/api/model-picks/presets", {**FAST, "name": "Quicker"})
+    await world.post("/api/model-picks/favorites", {"provider": "fast", "model": "tiny"})
+    await world.post("/api/model-picks/favorites", {"provider": "fast", "model": "small", "effort": "high", "speed": ""})
+
+    # A browser with none of the first one's storage, signed in with the same passkey.
+    async with aiohttp.ClientSession(cookie_jar=aiohttp.CookieJar(unsafe=True)) as other:
+        world.http, first = other, world.http
+        await world.sign_up()
+        seen = await read(world, other)
+        world.http = first
+    assert [(p["id"], p["name"]) for p in seen["presets"]] == [("p1", "Quicker"), ("p2", "Deep")]
+    assert seen["favorites"] == [
+        {"provider": "fast", "model": "tiny"},
+        {"provider": "fast", "model": "small", "effort": "high", "speed": ""},
+    ]
+    assert Store(world.store.path).model_picks() == seen
+
+
+async def test_a_star_toggles_off_and_a_removed_preset_is_gone(world):
+    await world.sign_up()
+    await world.post("/api/model-picks/presets", FAST)
+    await world.post("/api/model-picks/favorites", {"provider": "fast", "model": "tiny"})
+    await world.post("/api/model-picks/favorites", {"provider": "fast", "model": "tiny"})
+    await world.post("/api/model-picks/presets/p1/remove")
+    assert await read(world) == {"presets": [], "favorites": []}
+
+
+async def test_only_the_signed_in_owner_reads_or_writes_them_and_bad_picks_are_refused(world):
+    assert (await world.http.get(world.url("/api/model-picks"))).status == 401
+    assert (await world.post("/api/model-picks/presets", FAST)).status == 401
+    await world.sign_up()
+    nameless = await world.post("/api/model-picks/presets", {**FAST, "name": "  "})
+    assert nameless.status == 400
+    no_model = await world.post("/api/model-picks/favorites", {"provider": "fast"})
+    assert no_model.status == 400
+    assert await read(world) == {"presets": [], "favorites": []}
diff --git a/plugins/nako-portal/tests/test_offline.py b/plugins/nako-portal/tests/test_offline.py
new file mode 100644
index 0000000000000000000000000000000000000000..78153af54757bb5946ec76050f90ec8653a741e6
--- /dev/null
+++ b/plugins/nako-portal/tests/test_offline.py
@@ -0,0 +1,177 @@
+"""Offline SQLite transcript projection, lineage, tool-result merging, and multi-profile reads."""
+
+from __future__ import annotations
+
+import json
+import sqlite3
+import sys
+from pathlib import Path
+
+import pytest
+from portal.offline import RESULT_CHARS, Offline, raw_thread, with_results
+
+
+def _create_db(home: Path, *, legacy: bool = False) -> sqlite3.Connection:
+    home.mkdir(parents=True, exist_ok=True)
+    db = sqlite3.connect(home / "state.db")
+    db.execute(
+        "CREATE TABLE sessions (id TEXT PRIMARY KEY, source TEXT, title TEXT, chat_id TEXT, parent_session_id TEXT, ended_at REAL, archived INTEGER)"
+    )
+    if legacy:
+        db.execute(
+            "CREATE TABLE messages (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT, role TEXT, content TEXT, tool_call_id TEXT, tool_calls TEXT, tool_name TEXT, timestamp REAL)"
+        )
+    else:
+        db.execute(
+            "CREATE TABLE messages (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT, role TEXT, content TEXT, tool_call_id TEXT, tool_calls TEXT, tool_name TEXT, timestamp REAL, display_kind TEXT, active INTEGER DEFAULT 1)"
+        )
+    return db
+
+
+def test_raw_thread_follows_compaction_lineage_and_filters_hidden_or_inactive(tmp_path):
+    db = _create_db(tmp_path)
+    db.execute("INSERT INTO sessions VALUES ('s1', 'portal', 'Old title', 'chat-1', NULL, NULL, 0)")
+    db.execute("INSERT INTO sessions VALUES ('s2', 'portal', 'Current title', 'chat-1', 's1', NULL, 0)")
+    db.executemany(
+        "INSERT INTO messages (session_id, role, content, tool_call_id, tool_calls, tool_name, timestamp, display_kind, active) VALUES (?,?,?,?,?,?,?,?,?)",
+        [
+            ("s1", "user", "first question", None, None, None, 100.0, None, 1),
+            ("s1", "assistant", "hidden note", None, None, None, 101.0, "hidden", 1),
+            ("s1", "assistant", "retracted", None, None, None, 102.0, None, 0),
+            ("s1", "assistant", "first answer", None, None, None, 103.0, None, 1),
+            ("s2", "user", "   ", None, None, None, 104.0, None, 1),
+            ("s2", "user", "follow up", None, None, None, 105.0, None, 1),
+            ("s2", "assistant", "final answer", None, None, None, 106.0, None, 1),
+        ],
+    )
+    db.commit()
+    db.close()
+
+    thread = raw_thread(tmp_path, "s2")
+    assert thread["title"] == "Current title"
+    assert [(m["role"], m["text"]) for m in thread["messages"]] == [
+        ("user", "first question"),
+        ("assistant", "first answer"),
+        ("user", "follow up"),
+        ("assistant", "final answer"),
+    ]
+
+
+@pytest.mark.parametrize("visible", [(0, 0), (0, 1), (1, 0), (1, 1)])
+def test_compacted_notifications_keep_their_original_senders(tmp_path, visible):
+    from portal.hub import _as_notification
+
+    db = _create_db(tmp_path)
+    db.execute("ALTER TABLE messages ADD COLUMN message_uid TEXT")
+    db.execute("ALTER TABLE messages ADD COLUMN absorbed_message_uids TEXT")
+    db.execute("ALTER TABLE messages ADD COLUMN display_metadata TEXT")
+    db.execute("INSERT INTO sessions VALUES ('s', 'portal', 'Notifications', 'inbox', NULL, NULL, 0)")
+    alert = '[Cron delivery: build]\nfailed\n\nsee the report'
+    ask = 'which build?\n\ncan you check?'
+    db.executemany(
+        "INSERT INTO messages (session_id, role, content, timestamp, active, message_uid, absorbed_message_uids) "
+        "VALUES ('s', 'user', ?, ?, ?, ?, ?)",
+        [(alert, 1, visible[0], 'notice', None), (ask, 2, visible[1], 'ask', None),
+         (alert + '\n\n' + ask, 3, 1, 'notice', '["ask"]'),
+         ('only surviving text', 4, 1, 'other', '["missing"]')],
+    )
+    db.commit()
+    db.close()
+
+    messages = [_as_notification(m) for m in raw_thread(tmp_path, 's')['messages']]
+    assert [(m['role'], m['text'], m['timestamp']) for m in messages] == [
+        ('assistant', 'failed\n\nsee the report', 1), ('user', ask, 2), ('user', 'only surviving text', 4),
+    ]
+
+
+def test_raw_thread_handles_cyclic_lineage_and_legacy_schema(tmp_path):
+    db = _create_db(tmp_path, legacy=True)
+    db.execute("INSERT INTO sessions VALUES ('a', 'portal', 'Loop', 'c', 'b', NULL, 0)")
+    db.execute("INSERT INTO sessions VALUES ('b', 'portal', 'Loop', 'c', 'a', NULL, 0)")
+    db.execute(
+        "INSERT INTO messages (session_id, role, content, timestamp) VALUES ('a', 'user', 'hello', 10.0)"
+    )
+    db.commit()
+    db.close()
+
+    thread = raw_thread(tmp_path, "a")
+    assert [m["text"] for m in thread["messages"]] == ["hello"]
+
+
+def test_raw_thread_extracts_tool_contexts_tolerates_bad_args_and_attaches_results(tmp_path):
+    db = _create_db(tmp_path)
+    db.execute("INSERT INTO sessions VALUES ('s1', 'portal', 'Tools', 'chat-1', NULL, NULL, 0)")
+    calls = json.dumps([
+        {"id": "c1", "function": {"name": "terminal", "arguments": json.dumps({"command": "pytest -q\nsecond line"})}},
+        {"id": "c2", "function": {"name": "custom", "arguments": json.dumps({"note": "fallback value"})}},
+        {"id": "c3", "function": {"name": "broken", "arguments": "{not-json"}},
+    ])
+    db.executemany(
+        "INSERT INTO messages (session_id, role, content, tool_call_id, tool_calls, tool_name, timestamp, display_kind, active) VALUES (?,?,?,?,?,?,?,?,?)",
+        [
+            ("s1", "assistant", "", None, calls, None, 100.0, None, 1),
+            ("s1", "tool", "ok " + "x" * (RESULT_CHARS + 50), "c1", None, "terminal", 101.0, None, 1),
+            ("s1", "tool", "done", "c2", None, "custom", 102.0, None, 1),
+            ("s1", "tool", "err", "c3", None, "broken", 103.0, None, 1),
+        ],
+    )
+    db.commit()
+    db.close()
+
+    msgs = raw_thread(tmp_path, "s1")["messages"]
+    assert [(m["name"], m["context"]) for m in msgs] == [
+        ("terminal", "pytest -q"),
+        ("custom", "fallback value"),
+        ("broken", ""),
+    ]
+    assert len(msgs[0]["result"]) == RESULT_CHARS
+    assert msgs[1]["result"] == "done"
+    assert msgs[2]["result"] == "err"
+
+
+def test_with_results_serializes_non_strings_and_preserves_existing_results():
+    projected = [
+        {"role": "tool", "tool_call_id": "c1", "name": "t1"},
+        {"role": "tool", "tool_call_id": "c2", "name": "t2", "result": "already there"},
+    ]
+    history = [
+        {"role": "tool", "tool_call_id": "c1", "content": {"count": 3}},
+        {"role": "tool", "tool_call_id": "c2", "content": "ignored"},
+    ]
+    out = with_results(projected, history)
+    assert json.loads(out[0]["result"]) == {"count": 3}
+    assert out[1]["result"] == "already there"
+
+
+def test_offline_reads_across_profiles_and_falls_back_on_projection_failure(tmp_path):
+    root_db = _create_db(tmp_path)
+    root_db.execute("INSERT INTO sessions VALUES ('root-chat', 'portal', 'Root', 'c-root', NULL, NULL, 0)")
+    root_db.execute("INSERT INTO messages (session_id, role, content, timestamp) VALUES ('root-chat', 'user', 'shared needle', 100.0)")
+    root_db.commit()
+    root_db.close()
+
+    work = tmp_path / "profiles" / "work"
+    work_db = _create_db(work)
+    work_db.execute("INSERT INTO sessions VALUES ('work-chat', 'portal', 'Work', 'c-work', NULL, NULL, 0)")
+    work_db.execute("INSERT INTO sessions VALUES ('slack-chat', 'slack', 'Slack', 'c-slack', NULL, NULL, 0)")
+    work_db.execute("INSERT INTO messages (session_id, role, content, timestamp) VALUES ('work-chat', 'user', 'shared needle newer', 200.0)")
+    work_db.commit()
+    work_db.close()
+
+    # Projection child fails when Hermes isn't importable -> cleanly falls back to raw_thread.
+    offline = Offline(tmp_path, python=sys.executable, projection=True)
+
+    assert offline.chat_of("work-chat") == "c-work"
+    assert offline.chat_of("slack-chat") is None
+    assert offline.title_of("work-chat") == "Work"
+    assert offline.title_of("slack-chat") == "Slack"
+    assert offline.title_of("missing") is None
+    assert offline.thread("slack-chat") is None
+
+    # Projection child fails (no Hermes installed) -> cleanly falls back to raw_thread.
+    thread = offline.thread("work-chat")
+    assert thread["title"] == "Work"
+    assert [m["text"] for m in thread["messages"]] == ["shared needle newer"]
+
+    hits = offline.search_sessions("shared needle")
+    assert [h["id"] for h in hits] == ["work-chat", "root-chat"]
diff --git a/plugins/nako-portal/tests/test_outside.py b/plugins/nako-portal/tests/test_outside.py
new file mode 100644
index 0000000000000000000000000000000000000000..94246adcddf9cb46ba2e55d623dec5a95a9a911e
--- /dev/null
+++ b/plugins/nako-portal/tests/test_outside.py
@@ -0,0 +1,123 @@
+"""Sessions that came in another way (Slack, Discord, cron, the CLI): the app lists them, shows
+which are running a turn, and opens them read-only."""
+
+from __future__ import annotations
+
+import pytest
+from conftest import ORIGIN, next_message
+
+pytestmark = pytest.mark.asyncio
+
+SLACK = "20261116_090000_slack1"
+CRON = "local-cron0000000000000000"
+DISCORD = "20261116_080000_disc01"
+
+
+def _seed(hermes):
+    hermes.add_session("20261116_100000_portal", "Trip budget", messages=[("user", "hi"), ("assistant", "hello")])
+    hermes.add_session(DISCORD, "Book club picks", source="discord", last_active=1_000, messages=[("user", "picks?"), ("assistant", "three of them")])
+    hermes.add_session(SLACK, "Shipping export", source="slack", last_active=3_000, messages=[("user", "is the export short?"), ("assistant", "4 orders moved to tonight")])
+    hermes.add_session(CRON, "Morning digest", source="cron", last_active=2_000, messages=[("user", "digest"), ("assistant", "five links")])
+    # A cron run with nothing saved yet still lists; a turn's helper session doesn't.
+    hermes.add_session("local-empty000000000000000", "Inbox check", source="cron", last_active=4_000)
+    hermes.add_session("20261116_110000_tool01", "helper", source="tool", last_active=5_000, messages=[("user", "x")])
+
+
+async def _outside(world, query=""):
+    response = await world.http.get(world.url(f"/api/outside{query}"))
+    assert response.status == 200, await response.text()
+    return [(row["title"], row["source"], row["running"]) for row in await response.json()]
+
+
+async def test_sessions_from_elsewhere_list_latest_first_and_stay_out_of_the_sidebar(world):
+    await world.sign_up()
+    _seed(world.hermes)
+
+    assert await _outside(world) == [
+        ("Inbox check", "cron", False),
+        ("Shipping export", "slack", False),
+        ("Morning digest", "cron", False),
+        ("Book club picks", "discord", False),
+    ]
+    assert await _outside(world, "?source=cron") == [("Inbox check", "cron", False), ("Morning digest", "cron", False)]
+    assert await _outside(world, "?offset=3") == [("Book club picks", "discord", False)]
+
+    sidebar = await (await world.http.get(world.url("/api/sessions"))).json()
+    assert [row["title"] for row in sidebar] == ["Trip budget"]
+
+
+async def test_the_app_hears_which_sessions_elsewhere_are_running_without_any_alert(world):
+    await world.sign_up()
+    _seed(world.hermes)
+    await world.hermes.hub.outside({"sources": ["cron", "discord", "slack"], "running": []})
+    sticker = world.hub.sticker()
+
+    ws = await world.http.ws_connect(world.url("/ws"), headers={"Origin": ORIGIN})
+    joined = await next_message(ws, lambda m: m.get("kind") == "outside")
+    assert joined == {"kind": "outside", "sources": ["cron", "discord", "slack"], "running": []}
+
+    await world.hermes.hub.outside({"sources": ["cron", "discord", "slack"], "running": [SLACK]})
+    started = await next_message(ws, lambda m: m.get("kind") == "outside")
+    assert started["running"] == [SLACK]
+    assert await _outside(world) == [
+        ("Inbox check", "cron", False),
+        ("Shipping export", "slack", True),
+        ("Morning digest", "cron", False),
+        ("Book club picks", "discord", False),
+    ]
+
+    await world.hermes.hub.outside({"sources": ["cron", "discord", "slack"], "running": []})
+    assert (await next_message(ws, lambda m: m.get("kind") == "outside"))["running"] == []
+    # Watching isn't being told: nothing pinged, and nothing counts toward the sticker.
+    assert world.alerts == []
+    assert world.hub.sticker() == sticker
+    assert SLACK not in world.hub.status
+    await ws.close()
+
+
+async def test_a_gateway_going_away_stops_showing_sessions_elsewhere_as_running(world):
+    await world.sign_up()
+    _seed(world.hermes)
+    await world.hermes.hub.outside({"sources": ["slack"], "running": [SLACK]})
+    ws = await world.http.ws_connect(world.url("/ws"), headers={"Origin": ORIGIN})
+    assert (await next_message(ws, lambda m: m.get("kind") == "outside"))["running"] == [SLACK]
+
+    await world.gateway.stop(world.hub)
+    gone = await next_message(ws, lambda m: m.get("kind") == "outside")
+    assert gone == {"kind": "outside", "sources": ["slack"], "running": []}
+    await ws.close()
+
+
+async def test_a_session_from_elsewhere_opens_read_only(world):
+    await world.sign_up()
+    _seed(world.hermes)
+
+    opened = await (await world.http.get(world.url(f"/api/sessions/{SLACK}"))).json()
+    assert opened["source"] == "slack"
+    assert [m["text"] for m in opened["messages"]] == ["is the export short?", "4 orders moved to tonight"]
+    portal = await (await world.http.get(world.url("/api/sessions/20261116_100000_portal"))).json()
+    assert portal["source"] == "portal"
+
+    for path, body in (
+        ("messages", None),
+        ("stop", None),
+        ("title", {"title": "mine now"}),
