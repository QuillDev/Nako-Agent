@@ -0,0 +1,68 @@
+:root {
+  color-scheme: dark;
+  --background: #0d0a11;
+  --text: #f3eaef;
+  --muted: #b6a4b1;
+  --primary: #ec4899;
+  --bright: #f472b6;
+  --input: rgb(255 255 255 / 10%);
+  --error: #f87171;
+}
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  min-height: 100vh;
+  display: grid;
+  place-items: center;
+  background: var(--background);
+  color: var(--text);
+  font: 15px Inter, system-ui, sans-serif;
+}
+main { display: flex; flex-direction: column; align-items: center; gap: 16px; width: min(360px, 100vw - 48px); text-align: center; }
+[hidden] { display: none !important; }
+img { width: 96px; height: 96px; border-radius: 50%; outline: 2px solid var(--primary); outline-offset: 4px; }
+h1 { margin: 0; font-size: 26px; font-weight: 600; letter-spacing: -0.01em; }
+form, #unreachable, #starting { display: flex; flex-direction: column; gap: 10px; width: 100%; }
+#starting span { height: 18px; width: 108px; align-self: center; }
+#starting i { height: 36px; }
+#starting > * { background: var(--input); border-radius: 10px; }
+p { margin: 0; color: var(--muted); }
+p.error { color: var(--error); }
+/* Same controls as the portal's own (shadcn Input and Button). */
+input, button {
+  height: 36px;
+  border-radius: 10px;
+  font: inherit;
+  font-size: 14px;
+  transition: border-color 0.15s, box-shadow 0.15s, background-color 0.15s;
+}
+input {
+  padding: 0 12px;
+  border: 1px solid var(--input);
+  background: rgb(255 255 255 / 3%);
+  color: var(--text);
+}
+input::placeholder { color: var(--muted); }
+button {
+  padding: 0 16px;
+  border: 1px solid transparent;
+  background: var(--primary);
+  color: white;
+  font-weight: 500;
+  cursor: pointer;
+}
+button:hover { background: rgb(236 72 153 / 90%); }
+/* A soft ring that hugs the control instead of a second outline around it. */
+input:focus-visible, button:focus-visible { outline: none; border-color: var(--bright); box-shadow: 0 0 0 3px rgb(244 114 182 / 22%); }
+button:disabled { opacity: 0.5; cursor: default; }
+button.quiet { background: transparent; color: var(--muted); }
+button.quiet:hover { color: var(--text); }
+/* The app's own title bar on Windows and Linux: a drag strip with window buttons on the right. */
+#titlebar { position: fixed; inset: 0 0 auto 0; height: 40px; display: flex; justify-content: flex-end; align-items: center; gap: 2px; padding: 0 6px; }
+#titlebar button { width: 32px; height: 28px; padding: 0; display: grid; place-items: center; border-radius: 8px; background: transparent; color: var(--muted); }
+#titlebar button:hover { background: rgb(255 255 255 / 7%); color: var(--text); }
+#titlebar button.close:hover { background: #e81123; color: white; }
+#titlebar svg { width: 10px; height: 10px; fill: none; stroke: currentColor; stroke-width: 1; }
+/* The window has no system title bar on Windows and Linux: these strips move it. */
+[data-tauri-drag-region] { -webkit-app-region: drag; }
+[data-tauri-drag-region] :is(button, input, a) { -webkit-app-region: no-drag; }
diff --git a/plugins/nako-portal/desktop/ui/connect.js b/plugins/nako-portal/desktop/ui/connect.js
new file mode 100644
index 0000000000000000000000000000000000000000..6880fc760368630ec989e09ade77a6144d1d0631
--- /dev/null
+++ b/plugins/nako-portal/desktop/ui/connect.js
@@ -0,0 +1,51 @@
+// The app's own first screen: ask for the portal's address, or say it can't be reached.
+const { invoke } = window.nakoDesktop
+const $ = id => document.getElementById(id)
+
+function ask(origin, error) {
+  $("unreachable").hidden = true
+  $("ask").hidden = false
+  $("message").textContent = error || "Portal address"
+  $("message").className = error ? "error" : ""
+  if (origin && !$("address").value) $("address").value = origin
+  $("address").focus()
+}
+
+function unreachable(origin, error) {
+  $("ask").hidden = true
+  $("unreachable").hidden = false
+  $("reason").textContent = error
+  $("retry").onclick = () => connect(origin)
+  $("change").onclick = () => ask(origin)
+}
+
+async function connect(address) {
+  for (const button of document.querySelectorAll("main button")) button.disabled = true
+  try {
+    await invoke("connect", { address })
+  } catch (error) {
+    if ($("unreachable").hidden) ask(null, String(error))
+    else unreachable(address, String(error))
+  } finally {
+    for (const button of document.querySelectorAll("main button")) button.disabled = false
+  }
+}
+
+$("ask").addEventListener("submit", event => {
+  event.preventDefault()
+  connect($("address").value)
+})
+
+if (window.nakoWindow?.controls) {
+  $("titlebar").hidden = false
+  for (const button of document.querySelectorAll("[data-window]")) {
+    button.onclick = () => invoke(`plugin:window|${button.dataset.window}`, { label: "main" })
+  }
+}
+
+const change = new URLSearchParams(location.search).has("change")
+const state = await invoke("start", { change }).catch(error => ({ kind: "ask", error: String(error) }))
+$("starting").hidden = true
+document.querySelector("main").hidden = state.kind === "open"
+if (state.kind === "ask") ask(state.origin, state.error)
+if (state.kind === "unreachable") unreachable(state.origin, state.error)
diff --git a/plugins/nako-portal/desktop/ui/floating.css b/plugins/nako-portal/desktop/ui/floating.css
new file mode 100644
index 0000000000000000000000000000000000000000..a74782a1fd0955b491a5ec873e8a5fa6dc6217b7
--- /dev/null
+++ b/plugins/nako-portal/desktop/ui/floating.css
@@ -0,0 +1,120 @@
+html,
+body {
+  margin: 0;
+  width: 100%;
+  height: 100%;
+  overflow: hidden;
+  background: transparent;
+  user-select: none;
+}
+
+#nako {
+  position: absolute;
+  top: 6px;
+  left: 6px;
+  width: 64px;
+  height: 64px;
+  padding: 0;
+  border: 0;
+  background: none;
+  cursor: grab;
+  outline: none;
+}
+
+#nako:active {
+  cursor: grabbing;
+}
+
+img {
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+  filter: drop-shadow(0 2px 4px rgb(0 0 0 / 0.35));
+  transition: transform 120ms ease-out;
+  pointer-events: none;
+}
+
+#nako:hover img {
+  transform: scale(1.06);
+}
+
+#dot {
+  position: absolute;
+  top: 2px;
+  right: 2px;
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  background: #f472b6;
+  box-shadow: 0 0 0 2px #0d0a11;
+}
+
+#dot[hidden] {
+  display: none;
+}
+
+/* Under her: how many chats are working (pink) and how many finished that you haven't opened (green). */
+#pill {
+  position: absolute;
+  left: 50%;
+  bottom: -14px;
+  transform: translateX(-50%);
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  height: 16px;
+  padding: 0 7px;
+  border-radius: 8px;
+  background: #18181b;
+  color: #ececef;
+  font: 600 10.5px/16px system-ui, sans-serif;
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+  box-shadow: 0 1px 3px rgb(0 0 0 / 0.25), 0 0 0 1px rgb(255 255 255 / 0.12);
+  pointer-events: none;
+}
+
+#pill[hidden],
+#pill [hidden] {
+  display: none;
+}
+
+#pill span {
+  display: inline-flex;
+  align-items: center;
+  gap: 3px;
+}
+
+#pill span::before {
+  content: "";
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+}
+
+#working::before {
+  background: #ec4899;
+  animation: pulse 1.6s ease-in-out infinite;
+}
+
+#finished::before {
+  background: #10b981;
+}
+
+@keyframes pulse {
+  50% {
+    opacity: 0.4;
+  }
+}
+
+@media (prefers-color-scheme: light) {
+  #pill {
+    background: #ffffff;
+    color: #18181b;
+    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2), 0 0 0 1px rgb(0 0 0 / 0.1);
+  }
+
+  #working::before {
+    background: #db2777;
+  }
+}
