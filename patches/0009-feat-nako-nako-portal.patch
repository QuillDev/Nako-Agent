+import { BoxesIcon } from "lucide-react"
+import { Fragment } from "react"
+import { Button } from "@/components/ui/button"
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuSeparator, DropdownMenuTrigger } from "@/components/ui/dropdown-menu"
+import { navigate } from "@/hooks/use-portal"
+import { STATUS_DOT, useEnvironments } from "@/lib/environments"
+import { cn } from "@/lib/utils"
+
+// The chat's own environments (what its command tags with this chat), with their links one tap
+// away; hidden when the chat has none.
+export function ChatEnvironments({ session }: { session: string }) {
+  const { data } = useEnvironments(true)
+  const mine = data?.environments.filter(env => env.session === session && env.status !== "stopped") ?? []
+  if (!data || mine.length === 0) return null
+  const only = mine.length === 1 ? mine[0] : null
+  return (
+    <DropdownMenu>
+      <DropdownMenuTrigger asChild>
+        <Button
+          aria-label={only ? only.name : `${mine.length} ${data.title.toLowerCase()}`}
+          className="max-w-48 gap-1.5 px-2.5 text-muted-foreground text-xs"
+          data-chat-environments
+          size="sm"
+          title={only ? only.name : data.title}
+          variant="ghost"
+        >
+          <BoxesIcon />
+          <span className="hidden truncate sm:inline">{only ? only.name : mine.length}</span>
+        </Button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="end" className="w-[min(16rem,calc(100vw-1rem))] p-1.5 pt-2">
+        {mine.map((env, i) => (
+          <Fragment key={env.name}>
+            {i > 0 && <DropdownMenuSeparator />}
+            <p className="flex items-center gap-2 px-2 pb-1 text-muted-foreground text-xs">
+              <span className={cn("size-1.5 shrink-0 rounded-full", STATUS_DOT[env.status])} />
+              <span className="truncate">{env.name}</span>
+              {env.detail && <span className="truncate">· {env.detail}</span>}
+            </p>
+            {env.links.map(link => (
+              <DropdownMenuItem asChild className="text-xs" key={link.url}>
+                <a href={link.url} rel="noreferrer" target="_blank">
+                  {link.label}
+                </a>
+              </DropdownMenuItem>
+            ))}
+          </Fragment>
+        ))}
+        <DropdownMenuSeparator />
+        <DropdownMenuItem className="text-muted-foreground text-xs" onSelect={() => navigate("#/settings/environments")}>
+          All {data.title.toLowerCase()}
+        </DropdownMenuItem>
+      </DropdownMenuContent>
+    </DropdownMenu>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/chat-find.tsx b/plugins/nako-portal/web/src/components/portal/chat-find.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..144f9e6b8efe7b291f14ead6b40ef7d5c03f1f29
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/chat-find.tsx
@@ -0,0 +1,93 @@
+import { ChevronDownIcon, ChevronUpIcon, SearchIcon, XIcon } from "lucide-react"
+import { type RefObject, useCallback, useEffect, useRef, useState } from "react"
+import { Button } from "@/components/ui/button"
+import { chatFindRanges, nextMatch } from "@/lib/chat-find"
+
+const OPEN = "nako-find-in-chat"
+export function FindInChatButton() {
+  return <Button aria-label="Find in chat" title="Find in chat (Ctrl/⌘ F)" className="text-muted-foreground" size="icon" variant="ghost" onClick={() => window.dispatchEvent(new Event(OPEN))}><SearchIcon /></Button>
+}
+
+export function ChatFind({ root, session }: { root: RefObject<HTMLDivElement | null>; session: string }) {
+  const [open, setOpen] = useState(false)
+  const [query, setQuery] = useState("")
+  const [matches, setMatches] = useState<Range[]>([])
+  const [current, setCurrent] = useState(0)
+  const input = useRef<HTMLInputElement>(null)
+  const previousFocus = useRef<HTMLElement | null>(null)
+  const close = useCallback(() => {
+    setOpen(false)
+    previousFocus.current?.focus()
+  }, [])
+
+  useEffect(() => {
+    const show = () => {
+      if (!input.current) previousFocus.current = document.activeElement as HTMLElement | null
+      setOpen(true)
+      requestAnimationFrame(() => { input.current?.focus(); input.current?.select() })
+    }
+    const onKey = (event: KeyboardEvent) => {
+      if ((event.ctrlKey || event.metaKey) && !event.altKey && event.key.toLowerCase() === "f") {
+        event.preventDefault()
+        show()
+      } else if (event.key === "Escape" && input.current) { event.preventDefault(); close() }
+    }
+    window.addEventListener("keydown", onKey)
+    window.addEventListener(OPEN, show)
+    return () => { window.removeEventListener("keydown", onKey); window.removeEventListener(OPEN, show) }
+  }, [close])
+
+  useEffect(() => {
+    setCurrent(0)
+    if (!open || !root.current) { setMatches([]); return }
+    const element = root.current
+    let frame = 0
+    const update = () => setMatches(chatFindRanges(element, query))
+    update()
+    const observer = new MutationObserver(records => {
+      // Find's own count and controls aren't transcript changes.
+      if (!records.some(record => (record.target instanceof Element ? record.target : record.target.parentElement)?.closest("[data-find-text], [role=log]"))) return
+      cancelAnimationFrame(frame)
+      frame = requestAnimationFrame(update)
+    })
+    observer.observe(element, { childList: true, subtree: true, characterData: true })
+    return () => { observer.disconnect(); cancelAnimationFrame(frame) }
+  }, [open, query, root, session])
+
+  useEffect(() => {
+    const index = Math.max(0, Math.min(current, matches.length - 1))
+    const active = matches[index]
+    // Feature detect both halves of the Custom Highlight API.
+    const registry = typeof CSS !== "undefined" ? CSS.highlights : undefined
+    if (matches.length && registry && typeof Highlight !== "undefined") {
+      registry.set("chat-find", new Highlight(...matches))
+      registry.set("chat-find-current", new Highlight(...(active ? [active] : [])))
+    }
+    if (active) {
+      const element = active.startContainer.parentElement
+      // Range geometry scrolls the matching line, even inside a long reply.
+      const rect = active.getBoundingClientRect()
+      let scrollParent = element
+      while (scrollParent && !(scrollParent.scrollHeight > scrollParent.clientHeight && /auto|scroll/.test(getComputedStyle(scrollParent).overflowY))) scrollParent = scrollParent.parentElement
+      if (scrollParent && rect.height) {
+        const box = scrollParent.getBoundingClientRect()
+        scrollParent.scrollTop += rect.top - box.top - scrollParent.clientHeight / 2
+      } else element?.scrollIntoView({ block: "center" })
+    }
+    return () => { registry?.delete("chat-find"); registry?.delete("chat-find-current") }
+  }, [matches, current])
+
+  if (!open) return null
+  const index = Math.max(0, Math.min(current, matches.length - 1))
+  const move = (direction: number) => setCurrent(() => nextMatch(index, direction, matches.length))
+  return <div role="search" aria-label="Find in chat" className="flex items-center gap-1 border-b px-4 py-1 text-sm">
+    <input ref={input} aria-label="Find in chat" placeholder="Find in chat" className="min-w-0 flex-1 bg-transparent py-1 outline-none" value={query} onChange={event => setQuery(event.target.value)} onKeyDown={event => {
+      if (event.key === "Enter") { event.preventDefault(); move(event.shiftKey ? -1 : 1) }
+      if (event.key === "Escape") { event.preventDefault(); event.stopPropagation(); close() }
+    }} />
+    <span role="status" className="shrink-0 px-2 text-xs text-muted-foreground">{matches.length ? `${index + 1} / ${matches.length}` : "0"}</span>
+    <Button aria-label="Previous match" size="icon" variant="ghost" disabled={!matches.length} onClick={() => move(-1)}><ChevronUpIcon /></Button>
+    <Button aria-label="Next match" size="icon" variant="ghost" disabled={!matches.length} onClick={() => move(1)}><ChevronDownIcon /></Button>
+    <Button aria-label="Close find" size="icon" variant="ghost" onClick={close}><XIcon /></Button>
+  </div>
+}
diff --git a/plugins/nako-portal/web/src/components/portal/chat-search.tsx b/plugins/nako-portal/web/src/components/portal/chat-search.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1bf6062e81ebced9b7a71c05e43ea56f3dd6fbe0
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/chat-search.tsx
@@ -0,0 +1,220 @@
+// Cmd/Ctrl+K or the sidebar's Find row: find a chat by title, archived ones included. Picking an
+// archived chat brings it back to the list and opens it. It grows out of the Find row when that's on
+// screen (input over the row, list unfolding below), else it sits near the top of the window.
+import { ArchiveIcon, BellIcon, GitPullRequestIcon, MessageSquareIcon } from "lucide-react";
+import { LoadingRows } from "./screen-loading";
+import { Dialog as DialogPrimitive } from "radix-ui";
+import { type CSSProperties, memo, useEffect, useMemo, useRef, useState } from "react";
+import {
+  Command,
+  CommandEmpty,
+  CommandGroup,
+  CommandInput,
+  CommandItem,
+  CommandList,
+} from "@/components/ui/command";
+import {
+  Dialog,
+  DialogDescription,
+  DialogOverlay,
+  DialogPortal,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { navigate, type Portal } from "@/hooks/use-portal";
+import { api } from "@/lib/api";
+import { mergeMessageMatches, type MessageMatch } from "@/lib/chat-search";
+import type { SessionRow } from "@/lib/types";
+
+type Archived = Pick<SessionRow, "id" | "title" | "started_at">;
+
+const OPEN = "nako-chat-search";
+export const SEARCH_KEYS = /Mac|iPhone|iPad/.test(navigator.platform)
+  ? "⌘K"
+  : "Ctrl K";
+export const openChatSearch = () => window.dispatchEvent(new Event(OPEN));
+
+const WIDTH = 380;
+
+// Where the box opens: over the sidebar's Find row when it's visible, so the row becomes the input.
+const anchor = (): CSSProperties | null => {
+  const row = document.querySelector("[data-find]");
+  const r = row?.getBoundingClientRect();
+  // A hidden sidebar or closed drawer keeps the row's box, so ask what's actually drawn there.
+  if (!row || !r || !row.contains(document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2)))
+    return null;
+  const width = Math.min(Math.max(WIDTH, r.width + 2), window.innerWidth - r.left - 12);
+  return {
+    top: r.top - 1,
+    left: r.left - 1,
+    width,
+    "--find-row": `${r.width + 2}px`,
+  } as CSSProperties;
+};
+
+const matches = (title: string, query: string) =>
+  !query || title.toLowerCase().includes(query);
+
+export const ChatSearch = memo(function ChatSearch({
+  sessions,
+  unarchive,
+}: Pick<Portal, "sessions" | "unarchive">) {
+  const [open, setOpen] = useState(false);
+  const [query, setQuery] = useState("");
+  const [archived, setArchived] = useState<Archived[] | null>(null);
+  const [at, setAt] = useState<CSSProperties | null>(null);
+  const [results, setResults] = useState<MessageMatch[]>([]);
+  const [searchState, setSearchState] = useState("");
+  const generation = useRef(0);
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (
+        (e.ctrlKey || e.metaKey) &&
+        !e.altKey &&
+        !e.shiftKey &&
+        e.key.toLowerCase() === "k"
+      ) {
+        e.preventDefault();
+        setAt(anchor());
+        setOpen((o) => !o);
+      }
+    };
+    const onOpen = () => {
+      setAt(anchor());
+      setOpen(true);
+    };
+    window.addEventListener("keydown", onKey);
+    window.addEventListener(OPEN, onOpen);
+    return () => {
+      window.removeEventListener("keydown", onKey);
+      window.removeEventListener(OPEN, onOpen);
+    };
+  }, []);
+
+  useEffect(() => {
+    if (!open) return setQuery("");
+    let live = true;
+    setArchived(null);
+    api<Archived[]>("/api/sessions?archived=only")
+      .then((rows) => live && setArchived(rows))
+      .catch(() => live && setArchived([]));
+    return () => {
+      live = false;
+    };
+  }, [open]);
+
+  const q = query.trim().toLowerCase();
+  useEffect(() => {
+    const current = ++generation.current;
+    const controller = new AbortController();
+    setResults([]);
+    setSearchState("");
+    if (!open || q.length < 2) return;
+    setSearchState("Searching messages…");
+    const timer = setTimeout(() => {
+      void api<MessageMatch[]>(`/api/search?q=${encodeURIComponent(q)}`, { signal: controller.signal }).then(rows => {
+        if (current !== generation.current || controller.signal.aborted) return;
+        setResults(rows);
+        setSearchState("");
+      }).catch(() => {
+        if (current === generation.current && !controller.signal.aborted) setSearchState("Message search is unavailable");
+      });
+    }, 180);
+    return () => { ++generation.current; clearTimeout(timer); controller.abort(); };
+  }, [open, q]);
+  const chats = useMemo(
+    () => sessions.filter((s) => matches(s.title, q)),
+    [sessions, q],
+  );
+  const shelved = useMemo(
+    // A chat already in the list isn't shown as archived too (an older server returns every chat here).
+    () => {
+      const listed = new Set(sessions.map((s) => s.id));
+      return (archived ?? []).filter((s) => !listed.has(s.id) && matches(s.title, q));
+    },
+    [archived, sessions, q],
+  );
+
+  const pick = (session: string, wasArchived: boolean) => {
+    setOpen(false);
+    if (wasArchived) unarchive(session);
+    else navigate(`#/c/${session}`);
+  };
+  const messageMatches = mergeMessageMatches(results, [...chats, ...shelved]);
+
+  return (
+    <Dialog onOpenChange={setOpen} open={open}>
+      <DialogPortal>
+        <DialogOverlay className={at ? "bg-transparent" : undefined} />
+        <DialogPrimitive.Content
+          className={
+            at
+              ? "find-pop fixed z-50 overflow-hidden rounded-lg border bg-card shadow-2xl outline-none"
+              : "fixed top-[14vh] left-1/2 z-50 w-[min(380px,calc(100vw-1.5rem))] -translate-x-1/2 overflow-hidden rounded-xl border bg-card shadow-2xl outline-none data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95"
+          }
+          style={at ?? undefined}
+        >
+        <DialogTitle className="sr-only">Search chats</DialogTitle>
+        <DialogDescription className="sr-only">
+          Search chats, archived ones included
+        </DialogDescription>
+        <Command
+          className="bg-transparent **:data-[slot=command-input-wrapper]:h-8 **:data-[slot=command-input-wrapper]:px-2 **:data-[slot=command-input]:h-8 **:data-[slot=command-input]:py-0 **:data-[slot=command-item]:py-1"
+          loop
+          shouldFilter={false}
+        >
+          <CommandInput
+            onValueChange={setQuery}
+            placeholder="Find"
+            value={query}
+          />
+          <CommandList className="h-[min(20rem,55vh)]">
+            {searchState === "Searching messages…" || archived === null ? !chats.length && !shelved.length && <LoadingRows label="Searching chats…" count={3} /> : <CommandEmpty>{searchState || "no chats match"}</CommandEmpty>}
+            {chats.length > 0 && (
+              <CommandGroup heading="chats">
+                {chats.map((s) => (
+                  <CommandItem
+                    key={s.id}
+                    onSelect={() => pick(s.id, false)}
+                    value={`chat:${s.id}`}
+                  >
+                    {s.notifications ? <BellIcon /> : s.reviews ? <GitPullRequestIcon /> : <MessageSquareIcon />}
+                    <span className="min-w-0 flex-1 truncate">{s.title}</span>
+                    {s.machine && <span className="shrink-0 text-xs text-muted-foreground">{s.machine}</span>}
+                  </CommandItem>
+                ))}
+              </CommandGroup>
+            )}
+            {shelved.length > 0 && (
+              <CommandGroup heading="archived">
+                {shelved.map((s) => (
+                  <CommandItem
+                    key={s.id}
+                    onSelect={() => pick(s.id, true)}
+                    value={`archived:${s.id}`}
+                  >
+                    <ArchiveIcon />
+                    <span className="min-w-0 flex-1 truncate text-muted-foreground">
+                      {s.title}
+                    </span>
+                  </CommandItem>
+                ))}
+              </CommandGroup>
+            )}
+            {messageMatches.length > 0 && <CommandGroup heading="messages">
+              {messageMatches.map(s => <CommandItem key={s.id} value={`message:${s.id}`} onSelect={() => pick(s.id, s.archived)}>
+                {s.archived ? <ArchiveIcon /> : <MessageSquareIcon />}
+                <span className="flex min-w-0 flex-1 flex-col">
+                  <span className="truncate">{s.title}</span>
+                  <span className="truncate text-xs text-muted-foreground">{s.snippet}</span>
+                </span>
+              </CommandItem>)}
+            </CommandGroup>}
+            {searchState && (chats.length > 0 || shelved.length > 0) && <p role="status" className="px-2 py-1 text-xs text-muted-foreground">{searchState}</p>}
+          </CommandList>
+        </Command>
+        </DialogPrimitive.Content>
+      </DialogPortal>
+    </Dialog>
+  );
+});
diff --git a/plugins/nako-portal/web/src/components/portal/chat.tsx b/plugins/nako-portal/web/src/components/portal/chat.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a5741970c80672156332ffcfc419d49ccb49409a
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/chat.tsx
@@ -0,0 +1,380 @@
+import { MoreHorizontalIcon } from "lucide-react"
+import { memo, type ReactNode, useEffect, useLayoutEffect, useMemo, useRef, useState } from "react"
+import { useStickToBottomContext } from "use-stick-to-bottom"
+import { Conversation, ConversationContent, ConversationScrollButton } from "@/components/ai-elements/conversation"
+import { Message, MessageContent } from "@/components/ai-elements/message"
+import { Button } from "@/components/ui/button"
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from "@/components/ui/dropdown-menu"
+import { Skullet } from "@/components/ui/skeleton"
+import { navigate, type Portal } from "@/hooks/use-portal"
+import { retryMarkdown, useMarkdown, useMarkdownError } from "@/lib/markdown"
+import { sourceName } from "@/lib/outside"
+import { inBubble } from "@/lib/bubble"
+import { usePresence } from "@/lib/presence"
+import { Composer } from "./composer"
+import { ComposerPlaceholder } from "./screen-loading"
+import { PageHeader } from "./header"
+import { Presence } from "./presence"
+import { ChatEnvironments } from "./chat-environments"
+import { Processes } from "./processes"
+import { Requests } from "./requests"
+import { SecretDock } from "./secrets"
+import { useGroupPicker } from "./groups"
+import { type ChatActions, sessionActions, useRenameDialog } from "./session-actions"
+import { Transcript } from "./transcript"
+import { ChatFind, FindInChatButton } from "./chat-find"
+
+// The open chat's title, background processes and ⋯ menu; unchanged while a turn streams in below it.
+const ChatHeader = memo(function ChatHeader({ title, session, pinned, groupable, actions, running, environments }: { title: string; session: string; pinned: boolean; groupable: boolean; actions: ChatActions; running: boolean; environments: boolean }) {
+  return (
+    <PageHeader title={title}>
+      {/* The floating panel keeps to the chat itself; its full controls are one tap away in the app. */}
+      {!inBubble && (
+        <>
+          {environments && <ChatEnvironments session={session} />}
+          <Processes key={session} running={running} session={session} />
+          <DropdownMenu>
+            <DropdownMenuTrigger asChild>
+              <Button aria-label="More" size="icon" variant="ghost">
+                <MoreHorizontalIcon />
+              </Button>
+            </DropdownMenuTrigger>
+            <DropdownMenuContent align="end">
+              {sessionActions(actions, session, pinned, groupable).map(a => (
+                <DropdownMenuItem key={a.label} onSelect={a.run}>
+                  <a.icon className="size-4 text-muted-foreground" />
+                  {a.label}
+                </DropdownMenuItem>
+              ))}
+            </DropdownMenuContent>
+          </DropdownMenu>
+        </>
+      )}
+      <FindInChatButton />
+    </PageHeader>
+  )
+})
+
+// Nako floats over the chat's bottom edge, so the transcript scrolls on behind her once you scroll
+// up. Only her bubble takes pointer events; the rest lets scrolls and selection through.
+function Dock({ children, onHeight }: { children: ReactNode; onHeight: (height: number) => void }) {
+  const box = useRef<HTMLDivElement>(null)
+  useLayoutEffect(() => {
+    const el = box.current
+    if (!el) return
+    const measure = () => onHeight(el.offsetHeight)
+    measure()
+    const observer = new ResizeObserver(measure)
+    observer.observe(el)
+    return () => observer.disconnect()
+  }, [onHeight])
+  return (
+    <div className="pointer-events-none absolute inset-x-0 bottom-0 flex flex-col [&_[data-bubble]]:pointer-events-auto" data-dock ref={box}>
+      {children}
+    </div>
+  )
+}
+
+const SAMPLE_TURNS = [
+  {
+    prompt: "can you check why the staging build failed?",
+    reply: "the typecheck caught a missing field on the account payload after the schema update. i patched the decoder and re-ran the check — everything passes now.",
+  },
+  {
+    prompt: "nice, go ahead and open the PR with screenshots",
+    reply: "pushed the branch and opened the PR with desktop and phone screenshots attached. CI is running now and i will check back once it is green.",
+  },
+  {
+    prompt: "can we also trim the extra padding on mobile?",
+    reply: "trimmed the header spacing on narrow screens and verified it at phone width in both light and dark themes.",
+  },
+]
+
+// Stand-ins for turns that haven't loaded yet: a prompt on the right, a reply on the left.
+function TurnSkeletons({ count }: { count: number }) {
+  return (
+    <Skullet label="Loading conversation…" loading>
+      <div className="flex flex-col gap-6">
+        {Array.from({ length: count }, (_, i) => {
+          const turn = SAMPLE_TURNS[i % SAMPLE_TURNS.length]
+          return (
+            <div className="flex flex-col gap-6" key={i}>
+              <Message from="user">
+                <MessageContent>{turn.prompt}</MessageContent>
+              </Message>
+              <Message from="assistant">
+                <MessageContent>
+                  <p className="leading-relaxed">{turn.reply}</p>
+                </MessageContent>
+              </Message>
+            </div>
+          )
+        })}
+      </div>
+    </Skullet>
+  )
+}
+
+// Sits above the loaded turns while older ones remain. Coming near it loads the page before,
+// and the view stays on what was being read instead of jumping as that page lands above it.
+function OlderTurns({ portal }: { portal: Portal }) {
+  const { scrollRef } = useStickToBottomContext()
+  const start = portal.current?.start ?? 0
+  const top = useRef<HTMLDivElement>(null)
+  const sentinel = useRef<HTMLDivElement>(null)
+  const fromBottom = useRef(0)
+  const shownStart = useRef<number | null>(null)
+
+  // Opening at the bottom before the first paint, so the chat never shows its top and
+  // older pages don't start loading before anyone scrolled. On first mount the scroller's
+  // ref isn't attached yet (parents attach after children); StickToBottom.Content renders
+  // it as our grandparent (scroller > content > this).
+  useLayoutEffect(() => {
+    const root = scrollRef.current ?? top.current?.parentElement?.parentElement
+    if (!root) return
+    if (shownStart.current === null) root.scrollTop = root.scrollHeight
+    else if (start < shownStart.current) root.scrollTop = root.scrollHeight - fromBottom.current
+    shownStart.current = start
+  }, [scrollRef, start])
+
+  useEffect(() => {
+    const root = scrollRef.current
+    if (!root) return
+    const track = () => {
+      fromBottom.current = root.scrollHeight - root.scrollTop
+    }
+    track()
+    root.addEventListener("scroll", track, { passive: true })
+    return () => root.removeEventListener("scroll", track)
+  }, [scrollRef])
+
+  useEffect(() => {
+    const root = scrollRef.current
+    const target = sentinel.current
+    if (!root || !target) return
+    const observer = new IntersectionObserver(([entry]) => entry.isIntersecting && portal.loadOlder(), { root, rootMargin: "800px 0px 0px 0px" })
+    observer.observe(target)
+    return () => observer.disconnect()
+  }, [scrollRef, start, portal.loadOlder])
+
+  return (
+    <div className="-mb-6" ref={top}>
+      {start > 0 && (
+        <div className="pb-6" ref={sentinel}>
+          <TurnSkeletons count={2} />
+        </div>
+      )}
+    </div>
+  )
+}
+
+// Keeps a chat that was at the bottom there, without animating, when the layout around it changes
+// rather than the conversation: the scroller getting shorter (Nako's bubble growing under it) or the
+// text rewrapping to a new width (the sidebar opening or closing). StickToBottom only follows content
+// growth, smoothly, so the first left the last lines hidden under the bubble and the second scrolled
+// the chat up and back down.
+function KeepBottom({ dock }: { dock: number }) {
+  const { scrollRef, contentRef, isAtBottom } = useStickToBottomContext()
+  // StickToBottom's own view of it, which stays true while it eases toward new content.
+  const following = useRef(isAtBottom)
+  following.current = isAtBottom
+  // The dock over the chat grew or shrank (her bubble wrapping, the process list opening): its
+  // spacer moved the bottom, so stay on it in the same frame instead of easing there.
+  useLayoutEffect(() => {
+    const root = scrollRef.current
+    if (root && following.current) root.scrollTop = root.scrollHeight
+  }, [dock, scrollRef])
+  useEffect(() => {
+    const root = scrollRef.current
+    const content = contentRef.current
+    if (!root || !content) return
+    let height = root.clientHeight
+    let width = content.clientWidth
+    const observer = new ResizeObserver(() => {
+      const moved = root.clientHeight !== height || content.clientWidth !== width
+      height = root.clientHeight
+      width = content.clientWidth
+      if (moved && following.current) root.scrollTop = root.scrollHeight
+    })
+    observer.observe(root)
+    observer.observe(content)
+    return () => observer.disconnect()
+  }, [scrollRef, contentRef])
+  return null
+}
+
+function partOfDay(hour: number) {
+  return hour < 5 ? "evening" : hour < 12 ? "morning" : hour < 18 ? "afternoon" : "evening"
+}
+
+// A new chat puts the greeting and the composer together a little above the middle on wide
+// screens; on a phone the composer stays at the bottom, under the thumb.
+function NewChat({ portal }: { portal: Portal }) {
+  const name = portal.me?.name
+  return (
+    <div className="flex min-h-0 flex-1 flex-col md:justify-center md:pb-[16vh]">
+      <div className="flex flex-1 flex-col items-center justify-center gap-3 px-4 text-center md:flex-none md:pb-7">
+        <h2 className="font-serif text-[2.5rem] leading-[1.1] tracking-[-0.01em] md:text-[2.875rem]">
+          good <em className="text-primary">{partOfDay(new Date().getHours())}</em>
+          {name && `, ${name}`}
+        </h2>
+        {portal.error && <p className="text-destructive text-sm">{portal.error}</p>}
+      </div>
+      <Composer
+        command={portal.command}
+        commands={portal.commands}
+        draftKey="draft:new"
+        inChat={false}
+        placeholder="what are we working on?"
+        running={false}
+        send={portal.send}
+        setError={portal.setError}
+        stop={portal.stop}
+      />
+    </div>
+  )
+}
+
+// A session that came in another way (Slack, cron...): its transcript, no composer and no chat
+// controls. The portal only watches it; turns there stream nothing here, so it rereads instead.
+function ReadOnlyChat({ portal, source, find }: { portal: Portal; source: string; find?: ReactNode }) {
+  const c = portal.current!
+  const renderer = useMarkdown()
+  const markdownError = useMarkdownError()
+  const loading = c.loading || (!renderer && !markdownError)
+  const running = portal.outside.running.includes(c.session)
+  const name = sourceName(source)
+  return (
+    <>
+      <PageHeader
+        back={() => navigate("#/elsewhere")}
+        title={
+          <>
+            {c.title || "untitled"}
+            <span className="ml-2 font-normal text-muted-foreground text-xs">{name}</span>
+          </>
+        }
+      ><FindInChatButton /></PageHeader>
+      {find}
+      <Conversation className="min-h-0 flex-1" initial="instant" key={`${c.session}:${loading}`}>
+        <ConversationContent className="mx-auto w-full max-w-3xl gap-6" scrollClassName="overflow-y-auto">
+          {loading && <TurnSkeletons count={3} />}
+          {!loading && <OlderTurns portal={portal} />}
+          {!loading && <KeepBottom dock={0} />}
+          {!loading && <Transcript live={null} messages={c.messages} notes={NO_NOTES} quiet={false} running={running} session={c.session} />}
+          {portal.error && <p className="text-destructive text-sm">{portal.error}</p>}
+        </ConversationContent>
+        <ConversationScrollButton />
+      </Conversation>
+      <div className="mx-auto w-full max-w-3xl px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
+        <p className="rounded-3xl border bg-card px-4 py-3 text-center text-muted-foreground text-sm">Read-only, from {name}</p>
+      </div>
+    </>
+  )
+}
+
+const NO_NOTES: never[] = []
+
+export function Chat({ portal }: { portal: Portal }) {
+  const source = portal.current?.source
+  const root = useRef<HTMLDivElement>(null)
+  const markdownError = useMarkdownError()
+  const banner = (
+    <>
+      {Boolean(markdownError) && <p role="alert" className="border-b px-4 py-2 text-sm text-muted-foreground">Formatting couldn’t load. <button type="button" className="underline" onClick={() => void retryMarkdown().catch(() => {})}>Try again</button></p>}
+      {portal.current && <ChatFind key={portal.current.session} root={root} session={portal.current.session} />}
+    </>
+  )
+  if (portal.route.view === "chat" && portal.current?.session !== portal.route.session) return <><PageHeader title="Chat" /><div className="mx-auto min-h-0 w-full max-w-3xl flex-1 overflow-hidden p-4"><TurnSkeletons count={3} /></div><ComposerPlaceholder /></>
+  if (portal.route.view === "chat" && portal.current?.loadError) return <><PageHeader title={portal.current.title || "Chat"} /><div role="alert" className="mx-auto w-full max-w-3xl p-4 text-sm">{portal.current.loadError} <button type="button" className="underline" onClick={() => void portal.refresh(portal.current!.session)}>Retry</button></div></>
+  return <div ref={root} className="flex min-h-0 flex-1 flex-col">
+    {source && source !== "portal" ? <ReadOnlyChat find={banner} portal={portal} source={source} /> : <PortalChat find={banner} portal={portal} />}
+  </div>
+}
+
+function PortalChat({ portal, find }: { portal: Portal; find?: ReactNode }) {
+  const c = portal.current
+  const presence = usePresence()
+  // Held on the skeleton until the renderer is in too, so the chat mounts once, at its bottom.
+  const renderer = useMarkdown()
+  const markdownError = useMarkdownError()
+  const loading = !c || c.loading || (!renderer && !markdownError)
+  const draftKey = c ? `draft:${c.session}` : ""
+  const rename = useRenameDialog(portal)
+  const picker = useGroupPicker(portal)
+  const { pin, archive } = portal
+  const actions = useMemo(() => ({ pin, archive, rename: rename.start, group: picker.start }), [pin, archive, rename.start, picker.start])
+  const session = c?.session
+  const start = c?.start ?? 0
+  const notes = useMemo(() => portal.notes.filter(n => n.session === session && n.at >= start).map(n => ({ ...n, at: n.at - start })), [portal.notes, session, start])
+  const [dock, setDock] = useState(0)
+  // Nako waits on a secret until it's answered, so the composer becomes its field until then.
+  const secret = c?.requests.find(r => r.method === "secret")
+  const offline = !portal.connected && <p className="border-b bg-muted px-4 py-2 text-muted-foreground text-xs">nako is offline. messages will work again once it reconnects.</p>
+  if (!c)
+    return (
+      <>
+        <PageHeader title="New chat" />
+        {offline}
+        <NewChat portal={portal} />
+      </>
+    )
+  return (
+    <>
+      <ChatHeader environments={Boolean(portal.me?.environments)} running={c.running} actions={actions} pinned={Boolean(portal.sessions.find(s => s.id === c.session)?.pinned)} groupable={!portal.sessions.find(s => s.id === c.session)?.machine} session={c.session} title={c.title || portal.sessions.find(row => row.id === c.session)?.title || "chat"} />
+      {rename.dialog}
+      {picker.dialog}
+      {offline}
+      {find}
+      {/* A fresh scroller per opened chat, mounted once its latest page is in, so it starts at the bottom without scrolling there. */}
+      <Conversation className="min-h-0 flex-1" initial="instant" key={`${c.session}:${loading}`}>
+        {/* Scrollable from the first layout (StickToBottom only sets overflow later), so OlderTurns can pin the bottom before paint. */}
+        <ConversationContent className="mx-auto w-full max-w-3xl gap-6" scrollClassName="overflow-y-auto">
+          {loading && <TurnSkeletons count={3} />}
+          {!loading && <OlderTurns portal={portal} />}
+          {!loading && <KeepBottom dock={dock} />}
+          {!loading && <Transcript
+              live={portal.live}
+              messages={c.messages}
+              notes={notes}
+              running={c.running}
+              session={c.session}
+              quiet={presence}
+            />}
+          <Requests answer={portal.answer} requests={c.requests} />
+          {portal.error && <p className="text-destructive text-sm">{portal.error}</p>}
+          {/* Room under the last message for the dock, so it can scroll clear of Nako. */}
+          <div aria-hidden className="-mt-6 shrink-0" style={{ height: dock }} />
+        </ConversationContent>
+        <ConversationScrollButton style={{ bottom: dock + 16 }} />
+        {!loading && (
+          <Dock onHeight={setDock}>
+            {presence && !c.requests.length && (
+              <Presence
+                bare={inBubble}
+                key={c.session}
+                live={portal.live}
+                outcome={portal.sessions.find(s => s.id === c.session)?.status}
+                running={c.running}
+                signOff={portal.signOff?.session === c.session ? portal.signOff.text : ""}
+              />
+            )}
+          </Dock>
+        )}
+      </Conversation>
+      {c.loading && !portal.sessions.some(row => row.id === c.session) ? <ComposerPlaceholder /> : <SecretDock answer={portal.answer} key={c.session} request={secret}>
+        <Composer
+          command={portal.command}
+          commands={portal.commands}
+          draftKey={draftKey}
+          session={c.session}
+          inChat
+          running={c.running}
+          send={portal.send}
+          setError={portal.setError}
+          stop={portal.stop}
+        />
+      </SecretDock>}
+    </>
+  )
+}
