+}
+
+/** Settings > Mesh: the hub with its machines around it, and the way to add one. */
+export function MeshSettings({ portal }: { portal: Portal }) {
+  const raw = useMesh(portal.machinesSeen)
+  const [selected, setSelected] = useState<string | null>(null)
+  const [adding, setAdding] = useState(false)
+  const [error, setError] = useState("")
+  // "seen 5m ago" keeps moving while the page is open.
+  const [, tick] = useState(0)
+  useEffect(() => {
+    const timer = setInterval(() => tick(n => n + 1), 30_000)
+    return () => clearInterval(timer)
+  }, [])
+  if (raw === false) return null
+  return (
+    <Skullet data={raw} id="settings-mesh" label="Loading mesh…" sample={SAMPLE_MESH}>
+      {mesh => {
+        const machines = mesh.machines
+        const picked = machines.find(m => m.name === selected)
+        return (
+          <div className="flex flex-col gap-4">
+            {!mesh.hub && <p className="py-10 text-center text-muted-foreground text-sm">This portal isn't a mesh hub.</p>}
+            {mesh.hub && (
+              <>
+                <MeshMap hubName={mesh.name ?? "hub"} machines={machines} pick={setSelected} selected={selected} />
+                {machines.length === 0 && !adding && (
+                  <p className="text-center text-muted-foreground text-sm">No machines yet. Add one to hand it tasks from here.</p>
+                )}
+                {adding && <AddMachine close={() => setAdding(false)} onError={setError} ready={Boolean(mesh.plugin?.source)} />}
+                {picked && <MachineCard close={() => setSelected(null)} machine={picked} onError={setError} portal={portal} />}
+                {!adding && (
+                  <div className="flex justify-end">
+                    <Button
+                      onClick={() => {
+                        setAdding(true)
+                        setSelected(null)
+                      }}
+                      size="sm"
+                      variant="outline"
+                    >
+                      <PlusIcon />
+                      Add machine
+                    </Button>
+                  </div>
+                )}
+                {mesh.plugin && <PluginSourceRow onError={setError} plugin={mesh.plugin} />}
+              </>
+            )}
+            {error && <p className="text-destructive text-sm">{error}</p>}
+          </div>
+        )
+      }}
+    </Skullet>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/model-picker.tsx b/plugins/nako-portal/web/src/components/portal/model-picker.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..346926c849972680bafc040d722b753b7d5e28a9
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/model-picker.tsx
@@ -0,0 +1,228 @@
+import { BrainIcon, CheckIcon, ChevronDownIcon, GaugeIcon, RabbitIcon, RocketIcon, StarIcon, TurtleIcon } from "lucide-react"
+import { Popover } from "radix-ui"
+import { useEffect, useRef, useState } from "react"
+import { d, type Infer } from "@/lib/decode"
+import { Skullet } from "@/components/ui/skeleton"
+import { Button } from "@/components/ui/button"
+import { Command, CommandEmpty, CommandGroup, CommandInput, CommandItem } from "@/components/ui/command"
+import { DropdownContent, DropdownList, SearchableDropdown } from "@/components/ui/searchable-dropdown"
+import { api, ApiError } from "@/lib/api"
+import { presetDetails, presetMatches, refreshModelPicks, toggleModelFavorite, useModelFavorites, useModelPresets } from "@/lib/model-presets"
+import { favoriteId, type ModelFavorite } from "@/lib/model-favorites"
+
+export const modelChoice = d.object({
+  provider: d.string(), model: d.string(),
+  providers: d.array(d.object({ provider: d.string(), label: d.string(), models: d.array(d.string()) })),
+  effort: d.string().optional(), speed: d.string().optional(),
+  efforts: d.array(d.string()).optional(), speeds: d.array(d.string()).optional(), overridden: d.boolean().optional(),
+})
+export type ModelChoice = Infer<typeof modelChoice>
+export type ModelSelection = { provider?: string; model?: string; effort?: string; speed?: string; reset?: true }
+type Pick = ModelSelection
+
+function ModelPlaceholder() {
+  return (
+    <Skullet className="inline-block" label="Loading model…" loading>
+      <Button className="max-w-48 justify-between gap-2 font-normal" size="sm" type="button" variant="ghost">
+        <span className="truncate">claude-sonnet</span>
+        <ChevronDownIcon className="size-3 shrink-0 text-muted-foreground" />
+      </Button>
+    </Skullet>
+  )
+}
+
+export function NewChatModel({ selection, onPick }: { selection: ModelSelection; onPick: (pick: ModelSelection) => void }) {
+  const [defaults, setDefaults] = useState<ModelChoice | null | false>(null)
+  useEffect(() => {
+    let active = true
+    void api<unknown>("/api/model").then(raw => { if (active) setDefaults(modelChoice.parse(raw)) }).catch(() => { if (active) setDefaults(false) })
+    return () => { active = false }
+  }, [])
+  if (!defaults) return defaults === null ? <ModelPlaceholder /> : null
+  const otherRoute = selection.model !== undefined && (selection.model !== defaults.model || selection.provider !== defaults.provider)
+  return <ModelPicker label="this chat" session chips canSavePreset={!otherRoute} value={{ ...defaults, ...selection, overridden: Object.keys(selection).length > 0 }} onPick={async pick => {
+    if (pick.reset) onPick({})
+    else if (pick.model !== undefined) onPick(pick)
+    else onPick({ ...selection, ...pick })
+  }} />
+}
+
+// Speed tiers read as animals; a tier with no animal keeps a plain gauge.
+const SPEED_ICONS: Record<string, typeof GaugeIcon> = { normal: TurtleIcon, fast: RabbitIcon, ultrafast: RocketIcon }
+const optionIcon = (label: string, value: string) => label === "effort" ? BrainIcon : SPEED_ICONS[value] ?? GaugeIcon
+
+function Option({ label, value, values, onPick, chip = false }: {
+  label: string; value: string; values: string[]; onPick: (value: string) => void; chip?: boolean;
+}) {
+  const Icon = optionIcon(label, value)
+  return <div className={chip ? "shrink-0 data-[fit=out]:invisible data-[fit=out]:absolute data-[fit=out]:top-0 data-[fit=out]:left-0" : "min-w-0 flex-1"} data-tune={chip ? "" : undefined}>
+    <SearchableDropdown label={label} value={value || "inherit"} compact={chip} side={chip ? "top" : "bottom"}
+      className={chip ? "gap-1.5 px-2 text-xs text-muted-foreground" : "w-full text-xs"}
+      icon={<Icon className="size-3.5 shrink-0 text-muted-foreground" />}
+      options={[{ value: "inherit", label: "default" }, ...values.map(value => ({ value, label: value }))]}
+      onPick={v => onPick(v === "inherit" ? "" : v)} />
+  </div>
+}
+
+export function PresetIcon({ icon }: { icon?: string }) {
+  return icon ? <span aria-hidden="true" className="grid size-5 shrink-0 place-items-center overflow-hidden text-sm leading-none">{icon}</span> : null
+}
+
+export function ModelPicker({ value, onPick, label = "Model", disabled = false, session = false, canSavePreset = true, chips = false, named = session }: {
+  value: ModelChoice; onPick: (pick: Pick) => Promise<unknown>; label?: string; disabled?: boolean; session?: boolean; canSavePreset?: boolean; named?: boolean;
+  // Effort and speed as their own buttons beside the model; the composer hides the ones that don't fit.
+  chips?: boolean;
+}) {
+  const [open, setOpen] = useState(false)
+  const [query, setQuery] = useState("")
+  const [saving, setSaving] = useState(false)
+  const [error, setError] = useState("")
+  const favorites = useModelFavorites()
+  const search = useRef<HTMLInputElement>(null)
+  const catalog = new Map(value.providers.map(provider => [provider.provider, provider]))
+  const presets = useModelPresets()
+  const presetsOnly = named && presets.length > 0
+  const activePreset = presetsOnly ? presets.find(item => presetMatches(item, value)) : undefined
+  const supportsTuning = value.efforts !== undefined || value.speeds !== undefined
+  const preset = {
+    provider: value.provider, model: value.model,
+    effort: value.efforts?.includes(value.effort ?? "") ? value.effort ?? "" : "",
+    speed: value.speeds?.includes(value.speed ?? "") ? value.speed ?? "" : "",
+  }
+  const starred = new Set(favorites.map(favoriteId))
+  const filter = query.trim().toLowerCase()
+  const matches = (model: string, provider: string, tuning = "") => `${provider} ${model} ${tuning}`.toLowerCase().includes(filter)
+  const details = (favorite: ModelFavorite) => "effort" in favorite ? [favorite.effort, favorite.speed].filter(Boolean).join(" · ") : ""
+  const shownFavorites = favorites.filter(favorite => {
+    const provider = catalog.get(favorite.provider)
+    return provider?.models.includes(favorite.model) && (supportsTuning || !("effort" in favorite)) && matches(favorite.model, provider.label, details(favorite))
+  })
+  const toggle = (favorite: ModelFavorite) => {
+    setError("")
+    toggleModelFavorite(favorite).catch(e => setError(e instanceof Error ? e.message : String(e)))
+  }
+  const show = (next: boolean) => {
+    if (next) void refreshModelPicks()
+    setOpen(next)
+  }
+  const save = async (pick: Pick) => {
+    setSaving(true)
+    setError("")
+    try { await onPick(pick) } catch (e) {
+      setError(e instanceof Error ? e.message : String(e))
+      // A chip has nowhere to say what went wrong; the picker does.
+      setOpen(true)
+    }
+    finally { setSaving(false) }
+  }
+  // A single speed is no choice, so neither the picker nor a chip offers it.
+  const speeds = value.speeds && value.speeds.length > 1 ? value.speeds : undefined
+  const renderRow = (pick: ModelFavorite, description?: string) => {
+    const id = favoriteId(pick)
+    const active = pick.provider === value.provider && pick.model === value.model &&
+      (!("effort" in pick) || (pick.effort === preset.effort && pick.speed === preset.speed))
+    const name = `${pick.model} on ${catalog.get(pick.provider)?.label}${description ? `, ${description}` : ""}`
+    return <div key={id} className="flex items-stretch rounded-sm hover:bg-accent focus-within:bg-accent">
+      <CommandItem className="min-h-9 min-w-0 flex-1 max-sm:min-h-11" disabled={saving} value={id} onSelect={() => void save(pick)}>
+        <span className="min-w-0">
+          <span className="block truncate">{pick.model}</span>
+          {description && <span className="block truncate text-xs text-muted-foreground">{description}</span>}
+        </span>
+        {active && <CheckIcon className="ml-auto size-4 shrink-0" />}
+      </CommandItem>
+      <button type="button" aria-label={`Favorite ${name}`} aria-pressed={starred.has(id)} title={starred.has(id) ? "Remove favorite" : "Add favorite"}
+        className="grid w-9 shrink-0 place-items-center rounded-sm text-muted-foreground hover:text-foreground aria-pressed:text-primary max-sm:w-11"
+        onKeyDown={event => { if (event.key === "Enter" || event.key === " ") event.stopPropagation() }}
+        onClick={event => {
+          // The row moves between groups. Keep keyboard focus in the picker.
+          if (event.currentTarget === document.activeElement) search.current?.focus({ preventScroll: true })
+          toggle(pick)
+        }}>
+        <StarIcon className="size-4" fill={starred.has(id) ? "currentColor" : "none"} />
+      </button>
+    </div>
+  }
+  return <><Popover.Root open={open} onOpenChange={show}>
+    <Popover.Trigger asChild><Button aria-label={label} disabled={disabled} className="max-w-48 justify-between gap-2 font-normal" size="sm" variant={session ? "ghost" : "outline"}>
+      {presetsOnly && <PresetIcon icon={activePreset?.icon} />}
+      <span className="truncate">{activePreset?.name || value.model || "automatic"}</span><ChevronDownIcon className="size-3 shrink-0 text-muted-foreground" />
+    </Button></Popover.Trigger>
+    <DropdownContent align={session ? "start" : "end"} side={session ? "top" : "bottom"} className="w-80" aria-label={label}>
+      <div className="flex items-center justify-between px-3 pt-3 text-xs text-muted-foreground"><span>{label}</span>
+        {session && <button disabled={saving || !value.overridden} className="disabled:opacity-40 hover:text-foreground" onClick={() => void save({ reset: true })}>use default</button>}
+      </div>
+      {presetsOnly ? <>
+        <Command label="Model presets" loop>
+          <CommandInput aria-label="Search presets" placeholder="Search presets…" />
+          <DropdownList className="p-1">
+            <CommandEmpty>No preset matches.</CommandEmpty>
+            {presets.map(item => {
+              const available = catalog.get(item.pick.provider)?.models.includes(item.pick.model)
+              return <CommandItem key={item.id} value={`${item.name} ${item.id}`} keywords={[presetDetails(item)]}
+                disabled={saving || !available} className="min-h-11" onSelect={() => void save(item.pick)}>
+                <PresetIcon icon={item.icon} />
+                <span className="min-w-0 flex-1"><span className="block truncate">{item.name}</span>
+                  <span className="block truncate text-xs text-muted-foreground">{available ? presetDetails(item) : "Model unavailable"}</span></span>
+                {activePreset?.id === item.id && <CheckIcon />}
+              </CommandItem>
+            })}
+          </DropdownList>
+        </Command>
+        {session && <a className="block border-t px-3 py-2 text-xs text-muted-foreground hover:text-foreground" href="#/settings/nako" onClick={() => setOpen(false)}>Manage presets</a>}
+      </> : <>
+      <Command shouldFilter={false} className="bg-transparent">
+        <CommandInput aria-label="Search models" ref={search} onValueChange={setQuery} placeholder="Search models" value={query} />
+        <DropdownList>
+          <CommandEmpty>No model matches.</CommandEmpty>
+          {shownFavorites.length > 0 && <CommandGroup heading="Favorites" className="mb-1 border-b pb-2">
+            {shownFavorites.map(pick => renderRow(pick, [catalog.get(pick.provider)?.label, details(pick)].filter(Boolean).join(" · ")))}
+          </CommandGroup>}
+          {value.providers.map(p => {
+            const shown = p.models.map(model => ({ provider: p.provider, model }))
+              .filter(pick => !starred.has(favoriteId(pick)) && matches(pick.model, p.label))
+            return shown.length ? <CommandGroup heading={p.label} key={p.provider}>{shown.map(pick => renderRow(pick))}</CommandGroup> : null
+          })}
+        </DropdownList>
+      </Command>
+      {supportsTuning && <fieldset disabled={saving} className="flex items-center gap-1 border-t p-1.5">
+        {value.efforts && <Option label="effort" value={value.effort || ""} values={value.efforts} onPick={effort => void save({ effort })} />}
+        {speeds && <Option label="speed" value={value.speed || ""} values={speeds} onPick={speed => void save({ speed })} />}
+        {canSavePreset && (preset.effort || preset.speed) && catalog.get(preset.provider)?.models.includes(preset.model) &&
+          <button type="button" aria-pressed={starred.has(favoriteId(preset))}
+            className="flex min-h-9 shrink-0 items-center gap-1.5 rounded-lg px-2 text-xs text-muted-foreground hover:bg-accent aria-pressed:text-primary max-sm:min-h-11"
+            onClick={() => toggle(preset)}><StarIcon className="size-3.5" fill={starred.has(favoriteId(preset)) ? "currentColor" : "none"} /> {starred.has(favoriteId(preset)) ? "Preset saved" : "Save preset"}</button>}
+      </fieldset>}
+      </>}
+      {error && <p role="alert" className="px-3 pb-3 text-xs text-destructive">{error}</p>}
+    </DropdownContent>
+  </Popover.Root>
+  {chips && !activePreset && <fieldset disabled={disabled || saving} className="contents">
+    {value.efforts && <Option chip label="effort" value={value.effort || ""} values={value.efforts} onPick={effort => void save({ effort })} />}
+    {speeds && <Option chip label="speed" value={value.speed || ""} values={speeds} onPick={speed => void save({ speed })} />}
+  </fieldset>}
+  </>
+}
+
+export function SessionModel({ session, running }: { session: string; running: boolean }) {
+  const [value, setValue] = useState<ModelChoice | null | false>(null)
+  const path = `/api/sessions/${session}/model`
+  useEffect(() => {
+    let active = true
+    const read = () => api<unknown>(path).then(raw => { if (active) setValue(modelChoice.parse(raw)) }).catch(e => {
+      if (active) setValue(previous => e instanceof ApiError && e.status === 404 ? false : previous ?? false)
+    })
+    void read()
+    const timer = window.setInterval(read, 10000)
+    return () => { active = false; clearInterval(timer) }
+  }, [path, running])
+  if (!value) return value === null ? <ModelPlaceholder /> : null
+  return <ModelPicker label="this chat" session chips disabled={running} value={value} onPick={async body => {
+    let raw = await api<unknown>(path, { method: "POST", body })
+    const warning = d.object({ confirmation: d.string(), message: d.string() }).safeParse(raw)
+    if (warning.success) {
+      if (!window.confirm(warning.data.message)) return
+      raw = await api<unknown>(path, { method: "POST", body: { ...body, confirm: warning.data.confirmation } })
+    }
+    setValue(modelChoice.parse(raw))
+  }} />
+}
diff --git a/plugins/nako-portal/web/src/components/portal/model-preset-settings.tsx b/plugins/nako-portal/web/src/components/portal/model-preset-settings.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a748e9046769e47c4c5dfd1dc7e852aea64b2a64
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/model-preset-settings.tsx
@@ -0,0 +1,123 @@
+import { Skullet } from "@/components/ui/skeleton"
+import { SearchableDropdown } from "@/components/ui/searchable-dropdown"
+import { id } from "@/lib/id"
+import { useEffect, useState } from "react"
+import { api } from "@/lib/api"
+import { EllipsisIcon, PlusIcon } from "lucide-react"
+import { Button } from "@/components/ui/button"
+import { Dialog, DialogContent, DialogTitle } from "@/components/ui/dialog"
+import { Input } from "@/components/ui/input"
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from "@/components/ui/dropdown-menu"
+import { type ModelPreset, presetDetails, presetMatches, putModelPreset, removeModelPreset, useModelPresets, usePicksLoadState } from "@/lib/model-presets"
+import { type ModelChoice, PresetIcon } from "./model-picker"
+import { PresetEmoji } from "./preset-emoji"
+
+const SAMPLE_PRESETS: ModelPreset[] = [
+  { id: "sample", name: "Daily coding", icon: "✨", pick: { provider: "anthropic", model: "claude-sonnet-5-5", effort: "high", speed: "" } },
+]
+
+export function ModelPresetSettings({ value }: { value: ModelChoice }) {
+  const presets = useModelPresets()
+  const loadState = usePicksLoadState()
+  const [editing, setEditing] = useState<ModelPreset | null>(null)
+  const [error, setError] = useState("")
+  const active = presets.find(item => presetMatches(item, value))
+  const edit = (preset?: ModelPreset) => {
+    setError("")
+    setEditing(preset ?? {
+      id: id(), name: "", icon: "",
+      pick: { provider: value.provider, model: value.model, effort: value.effort ?? "", speed: value.speed ?? "" },
+    })
+  }
+  return <section aria-label="Model presets" className="mt-2 space-y-1 border-t pt-3 text-sm">
+    <div className="flex items-center justify-between">
+      <h2 className="font-medium">Model presets</h2>
+      <Button type="button" size="sm" variant="outline" onClick={() => edit()}><PlusIcon />Add preset</Button>
+    </div>
+    {loadState === "failed" && <p className="text-muted-foreground">Could not load presets.</p>}
+    <Skullet id="settings-presets" label="Loading presets…" loading={loadState === "pending"}>
+      <div>
+        {loadState === "ready" && !presets.length && <p className="py-1 text-muted-foreground">No presets yet.</p>}
+        {(loadState === "pending" ? SAMPLE_PRESETS : presets).map(preset => <div key={preset.id} className="flex min-h-14 items-center gap-2 border-b last:border-0">
+          <PresetIcon icon={preset.icon} />
+          <div className="min-w-0 flex-1"><div className="truncate">{preset.name}</div><div className="truncate text-xs text-muted-foreground">{presetDetails(preset)}</div></div>
+          {active?.id === preset.id && <span className="rounded-md border px-1.5 py-0.5 text-xs text-muted-foreground">Default</span>}
+          <DropdownMenu><DropdownMenuTrigger asChild><Button type="button" variant="ghost" size="icon" aria-label={`Options for ${preset.name}`}><EllipsisIcon /></Button></DropdownMenuTrigger>
+            <DropdownMenuContent align="end">
+              <DropdownMenuItem onSelect={() => edit(preset)}>Edit preset</DropdownMenuItem>
+              <DropdownMenuItem onSelect={() => {
+                setError("")
+                removeModelPreset(preset.id).catch(e => setError(e instanceof Error ? e.message : String(e)))
+              }}>Remove preset</DropdownMenuItem>
+            </DropdownMenuContent>
+          </DropdownMenu>
+        </div>)}
+      </div>
+    </Skullet>
+    {!editing && error && <p role="alert" className="text-destructive">{error}</p>}
+    {editing && <Dialog open onOpenChange={open => { if (!open) { setEditing(null); setError("") } }}>
+      <DialogContent className="max-h-[95dvh] overflow-y-auto sm:max-w-sm" aria-describedby={undefined}>
+        <DialogTitle>{presets.some(preset => preset.id === editing.id) ? "Edit preset" : "Add preset"}</DialogTitle>
+        <PresetForm value={value} preset={editing} error={error} onCancel={() => { setEditing(null); setError("") }} onSave={preset => {
+          putModelPreset(preset).then(() => { setEditing(null); setError("") }, e => setError(e instanceof Error ? e.message : String(e)))
+        }} />
+      </DialogContent>
+    </Dialog>}
+  </section>
+}
+
+function PresetForm({ value, preset, error, onCancel, onSave }: { value: ModelChoice; preset: ModelPreset; error: string; onCancel: () => void; onSave: (preset: ModelPreset) => void }) {
+  const [draft, setDraft] = useState(preset)
+  const { pick } = draft
+  const routes = value.providers.flatMap(({ provider, label, models }) => models.map(model => ({ provider, model, label })))
+  const route = (provider: string, model: string) => JSON.stringify([provider, model])
+  const selected = route(pick.provider, pick.model)
+  const available = routes.some(item => route(item.provider, item.model) === selected)
+  const current = pick.provider === value.provider && pick.model === value.model
+  const [preview, setPreview] = useState<{ route: string; efforts?: string[]; speeds?: string[]; error?: string } | null>(null)
+  useEffect(() => {
+    if (current || !available) return
+    let active = true
+    const query = new URLSearchParams({ provider: pick.provider, model: pick.model })
+    api<{ efforts: string[]; speeds: string[] }>(`/api/model/options?${query}`).then(
+      result => { if (active) setPreview({ ...result, route: selected }) },
+      () => { if (active) setPreview({ route: selected, error: "Could not load tuning options for this model." }) },
+    )
+    return () => { active = false }
+  }, [available, current, pick.model, pick.provider, selected])
+  const loaded = !current && preview?.route === selected ? preview : null
+  const choices = current ? value : loaded
+  const options = (known: string[] | undefined, saved: string) => [...new Set([...(known ?? []), ...(saved ? [saved] : [])])]
+  const tuning = (fieldName: "effort" | "speed", values: string[]) => {
+    const label = fieldName === "effort" ? "Effort" : "Speed"
+    return <div className="grid min-w-0 gap-1.5">
+      <span>{label}</span>
+      <SearchableDropdown label={label} value={pick[fieldName]} className="h-9 w-full"
+        options={[{ value: "", label: "Default" }, ...values.map(value => ({ value, label: value }))]}
+        onPick={value => setDraft({ ...draft, pick: { ...pick, [fieldName]: value } })} />
+    </div>
+  }
+  return <form className="grid gap-3 text-sm" onSubmit={e => { e.preventDefault(); if (draft.name.trim() && available) onSave(draft) }}>
+    <div className="grid gap-1.5">
+      <label htmlFor="preset-name">Name</label>
+      <div className="flex items-center gap-2">
+        <PresetEmoji value={draft.icon} onPick={icon => setDraft(current => ({ ...current, icon }))} />
+        <Input id="preset-name" value={draft.name} required maxLength={40} placeholder="Quick replies" onChange={e => setDraft({ ...draft, name: e.target.value })} />
+      </div>
+    </div>
+    <div className="grid min-w-0 gap-1.5">
+      <span>Model</span>
+      <SearchableDropdown label="Model" value={selected} placeholder="Choose an available model" className="h-9 w-full"
+        options={routes.map(({ provider, model, label }) => ({ value: route(provider, model), label: model, detail: label }))}
+        onPick={choice => {
+          if (choice === selected) return
+          const next = routes.find(item => route(item.provider, item.model) === choice)
+          if (next) setDraft({ ...draft, pick: { provider: next.provider, model: next.model, effort: "", speed: "" } })
+        }} />
+    </div>
+    <div className="grid grid-cols-2 gap-3">{tuning("effort", options(choices?.efforts, pick.effort))}{tuning("speed", options(choices?.speeds, pick.speed))}</div>
+    {loaded?.error && <p role="alert" className="text-destructive">{loaded.error}</p>}
+    {error && <p role="alert" className="text-destructive">{error}</p>}
+    <div className="flex justify-end gap-2"><Button type="button" variant="ghost" onClick={onCancel}>Cancel</Button><Button type="submit" disabled={!draft.name.trim() || !available}>Save preset</Button></div>
+  </form>
+}
diff --git a/plugins/nako-portal/web/src/components/portal/presence.tsx b/plugins/nako-portal/web/src/components/portal/presence.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5259df285b1735d540404fc07ced4e6f2faefe35
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/presence.tsx
@@ -0,0 +1,158 @@
+import { type ReactNode, useEffect, useLayoutEffect, useRef, useState } from "react"
+import { Shimmer } from "@/components/ai-elements/shimmer"
+import type { Live, Status } from "@/lib/types"
+
+export type Activity = "idle" | "thinking" | "tools" | "replying"
+
+// A running tool wins; then reply text written since the last tool; then the last tool she ran,
+// while she works out the next step; otherwise she's thinking.
+export function activity(live: Live | null): Exclude<Activity, "idle"> {
+  const tools = live?.tools ?? []
+  if (tools.some(t => t.state === "running")) return "tools"
+  if (live?.messages.some(m => m.text.trim() && (m.after ?? 0) >= tools.length)) return "replying"
+  return tools.length ? "tools" : "thinking"
+}
+
+const SAYS = { idle: "ready when you are", thinking: "hmm, let me think", replying: "writing it up" }
+// Said while the sign-off line is on its way, when none comes back in time, and after a failed turn.
+const WRAPPING_UP = "wrapping up"
+const DONE = "done."
+const FAILED = "hmm, that didn't work"
+// How long to wait for the model's line, and how long a sign-off stays up.
+const SIGN_OFF_WAIT_MS = 5000
+const SIGN_OFF_MS = 8000
+
+// What she says once the turn she was working on ends: the model's line about it when it comes,
+// "done." if it doesn't, then back to waiting.
+function useSignOff(running: boolean, outcome: Status | null | undefined, line: string) {
+  const [phase, setPhase] = useState<"none" | "waiting" | "shown" | "gone">("none")
+  const [fallback, setFallback] = useState("")
+  const was = useRef(running)
+  useEffect(() => {
+    const ended = was.current && !running
+    was.current = running
+    if (running) return setPhase("none")
+    if (!ended) return
+    if (outcome === "failed") {
+      setFallback(FAILED)
+      return setPhase("shown")
+    }
+    setFallback(DONE)
+    setPhase("waiting")
+  }, [running, outcome])
+  useEffect(() => {
+    if (phase === "waiting" && line) setPhase("shown")
+    if (phase === "waiting") {
+      const timer = setTimeout(() => setPhase("shown"), SIGN_OFF_WAIT_MS)
+      return () => clearTimeout(timer)
+    }
+    if (phase === "shown") {
+      const timer = setTimeout(() => setPhase("gone"), SIGN_OFF_MS)
+      return () => clearTimeout(timer)
+    }
+  }, [phase, line])
+  // She keeps her happy face while she signs off, and only waves for the next message after.
+  // The render a turn ends in, before the effect above moves on: already signing off, so the
+  // bubble doesn't flash the waiting line first.
+  const ending = phase === "none" && was.current && !running
+  if (ending && outcome === "failed") return { text: FAILED, waiting: false, proud: false }
+  if (phase === "waiting" || ending) return { text: "", waiting: true, proud: true }
+  if (phase === "shown") return { text: (fallback === FAILED ? "" : line) || fallback, waiting: false, proud: fallback !== FAILED }
+  return { text: "", waiting: false, proud: false }
+}
+
+// The busy stickers are animations of a few hundred kB each. Fetching them while she's idle means
+// the first turn shows her thinking at once instead of an empty frame while the file downloads.
+let warmed = false
+function warmStickers() {
+  if (warmed) return
+  warmed = true
+  const still = matchMedia("(prefers-reduced-motion: reduce)").matches
+  const load = () => {
+    for (const state of ["thinking", "tools", "replying"] satisfies Activity[]) new Image().src = `/nako/${state}${still ? "-still.png" : ".webp"}`
+  }
+  if ("requestIdleCallback" in window) requestIdleCallback(load, { timeout: 3000 })
+  else setTimeout(load, 1500)
+}
+
+type Shown = { id: string; node: ReactNode }
+
+// Swaps what's inside when `id` changes: the old line slides up and out as the new one rises in.
+function Swap({ id, children }: { id: string; children: ReactNode }) {
+  const shown = useRef<Shown>({ id, node: children })
+  const [leaving, setLeaving] = useState<Shown | null>(null)
+  useLayoutEffect(() => {
+    if (shown.current.id !== id) setLeaving(shown.current)
+  }, [id])
+  useLayoutEffect(() => {
+    shown.current = { id, node: children }
+  })
+  return (
+    <span className="-my-1 grid min-w-0 overflow-hidden py-1">
+      {leaving && (
+        <span aria-hidden className="presence-out col-start-1 row-start-1 min-w-0" key={`out-${leaving.id}`} onAnimationEnd={() => setLeaving(null)}>
+          {leaving.node}
+        </span>
+      )}
+      <span className="presence-in col-start-1 row-start-1 min-w-0" key={id}>
+        {children}
+      </span>
+    </span>
+  )
+}
+
+// Nako docked above the composer, thinking out loud. During a turn her sticker shows what she's
+// doing and the bubble says it (the tool she's on, one at a time); afterwards she signs off and
+// waits, and stays while the person types. Bare: the floating panel, where her sticker already
+// floats outside, so only the bubble shows.
+export function Presence({
+  live,
+  running,
+  outcome,
+  signOff: line,
+  bare = false,
+}: { live: Live | null; running: boolean; outcome?: Status | null; signOff: string; bare?: boolean }) {
+  const signOff = useSignOff(running, outcome, line)
+  useEffect(() => {
+    if (!bare) warmStickers()
+  }, [bare])
+  const now: Activity = running ? activity(live) : signOff.proud ? "replying" : "idle"
+  const tool = now === "tools" ? (live?.tools.findLast(t => t.state === "running") ?? live?.tools.at(-1)) : undefined
+  const busy = running || signOff.waiting
+  const said = tool
+    ? `${tool.name}${tool.context ? ` ${tool.context}` : ""}`
+    : running
+      ? SAYS[now as keyof typeof SAYS]
+      : signOff.waiting
+        ? WRAPPING_UP
+        : signOff.text || SAYS.idle
+  return (
+    <div aria-live="polite" className={`mx-auto flex w-full max-w-3xl items-end gap-2.5 pb-1 ${bare ? "px-3" : "px-4"}`} data-activity={now}>
+      {!bare && (
+        <picture className="-ml-1.5 size-[76px] shrink-0">
+          <source media="(prefers-reduced-motion: reduce)" srcSet={`/nako/${now}-still.png`} />
+          <img alt="" className="size-full" src={`/nako/${now}.webp`} />
+        </picture>
+      )}
+      {/* A thought bubble: raised beside her head, with two puffs trailing down to her. Bare, it sits
+          on the composer with no puffs, since there's no her to trail to. */}
+      <div className={`relative min-w-0 max-w-[17rem] rounded-3xl border bg-card px-4 py-2 text-sm ${bare ? "mb-1" : "mb-[50px] -ml-2"}`} data-bubble>
+        {!bare && (
+          <>
+            <span aria-hidden className="absolute -bottom-4 left-1 size-3 rounded-full border bg-card" />
+            <span aria-hidden className="absolute bottom-[-29px] -left-1.5 size-[7px] rounded-full border bg-card" />
+          </>
+        )}
+        <Swap id={tool ? `tool:${tool.id || tool.name}` : said}>
+          {busy ? (
+            <Shimmer as="span" className={tool ? "block truncate" : undefined}>
+              {said}
+            </Shimmer>
+          ) : (
+            said
+          )}
+        </Swap>
+      </div>
+    </div>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/preset-emoji.tsx b/plugins/nako-portal/web/src/components/portal/preset-emoji.tsx
