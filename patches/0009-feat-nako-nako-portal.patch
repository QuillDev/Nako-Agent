+      <ProviderMark slug={provider.slug} className="size-[18px]" />
+      <span className="min-w-0 flex-1 truncate">{provider.label}</span>
+      {provider.connected && <CheckIcon className="size-4 text-primary" />}
+      <ChevronRightIcon className="size-4 text-muted-foreground" />
+    </button>
+  )
+  return (
+    <>
+      <DialogHeader className="flex-row items-center gap-2 text-left">
+        <DialogTitle className="min-w-0 flex-1 font-medium text-sm leading-8">Add a provider</DialogTitle>
+        <CloseButton />
+      </DialogHeader>
+      <label className="flex h-10 items-center gap-2 rounded-full border border-input bg-background px-3.5">
+        <SearchIcon className="size-4 shrink-0 text-muted-foreground" />
+        <input
+          aria-label="Search providers"
+          className="h-full min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
+          onChange={e => setQuery(e.target.value)}
+          placeholder="Search providers"
+          spellCheck={false}
+          value={query}
+        />
+      </label>
+      <div className="-mx-4 max-h-[60vh] overflow-y-auto px-4">
+        {accounts.length > 0 && <p className="pt-1 pb-1 text-muted-foreground text-xs">Sign in with an account</p>}
+        {accounts.map(row)}
+        {keys.length > 0 && <p className="pt-3 pb-1 text-muted-foreground text-xs">API key</p>}
+        {keys.map(row)}
+        {shown.length === 0 && <p className="py-3 text-muted-foreground text-sm">Nothing matches {query.trim()}.</p>}
+      </div>
+    </>
+  )
+}
+
+type Open = { kind: "provider"; slug: string } | { kind: "add" } | null
+
+const SAMPLE_PROVIDERS: Provider[] = [
+  { slug: "claude-subscription-directsdk-experimental", label: "Claude Subscription", description: "", kind: "cli", command: "", connected: true, source: "", env_var: "", env_vars: [], signup_url: "" },
+  { slug: "openai-codex", label: "ChatGPT or Codex Subscription", description: "", kind: "signin", command: "", connected: true, source: "", env_var: "", env_vars: [], signup_url: "" },
+  { slug: "openrouter", label: "OpenRouter", description: "", kind: "key", command: "", connected: true, source: "", env_var: "", env_vars: [], signup_url: "" },
+]
+
+/** Settings > Providers: what Hermes can run on, what's set up, and adding the rest. */
+export function ProvidersSettings({ onError }: { onError: (message: string) => void }) {
+  const providers = useProviders()
+  const [open, setOpen] = useState<Open>(null)
+  if (providers === false) return <p className="text-muted-foreground text-sm">Unavailable on this portal.</p>
+  const current = providers && open?.kind === "provider" ? providers.find(p => p.slug === open.slug) : undefined
+  const close = () => setOpen(null)
+  return (
+    <>
+      <ProviderListHeader onAdd={providers ? () => setOpen({ kind: "add" }) : undefined} />
+      <Skullet data={providers} id="settings-providers" label="Loading providers…" sample={SAMPLE_PROVIDERS}>
+        {rows => {
+          const connected = rows.filter(p => p.connected || (p.accounts?.length ?? 0) > 0)
+          return (
+            <div className="flex flex-col">
+              {connected.map(p => (
+                <button
+                  className="flex w-full items-center gap-3 rounded-md px-1 py-2.5 text-left outline-none hover:bg-accent focus-visible:bg-accent"
+                  key={p.slug}
+                  onClick={() => setOpen({ kind: "provider", slug: p.slug })}
+                  type="button"
+                >
+                  <ProviderMark slug={p.slug} className="size-[18px]" />
+                  <span className="min-w-0 flex-1">
+                    <span className="block truncate text-sm">{p.label}</span>
+                    <span className="block truncate text-muted-foreground text-xs">{p.kind === "key" ? "API key" : p.accounts?.some(a => !a.signed_in) ? "needs sign-in" : "signed in"}</span>
+                  </span>
+                  <ChevronRightIcon className="size-4 text-muted-foreground" />
+                </button>
+              ))}
+              {connected.length === 0 && <p className="px-1 py-2 text-muted-foreground text-sm">Nothing set up yet.</p>}
+            </div>
+          )
+        }}
+      </Skullet>
+      {providers && (
+      <Dialog onOpenChange={next => !next && close()} open={open !== null}>
+        <DialogContent className={PANEL} data-provider-panel={open?.kind === "add" ? "add" : current?.slug || ""} onOpenAutoFocus={e => e.preventDefault()} showCloseButton={false}>
+          {open?.kind === "add" ? (
+            <AddPanel
+              onPick={provider => setOpen({ kind: "provider", slug: provider.slug })}
+              rows={providers}
+            />
+          ) : current ? (
+            current.accounts ? (
+              <AccountsPanel key={current.slug} onError={onError} provider={current} />
+            ) : current.kind === "key" ? (
+              current.connected ? (
+                <KeyPanel key={current.slug} onClose={close} onError={onError} provider={current} />
+              ) : (
+                <NewKeyPanel key={current.slug} onClose={close} onError={onError} provider={current} />
+              )
+            ) : current.kind === "signin" ? (
+              <SignInPanel key={current.slug} onDone={close} onError={onError} provider={current} />
+            ) : (
+              <CommandPanel key={current.slug} provider={current} />
+            )
+          ) : null}
+        </DialogContent>
+      </Dialog>
+      )}
+    </>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/requests.tsx b/plugins/nako-portal/web/src/components/portal/requests.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1ed53f2a6d79eb742586f53b4e156875252b7c4c
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/requests.tsx
@@ -0,0 +1,86 @@
+import { memo, useEffect, useState } from "react"
+import { Confirmation, ConfirmationAction, ConfirmationActions, ConfirmationRequest, ConfirmationTitle } from "@/components/ai-elements/confirmation"
+import { Suggestion, Suggestions } from "@/components/ai-elements/suggestion"
+import { Button } from "@/components/ui/button"
+import { Input } from "@/components/ui/input"
+import type { Portal } from "@/hooks/use-portal"
+import { checkBuild } from "@/lib/fresh-build"
+import type { PortalRequest } from "@/lib/types"
+
+const APPROVAL_LABELS: Record<string, string> = { once: "Allow once", session: "Allow this session", always: "Always allow", deny: "Deny" }
+
+function Approval({ request, answer }: { request: PortalRequest; answer: Portal["answer"] }) {
+  const p = request.params
+  return (
+    <Confirmation approval={{ id: request.id }} state="approval-requested">
+      <ConfirmationTitle>
+        <span className="font-medium">Needs your ok.</span> {p.description}
+      </ConfirmationTitle>
+      {p.command && <pre className="overflow-x-auto rounded-md bg-muted p-2 text-xs">{p.command}</pre>}
+      <ConfirmationRequest>
+        <ConfirmationActions className="flex-wrap justify-start">
+          {(p.choices || []).map(choice => (
+            <ConfirmationAction key={choice} onClick={() => answer(request.id, { choice })} variant={choice === "deny" ? "outline" : "default"}>
+              {APPROVAL_LABELS[choice] || choice}
+            </ConfirmationAction>
+          ))}
+        </ConfirmationActions>
+      </ConfirmationRequest>
+    </Confirmation>
+  )
+}
+
+// AI Elements has no multiple-question element, so a clarify request is its questions
+// with the offered choices as suggestions and a free-text answer for each.
+function Clarify({ request, answer }: { request: PortalRequest; answer: Portal["answer"] }) {
+  const questions = request.params.questions || []
+  const [answers, setAnswers] = useState<Record<string, string>>({})
+  const pick = (qid: string, value: string) => {
+    if (questions.length === 1) return answer(request.id, { answers: { [qid]: value } })
+    setAnswers(a => ({ ...a, [qid]: value }))
+  }
+  return (
+    <div className="flex flex-col gap-4 rounded-lg border p-4">
+      {questions.map(q => (
+        <div className="flex flex-col gap-2" key={q.qid}>
+          <p className="text-sm">{q.question}</p>
+          {(q.choices || []).length > 0 && (
+            <Suggestions>
+              {q.choices!.map(choice => (
+                <Suggestion key={choice} onClick={value => pick(q.qid, value)} suggestion={choice} />
+              ))}
+            </Suggestions>
+          )}
+          <Input aria-label={q.question} onChange={e => setAnswers(a => ({ ...a, [q.qid]: e.target.value }))} placeholder="Your answer" value={answers[q.qid] || ""} />
+        </div>
+      ))}
+      <div>
+        <Button
+          onClick={() => answer(request.id, { answers: Object.fromEntries(questions.map(q => [q.qid, answers[q.qid]?.trim() || null])) })}
+          size="sm"
+        >
+          Answer
+        </Button>
+      </div>
+    </div>
+  )
+}
+
+// A kind of request this page predates: the server already has a newer page that can answer it.
+function UnknownRequest({ method }: { method: string }) {
+  useEffect(() => void checkBuild(true), [])
+  return <p className="rounded-lg border p-4 text-muted-foreground text-sm">{method}: reload the page to answer this one.</p>
+}
+
+// A secret request isn't drawn here: it takes over the composer (SecretComposer).
+export const Requests = memo(function Requests({ requests, answer }: { requests: PortalRequest[]; answer: Portal["answer"] }) {
+  return requests.map(r =>
+    r.method === "approval" ? (
+      <Approval answer={answer} key={r.id} request={r} />
+    ) : r.method === "clarify" ? (
+      <Clarify answer={answer} key={r.id} request={r} />
+    ) : r.method === "secret" ? null : (
+      <UnknownRequest key={r.id} method={r.method} />
+    ),
+  )
+})
