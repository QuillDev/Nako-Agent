diff --git a/plugins/nako-portal/web/src/lib/retryable-loader.ts b/plugins/nako-portal/web/src/lib/retryable-loader.ts
new file mode 100644
index 0000000000000000000000000000000000000000..787a0ff6211434ce69a2af3aea750255b85e11fe
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/retryable-loader.ts
@@ -0,0 +1,32 @@
+/** One shared import at a time, with failures cleared so a user can retry. */
+export function retryableLoader<T>(importer: () => Promise<T>) {
+  let value: T | null = null
+  let error: unknown = null
+  let pending: Promise<T> | null = null
+  const listeners = new Set<() => void>()
+  const notify = () => { for (const listener of listeners) listener() }
+  const load = (): Promise<T> => {
+    if (value !== null) return Promise.resolve(value)
+    if (pending) return pending
+    error = null
+    pending = Promise.resolve().then(importer).then(result => {
+      value = result
+      pending = null
+      notify()
+      return result
+    }, reason => {
+      pending = null
+      error = reason
+      notify()
+      throw reason
+    })
+    notify()
+    return pending
+  }
+  return {
+    load,
+    get: () => value,
+    error: () => error,
+    subscribe: (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener) } },
+  }
+}
diff --git a/plugins/nako-portal/web/src/lib/secrets.ts b/plugins/nako-portal/web/src/lib/secrets.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a6da90ad7d4e4a84bd19c3d5640cccc31f8a8a4b
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/secrets.ts
@@ -0,0 +1,72 @@
+// Secrets the agent and you hand each other by name. The agent-secrets plugin keeps them; the
+// portal is where you type and reveal them. A reply shows one with a `SECRET:NAME` line; hub.py's
+// SECRET_LINE matches the same shape for notifications.
+import { useSyncExternalStore } from "react"
+import { api, ApiError } from "@/lib/api"
+
+export type SecretInfo = { name: string; note: string; origin: "you" | "agent"; created_at: number; updated_at: number }
+
+const LINE = /^[^\S\n]*SECRET:([A-Za-z_][A-Za-z0-9_]{0,63})[^\S\n]*$/gm
+const CODE = /```[\s\S]*?(?:```|$)|`[^`\n]*`/g
+
+export type ReplyPart = { text: string; secret?: undefined } | { secret: string; text?: undefined }
+
+/** A reply cut at its SECRET: lines, so each secret shows where the line was. Lines inside code
+ * stay text, and so does a last line still streaming in (its name may not be complete yet). */
+export function splitSecrets(text: string, streaming = false): ReplyPart[] {
+  const masked = text.replace(CODE, m => " ".repeat(m.length))
+  const found = [...masked.matchAll(LINE)].filter(m => !streaming || m.index + m[0].length < text.trimEnd().length)
+  if (!found.length) return [{ text }]
+  const parts: ReplyPart[] = []
+  let at = 0
+  for (const m of found) {
+    const before = text.slice(at, m.index).trim()
+    if (before) parts.push({ text: before })
+    parts.push({ secret: m[1] })
+    at = m.index + m[0].length
+  }
+  const after = text.slice(at).trim()
+  if (after) parts.push({ text: after })
+  return parts
+}
+
+export const secretPath = (name: string) => `/api/secrets/${encodeURIComponent(name)}`
+
+export const revealSecret = (name: string) => api<SecretInfo & { value: string }>(secretPath(name)).then(s => s.value)
+
+// The stored names and notes, shared by every card and Settings; reloaded on `secrets.changed`.
+// null until the first read; false when the server has no secrets plugin.
+let list: SecretInfo[] | false | null = null
+let loading: Promise<void> | null = null
+const listeners = new Set<() => void>()
+
+export function reloadSecrets() {
+  loading = api<SecretInfo[]>("/api/secrets").then(
+    rows => {
+      list = rows
+      for (const l of listeners) l()
+    },
+    e => {
+      list = e instanceof ApiError && e.status === 404 ? false : list || false
+      for (const l of listeners) l()
+    },
+  )
+  return loading
+}
+
+// A name a reply shows that the list doesn't have yet (stored by a command just now): read again
+// once before calling it gone.
+const rechecked = new Set<string>()
+export function recheckSecret(name: string) {
+  if (rechecked.has(name)) return null
+  rechecked.add(name)
+  return reloadSecrets()
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener)
+  if (!loading) void reloadSecrets()
+  return () => listeners.delete(listener)
+}
+
+export const useSecrets = () => useSyncExternalStore(subscribe, () => list)
diff --git a/plugins/nako-portal/web/src/lib/session-refs.ts b/plugins/nako-portal/web/src/lib/session-refs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5fe494c6deb6f58729ef6368b38368ac1779e52c
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/session-refs.ts
@@ -0,0 +1,61 @@
+// `@session:<profile>/<id>` references, the form Hermes's session search tells Nako to cite a past
+// chat in. Hermes Desktop draws them as links to the chat; here they become links to the chat's
+// page in the portal, labelled with its title once the chat list knows it.
+import { useSyncExternalStore } from "react"
+
+// Same match as Hermes Desktop (`apps/desktop/src/lib/session-refs.ts`): a bare value or one
+// fenced in backticks/quotes, not inside a word, a path or a markdown link a reply already wrote.
+const SESSION_REF = /(?<![\w/])(?<!]\()@session:(`[^`\n]+`|"[^"\n]+"|'[^'\n]+'|\S+)/g
+const TRAILING = /[,.;:!?)\]}]+$/
+// What the portal's chat route accepts (`parseRoute`).
+const SESSION_ID = /^[\w.-]+$/
+// Code fences and inline code spans, which show references as typed.
+const CODE = /(```[\s\S]*?(?:```|$)|`[^`\n]*`)/g
+
+export const CHAT_HREF = "#/c/"
+
+/** The chat a reference points at, or null when it isn't one the portal can open. */
+export function sessionOf(value: string): string | null {
+  const id = value.slice(value.indexOf("/") + 1).trim()
+  return SESSION_ID.test(id) ? id : null
+}
+
+/** A chat id short enough to read, for a chat the list doesn't know the title of. */
+export const shortId = (id: string) => (id.length > 10 ? `${id.slice(0, 8)}…` : id)
+
+function linkify(text: string) {
+  return text.replace(SESSION_REF, (match, raw: string) => {
+    const fenced = /^([`"']).*\1$/.test(raw) && raw.length > 1
+    const value = fenced ? raw.slice(1, -1) : raw.replace(TRAILING, "")
+    const session = sessionOf(value)
+    if (!session) return match
+    const trailing = fenced ? "" : raw.slice(value.length)
+    return `[${shortId(session).replace(/[[\]\\]/g, "\\$&")}](${CHAT_HREF}${session})${trailing}`
+  })
+}
+
+/** The reply with each reference outside code turned into a markdown link to its chat. */
+export function linkSessionRefs(text: string): string {
+  if (!text.includes("@session:")) return text
+  return text
+    .split(CODE)
+    .map((part, i) => (i % 2 ? part : linkify(part)))
+    .join("")
+}
+
+// Chat titles from the sidebar's list, so a link can read as the chat's name.
+let titles = new Map<string, string>()
+const listeners = new Set<() => void>()
+
+export function rememberTitles(rows: { id: string; title: string }[]) {
+  titles = new Map(rows.filter(row => row.title).map(row => [row.id, row.title]))
+  for (const listener of listeners) listener()
+}
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+/** The chat's title, or an empty string while the list doesn't have it. */
+export const useChatTitle = (session: string) => useSyncExternalStore(subscribe, () => titles.get(session) ?? "")
diff --git a/plugins/nako-portal/web/src/lib/table-copy.ts b/plugins/nako-portal/web/src/lib/table-copy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6a79975c3eef6717ccd53e7c883c7abf8bbd9cb5
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/table-copy.ts
@@ -0,0 +1,29 @@
+// Streamdown's table copy button opens a Markdown/CSV/TSV menu. We only want TSV (it pastes
+// straight into a spreadsheet), so catch the click before Streamdown sees it and copy at once.
+// The HTML copy goes along too, so rich editors keep the rows and columns.
+import { loadedMarkdown } from "./markdown"
+
+const FLASH_MS = 1500
+
+document.addEventListener(
+  "click",
+  async e => {
+    const button = (e.target as Element | null)?.closest<HTMLButtonElement>('button[title="Copy table"]')
+    const table = button?.closest('[data-streamdown="table-wrapper"]')?.querySelector("table")
+    // A table on screen means the renderer that drew it is loaded.
+    const markdown = loadedMarkdown()
+    if (!button || !table || !markdown) return
+    e.preventDefault()
+    e.stopPropagation()
+    const tsv = markdown.tableDataToTSV(markdown.extractTableDataFromElement(table))
+    await navigator.clipboard.write([
+      new ClipboardItem({
+        "text/plain": new Blob([tsv], { type: "text/plain" }),
+        "text/html": new Blob([table.outerHTML], { type: "text/html" }),
+      }),
+    ])
+    button.dataset.copied = ""
+    setTimeout(() => delete button.dataset.copied, FLASH_MS)
+  },
+  true,
+)
diff --git a/plugins/nako-portal/web/src/lib/theme.ts b/plugins/nako-portal/web/src/lib/theme.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3cec45fedc8d5eee22b3c844121384380b6b1443
--- /dev/null
+++ b/plugins/nako-portal/web/src/lib/theme.ts
@@ -0,0 +1,38 @@
+// Light, dark, or follow the device. public/theme.js applies the same choice before first paint.
+import { useSyncExternalStore } from "react"
+
+export type Theme = "system" | "light" | "dark"
+
+const KEY = "theme"
+const LIGHT = "(prefers-color-scheme: light)"
+const listeners = new Set<() => void>()
+
+function stored(): Theme {
+  const value = localStorage.getItem(KEY)
+  return value === "light" || value === "dark" ? value : "system"
+}
+
+function apply() {
+  const theme = stored()
+  const light = theme === "light" || (theme === "system" && matchMedia(LIGHT).matches)
+  const root = document.documentElement
+  root.classList.toggle("light", light)
+  root.classList.toggle("dark", !light)
+  document.querySelector('meta[name="theme-color"]')?.setAttribute("content", light ? "#fbfbfc" : "#09090b")
+}
+
+matchMedia(LIGHT).addEventListener("change", apply)
+
+export function setTheme(theme: Theme) {
+  if (theme === "system") localStorage.removeItem(KEY)
+  else localStorage.setItem(KEY, theme)
+  apply()
+  for (const listener of listeners) listener()
+}
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+export const useTheme = () => useSyncExternalStore(subscribe, stored)
