@@ -0,0 +1,81 @@
+import { ChevronRightIcon, PlusIcon, SearchIcon } from "lucide-react"
+import { Button } from "@/components/ui/button"
+import { Skullet } from "@/components/ui/skeleton"
+
+export function ProviderListHeader({ onAdd }: { onAdd?: () => void }) {
+  return <div className="flex min-h-8 items-center justify-between gap-3"><span className="text-muted-foreground text-xs">Accounts and keys this profile can run on</span>
+    <Button className="shrink-0" disabled={!onAdd} onClick={onAdd} size="sm" variant="outline"><PlusIcon />Add a provider</Button>
+  </div>
+}
+
+const ROW_PAGES = new Set(["general", "notifications", "nako", "profile", "presets", "signoff", "account", "gateway"])
+const PAGE_IDS: Record<string, string> = {
+  providers: "settings-providers",
+  secrets: "settings-secrets",
+  mcp: "settings-mcp",
+  mesh: "settings-mesh",
+  environments: "settings-environments",
+  gateway: "settings-gateway",
+  profile: "settings-profile",
+  presets: "settings-presets",
+  signoff: "settings-signoff",
+  account: "settings-passkeys",
+}
+
+export function SettingsLoading({ page, rows = 3 }: { page: string; rows?: number }) {
+  const search = page === "mcp" || page === "secrets"
+  const id = PAGE_IDS[page]
+  const body = page === "mesh" ? (
+    <div className="flex flex-col gap-4">
+      <div className="relative mx-auto aspect-square w-full max-w-xl sm:aspect-[4/3]">
+        <svg className="absolute size-full stroke-border" preserveAspectRatio="none" viewBox="0 0 100 100" {...{ "skullet-ignore": "" }}>{[[50, 18], [20, 68], [80, 68]].map(([x, y]) => <line key={x} x1="50" y1="50" x2={x} y2={y} vectorEffect="non-scaling-stroke" />)}</svg>
+        {[[50, 50, "hub"], [50, 18, "laptop"], [20, 68, "desktop"], [80, 68, "homelab"]].map(([x, y, name], i) => (
+          <div key={String(name)} style={{ left: `${x}%`, top: `${y}%` }} className="absolute flex -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-1.5">
+            <span className={i ? "size-12 rounded-full border-2 bg-card" : "size-14 rounded-full border-2 bg-card"} {...{ "skullet-block": "" }} />
+            <span className="font-medium text-sm">{name}</span>
+          </div>
+        ))}
+      </div>
+      <div className="flex justify-end"><Button size="sm" variant="outline"><PlusIcon />Add machine</Button></div>
+    </div>
+  ) : ROW_PAGES.has(page) ? (
+    <div className="flex flex-col gap-2">
+      {Array.from({ length: rows }, (_, i) => (
+        <div className="flex min-h-9 items-center justify-between gap-4 text-sm" key={i}>
+          <span>Setting option</span>
+          <Button size="sm" variant="outline">Current value</Button>
+        </div>
+      ))}
+    </div>
+  ) : (
+    <div className="flex flex-col gap-2">
+      {search && (
+        <div className="flex items-center gap-2 pb-1">
+          <div className="flex h-10 min-w-0 flex-1 items-center gap-2 rounded-full border border-input bg-card px-3.5" {...{ "skullet-block": "" }}>
+            <SearchIcon className="size-4 shrink-0" />
+            <span className="text-sm">Search</span>
+          </div>
+          <Button className="size-10 rounded-full" size="icon"><PlusIcon className="size-[18px]" /></Button>
+        </div>
+      )}
+      <div className="flex flex-col">
+        {Array.from({ length: rows }, (_, index) => (
+          <div key={index} className="flex items-center gap-3 px-1 py-2.5">
+            {page === "providers" && <span className="size-[18px] shrink-0 rounded-full" {...{ "skullet-block": "" }} />}
+            <span className="flex min-w-0 flex-1 flex-col">
+              <span className="truncate text-sm">Provider or server name</span>
+              <span className="truncate text-muted-foreground text-xs">connected</span>
+            </span>
+            <ChevronRightIcon className="size-4 shrink-0 text-muted-foreground" />
+          </div>
+        ))}
+      </div>
+    </div>
+  )
+  return (
+    <div className="flex flex-col gap-2">
+      {page === "providers" && <ProviderListHeader />}
+      <Skullet id={id} label="Loading settings…" loading>{body}</Skullet>
+    </div>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/settings.tsx b/plugins/nako-portal/web/src/components/portal/settings.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f9f76dd1e083d27ba67376734d153ff41808653f
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/settings.tsx
@@ -0,0 +1,327 @@
+import { lazy, Suspense, useCallback, useEffect, useState } from "react"
+import { forgetShapes } from "skullet"
+import { Button } from "@/components/ui/button"
+import { Input } from "@/components/ui/input"
+import { Skullet } from "@/components/ui/skeleton"
+import { SearchableDropdown } from "@/components/ui/searchable-dropdown"
+import { Switch } from "@/components/ui/switch"
+import { GatewayRestart } from "./gateway-restart"
+import { type Portal } from "@/hooks/use-portal"
+import { api, ApiError } from "@/lib/api"
+import { cancelled, register } from "@/lib/passkeys"
+import { appAlerts, appBubble, enablePush, openAppNotificationSettings, pushState, setAppBubble } from "@/lib/push"
+import { setPresence, usePresence } from "@/lib/presence"
+import { setTheme, type Theme, useTheme } from "@/lib/theme"
+import { useEnvironments } from "@/lib/environments"
+import { useMesh } from "@/lib/mesh"
+import { useMcp } from "@/lib/mcp"
+import { useProviders } from "@/lib/providers"
+import { useSecrets } from "@/lib/secrets"
+import type { Passkey } from "@/lib/types"
+import { SettingsFrame, SettingsPlaceholder } from "./settings-frame"
+import { SettingsLoading } from "./settings-loading"
+import { useUsage } from "@/lib/usage"
+import { type ModelChoice, modelChoice, ModelPicker } from "./model-picker"
+
+const McpSettings = lazy(() => import("./mcp").then(m => ({ default: m.McpSettings })))
+const ProvidersSettings = lazy(() => import("./providers").then(m => ({ default: m.ProvidersSettings })))
+const SignOffSettings = lazy(() => import("./sign-off-settings").then(m => ({ default: m.SignOffSettings })))
+const EnvironmentsSettings = lazy(() => import("./environments").then(m => ({ default: m.EnvironmentsSettings })))
+const MeshSettings = lazy(() => import("./mesh").then(m => ({ default: m.MeshSettings })))
+const UsageSettings = lazy(() => import("./usage-settings").then(m => ({ default: m.UsageSettings })))
+const ModelPresetSettings = lazy(() => import("./model-preset-settings").then(m => ({ default: m.ModelPresetSettings })))
+const SecretsSettings = lazy(() => import("./secrets-settings").then(m => ({ default: m.SecretsSettings })))
+
+const THEMES: Theme[] = ["system", "light", "dark"]
+
+const PUSH_NOTE = { unsupported: "unsupported here", blocked: "blocked in browser settings" }
+
+export function Row({ label, children }: { label: React.ReactNode; children?: React.ReactNode }) {
+  return (
+    <div className="flex min-h-9 items-center justify-between gap-4 text-sm">
+      <span className="min-w-0 shrink-0 max-w-[55%]">{label}</span>
+      {children}
+    </div>
+  )
+}
+
+// Pick one of a few short options, e.g. the theme.
+function Segmented<T extends string>({ options, value, onPick }: { options: readonly T[]; value: T; onPick: (option: T) => void }) {
+  return (
+    <div className="inline-flex gap-0.5 rounded-lg border bg-card p-0.5">
+      {options.map(option => (
+        <button
+          aria-pressed={value === option}
+          className="rounded-md px-2.5 py-1 text-muted-foreground text-xs outline-none aria-pressed:bg-accent aria-pressed:text-foreground"
+          key={option}
+          onClick={() => onPick(option)}
+          type="button"
+        >
+          {option}
+        </button>
+      ))}
+    </div>
+  )
+}
+
+type Profiles = { profile: string; profiles: string[] }
+
+const SAMPLE_PROFILE: Profiles = { profile: "default", profiles: ["default", "work"] }
+const SAMPLE_MODEL: ModelChoice = {
+  provider: "anthropic",
+  model: "claude-sonnet-5-5",
+  providers: [{ provider: "anthropic", label: "Anthropic", models: ["claude-sonnet-5-5"] }],
+}
+const SAMPLE_PASSKEYS: Passkey[] = [{ id: "sample", label: "MacBook Pro", current: true }]
+
+// Which Hermes profile the portal shows, and the model that profile runs on. Switching
+// profiles swaps every chat for that profile's; the model belongs to the profile shown.
+function ProfileRows({ onError }: { onError: (message: string) => void }) {
+  const [state, setState] = useState<Profiles | null>(null)
+  const [model, setModel] = useState<ModelChoice | null | false>(null)
+  const [profileFailed, setProfileFailed] = useState(false)
+  const fail = useCallback((e: unknown) => onError((e as Error).message), [onError])
+  useEffect(() => {
+    let active = true
+    api<Profiles>("/api/profile").then(value => { if (active) setState(value) }, e => { if (active) { setProfileFailed(true); fail(e) } })
+    return () => { active = false }
+  }, [fail])
+  const shown = state?.profile
+  useEffect(() => {
+    if (!shown) return
+    let active = true
+    setModel(null)
+    api<unknown>("/api/model").then(raw => { if (active) setModel(modelChoice.parse(raw)) }).catch(e => {
+      if (!active) return
+      setModel(false)
+      if (!(e instanceof ApiError && e.status === 404)) fail(e)
+    })
+    return () => { active = false }
+  }, [shown, fail])
+  if (!state && profileFailed) return null
+  const pick = (profile: string) => state && profile !== state.profile && api<Profiles>("/api/profile", { method: "POST", body: { profile } }).then(setState, fail)
+  const pickModel = async (body: { provider?: string; model?: string; effort?: string; speed?: string }) => setModel(modelChoice.parse(await api<unknown>("/api/model", { method: "POST", body })))
+  return (
+    <Skullet data={state} id="settings-profile" label="Loading profile…" sample={SAMPLE_PROFILE}>
+      {profileState => (
+        <div className="flex flex-col gap-2">
+          {profileState.profiles.length > 1 && <ProfileRow onPick={pick} state={profileState} />}
+          {model !== false && (
+            <Skullet data={state ? (model || null) : SAMPLE_MODEL} id="settings-default-model" label="Loading default model…" sample={SAMPLE_MODEL}>
+              {choice => (
+                <div className="flex flex-col gap-2">
+                  <Row label="Default model"><ModelPicker label="default model" named onPick={pickModel} value={choice} /></Row>
+                  {state && model && <Suspense fallback={<SettingsLoading page="presets" rows={1} />}><ModelPresetSettings value={choice} /></Suspense>}
+                </div>
+              )}
+            </Skullet>
+          )}
+        </div>
+      )}
+    </Skullet>
+  )
+}
+
+function ProfileRow({ state, onPick: pick }: { state: Profiles; onPick: (profile: string) => void }) {
+  return (
+    <Row label="Profile">
+      <SearchableDropdown label="Profile" value={state.profile} onPick={pick} className="w-40" align="end"
+        options={state.profiles.map(profile => ({ value: profile, label: profile }))} />
+    </Row>
+  )
+}
+
+export function Settings({ portal, page }: { portal: Portal; page: string | null }) {
+  const [passkeys, setPasskeys] = useState<Passkey[] | null>(null)
+  const [push, setPush] = useState(pushState())
+  const [app, setApp] = useState(appAlerts())
+  const [bubble, setBubble] = useState(appBubble())
+  // Coming back from the phone's notification or overlay settings shows what was picked there.
+  useEffect(() => {
+    const reread = () => {
+      if (document.visibilityState !== "visible") return
+      setApp(appAlerts())
+      setBubble(appBubble())
+    }
+    // The desktop app says when its floating Nako is turned on or off from its tray menu.
+    const floating = () => setBubble(appBubble())
+    document.addEventListener("visibilitychange", reread)
+    window.addEventListener("nako-floating", floating)
+    return () => {
+      document.removeEventListener("visibilitychange", reread)
+      window.removeEventListener("nako-floating", floating)
+    }
+  }, [])
+  const [error, setError] = useState("")
+  const theme = useTheme()
+  const presence = usePresence()
+  const load = useCallback(() => api<Passkey[]>("/api/passkeys").then(setPasskeys, e => { setPasskeys(previous => previous ?? []); setError(e instanceof Error ? e.message : String(e)) }), [])
+  useEffect(() => void load(), [load])
+
+  const attempt = (fn: () => Promise<unknown>) => async () => {
+    setError("")
+    try {
+      await fn()
+    } catch (e) {
+      setError(cancelled(e) ? "Cancelled." : (e as Error).message)
+    }
+  }
+
+  const [usage, setUsage] = useUsage(setError)
+  const secrets = useSecrets()
+  const providers = useProviders()
+  const mcp = useMcp()
+  const mesh = useMesh(portal.machinesSeen)
+  const environments = useEnvironments(Boolean(portal.me?.environments)).data
+  const pages: Record<string, React.ReactNode> = {
+    general: (
+      <>
+        <Row label="Theme">
+          <Segmented onPick={setTheme} options={THEMES} value={theme} />
+        </Row>
+        <Row label="Your name">
+          <Input
+            aria-label="Your name"
+            className="h-8 w-40"
+            defaultValue={portal.me?.name || ""}
+            key={portal.me?.name}
+            maxLength={40}
+            onBlur={e => e.currentTarget.value.trim() !== (portal.me?.name || "") && attempt(() => portal.setName(e.currentTarget.value))()}
+            onKeyDown={e => e.key === "Enter" && e.currentTarget.blur()}
+            placeholder="for the greeting"
+          />
+        </Row>
+      </>
+    ),
+    notifications: (
+      <>
+        {app ? (
+          <Row label="Alerts">
+            {app === "app" ? (
+              <span className="text-muted-foreground text-xs">handled by the app</span>
+            ) : (
+              <Switch checked={app === "on"} label="Alerts" onCheckedChange={openAppNotificationSettings} />
+            )}
+          </Row>
+        ) : (
+          <Row label="Push alerts">
+            {push === "unsupported" || push === "blocked" ? (
+              <span className="text-muted-foreground text-xs">{PUSH_NOTE[push]}</span>
+            ) : (
+              <Switch
+                checked={push === "on"}
+                disabled={push === "on"}
+                label="Push alerts"
+                onCheckedChange={attempt(async () => {
+                  try {
+                    await enablePush()
+                  } finally {
+                    setPush(pushState())
+                  }
+                })}
+              />
+            )}
+          </Row>
+        )}
+        {bubble && (
+          <Row label="Floating Nako">
+            <Switch
+              checked={bubble === "on"}
+              label="Floating Nako"
+              onCheckedChange={on => {
+                setAppBubble(on)
+                setBubble(appBubble())
+              }}
+            />
+          </Row>
+        )}
+      </>
+    ),
+    nako: (
+      <>
+        <Row label="Sticker while she works">
+          <Switch checked={presence} label="Sticker while she works" onCheckedChange={setPresence} />
+        </Row>
+        <div className="flex min-h-20 flex-col gap-2"><Suspense fallback={<SettingsLoading page="signoff" rows={2} />}><SignOffSettings onError={setError} /></Suspense></div>
+        <ProfileRows onError={setError} />
+      </>
+    ),
+    usage: usage !== "unsupported" && usage !== "failed" && <UsageSettings state={usage} providers={providers || null} session={portal.route.view === "settings" ? portal.route.fromChat : undefined} onUpdate={setUsage} onError={setError} />,
+    providers: <ProvidersSettings onError={setError} />,
+    secrets: <SecretsSettings onError={setError} />,
+    mcp: <McpSettings onError={setError} />,
+    gateway: <GatewayRestart />,
+    mesh: <MeshSettings portal={portal} />,
+    environments: <EnvironmentsSettings />,
+    account: (
+      <>
+        <p className="pt-1 pb-1 text-muted-foreground text-xs">Session</p>
+        <Row label="Sign out of this device">
+          <Button
+            className="border-destructive/40 text-destructive hover:text-destructive"
+            onClick={attempt(async () => {
+              await api("/api/logout", { method: "POST" })
+              forgetShapes()
+              location.replace("/")
+            })}
+            size="sm"
+            variant="outline"
+          >
+            Sign out
+          </Button>
+        </Row>
+        <p className="pt-5 pb-1 text-muted-foreground text-xs">Passkeys</p>
+        <div className="flex justify-end">
+          <Button
+            onClick={attempt(async () => {
+              await register(null)
+              await load()
+            })}
+            size="sm"
+            variant="outline"
+          >
+            Add passkey
+          </Button>
+        </div>
+        <Skullet data={passkeys} id="settings-passkeys" label="Loading passkeys…" sample={SAMPLE_PASSKEYS}>
+          {keys => (
+            <div className="flex flex-col gap-2">
+              {keys.map(k => (
+                <Row
+                  key={k.id}
+                  label={
+                    <span className="flex items-center gap-2">
+                      <span className="truncate">{k.label}</span>
+                      {k.current && <span className="rounded-md border px-1.5 text-muted-foreground text-xs">this device</span>}
+                    </span>
+                  }
+                >
+                  {!k.current && (
+                    <Button
+                      onClick={attempt(async () => {
+                        if (!confirm("Remove this passkey? That device will be signed out.")) return
+                        await api(`/api/passkeys/${encodeURIComponent(k.id)}/remove`, { method: "POST" })
+                        await load()
+                      })}
+                      size="sm"
+                      variant="ghost"
+                    >
+                      Remove
+                    </Button>
+                  )}
+                </Row>
+              ))}
+            </div>
+          )}
+        </Skullet>
+      </>
+    ),
+  }
+
+  const shown = page ?? "general"
+  return <SettingsFrame page={page} hasEnvironments={Boolean(portal.me?.environments)} environmentsTitle={environments?.title}
+    unavailable={{ usage: usage === "unsupported", providers: providers === false, secrets: secrets === false, mcp: mcp === false, mesh: mesh !== null && (!mesh || !mesh.hub) }}
+    error={error || portal.error}>
+    <Suspense fallback={<SettingsPlaceholder page={page} />}>{pages[shown] ?? pages.general}</Suspense>
+  </SettingsFrame>
+}
diff --git a/plugins/nako-portal/web/src/components/portal/sidebar-footer.tsx b/plugins/nako-portal/web/src/components/portal/sidebar-footer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e36e61f530ecb041a60acc167869e2f688c2309a
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/sidebar-footer.tsx
@@ -0,0 +1,134 @@
+import { useRef, useState } from "react";
+import { Popover } from "radix-ui";
+import { ArrowDownToLineIcon } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { appVersion, canCheck, checkForUpdate, installDesktopUpdate, useDesktopUpdate } from "@/lib/desktop-update";
+import type { HermesBuild } from "@/lib/types";
+import { cn } from "@/lib/utils";
+
+/** Green while the portal and nako are both reachable, amber while this page reconnects to the portal, red while nako is offline. */
+export function ConnectionDot({
+  connected,
+  linked,
+}: {
+  connected: boolean;
+  linked: boolean;
+}) {
+  const [color, label] = !connected
+    ? ["bg-destructive", "nako is offline"]
+    : !linked
+      ? ["bg-amber-500 animate-pulse", "reconnecting"]
+      : ["bg-emerald-500", "connected"];
+  return (
+    <span
+      aria-label={label}
+      className={cn("ml-2 size-2 shrink-0 rounded-full", color)}
+      role="status"
+      title={label}
+    />
+  );
+}
+
+const CHECK_LABEL = {
+  checking: "checking…",
+  latest: "up to date",
+  error: "couldn't check",
+} as const;
+
+export function HermesVersion({ version }: { version: HermesBuild }) {
+  const [open, setOpen] = useState(false);
+  const leave = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);
+  const enter = () => {
+    clearTimeout(leave.current);
+    setOpen(true);
+  };
+  const exit = () => {
+    leave.current = setTimeout(() => setOpen(false), 180);
+  };
+  return (
+    <>
+      {appVersion && <span aria-hidden="true" className="text-muted-foreground text-xs">·</span>}
+      <Popover.Root open={open} onOpenChange={setOpen}>
+        <Popover.Trigger
+          aria-label={`Hermes ${version.version} build details`}
+          className="ml-1 inline-flex min-h-9 shrink-0 items-center gap-1 rounded-md px-1.5 text-muted-foreground text-xs tabular-nums hover:bg-accent focus-visible:bg-accent"
+          onPointerEnter={(event) => { if (event.pointerType === "mouse") enter(); }}
+          onPointerLeave={(event) => { if (event.pointerType === "mouse") exit(); }}
+          onFocus={(event) => { if (event.currentTarget.matches(":focus-visible")) enter(); }}
+          onBlur={(event) => {
+            if (!event.relatedTarget || !document.getElementById(event.currentTarget.getAttribute("aria-controls") ?? "")?.contains(event.relatedTarget)) exit();
+          }}
+          onClick={(event) => { if (event.detail === 0 || (event.nativeEvent instanceof PointerEvent && event.nativeEvent.pointerType === "mouse")) { event.preventDefault(); enter(); } }}
+        >
+          {/* Nous Research mark, from Hermes Agent's assets/nous-girl-black.svg. */}
+          <img alt="" className="size-4 opacity-65 dark:invert" src="/nous-mark.png" />
+          {version.version}
+        </Popover.Trigger>
+        <Popover.Portal>
+          <Popover.Content
+            aria-label="Hermes Agent build"
+            className="z-50 max-w-[calc(100vw-1rem)] rounded-lg border bg-popover px-3 py-2 text-xs shadow-md"
+            side="top"
+            sideOffset={6}
+            collisionPadding={8}
+            onOpenAutoFocus={(event) => event.preventDefault()}
+            onCloseAutoFocus={(event) => event.preventDefault()}
+            onPointerEnter={(event) => { if (event.pointerType === "mouse") enter(); }}
+            onPointerLeave={(event) => { if (event.pointerType === "mouse") exit(); }}
+          >
+            <div className="mb-0.5 font-medium">Hermes Agent</div>
+            <div className="break-all text-muted-foreground">{version.build}</div>
+          </Popover.Content>
+        </Popover.Portal>
+      </Popover.Root>
+    </>
+  );
+}
+
+/** The app's version; in an app that updates itself, clicking it checks, and a found update gets its button beside it. */
+export function AppVersion() {
+  const update = useDesktopUpdate();
+  if (!appVersion) return <span />;
+  const state = update?.state;
+  const label =
+    (state === "checking" || state === "latest" || state === "error"
+      ? CHECK_LABEL[state]
+      : null) ?? `v${appVersion}`;
+  const ready =
+    (state === "ready" || state === "installing") && update?.version;
+  return (
+    <div className="flex min-w-0 items-center">
+      {canCheck() ? (
+        <button
+          className="rounded-md px-2 py-1 text-muted-foreground text-xs tabular-nums hover:bg-accent hover:text-foreground disabled:pointer-events-none"
+          disabled={state === "checking" || state === "installing"}
+          onClick={checkForUpdate}
+          title={update?.error ?? "Check for updates"}
+          type="button"
+        >
+          {label}
+        </button>
+      ) : (
+        <span className="px-2 text-muted-foreground text-xs tabular-nums">
+          {label}
+        </span>
+      )}
+      {ready && (
+        <Button
+          aria-label={`Update to ${update.version}`}
+          className="text-primary hover:text-primary"
+          onClick={installDesktopUpdate}
+          size="icon"
+          title={
+            update.error
+              ? `Update to ${update.version} (last try: ${update.error})`
+              : `Update to ${update.version}`
+          }
+          variant="ghost"
+        >
+          <ArrowDownToLineIcon />
+        </Button>
+      )}
+    </div>
+  );
+}
diff --git a/plugins/nako-portal/web/src/components/portal/sidebar-rows.tsx b/plugins/nako-portal/web/src/components/portal/sidebar-rows.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..62e60b3ff82ced9fbdb6de150481a29178c353f6
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/sidebar-rows.tsx
@@ -0,0 +1,250 @@
+import { memo, useRef } from "react";
+import { ChevronDownIcon, FolderMinusIcon, PencilIcon, type LucideIcon } from "lucide-react";
+import { ContextMenu, ContextMenuContent, ContextMenuItem, ContextMenuTrigger } from "@/components/ui/context-menu";
+import { type ChatGroup, GROUP_COLORS, type GroupColor, type SessionRow, type Status } from "@/lib/types";
+import { cn } from "@/lib/utils";
+import { GROUP_HEX, GroupSwatch } from "./groups";
+import { type ChatActions, sessionActions } from "./session-actions";
+import { CHAT_DRAG, type ChatDrag } from "./sidebar-utils";
+
+// How long the pointer rests on a chat before it's read ahead of the click.
+const HOVER_MS = 80;
+
+export const DOT: Partial<Record<Status, string>> = {
+  working: "bg-primary animate-pulse",
+  "needs you": "bg-amber-500",
+  failed: "bg-destructive",
+};
+
+// A chat with something you haven't read yet: a reply that landed while you were elsewhere, or a post.
+const NEW = "bg-emerald-500";
+
+type RowProps = {
+  row: SessionRow;
+  selected: boolean;
+  go: (hash: string) => void;
+  prefetch: (session: string) => void;
+  actions: ChatActions;
+  drag?: ChatDrag;
+};
+
+// One chat in the list. It renders again only when its own row, selection or handlers change,
+// so a status dot or a streaming turn elsewhere doesn't redraw the whole list.
+export const ChatRow = memo(function ChatRow({
+  row,
+  selected,
+  go,
+  prefetch,
+  actions,
+  drag,
+}: RowProps) {
+  const hover = useRef<ReturnType<typeof setTimeout>>(undefined);
+  return (
+    <ContextMenu>
+      <ContextMenuTrigger asChild>
+        <button
+          className={cn(
+            "flex w-full select-none items-center gap-2 rounded-md px-2 py-2 text-left text-sm hover:bg-accent data-[state=open]:bg-accent data-[dragging]:opacity-50",
+            selected && "bg-accent",
+          )}
+          // Shift+click pins or unpins instead of opening.
+          onClick={(e) =>
+            e.shiftKey ? actions.pin(row.id, !row.pinned) : go(`#/c/${row.id}`)
+          }
+          // Read the chat while the pointer settles on it, so the click opens it at once.
+          onFocus={() => prefetch(row.id)}
+          onPointerDown={() => prefetch(row.id)}
+          onPointerEnter={() => {
+            clearTimeout(hover.current);
+            hover.current = setTimeout(() => prefetch(row.id), HOVER_MS);
+          }}
+          onPointerLeave={() => clearTimeout(hover.current)}
+          // Another machine's chats can't be grouped.
+          draggable={Boolean(drag && !row.machine)}
+          onDragStart={(e) => {
+            if (!drag) return;
+            e.dataTransfer.setData(CHAT_DRAG, row.id);
+            e.dataTransfer.effectAllowed = "move";
+            e.currentTarget.dataset.dragging = "";
+            drag.start(row);
+          }}
+          onDragEnd={(e) => {
+            delete e.currentTarget.dataset.dragging;
+            drag?.end();
+          }}
+          type="button"
+        >
+          <span className="min-w-0 flex-1 truncate">{row.title}</span>
+          {row.machine && (
+            <span className="max-w-[40%] shrink-0 truncate text-xs text-muted-foreground">{row.machine}</span>
+          )}
+          {row.status && DOT[row.status] ? (
+            <span
+              className={cn("size-2 shrink-0 rounded-full", DOT[row.status])}
+              title={row.status}
+            />
+          ) : (
+            row.finished &&
+            !selected && <span className={cn("size-2 shrink-0 rounded-full", NEW)} title="new reply" />
+          )}
+        </button>
+      </ContextMenuTrigger>
+      <ContextMenuContent>
+        {sessionActions(actions, row.id, Boolean(row.pinned), !row.machine).map((a) => (
+          <ContextMenuItem key={a.label} onSelect={a.run}>
+            <a.icon className="size-4 text-muted-foreground" />
+            {a.label}
+          </ContextMenuItem>
+        ))}
+      </ContextMenuContent>
+    </ContextMenu>
+  );
+});
+
+type GroupProps = {
+  group: ChatGroup;
+  rows: SessionRow[];
+  folded: boolean;
+  open: string | null;
+  fold: (id: string) => void;
+  go: (hash: string) => void;
+  prefetch: (session: string) => void;
+  actions: ChatActions;
+  groupActions: GroupActions;
+  drag?: ChatDrag;
+  // A dragged chat is over this group and would land in it.
+  target: boolean;
+};
+
+type GroupActions = {
+  rename: (group: ChatGroup) => void;
+  recolor: (group: string, color: GroupColor) => void;
+  ungroup: (group: string) => void;
+};
+
+// A chat group: its name row (click folds it; right-click renames, recolors or ungroups) and its chats.
+export const GroupBlock = memo(function GroupBlock({ group, rows, folded, open, fold, go, prefetch, actions, groupActions, drag, target }: GroupProps) {
+  const holdsOpen = rows.some((r) => r.id === open);
+  // Folded, a status dot inside still shows on the name row, or else a new reply's.
+  const dot = folded ? rows.map((r) => r.status).find((s) => s && DOT[s]) : undefined;
+  const fresh = folded && !dot && rows.some((r) => r.finished && r.id !== open);
+  return (
+    <div
+      className={cn("rounded-md", target && "bg-accent")}
+      onDragOver={drag && ((e) => drag.over(e, group.id))}
+      onDrop={drag && ((e) => drag.drop(e, group.id))}
+    >
+      <ContextMenu>
+        <ContextMenuTrigger asChild>
+          <button
+            aria-expanded={!folded}
+            className={cn(
+              "flex w-full select-none items-center gap-2 rounded-md px-2 py-2 text-left text-sm hover:bg-accent data-[state=open]:bg-accent",
+              folded && holdsOpen && "bg-accent",
+            )}
+            onClick={() => fold(group.id)}
+            type="button"
+          >
+            <GroupSwatch color={group.color} />
+            <span className="min-w-0 flex-1 truncate font-medium">{group.name}</span>
+            {dot && <span className={cn("size-2 shrink-0 rounded-full", DOT[dot])} title={dot} />}
+            {fresh && <span className={cn("size-2 shrink-0 rounded-full", NEW)} title="new reply" />}
+            <ChevronDownIcon
+              className={cn("size-4 shrink-0 text-muted-foreground transition-transform", folded && "-rotate-90")}
+            />
+          </button>
+        </ContextMenuTrigger>
+        <ContextMenuContent>
+          <ContextMenuItem onSelect={() => groupActions.rename(group)}>
+            <PencilIcon className="size-4 text-muted-foreground" />
+            Rename group
+          </ContextMenuItem>
+          <div className="flex gap-1.5 px-2 py-1.5">
+            {GROUP_COLORS.map((color) => (
+              <ContextMenuItem
+                aria-label={color}
+                className={cn(
+                  "size-5 rounded-[5px] p-0",
+                  color === group.color && "outline-2 outline-foreground outline-offset-2",
+                )}
+                key={color}
+                onSelect={() => groupActions.recolor(group.id, color)}
+                style={{ background: GROUP_HEX[color] }}
+                title={color}
+              />
+            ))}
+          </div>
+          <ContextMenuItem onSelect={() => groupActions.ungroup(group.id)}>
+            <FolderMinusIcon className="size-4 text-muted-foreground" />
+            Ungroup
+          </ContextMenuItem>
+        </ContextMenuContent>
+      </ContextMenu>
+      {!folded && (
+        <div className="relative pl-5">
+          <span
+            aria-hidden="true"
+            className="pointer-events-none absolute inset-y-0 left-[13px] w-0.5 opacity-70"
+            style={{ background: GROUP_HEX[group.color] }}
+          />
+          {rows.map((row) => (
+            <ChatRow
+              actions={actions}
+              drag={drag}
+              go={go}
+              key={row.id}
+              prefetch={prefetch}
+              row={row}
+              selected={open === row.id}
+            />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+});
+
+// A chat posts land in. The dot is green while a post waits unread, or shows the chat's status.
+export function ChannelRow({
+  row,
+  icon: Icon,
+  fallback,
+  open,
+  go,
+}: {
+  row?: SessionRow;
+  icon: LucideIcon;
+  fallback: string;
+  open: string | null;
+  go: (hash: string) => void;
+}) {
+  return (
+    <button
+      className={cn(
+        "flex w-full select-none items-center gap-2 rounded-md px-2 py-2 text-left text-sm first:mt-2 hover:bg-accent",
+        row && open === row.id && "bg-accent",
+      )}
+      disabled={!row}
+      onClick={() => row && go(`#/c/${row.id}`)}
+      type="button"
+    >
+      <Icon className="size-4 shrink-0 text-muted-foreground" />
+      <span className="min-w-0 flex-1 truncate">{row?.title || fallback}</span>
+      {row?.status && DOT[row.status] ? (
+        <span
+          className={cn("size-2 shrink-0 rounded-full", DOT[row.status])}
+          title={row.status}
+        />
+      ) : (
+        row?.unread &&
+        open !== row.id && (
+          <span
+            className={cn("size-2 shrink-0 rounded-full", NEW)}
+            title="new post"
+          />
+        )
+      )}
+    </button>
+  );
+}
+
diff --git a/plugins/nako-portal/web/src/components/portal/sidebar-utils.ts b/plugins/nako-portal/web/src/components/portal/sidebar-utils.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ee51a5795e45ebd7f69a174037db832880966a13
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/sidebar-utils.ts
@@ -0,0 +1,71 @@
+import { type DragEvent, useCallback, useState } from "react";
+import { age } from "@/lib/times";
+import { d } from "@/lib/decode";
+import type { ChatGroup, SessionRow } from "@/lib/types";
+
+// A line in the list: one chat, or a chat group with its chats (newest first).
+export type Entry =
+  | { kind: "chat"; row: SessionRow }
+  | { kind: "group"; group: ChatGroup; rows: SessionRow[] };
+
+// Pinned chats first, then the rest by age. A group sits where its newest chat would, so it moves
+// up as any of its chats does; the rows come newest first, so the first one met places it.
+export function sections(rows: SessionRow[]) {
+  const out: [string, Entry[]][] = [];
+  const pinned = rows.filter((r) => r.pinned);
+  if (pinned.length) out.push(["pinned", pinned.map((row) => ({ kind: "chat", row }))]);
+  const placed = new Map<string, SessionRow[]>();
+  for (const row of rows.filter((r) => !r.pinned)) {
+    const held = row.group && placed.get(row.group.id);
+    if (held) {
+      held.push(row);
+      continue;
+    }
+    const label = age(row.started_at);
+    let entry: Entry = { kind: "chat", row };
+    if (row.group) {
+      const members = [row];
+      placed.set(row.group.id, members);
+      entry = { kind: "group", group: row.group, rows: members };
+    }
+    const section = out.find(([name]) => name === label);
+    if (section) section[1].push(entry);
+    else out.push([label, [entry]]);
+  }
+  return out;
+}
+
+// Groups folded shut on this device.
+const FOLDED = "nako-folded-groups";
+export function useFolded() {
+  const [folded, setFolded] = useState<Set<string>>(() => {
+    try {
+      return new Set(d.array(d.string()).parse(JSON.parse(localStorage.getItem(FOLDED) || "[]")));
+    } catch {
+      return new Set();
+    }
+  });
+  const toggle = useCallback((id: string) => {
+    setFolded((now) => {
+      const next = new Set(now);
+      if (!next.delete(id)) next.add(id);
+      localStorage.setItem(FOLDED, JSON.stringify([...next]));
+      return next;
+    });
+  }, []);
+  return [folded, toggle] as const;
+}
+
+// Dragging a chat onto a group files it there; dropping it anywhere else in the list takes it out
+// of its group. Only with a mouse: on touch, a long press is the chat's menu.
+export const CHAT_DRAG = "application/x-nako-chat";
+export const canDrag = typeof matchMedia === "function" && !matchMedia("(pointer: coarse)").matches;
+
+export type ChatDrag = {
+  start: (row: SessionRow) => void;
+  end: () => void;
+  // `group` is where the chat would land: a group id, or null for out of its group.
+  over: (e: DragEvent, group: string | null) => void;
+  drop: (e: DragEvent, group: string | null) => void;
+};
+
diff --git a/plugins/nako-portal/web/src/components/portal/sidebar.tsx b/plugins/nako-portal/web/src/components/portal/sidebar.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1909d34a0b238875ccc1ed17c245490ba0532d92
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/sidebar.tsx
@@ -0,0 +1,261 @@
+import { BellIcon, ChevronLeftIcon, GitPullRequestIcon, PinIcon, PlusIcon, RadioTowerIcon, SearchIcon, SettingsIcon } from "lucide-react";
+import { type DragEvent, memo, useMemo, useRef, useState } from "react";
+import { Button } from "@/components/ui/button";
+import { openChatSearch, SEARCH_KEYS } from "@/components/portal/chat-search";
+import type { Portal } from "@/hooks/use-portal";
+import { inBubble } from "@/lib/bubble";
+import type { GroupColor, SessionRow } from "@/lib/types";
+import { cn } from "@/lib/utils";
+import { useDrawer } from "./drawer";
+import { LoadingRows } from "./screen-loading";
+import { LoadWarning } from "./load-warning";
+import { useGroupPicker, useGroupRename } from "./groups";
+import { useRenameDialog } from "./session-actions";
+import { CHAT_DRAG, canDrag, type ChatDrag, sections, useFolded } from "./sidebar-utils";
+import { ChannelRow, ChatRow, DOT, GroupBlock } from "./sidebar-rows";
+import { AppVersion, ConnectionDot, HermesVersion } from "./sidebar-footer";
+
+type SidebarProps = Pick<Portal, "sessions" | "sessionsState" | "pin" | "archive" | "prefetch" | "setGroup" | "createGroup" | "updateGroup" | "deleteGroup" | "setError" | "rename" | "route" | "outside" | "connected" | "linked" | "hermes" | "me"> & {
+  currentSession?: string;
+  currentTitle?: string;
+  currentSource?: string;
+  className?: string;
+};
+
+// Streaming text never enters these props; only sidebar-visible state can redraw the list.
+export const Sidebar = memo(function Sidebar({ className, currentSession, currentTitle, currentSource, ...portal }: SidebarProps) {
+  const { go, phone, toggle } = useDrawer();
+  const rename = useRenameDialog({ ...portal, current: currentSession ? { session: currentSession, title: currentTitle ?? "" } : null });
+  const picker = useGroupPicker(portal);
+  const renameGroup = useGroupRename(portal);
+  const [folded, fold] = useFolded();
+  const { sessions, pin, archive, prefetch, setGroup, updateGroup, deleteGroup } = portal;
+  const listed = useMemo(
+    () =>
+      sections(sessions.filter((s) => !s.notifications && !s.reviews)),
+    [sessions],
+  );
+  const actions = useMemo(
+    () => ({ pin, archive, rename: rename.start, group: picker.start }),
+    [pin, archive, rename.start, picker.start],
+  );
+  const groupActions = useMemo(
+    () => ({
+      rename: renameGroup.start,
+      recolor: (group: string, color: GroupColor) => updateGroup(group, { color }),
+      ungroup: deleteGroup,
+    }),
+    [renameGroup.start, updateGroup, deleteGroup],
+  );
+  // The chat being dragged, and the group it's over ("" for out of its group).
+  const dragged = useRef<SessionRow | null>(null);
+  const [dropAt, setDropAt] = useState<string | null>(null);
+  const drag = useMemo<ChatDrag | undefined>(() => {
+    if (!canDrag) return undefined;
+    const end = () => {
+      dragged.current = null;
+      setDropAt(null);
+    };
+    // The chat would move: it's ours being dragged, and the place isn't the group it's already in.
+    const moves = (e: DragEvent, group: string | null) => {
+      const row = dragged.current;
+      return row && e.dataTransfer.types.includes(CHAT_DRAG) && (row.group?.id ?? null) !== group ? row : null;
+    };
+    return {
+      start: (row) => {
+        dragged.current = row;
+      },
+      end,
+      over: (e, group) => {
+        if (!dragged.current) return;
+        // A group catches the drag before the list around it does.
+        e.stopPropagation();
+        if (!moves(e, group)) {
+          setDropAt(null);
+          return;
+        }
+        e.preventDefault();
+        e.dataTransfer.dropEffect = "move";
+        setDropAt(group ?? "");
+      },
+      drop: (e, group) => {
+        const row = moves(e, group);
+        if (!row) return;
+        e.preventDefault();
+        e.stopPropagation();
+        end();
+        setGroup(row.id, group);
+      },
+    };
+  }, [setGroup]);
+  const inbox = sessions.find((s) => s.notifications);
+  const reviews = sessions.find((s) => s.reviews);
+  const open = portal.route.view === "chat" ? portal.route.session : null;
+
+  return (
+    <aside
+      className={cn("flex w-full flex-col border-r bg-sidebar", className)}
+    >
+      <div className="flex flex-col gap-1 p-3 pt-[max(0.75rem,env(safe-area-inset-top))]">
+        <div
+          className="flex items-center gap-2 pl-1"
+          data-tauri-drag-region="deep"
+        >
+          {!inBubble && <img alt="" className="size-6" src="/favicon.png" />}
+          <span className="flex-1 font-medium text-sm">Nako</span>
+          <Button
+            aria-label="New chat"
+            onClick={() => go("#/new")}
+            size="icon"
+            title="New chat"
+            variant="ghost"
+          >
+            <PlusIcon />
+          </Button>
+          {!phone && (
+            <Button
+              aria-label="Hide chats"
+              className="-ml-1"
+              onClick={toggle}
+              size="icon"
+              title="Hide chats (Ctrl+B)"
+              variant="ghost"
+            >
+              <ChevronLeftIcon />
+            </Button>
+          )}
+        </div>
+        <button
+          className="flex h-8 w-full items-center gap-2 rounded-md px-2 text-left text-muted-foreground text-sm hover:bg-accent hover:text-foreground"
+          data-find=""
+          onClick={openChatSearch}
+          type="button"
+        >
+          <SearchIcon className="size-4 shrink-0" />
+          <span className="flex-1">Find</span>
+          {!phone && (
+            <kbd className="font-sans text-[11px] text-muted-foreground/70">
+              {SEARCH_KEYS}
+            </kbd>
+          )}
+        </button>
+      </div>
+      <nav
+        className="min-h-0 flex-1 overflow-y-auto px-2 pb-2"
+        onDragLeave={(e) => {
+          if (!(e.relatedTarget instanceof Node && e.currentTarget.contains(e.relatedTarget))) setDropAt(null);
+        }}
+        onDragOver={drag && ((e) => drag.over(e, null))}
+        onDrop={drag && ((e) => drag.drop(e, null))}
+      >
+        {/* Always first, Reviews under it once something has posted there. */}
+        <ChannelRow
+          fallback="Notifications"
+          go={go}
+          icon={BellIcon}
+          open={open}
+          row={inbox}
+        />
+        {(reviews || portal.sessionsState === "loading") ? (
+          <ChannelRow
+            fallback="Reviews"
+            go={go}
+            icon={GitPullRequestIcon}
+            open={open}
+            row={reviews}
+          />
+        ) : <div aria-hidden="true" className="h-9" />}
+        {/* Sessions from Slack, cron and other ways in; only when there are some. */}
+        {portal.outside.sources.length > 0 ? (
+          <button
+            className={cn(
+              "flex w-full select-none items-center gap-2 rounded-md px-2 py-2 text-left text-sm hover:bg-accent",
+              (portal.route.view === "outside" || (currentSource && currentSource !== "portal")) && "bg-accent",
+            )}
+            onClick={() => go("#/elsewhere")}
+            type="button"
+          >
+            <RadioTowerIcon className="size-4 shrink-0 text-muted-foreground" />
+            <span className="min-w-0 flex-1 truncate">Elsewhere</span>
+            {portal.outside.running.length > 0 && (
+              <span className={cn("size-2 shrink-0 rounded-full", DOT.working)} title="working" />
+            )}
+          </button>
+        ) : <div aria-hidden="true" className="h-9" />}
+        {portal.sessionsState === "loading" && <LoadingRows label="Loading chats…" />}
+        {portal.sessionsState === "failed" && <p role="alert" className="px-2 py-1 text-muted-foreground text-xs">Could not load chats.</p>}
+        {portal.sessionsState === "ready" && listed.length === 0 && (
+          <p className="px-2 py-1 text-muted-foreground text-xs">
+            no chats yet
+          </p>
+        )}
+        {listed.map(([label, items]) => (
+          <div key={label}>
+            <p className="flex items-center gap-1.5 px-2 pt-3 pb-1 text-muted-foreground text-xs">
+              {label === "pinned" && <PinIcon className="size-3" />}
+              {label}
+            </p>
+            {items.map((entry) =>
+              entry.kind === "group" ? (
+                <GroupBlock
+                  actions={actions}
+                  drag={drag}
+                  fold={fold}
+                  folded={folded.has(entry.group.id)}
+                  go={go}
+                  group={entry.group}
+                  groupActions={groupActions}
+                  key={`g:${entry.group.id}`}
+                  open={open}
+                  prefetch={prefetch}
+                  rows={entry.rows}
+                  target={dropAt === entry.group.id}
+                />
+              ) : (
+                <ChatRow
+                  actions={actions}
+                  drag={drag}
+                  go={go}
+                  key={entry.row.id}
+                  prefetch={prefetch}
+                  row={entry.row}
+                  selected={open === entry.row.id}
+                />
+              ),
+            )}
+          </div>
+        ))}
+      </nav>
+      <div className="flex items-center justify-between gap-2 border-t p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))]">
+        <div className="flex min-w-0 items-center">
+          <ConnectionDot connected={portal.connected} linked={portal.linked} />
+          {portal.connected ? (
+            <>
+              <AppVersion />
+              {portal.linked && portal.hermes && <HermesVersion version={portal.hermes} />}
+            </>
+          ) : (
+            <span className="px-2 text-muted-foreground text-xs">
+              nako is offline
+            </span>
+          )}
+        </div>
+        <div className="flex items-center gap-1">
+          {portal.connected && <LoadWarning go={go} me={portal.me} />}
+          <Button
+            aria-label="Settings"
+            onClick={() => go("#/settings")}
+            size="icon"
+            title="Settings"
+            variant="ghost"
+          >
+            <SettingsIcon />
+          </Button>
+        </div>
+      </div>
+      {rename.dialog}
+      {picker.dialog}
+      {renameGroup.dialog}
+    </aside>
+  );
+});
