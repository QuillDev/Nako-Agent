--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/html-viewer.tsx
@@ -0,0 +1,121 @@
+import { DownloadIcon, Maximize2Icon, XIcon } from "lucide-react"
+import { useEffect, useRef, useState } from "react"
+import { DialogClose } from "@/components/ui/dialog"
+import { Skeleton } from "@/components/ui/skeleton"
+
+// Runs in an opaque origin (no portal cookies/storage/DOM access) while letting scripts, styles and links work.
+const HTML_SANDBOX = "allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox"
+// Virtual desktop/email width scaled down into the inline preview box so 600px emails aren't clipped.
+const VIRTUAL_WIDTH = 640
+const ACTION = "cursor-pointer p-1 text-muted-foreground transition-all hover:text-foreground"
+
+export function HtmlThumb({
+  item,
+  onOpen,
+  onBroken,
+}: { item: { url: string; name: string; download?: string }; onOpen: () => void; onBroken: () => void }) {
+  const wrap = useRef<HTMLDivElement>(null)
+  const broken = useRef(onBroken)
+  broken.current = onBroken
+  const [ready, setReady] = useState(false)
+  const [box, setBox] = useState({ width: 368, height: 240 })
+
+  useEffect(() => {
+    const controller = new AbortController()
+    fetch(item.url, { method: "HEAD", credentials: "same-origin", signal: controller.signal })
+      .then(res => {
+        if (!res.ok) broken.current()
+      })
+      .catch(() => {})
+    return () => controller.abort()
+  }, [item.url])
+
+  useEffect(() => {
+    const el = wrap.current
+    if (!el) return
+    const sync = () => {
+      if (el.clientWidth && el.clientHeight) setBox({ width: el.clientWidth, height: el.clientHeight })
+    }
+    sync()
+    const observer = new ResizeObserver(sync)
+    observer.observe(el)
+    return () => observer.disconnect()
+  }, [])
+
+  const scale = Math.min(1, box.width / VIRTUAL_WIDTH)
+  const frameWidth = Math.round(box.width / scale)
+  const frameHeight = Math.round(box.height / scale)
+
+  return (
+    <div className="flex w-96 max-w-full flex-col gap-2 rounded-xl border border-border bg-sidebar p-2">
+      <div className="flex h-8 items-center justify-between gap-2 text-muted-foreground text-xs">
+        <span className="ml-1 min-w-0 truncate font-mono">{item.name}</span>
+        <div className="flex shrink-0 items-center gap-2 pr-1">
+          {item.download && (
+            <a aria-label={`Download ${item.name}`} className={ACTION} download={item.name} href={item.download} title="Download">
+              <DownloadIcon size={14} />
+            </a>
+          )}
+          <button aria-label={`Full screen ${item.name}`} className={ACTION} onClick={onOpen} title="Full screen" type="button">
+            <Maximize2Icon size={14} />
+          </button>
+        </div>
+      </div>
+      <div className="relative h-60 w-full overflow-hidden rounded-md border bg-white" ref={wrap}>
+        <iframe
+          aria-hidden="true"
+          className="pointer-events-none block border-0 bg-white"
+          loading="lazy"
+          onLoad={() => setReady(true)}
+          sandbox={HTML_SANDBOX}
+          scrolling="no"
+          src={item.url}
+          style={{
+            width: frameWidth,
+            height: frameHeight,
+            transform: `scale(${scale})`,
+            transformOrigin: "top left",
+            visibility: ready ? "visible" : "hidden",
+          }}
+          tabIndex={-1}
+          title={item.name}
+        />
+        {!ready && <Skeleton aria-label="Loading preview" className="absolute inset-0 rounded-none" role="status" />}
+      </div>
+    </div>
+  )
+}
+
+export function HtmlViewer({ src, name, download }: { src: string; name: string; download?: string }) {
+  const [ready, setReady] = useState(false)
+  return (
+    <div className="flex h-full w-full flex-col bg-background sm:p-4">
+      <div className="flex min-h-0 flex-1 flex-col gap-2 bg-sidebar p-2 sm:rounded-xl sm:border sm:border-border">
+        <div className="flex h-8 shrink-0 items-center justify-between gap-2 text-muted-foreground text-xs">
+          <span className="ml-1 min-w-0 truncate font-mono">{name}</span>
+          <div className="flex shrink-0 items-center gap-2 pr-1">
+            {download && (
+              <a aria-label={`Download ${name}`} className={ACTION} download={name} href={download} title="Download">
+                <DownloadIcon size={14} />
+              </a>
+            )}
+            <DialogClose aria-label="Exit full screen" className={ACTION} title="Exit full screen">
+              <XIcon size={14} />
+            </DialogClose>
+          </div>
+        </div>
+        <div className="relative min-h-0 flex-1 overflow-hidden rounded-md border bg-white">
+          {!ready && <Skeleton aria-label="Loading preview" className="absolute inset-0 rounded-none" role="status" />}
+          <iframe
+            className="block size-full border-0 bg-white"
+            onLoad={() => setReady(true)}
+            sandbox={HTML_SANDBOX}
+            src={src}
+            style={{ visibility: ready ? "visible" : "hidden" }}
+            title={name}
+          />
+        </div>
+      </div>
+    </div>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/image-viewer.tsx b/plugins/nako-portal/web/src/components/portal/image-viewer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9cb3d24ca680e79d5e7e866ac93031be67025f68
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/image-viewer.tsx
@@ -0,0 +1,216 @@
+import { ChevronLeftIcon, ChevronRightIcon, DownloadIcon, XIcon } from "lucide-react"
+import { useEffect, useRef, useState } from "react"
+import { Skeleton } from "@/components/ui/skeleton"
+import { DialogClose } from "@/components/ui/dialog"
+
+type View = { scale: number; x: number; y: number }
+type Point = { x: number; y: number }
+
+const MAX_SCALE = 8
+const ZOOM_STEP = 2.5
+const SWIPE = 70
+const FIT: View = { scale: 1, x: 0, y: 0 }
+
+// Keeps the image covering the viewport edge it overflows, and centred on axes where it fits.
+function clamp(view: View, image: HTMLElement, box: HTMLElement): View {
+  const scale = Math.min(MAX_SCALE, Math.max(1, view.scale))
+  const maxX = Math.max(0, (image.offsetWidth * scale - box.clientWidth) / 2)
+  const maxY = Math.max(0, (image.offsetHeight * scale - box.clientHeight) / 2)
+  return { scale, x: Math.min(maxX, Math.max(-maxX, view.x)), y: Math.min(maxY, Math.max(-maxY, view.y)) }
+}
+
+// Scales by `factor` while the point under `at` (relative to the viewport centre) stays put.
+function zoomAt(view: View, factor: number, at: Point): View {
+  const scale = Math.min(MAX_SCALE, Math.max(1, view.scale * factor))
+  const k = scale / view.scale
+  return { scale, x: at.x - (at.x - view.x) * k, y: at.y - (at.y - view.y) * k }
+}
+
+const corner =
+  "absolute top-3 grid size-9 place-items-center rounded-full bg-black/60 text-white/90 outline-none hover:bg-black/80"
+
+const arrow =
+  "absolute top-1/2 hidden size-10 -translate-y-1/2 place-items-center rounded-full bg-black/60 text-white/90 outline-none hover:bg-black/80 md:grid"
+
+export function ImageViewer({
+  src,
+  name,
+  download,
+  onPrev,
+  onNext,
+}: { src: string; name: string; download?: string; onPrev?: () => void; onNext?: () => void }) {
+  const box = useRef<HTMLDivElement>(null)
+  const image = useRef<HTMLImageElement>(null)
+  const close = useRef<HTMLButtonElement>(null)
+  const [view, setView] = useState<View>(FIT)
+  const [media, setMedia] = useState<{ src: string; ok: boolean } | null>(null)
+  const [smooth, setSmooth] = useState(false)
+  // Horizontal drag past the image's edge: shown as a damped offset, and a long enough one changes image.
+  const [pull, setPull] = useState(0)
+  const current = useRef(view)
+  const pointers = useRef(new Map<number, Point>())
+  const gesture = useRef({ moved: false, onImage: false, pinched: false, pull: 0, downAt: { x: 0, y: 0 }, lastTap: 0, lastTapAt: { x: 0, y: 0 } })
+  const nav = useRef({ onPrev, onNext })
+  nav.current = { onPrev, onNext }
+
+  const apply = (next: View, animate = false) => {
+    if (!image.current || !box.current) return
+    const clamped = clamp(next, image.current, box.current)
+    current.current = clamped
+    setSmooth(animate)
+    setView(clamped)
+    return clamped
+  }
+
+  const centred = (clientX: number, clientY: number): Point => {
+    const r = box.current!.getBoundingClientRect()
+    return { x: clientX - r.left - r.width / 2, y: clientY - r.top - r.height / 2 }
+  }
+
+  useEffect(() => {
+    const el = box.current
+    if (!el) return
+    // React's onWheel is passive, so preventDefault (page zoom on ctrl+wheel / trackpad pinch) needs a native listener.
+    const onWheel = (e: WheelEvent) => {
+      e.preventDefault()
+      const speed = e.ctrlKey ? 0.01 : 0.002
+      const delta = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY
+      apply(zoomAt(current.current, Math.exp(-delta * speed), centred(e.clientX, e.clientY)))
+    }
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "ArrowLeft") nav.current.onPrev?.()
+      else if (e.key === "ArrowRight") nav.current.onNext?.()
+      else return
+      e.preventDefault()
+    }
+    el.addEventListener("wheel", onWheel, { passive: false })
+    window.addEventListener("keydown", onKey)
+    const onResize = () => apply(current.current)
+    window.addEventListener("resize", onResize)
+    return () => {
+      el.removeEventListener("wheel", onWheel)
+      window.removeEventListener("keydown", onKey)
+      window.removeEventListener("resize", onResize)
+    }
+  }, [])
+
+  const onPointerDown = (e: React.PointerEvent) => {
+    if (e.button !== 0 || (e.target as Element).closest("button, a")) return
+    box.current!.setPointerCapture(e.pointerId)
+    pointers.current.set(e.pointerId, { x: e.clientX, y: e.clientY })
+    const g = gesture.current
+    if (pointers.current.size === 1) {
+      g.moved = false
+      g.pinched = false
+      g.pull = 0
+      // Pointer capture retargets later events to the box, so remember what the press started on.
+      g.onImage = e.target === image.current
+    } else g.pinched = true
+    g.downAt = { x: e.clientX, y: e.clientY }
+  }
+
+  const onPointerMove = (e: React.PointerEvent) => {
+    const prev = pointers.current.get(e.pointerId)
+    if (!prev) return
+    const next = { x: e.clientX, y: e.clientY }
+    const g = gesture.current
+    if (Math.hypot(next.x - g.downAt.x, next.y - g.downAt.y) > 6) g.moved = true
+    const others = [...pointers.current.entries()].filter(([id]) => id !== e.pointerId)
+    pointers.current.set(e.pointerId, next)
+    const v = current.current
+    if (others.length === 1) {
+      // Pinch: scale by the change in finger distance around the old midpoint, then follow the midpoint.
+      const other = others[0][1]
+      const before = Math.hypot(prev.x - other.x, prev.y - other.y)
+      const after = Math.hypot(next.x - other.x, next.y - other.y)
+      const midBefore = centred((prev.x + other.x) / 2, (prev.y + other.y) / 2)
+      const midAfter = centred((next.x + other.x) / 2, (next.y + other.y) / 2)
+      const zoomed = zoomAt(v, before ? after / before : 1, midBefore)
+      g.pull = 0
+      setPull(0)
+      apply({ ...zoomed, x: zoomed.x + midAfter.x - midBefore.x, y: zoomed.y + midAfter.y - midBefore.y })
+    } else if (others.length === 0 && !g.pinched) {
+      // Drag pans; whatever the image edge stops becomes pull toward the neighbouring image.
+      const dx = next.x - prev.x
+      const wanted = g.pull ? v.x : v.x + dx
+      const moved = apply({ ...v, x: wanted, y: v.y + next.y - prev.y })
+      if (!moved) return
+      const blocked = g.pull ? dx : wanted - moved.x
+      if (blocked || g.pull) {
+        g.pull += blocked
+        // No neighbour that way: let it give a little, then stop.
+        if ((g.pull > 0 && !nav.current.onPrev) || (g.pull < 0 && !nav.current.onNext)) g.pull = Math.max(-SWIPE / 2, Math.min(SWIPE / 2, g.pull))
+        setPull(g.pull)
+      }
+    }
+  }
+
+  const onPointerUp = (e: React.PointerEvent) => {
+    if (!pointers.current.delete(e.pointerId)) return
+    const g = gesture.current
+    if (pointers.current.size) return
+    if (g.pull) {
+      const swipe = e.type !== "pointercancel" && Math.abs(g.pull) >= SWIPE ? (g.pull > 0 ? nav.current.onPrev : nav.current.onNext) : undefined
+      g.pull = 0
+      setSmooth(true)
+      setPull(0)
+      swipe?.()
+      return
+    }
+    if (g.moved || g.pinched || e.type === "pointercancel") return
+    const now = performance.now()
+    const tapAt = { x: e.clientX, y: e.clientY }
+    const double = now - g.lastTap < 300 && Math.hypot(tapAt.x - g.lastTapAt.x, tapAt.y - g.lastTapAt.y) < 30
+    g.lastTap = double ? 0 : now
+    g.lastTapAt = tapAt
+    if (double) {
+      const v = current.current
+      apply(v.scale > 1 ? FIT : zoomAt(v, ZOOM_STEP, centred(e.clientX, e.clientY)), true)
+    } else if (!g.onImage && current.current.scale === 1) {
+      close.current?.click()
+    }
+  }
+
+  return (
+    <div
+      className="relative flex h-full w-full touch-none select-none items-center justify-center overflow-hidden"
+      data-zoomed={view.scale > 1 || undefined}
+      onPointerCancel={onPointerUp}
+      onPointerDown={onPointerDown}
+      onPointerMove={onPointerMove}
+      onPointerUp={onPointerUp}
+      ref={box}
+    >
+      {media?.src !== src && <Skeleton role="status" className="absolute h-1/3 w-1/2"><span className="sr-only">Loading image…</span></Skeleton>}
+      {media?.src === src && !media.ok && <p role="alert" className="absolute text-sm text-white">Image unavailable</p>}
+      <img
+        alt={name}
+        onLoad={() => setMedia({ src, ok: true })}
+        onError={() => setMedia({ src, ok: false })}
+        className={`max-h-[calc(100dvh-2rem)] max-w-[calc(100vw-2rem)] rounded-md object-contain will-change-transform ${view.scale > 1 ? "cursor-grab active:cursor-grabbing" : "cursor-zoom-in"} ${smooth ? "transition-transform duration-200 ease-out" : ""}`}
+        draggable={false}
+        ref={image}
+        src={src}
+        style={{ visibility: media?.src === src && media.ok ? "visible" : "hidden", transform: `translate(${view.x + pull * 0.6}px, ${view.y}px) scale(${view.scale})` }}
+      />
+      {onPrev && (
+        <button aria-label="Previous image" className={`${arrow} left-3`} onClick={onPrev} type="button">
+          <ChevronLeftIcon className="size-5" />
+        </button>
+      )}
+      {onNext && (
+        <button aria-label="Next image" className={`${arrow} right-3`} onClick={onNext} type="button">
+          <ChevronRightIcon className="size-5" />
+        </button>
+      )}
+      {download && (
+        <a aria-label={`Download ${name}`} className={`${corner} right-14`} download={name} href={download} title="Download">
+          <DownloadIcon className="size-4" />
+        </a>
+      )}
+      <DialogClose aria-label="Close" className={`${corner} right-3`} ref={close}>
+        <XIcon className="size-4" />
+      </DialogClose>
+    </div>
+  )
+}
diff --git a/plugins/nako-portal/web/src/components/portal/load-warning.tsx b/plugins/nako-portal/web/src/components/portal/load-warning.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..17208b9d5cda790264f5d552d07b27b1c251999d
--- /dev/null
+++ b/plugins/nako-portal/web/src/components/portal/load-warning.tsx
@@ -0,0 +1,117 @@
+import { CpuIcon, MemoryStickIcon, type LucideIcon } from "lucide-react"
+import { useState } from "react"
+import { Popover } from "radix-ui"
+import { Button } from "@/components/ui/button"
+import { STATUS_DOT, useEnvironments } from "@/lib/environments"
+import { CRITICAL_AT, gigabytes, loadWarning, type MachineLoad, useMachineLoad } from "@/lib/machine-load"
+import type { Me } from "@/lib/types"
+import { cn } from "@/lib/utils"
+
+// How many of the biggest environments the popover lists.
+const BIGGEST = 4
+
+function tone(percent: number, warnAt: number) {
+  return percent >= CRITICAL_AT ? "critical" : percent >= warnAt ? "warn" : "ok"
+}
+
+function Meter({ icon: Icon, label, value, percent, warnAt }: { icon: LucideIcon; label: string; value: string; percent: number; warnAt: number }) {
+  const level = tone(percent, warnAt)
+  return (
+    <div className="flex flex-col gap-1.5">
+      <div className="flex items-center gap-2 text-sm">
+        <Icon className="size-3.5 text-muted-foreground" />
+        <span>{label}</span>
+        <span className="ml-auto text-muted-foreground text-xs tabular-nums">{value}</span>
+      </div>
+      <div className="h-1.5 overflow-hidden rounded-full bg-muted">
+        <div
+          className={cn("h-full rounded-full", level === "critical" ? "bg-destructive" : level === "warn" ? "bg-amber-500" : "bg-muted-foreground")}
+          style={{ width: `${Math.min(100, percent)}%` }}
+        />
+      </div>
+    </div>
+  )
+}
+
+function Details({ load, me, open, go }: { load: MachineLoad; me: Me | null; open: boolean; go: (hash: string) => void }) {
+  const { data } = useEnvironments(open && Boolean(me?.environments), 10_000)
+  const biggest = (data?.environments ?? [])
+    .filter(env => env.status !== "stopped" && env.memory !== undefined)
+    .sort((a, b) => (b.memory ?? 0) - (a.memory ?? 0))
+    .slice(0, BIGGEST)
+  return (
+    <div className="flex flex-col gap-3">
+      <Meter
+        icon={MemoryStickIcon}
+        label="Memory"
+        percent={load.memory.percent}
+        value={`${Math.round(load.memory.used / 1024 ** 3)} / ${Math.round(load.memory.total / 1024 ** 3)} GB`}
+        warnAt={load.warn_at}
+      />
+      {load.cpu.percent !== null && (
+        <Meter icon={CpuIcon} label="CPU" percent={load.cpu.percent} value={`${load.cpu.percent}%`} warnAt={load.warn_at} />
+      )}
+      {biggest.length > 0 && (
+        <div className="flex flex-col">
+          <p className="pb-0.5 text-muted-foreground text-xs">Using the most</p>
+          {biggest.map(env => (
+            <div className="flex items-center gap-2 py-1 text-sm" key={env.name}>
+              <span className={cn("size-2 shrink-0 rounded-full", STATUS_DOT[env.status])} />
+              <span className="min-w-0 flex-1 truncate">{env.name}</span>
+              <span className="text-muted-foreground text-xs tabular-nums">{gigabytes(env.memory ?? 0)}</span>
+            </div>
+          ))}
+        </div>
+      )}
+      {me?.environments && data && (
+        <Button className="w-full" onClick={() => go("#/settings/environments")} size="sm" variant="outline">
+          Open {data.title.toLowerCase()}
+        </Button>
+      )}
+    </div>
+  )
+}
+
+/** A small pill by Settings while memory or CPU runs high; tapping it shows what's using the machine. */
+export function LoadWarning({ me, go }: { me: Me | null; go: (hash: string) => void }) {
+  const load = useMachineLoad(Boolean(me?.machine_load))
+  const [open, setOpen] = useState(false)
+  const warning = loadWarning(load)
+  if (!load || (!warning && !open)) return null
+  const shown = warning ?? { label: "RAM", percent: load.memory.percent }
+  const critical = shown.percent >= CRITICAL_AT
+  return (
+    <Popover.Root onOpenChange={setOpen} open={open}>
+      <Popover.Trigger
+        aria-label={`${shown.label} at ${shown.percent}%`}
+        className={cn(
+          "inline-flex h-7 shrink-0 items-center gap-1.5 rounded-full px-2.5 font-medium text-xs tabular-nums",
+          critical ? "bg-destructive/12 text-destructive" : "bg-amber-500/12 text-amber-700 dark:text-amber-400",
+        )}
+      >
+        {shown.label === "CPU" ? <CpuIcon className="size-3.5" /> : <MemoryStickIcon className="size-3.5" />}
+        {shown.label} {shown.percent}%
+      </Popover.Trigger>
+      <Popover.Portal>
+        <Popover.Content
+          aria-label="Machine load"
+          className="z-50 w-[256px] max-w-[calc(100vw-1rem)] rounded-xl border bg-popover p-3.5 shadow-lg"
+          collisionPadding={8}
+          onCloseAutoFocus={event => event.preventDefault()}
+          side="top"
+          sideOffset={8}
+        >
+          <Details
+            go={hash => {
+              setOpen(false)
+              go(hash)
+            }}
+            load={load}
+            me={me}
+            open={open}
+          />
+        </Popover.Content>
+      </Popover.Portal>
+    </Popover.Root>
+  )
+}
