+            "title": title,
+            "source": source,
+            "last_active": last_active if last_active is not None else time.time(),
+            "chat": (chat or f"chat-{sid}") if source == "portal" else None,
+            "rows": [],
+            "started_at": time.time(),
+            "pinned": False,
