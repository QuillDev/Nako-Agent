index 0000000000000000000000000000000000000000..645c34ac16b107a85e0814f51e6be202436a31fb
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/machine_load.py
@@ -0,0 +1,65 @@
+"""How busy this machine is: memory in use and CPU over the last minute, read from Linux's /proc.
+
+The sidebar asks every so often and shows a warning only while either one is high. On a system
+without /proc (macOS, Windows) there's nothing to read and the portal shows nothing.
+"""
+
+import time
+from collections import deque
+from pathlib import Path
+
+# Above this share (percent) of memory or CPU, the app warns.
+WARN_AT = 75
+# CPU is averaged over this many seconds, so a short build spike doesn't raise the warning.
+WINDOW = 60.0
+
+
+class MachineLoad:
+    def __init__(self, proc="/proc", *, clock=time.monotonic, window=WINDOW):
+        self.proc = Path(proc)
+        self.clock = clock
+        self.window = window
+        # (time, busy jiffies, total jiffies) from /proc/stat, oldest first.
+        self.samples = deque()
+        if self.available:
+            # A starting point, so the first reading already has a CPU share.
+            self.samples.append((clock(), *self._cpu_counters()))
+
+    @property
+    def available(self):
+        return (self.proc / "meminfo").is_file() and (self.proc / "stat").is_file()
+
+    def _memory(self):
+        info = {}
+        for line in (self.proc / "meminfo").read_text(encoding="utf-8-sig").splitlines():
+            key, _, rest = line.partition(":")
+            parts = rest.split()
+            if parts:
+                info[key] = int(parts[0]) * 1024
+        total = info["MemTotal"]
+        # Used means what programs hold: total minus what the kernel could hand out now (cache included).
+        used = total - info.get("MemAvailable", info.get("MemFree", 0))
+        return {"used": used, "total": total, "percent": round(100 * used / total) if total else 0}
+
+    def _cpu_counters(self):
+        for line in (self.proc / "stat").read_text(encoding="utf-8-sig").splitlines():
+            if line.startswith("cpu "):
+                values = [int(v) for v in line.split()[1:]]
+                idle = values[3] + (values[4] if len(values) > 4 else 0)  # idle + iowait
+                total = sum(values[:8])  # guest time is already counted in user/nice
+                return total - idle, total
+        raise ValueError("no cpu line in /proc/stat")
+
+    def read(self):
+        """Memory now, and CPU busy share since the oldest sample within the window."""
+        now = self.clock()
+        busy, total = self._cpu_counters()
+        self.samples.append((now, busy, total))
+        # Keep one sample at or before the window's start, so the average spans the full minute (longer
+        # after a quiet spell with nobody asking).
+        while len(self.samples) > 2 and self.samples[1][0] <= now - self.window:
+            self.samples.popleft()
+        _, busy0, total0 = self.samples[0]
+        spent = total - total0
+        cpu = round(100 * (busy - busy0) / spent) if spent > 0 else None
+        return {"memory": self._memory(), "cpu": {"percent": cpu}, "warn_at": WARN_AT}
diff --git a/plugins/nako-portal/dashboard/portal/machine_ops.py b/plugins/nako-portal/dashboard/portal/machine_ops.py
new file mode 100644
index 0000000000000000000000000000000000000000..eb7119002924e4aba1043858dba22b6c594d7d8e
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/machine_ops.py
@@ -0,0 +1,217 @@
+"""Looking after this machine's Hermes from its portal server: its version, restarting its gateway,
+updating it, and bringing the gateway back when it goes away and stays away.
+
+The server outlives the gateway, so it's the one part of a machine that can still act when the
+gateway is down. Another machine (the mesh hub) reaches these through the machine's mesh link.
+Restarts and updates run as a detached job (`machine_job.py`), so they finish even if the gateway
+they stop, or a server replaced by an updated plugin, goes away under them.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import os
+import subprocess
+import sys
+import time
+import uuid
+from pathlib import Path
+
+from .machine_job import hermes_version
+
+log = logging.getLogger("hermes.portal")
+
+JOB_FILE = "mesh-job.json"
+JOB_SCRIPT = Path(__file__).resolve().parent / "machine_job.py"
+KINDS = ("restart", "start", "update")
+# A job that never wrote a result this long after it started is taken as dead.
+JOB_STALE = 45 * 60
+# How long the gateway may stay away before the watchdog starts it, and how often it may.
+GRACE = 90
+COOLDOWN = 10 * 60
+# The agent's own marker while its update runs (the update stops and restarts gateways itself).
+# It is named after the agent, as is the Windows scheduled task below.
+UPDATE_MARKER = ".{agent}-update-in-progress"
+UPSTREAM = "hermes"
+UPDATE_MARKER_TTL = 40 * 60
+
+
+def _task_name(home, agent=UPSTREAM):
+    """The Windows scheduled task the agent installs for this home's gateway."""
+    home = Path(home)
+    task = f"{agent.capitalize()}_Gateway"
+    if home.parent.name == "profiles":
+        return f"{task}_{home.name}"
+    return task
+
+
+def _platform():
+    return "windows" if os.name == "nt" else "posix"
+
+
+class MachineOps:
+    """`hub` is this server's own hub (its `connected` says whether a gateway is dialed in).
+    `hermes` is the command that runs the agent here (argv), or None when it wasn't found.
+    `agent` is what that agent calls itself."""
+
+    def __init__(self, data, home, hermes, hub, *, agent=UPSTREAM, python=None, platform=None, watchdog=False, grace=GRACE, cooldown=COOLDOWN, clock=time.time):
+        self.data = Path(data)
+        self.home = Path(home)
+        self.hermes = list(hermes) if hermes else None
+        self.agent = agent or UPSTREAM
+        self.hub = hub
+        self.python = python or sys.executable
+        self.platform = platform or _platform()
+        self.watchdog = watchdog
+        self.grace = grace
+        self.cooldown = cooldown
+        self.clock = clock
+        self.info = None
+        self.revived_at = None
+        # Called with this machine's Hermes info whenever it's read again (the node tells the hub).
+        self.on_info = None
+        self._waiting = None
+        self._watching = None
+
+    # Version
+
+    async def refresh(self):
+        if self.hermes is None:
+            return None
+        info = await asyncio.to_thread(hermes_version, self.hermes)
+        if info is not None:
+            self.info = info
+            if self.on_info is not None:
+                self.on_info(info)
+        return self.info
+
+    # Jobs
+
+    @property
+    def job_path(self):
+        return self.data / JOB_FILE
+
+    def _read_job(self):
+        try:
+            return json.loads(self.job_path.read_text(encoding="utf-8-sig"))
+        except (OSError, ValueError):
+            return None
+
+    def running(self):
+        job = self._read_job()
+        return bool(job) and job.get("status") in ("starting", "running") and self.clock() - (job.get("started_at") or 0) < JOB_STALE
+
+    def job(self):
+        """The last restart or update and how it went, with whether the gateway is up now."""
+        job = self._read_job()
+        if job is None:
+            return {"job": None, "gateway": bool(self.hub.connected), "hermes": self.info}
+        status = job.get("status")
+        if status in ("starting", "running") and self.clock() - (job.get("started_at") or 0) >= JOB_STALE:
+            status = "lost"
+        view = {k: job.get(k) for k in ("id", "kind", "channel", "step", "old", "new", "update_exit", "started_gateway", "started_at", "finished_at", "log_tail")}
+        if status in ("starting", "running"):
+            try:
+                view["log_tail"] = Path(job["log"]).read_text(encoding="utf-8-sig", errors="replace")[-2000:]
+            except (OSError, KeyError):
+                pass
+        return {"job": {**view, "status": status}, "gateway": bool(self.hub.connected), "hermes": self.info}
+
+    async def start(self, kind, channel=None):
+        if kind not in KINDS:
+            raise ValueError(f"unknown job {kind!r}")
+        if self.hermes is None:
+            raise ValueError(f"Can't find the {self.agent} command on this machine")
+        if channel is not None and not (isinstance(channel, str) and channel.replace("-", "").replace(".", "").isalnum() and len(channel) < 40):
+            raise ValueError("bad channel name")
+        if self.running():
+            current = self._read_job() or {}
+            raise ValueError(f"A {current.get('kind')} is already running here (started {int(self.clock() - current.get('started_at', 0))}s ago)")
+        self.data.mkdir(parents=True, exist_ok=True)
+        job_id = uuid.uuid4().hex[:12]
+        log_path = self.data / f"mesh-job-{kind}.log"
+        log_path.write_text("", encoding="utf-8")
+        state = {
+            "id": job_id,
+            "kind": kind,
+            "channel": channel,
+            "status": "starting",
+            "step": "starting",
+            "started_at": self.clock(),
+            "hermes": self.hermes,
+            "platform": self.platform,
+            "task": _task_name(self.home, self.agent),
+            "log": str(log_path),
+        }
+        temp = self.job_path.with_suffix(".tmp")
+        temp.write_text(json.dumps(state, indent=2), encoding="utf-8")
+        os.replace(temp, self.job_path)
+        await asyncio.to_thread(self._spawn)
+        log.info("portal: started a %s job (%s)", kind, job_id)
+        if self._waiting is None or self._waiting.done():
+            self._waiting = asyncio.get_running_loop().create_task(self._until_done(job_id))
+        return self.job()
+
+    def _spawn(self):
+        command = [self.python, "-I", str(JOB_SCRIPT), str(self.job_path)]
+        with open(self.data / "mesh-job.out", "ab") as out:
+            if os.name == "nt":
+                flags = subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.CREATE_NO_WINDOW
+                subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, creationflags=flags, close_fds=True)
+            else:
+                subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, start_new_session=True, close_fds=True)
+
+    async def _until_done(self, job_id):
+        while True:
+            await asyncio.sleep(1)
+            job = self._read_job() or {}
+            if job.get("id") != job_id or not self.running():
+                break
+        await self.refresh()
+
+    # The gateway
+
+    def gateway_changed(self, connected):
+        """The gateway connected (read the version it brought) or went away (start watching)."""
+        loop = asyncio.get_running_loop()
+        if connected:
+            if self._watching is not None:
+                self._watching.cancel()
+                self._watching = None
+            loop.create_task(self.refresh())
+            return
+        if self.watchdog and (self._watching is None or self._watching.done()):
+            self._watching = loop.create_task(self._watch())
+
+    def _updating(self):
+        """Hermes's own `hermes update` is running (it restarts the gateway itself when done)."""
+        for root in (self.home, self.home.parent.parent):
+            marker = root / UPDATE_MARKER.format(agent=self.agent)
+            try:
+                if self.clock() - marker.stat().st_mtime < UPDATE_MARKER_TTL:
+                    return True
+            except OSError:
+                continue
+        return False
+
+    async def _watch(self):
+        """Bring a gateway back that went away and stayed away."""
+        try:
+            while not self.hub.connected:
+                await asyncio.sleep(self.grace)
+                if self.hub.connected:
+                    return
+                if self.running() or self._updating():
+                    continue
+                if self.revived_at is not None and self.clock() - self.revived_at < self.cooldown:
+                    continue
+                self.revived_at = self.clock()
+                log.warning("portal: the gateway has been away for %ss; starting it", self.grace)
+                try:
+                    await self.start("start")
+                except ValueError as error:
+                    log.warning("portal: couldn't start the gateway: %s", error)
+        except asyncio.CancelledError:
+            pass
diff --git a/plugins/nako-portal/dashboard/portal/media.py b/plugins/nako-portal/dashboard/portal/media.py
new file mode 100644
index 0000000000000000000000000000000000000000..3dc5d0c2680e6e56625bac5171bcd467b765b12f
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/media.py
@@ -0,0 +1,69 @@
+"""Files a transcript points at: MEDIA: tags in replies and image refs in user turns.
+
+web/src/lib/media.ts parses the same shapes for the browser; keep the two in step.
+"""
+
+import re
+
+# Hermes's own MEDIA_DELIVERY_EXTS (gateway/platforms/base.py), longest first.
+EXTS = sorted(
+    [
+        "png", "jpg", "jpeg", "gif", "webp", "bmp", "tiff", "svg", "mp4", "mov", "avi", "mkv", "webm", "3gp",
+        "mp3", "m2a", "wav", "ogg", "opus", "m4a", "flac", "pdf", "docx", "doc", "odt", "rtf", "txt", "md",
+        "epub", "xlsx", "xls", "ods", "csv", "tsv", "json", "xml", "yaml", "yml", "kmz", "kml", "geojson", "gpx",
+        "pptx", "ppt", "odp", "key", "zip", "tar", "gz", "tgz", "bz2", "xz", "7z", "rar", "apk", "ipa", "html", "htm",
+    ],
+    key=len,
+    reverse=True,
+)
+IMAGE_EXTS = {"png", "jpg", "jpeg", "gif", "webp", "bmp", "svg"}
+
+_QUOTED = r"`[^`\n]+`|\"[^\"\n]+\"|'[^'\n]+'"
+# A tag anywhere in a line, ending at a known extension; or a whole line holding just the tag.
+MEDIA = re.compile(
+    rf"MEDIA:[^\S\n]*(?P<path>{_QUOTED}|(?:~/|/|[A-Za-z]:[\\/])[^\n]*?\.(?:{'|'.join(EXTS)}))"
+    rf"(?=[\s`\"'*_,;:)\]}}\[]|MEDIA:|\.(?:\s|$)|$)"
+    rf"|^MEDIA:(?P<line>(?:~/|/|[A-Za-z]:[\\/])[^\n]+?)[^\S\n]*$",
+    re.IGNORECASE | re.MULTILINE,
+)
+# What Hermes writes into a user turn for an attached image.
+USER_IMAGE = re.compile(
+    rf"\[Image attached at: (?P<hint>[^\n\]]+)\]|^@image:(?P<ref>{_QUOTED}|\S+)[^\S\n]*$",
+    re.MULTILINE,
+)
+# Fenced blocks and inline code hold examples, never deliveries.
+_CODE = re.compile(r"```[\s\S]*?(?:```|$)|(?<!MEDIA:)(?<!@image:)`[^`\n]*`")
+
+
+def _unquote(value):
+    return value[1:-1] if len(value) > 1 and value[0] == value[-1] and value[0] in "`\"'" else value
+
+
+def _masked(text):
+    return _CODE.sub(lambda m: " " * len(m.group(0)), text)
+
+
+def media_paths(text):
+    masked = _masked(text or "")
+    return [_unquote(m.group("path") or m.group("line")) for m in MEDIA.finditer(masked)]
+
+
+def user_image_paths(text):
+    masked = _masked(text or "")
+    return [_unquote(m.group("hint") or m.group("ref")) for m in USER_IMAGE.finditer(masked)]
+
+
+def is_image(path):
+    return path.rsplit(".", 1)[-1].lower() in IMAGE_EXTS if "." in path else False
+
+
+def shown_files(messages):
+    """Every path a transcript shows: anything a reply delivered, and images a user attached."""
+    paths = set()
+    for message in messages:
+        text = message.get("text") or ""
+        if message.get("role") == "assistant":
+            paths.update(media_paths(text))
+        elif message.get("role") == "user":
+            paths.update(p for p in user_image_paths(text) if is_image(p))
+    return paths
diff --git a/plugins/nako-portal/dashboard/portal/mesh.py b/plugins/nako-portal/dashboard/portal/mesh.py
new file mode 100644
index 0000000000000000000000000000000000000000..a6e15fa242513c2f860c3f53eb2af0dbe13d5c2e
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/mesh.py
@@ -0,0 +1,1174 @@
+"""Other machines' Hermes, reached through this portal.
+
+One portal server is the hub. Every other machine (a node) runs the portal too, with its server
+dialing the hub's mesh port over one WebSocket and a per-machine token. The hub can then list
+a node's chats, open them, start one, send into one, stop one and answer its questions, and the
+node passes everything its own hub would show a browser (live replies, tool calls, status) back
+up, so the hub's app shows the node's chats like its own, under the machine's name.
+
+Node chats get ids `mesh.<machine>.<session>` on the hub. Nothing here imports Hermes: the hub
+side only knows the node's hub methods, the node side only its own hub.
+
+The node also mirrors the hub's skills into a folder of its own (the hub owns them; the node's
+copies are read-only and replaced on every change), which its Hermes reads as an extra skills dir.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import hashlib
+import json
+import logging
+import os
+import platform
+import re
+import secrets
+import socket
+import stat
+import time
+from pathlib import Path
+
+from aiohttp import ClientError, web
+
+from .attachments import MAX_FILE, MAX_FILES, Attachments, decode_attachment, read_attachment
+from .hub import FROM_THREAD
+from .link import HEARTBEAT, MAX_FRAME, Peer, decode_files, encode_files
+from .media import media_paths, shown_files
+from .mesh_setup import powershell_script, shell_script
+
+log = logging.getLogger("hermes.portal")
+
+MESH_PATH = "/mesh"
+PREFIX = "mesh."
+MACHINE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")
+REMOTE = re.compile(r"^mesh\.([a-z0-9][a-z0-9-]{0,31})\.([\w-][\w.-]{0,100})$")
+NODES_FILE = "mesh-nodes.json"
+# A node's chat list is skipped (not waited on) past this, so one slow machine can't stall the sidebar.
+LIST_TIMEOUT = 5
+# What the hub may call on a node: its hub's own methods, by name.
+# What a machine may ask the hub to do on another machine (or on the hub) for its agent.
+RELAYED = ("open", "send", "interrupt", "answer")
+NODE_CALLS = (
+    "sessions",
+    "archived",
+    "open",
+    "create",
+    "send",
+    "interrupt",
+    "answer",
+    "archive",
+    "rename",
+    "pin",
+    "commands",
+    "processes",
+    "process_log",
+    "session_model",
+    "set_session_model",
+    "command",
+)
+# What the hub may ask a machine's portal server to do to that machine's Hermes (`machine_ops`).
+MACHINE_OPS = ("restart_gateway", "update_hermes", "job")
+# How long a new machine's one-line setup works.
+SETUP_TTL = 24 * 3600
+SETUP_PATH = MESH_PATH + "/setup/{code}"
+NO_SOURCE = (
+    "Machines can't install this plugin from where the hub's copy came from. Set the plugin "
+    "source on the Mesh page to a git URL they can reach (the repo this plugin was published to)."
+)
+SOURCE_KEY = "mesh:plugin_source"
+SKILL_POLL = 60
+SKILL_BATCH = 8 * 1024 * 1024
+SKILL_FILE_MAX = 4 * 1024 * 1024
+SKIPPED_NAMES = {"__pycache__", "node_modules"}
+MIRROR_STATE = ".mesh-manifest.json"
+
+
+def remote_id(machine, session):
+    return f"{PREFIX}{machine}.{session}"
+
+
+def parse(session):
+    """(machine, node session) for a node's chat, else None."""
+    found = REMOTE.match(str(session or ""))
+    return (found.group(1), found.group(2)) if found else None
+
+
+def thread_rows(machine, rows):
+    """A machine's chats as an agent lists them: ids it can use, the person's inboxes left out."""
+    return [
+        {
+            "session": remote_id(machine, row["id"]),
+            "title": row.get("title"),
+            "status": row.get("status"),
+            "started_at": row.get("started_at"),
+            "messages": row.get("message_count"),
+        }
+        for row in rows or []
+        if not row.get("notifications") and not row.get("reviews")
+    ]
+
+
+def _rewrite(value, machine):
+    """A node's answer as the hub shows it: its chat ids carry the machine."""
+    if isinstance(value, dict):
+        return {k: (remote_id(machine, v) if k == "session" and isinstance(v, str) and v else _rewrite(v, machine)) for k, v in value.items()}
+    if isinstance(value, list):
+        return [_rewrite(v, machine) for v in value]
+    return value
+
+
+# Tokens
+
+
+def _digest(token):
+    return hashlib.sha256(token.encode()).hexdigest()
+
+
+def load_nodes(data):
+    path = Path(data) / NODES_FILE
+    try:
+        nodes = json.loads(path.read_text(encoding="utf-8-sig"))
+    except (OSError, ValueError):
+        return {}
+    return nodes if isinstance(nodes, dict) else {}
+
+
+def add_node(data, name):
+    """A new machine's token (shown once; the hub keeps only its hash). Re-adding replaces it."""
+    if not MACHINE.match(name):
+        raise ValueError("Machine names are lowercase letters, digits and dashes")
+    data = Path(data)
+    data.mkdir(parents=True, exist_ok=True)
+    nodes = load_nodes(data)
+    token = secrets.token_urlsafe(32)
+    nodes[name] = {"token_sha256": _digest(token), "added": int(time.time())}
+    _write_private(data / NODES_FILE, json.dumps(nodes, indent=2) + "\n")
+    return token
+
+
+def _save_nodes(data, nodes):
+    _write_private(Path(data) / NODES_FILE, json.dumps(nodes, indent=2) + "\n")
+
+
+def start_setup(data, name, token, now=None):
+    """A one-line setup for a machine just added: a code for its setup page, which holds the
+    token until the machine joins or a day passes. Only the code's hash is kept for lookups."""
+    now = time.time() if now is None else now
+    nodes = load_nodes(data)
+    code = secrets.token_urlsafe(18)
+    nodes[name]["setup"] = {"code_sha256": _digest(code), "token": token, "expires": now + SETUP_TTL}
+    _save_nodes(data, nodes)
+    return code
+
+
+def setup_for(data, code, now=None):
+    """(machine, its setup) for a live setup code, else (None, None)."""
+    now = time.time() if now is None else now
+    digest = _digest(str(code or ""))
+    for name, entry in load_nodes(data).items():
+        setup = entry.get("setup") or {}
+        if setup.get("code_sha256") and secrets.compare_digest(setup["code_sha256"], digest) and setup.get("expires", 0) > now:
+            return name, setup
+    return None, None
+
+
+def _joined(data, name):
+    """The machine is in: its setup page stops holding the token."""
+    nodes = load_nodes(data)
+    setup = (nodes.get(name) or {}).get("setup")
+    if setup and setup.get("token"):
+        setup.pop("token")
+        _save_nodes(data, nodes)
+
+
+def setup_page(*, name, address, token, code, plugin, agent="hermes"):
+    """What a stock Hermes on the new machine reads and follows to join."""
+    source = (plugin or {}).get("source")
+    ref = (plugin or {}).get("ref")
+    install = f"{agent} plugins install {source}" + (f" --ref {ref}" if ref else "") + " --enable --yes-deps --force"
+    status = f"curl -fsSL {address}{SETUP_PATH.format(code=code)}/status"
+    return f"""# Join the Nako mesh as "{name}"
+
+The user wants this machine to join their Nako mesh, so their main Hermes (the hub at {address}) can hand it tasks.
+Do every step yourself, in order, with your terminal. If a step fails, stop and tell the user which one and what it printed.
+Never repeat the token below to the user or write it anywhere except through these commands.
+On Windows, type curl.exe wherever these steps say curl (PowerShell's curl is something else), and ~/.{agent} is %USERPROFILE%\\.{agent}.
+
+1. Install the Nako Portal plugin:
+
+   {install}
+
+2. Join the mesh. This saves the token in this Hermes's .env, adds the hub's synced skills folder, and names the machine:
+
+   {agent} mesh join {address} {token} --name {name}
+
+3. Keep the gateway running in the background so the machine stays reachable:
+   run `{agent} gateway status`. If no background service is installed, run `{agent} gateway install` first.
+   On Windows, start it through its scheduled task, `schtasks /Run /TN {agent.capitalize()}_Gateway` (after `{agent} gateway stop` if one runs),
+   never with `{agent} gateway start` or `restart`, which run it outside the task. Elsewhere run `{agent} gateway restart`.
+   If you are running inside that gateway and can't restart it, ask the user to do it in a terminal, then continue.
+
+4. Check that it joined: run `{status}` every 10 seconds for up to 2 minutes until it prints "online": true.
+   If it never does, show the user the end of ~/.{agent}/logs/gateway.log and ~/.{agent}/nako-portal/server.log.
+
+5. Tell the user in one line that "{name}" joined the mesh.
+"""
+
+
+def remove_node(data, name):
+    nodes = load_nodes(data)
+    if nodes.pop(name, None) is None:
+        return False
+    _write_private(Path(data) / NODES_FILE, json.dumps(nodes, indent=2) + "\n")
+    return True
+
+
+def _write_private(path, text):
+    temp = path.with_suffix(path.suffix + ".tmp")
+    temp.write_text(text, encoding="utf-8")
+    temp.chmod(0o600)
+    os.replace(temp, path)
+
+
+# Skills
+
+
+def _excluded(parts, exclude):
+    return any(p in exclude or p.startswith(".") or p in SKIPPED_NAMES for p in parts)
+
+
+def skill_manifest(root, exclude=()):
+    """{relative path: sha256} for every file the hub shares: each skill folder (one with a
+    SKILL.md) and category DESCRIPTION.md files, minus any path with an excluded name in it
+    (a skill's name or a category's)."""
+    root = Path(root)
+    exclude = set(exclude or ())
+    files = {}
+    if not root.is_dir():
+        return files
+    skill_dirs = set()
+    for folder, dirs, names in os.walk(root):
+        folder = Path(folder)
+        dirs[:] = [d for d in dirs if not _excluded((d,), exclude) and not (folder / d).is_symlink()]
+        marker = folder / "SKILL.md"
+        in_skill = folder.parent in skill_dirs or ("SKILL.md" in names and not marker.is_symlink())
+        if in_skill:
+            skill_dirs.add(folder)
+        for name in names:
+            path = folder / name
+            if _excluded((name,), exclude) or path.is_symlink() or (not in_skill and name != "DESCRIPTION.md"):
+                continue
+            try:
+                if path.stat().st_size <= SKILL_FILE_MAX:
+                    files[path.relative_to(root).as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
+            except OSError:
+                continue
+    return files
+
+
+def read_skill_files(root, wanted, exclude=()):
+    root = Path(root).resolve()
+    exclude = set(exclude or ())
+    out, size = {}, 0
+    for rel in wanted:
+        if not _safe_rel(rel) or _excluded(Path(rel).parts, exclude):
+            continue
+        path = root / rel
+        if any(p.is_symlink() for p in (path, *path.parents) if p != root and root in p.parents):
+            continue
+        if not path.resolve().is_relative_to(root):
+            continue
+        markers = (p / "SKILL.md" for p in path.parents if p == root or root in p.parents)
+        if path.name != "DESCRIPTION.md" and not any(p.is_file() and not p.is_symlink() for p in markers):
+            continue
+        try:
+            if path.stat().st_size > SKILL_FILE_MAX:
+                continue
+            data = path.read_bytes()
+        except OSError:
+            continue
+        if out and size + len(data) > SKILL_BATCH:
+            break
+        out[rel] = base64.b64encode(data).decode()
+        size += len(data)
+    return out
+
+
+def _safe_rel(rel):
+    parts = Path(rel).parts
+    return bool(parts) and not Path(rel).is_absolute() and ".." not in parts and not any(":" in p for p in parts)
+
+
+async def mirror_skills(target, manifest, fetch):
+    """Make `target` hold exactly the hub's skills. `fetch(paths)` -> {path: base64}. Files are
+    left read-only, so an edit on this machine fails loudly instead of being lost on the next sync."""
+    target = Path(target)
+    state_path = target / MIRROR_STATE
+    manifest = {rel: sha for rel, sha in manifest.items() if _safe_rel(rel)}
+
+    def prepare():
+        target.mkdir(parents=True, exist_ok=True)
+        try:
+            have = json.loads(state_path.read_text(encoding="utf-8-sig"))
+        except (OSError, ValueError):
+            have = {}
+        stale = [rel for rel, sha in manifest.items() if have.get(rel) != sha or not (target / rel).is_file()]
+        return have, stale
+
+    have, stale = await asyncio.to_thread(prepare)
+    changed = 0
+
+    def write_batch(got):
+        written = 0
+        for rel, encoded in got.items():
+            if rel not in manifest:
+                continue
+            try:
+                data = base64.b64decode(encoded, validate=True)
+            except (ValueError, TypeError):
+                continue
+            if len(data) > SKILL_FILE_MAX or hashlib.sha256(data).hexdigest() != manifest[rel]:
+                log.warning("portal: skill digest mismatch for %s; will retry next sync", rel)
+                continue
+            path = target / rel
+            path.parent.mkdir(parents=True, exist_ok=True)
+            if path.exists():
+                path.chmod(stat.S_IWRITE | stat.S_IREAD)
+            temp = path.with_name(path.name + ".mesh-tmp")
+            temp.write_bytes(data)
+            os.replace(temp, path)
+            path.chmod(stat.S_IREAD | stat.S_IRGRP | stat.S_IROTH)
+            have[rel] = manifest[rel]
+            written += 1
+        return written
+
+    while stale:
+        got = await fetch(stale)
+        if not got or not set(stale).intersection(got):
+            break
+        changed += await asyncio.to_thread(write_batch, got)
+        stale = [rel for rel in stale if rel not in got]
+
+    def finish():
+        removed = 0
+        for rel in [rel for rel in have if rel not in manifest]:
+            if _safe_rel(rel):
+                path = target / rel
+                if path.exists():
+                    path.chmod(stat.S_IWRITE | stat.S_IREAD)
+                    path.unlink()
+            have.pop(rel)
+            removed += 1
+        for folder in sorted((p for p in target.rglob("*") if p.is_dir()), key=lambda p: len(p.parts), reverse=True):
+            try:
+                folder.rmdir()
+            except OSError:
+                pass
+        state_path.write_text(json.dumps(have, sort_keys=True), encoding="utf-8")
+        return removed
+
+    changed += await asyncio.to_thread(finish)
+    return changed
+
+
+# The hub's side
+
+
+class RemoteHub:
+    """One node's hub, called like the local one."""
+
+    def __init__(self, mesh, machine):
+        self.mesh = mesh
+        self.machine = machine
+
+    def __getattr__(self, name):
+        if name not in NODE_CALLS:
+            raise AttributeError(name)
+
+        async def call(*args):
+            args = list(args)
+            # Files cross the link base64-encoded: send(session, text, files), create(text, files, ...).
+            at = {"send": 2, "create": 1}.get(name)
+            if at is not None and len(args) > at:
+                args[at] = encode_files(list(args[at] or []))
+            result = _rewrite(await self.mesh.call(self.machine, name, *args), self.machine)
+            if name == "open":
+                self.mesh.attachments.save(remote_id(self.machine, args[0]), opened=result)
+            elif name == "archive":
+                sid = remote_id(self.machine, args[0])
+                cached = self.mesh.attachments.view(sid).get("opened")
+                if cached:
+                    self.mesh.attachments.save(sid, opened={**cached, "archived": bool(args[1]) if len(args) > 1 else True})
+            return result
+
+        return call
+
+
+class LocalHub:
+    """The hub's own hub, as another machine sees it: chat ids carry the hub's name."""
+
+    def __init__(self, hub, name):
+        self.hub = hub
+        self.name = name
+
+    def __getattr__(self, name):
+        method = getattr(self.hub, name)
+
+        async def call(*args):
+            return _rewrite(await method(*args), self.name)
+
+        return call
+
+
+class Mesh:
+    """The hub's machines: who is connected, what they're doing, and calls into them.
+
+    `hub` is this server's own hub; a node's live frames reach the app through it."""
+
+    def __init__(self, data, hub, *, name="hub", address=None, plugin=None, skills_dir=None, skills_exclude=(), store=None, ops=None, clock=time.time):
+        self.data = Path(data)
+        self.attachments = Attachments(self.data / "attachments")
+        # The hub's own name in the mesh: other machines reach its chats as `mesh.<name>.<id>`.
+        self.name = name
+        # Where machines dial in (`mesh_listen`), for the join command a new machine runs.
+        self.address = address
+        # {source, ref}: the plugin a new machine installs, so it runs the hub's own version.
+        self.plugin = plugin
+        self.hub = hub
+        self.skills_dir = Path(skills_dir) if skills_dir else None
+        self.skills_exclude = list(skills_exclude or ())
+        self.store = store
+        # The hub's own Hermes, for its version in the machine list (`machine_ops.MachineOps`).
+        self.ops = ops
+        self.agent = ops.agent if ops is not None else "hermes"
+        self.clock = clock
+        self.peers = {}
+        self.info = {}
+        self.status = {}
+        self.requests = {}
+        hub.elsewhere = lambda: [(entry.get("status"), bool(entry.get("unread"))) for entry in self.status.values()]
+
+    # Where machines get the plugin
+
+    def plugin_source(self):
+        """The git URL new machines install the plugin from: the one saved on the Mesh page, else
+        the one found from settings or the plugin's own checkout. None when neither exists."""
+        saved = self.store.meta(SOURCE_KEY, None) if self.store is not None else None
+        return saved or (self.plugin or {}).get("source")
+
+    def install_from(self):
+        return {"source": self.plugin_source(), "ref": (self.plugin or {}).get("ref")}
+
+    def source_view(self):
+        saved = self.store.meta(SOURCE_KEY, None) if self.store is not None else None
+        return {"source": self.plugin_source(), "detected": (self.plugin or {}).get("source"), "saved": bool(saved)}
+
+    def set_source(self, source):
+        """Save the plugin source from the Mesh page; empty goes back to the detected one."""
+        from .mesh_setup import SAFE
+
+        source = str(source or "").strip()
+        if source and not SAFE["source"].match(source):
+            raise ValueError("Use a git URL machines can reach, like https://github.com/<you>/<repo>.git")
+        if self.store is None:
+            raise ValueError("Nowhere to save it")
+        self.store.set_meta(SOURCE_KEY, source or None)
+        return self.source_view()
+
+    # Who's there
+
+    def add(self, name):
+        """Let a machine join: its token, and the command that joins it, shown once."""
+        if name == self.name:
+            raise ValueError(f"{name} is this hub's own name")
+        if not self.plugin_source():
+            raise ValueError(NO_SOURCE)
+        if not self.address:
+            raise ValueError("Machines need an address for this hub: set the portal's origin (or mesh_address)")
+        token = add_node(self.data, name)
+        command = f"{self.agent} mesh join {self.address or '<this hub>'} {token} --name {name}"
+        code = start_setup(self.data, name, token, self.clock())
+        url = f"{self.address}{SETUP_PATH.format(code=code)}"
+        prompt = f'Set this machine up as "{name}" in my Nako mesh: run `curl -fsSL {url}` (curl.exe on Windows) and follow the steps it prints, exactly and in order.'
+        # The one line to paste in a terminal on the new machine, by its OS.
+        lines = {"unix": f"curl -fsSL {url}/sh | bash", "windows": f"iex (irm {url}/ps1)"}
+        return {"name": name, "token": token, "command": command, "prompt": prompt, "lines": lines}
+
+    async def script(self, request):
+        """GET /mesh/setup/{code}/sh or /ps1: the script that line runs."""
+        code, kind = request.match_info["code"], request.match_info["kind"]
+        name, setup = setup_for(self.data, code, self.clock())
+        if name is None:
+            message = "This setup line expired or was never made. Add the machine again on the Mesh page."
+            text = f"echo '{message}' >&2; exit 1\n" if kind == "sh" else f"Write-Host '{message}' -ForegroundColor Red\n"
+            return web.Response(status=404 if kind == "sh" else 200, text=text, content_type="text/plain")
+        if not setup.get("token"):
+            text = f"echo '{name} already joined the mesh.'\n" if kind == "sh" else f"Write-Host '{name} already joined the mesh.'\n"
+            return web.Response(text=text, content_type="text/plain")
+        plugin = self.install_from()
+        values = {
+            "hub": self.address,
+            "name": name,
+            "token": setup["token"],
+            "status": f"{self.address}{SETUP_PATH.format(code=code)}/status",
+            "source": plugin.get("source") or "",
+            "ref": plugin.get("ref") or "",
+            "agent": self.agent,
+        }
+        text = shell_script(**values) if kind == "sh" else powershell_script(**values)
+        return web.Response(text=text, content_type="text/plain", headers={"Cache-Control": "no-store"})
+
+    async def setup(self, request):
+        """GET /mesh/setup/{code}: the steps a new machine's Hermes follows (plain text)."""
+        name, setup = setup_for(self.data, request.match_info["code"], self.clock())
+        if name is None:
+            return web.Response(status=404, text="This setup link expired or was never made. Add the machine again in Settings.\n")
+        if not setup.get("token"):
+            return web.Response(text=f'"{name}" already joined the mesh. Nothing to do.\n')
+        page = setup_page(name=name, address=self.address, token=setup["token"], code=request.match_info["code"], plugin=self.install_from(), agent=self.agent)
+        return web.Response(text=page, content_type="text/plain", headers={"Cache-Control": "no-store"})
+
+    async def setup_status(self, request):
+        name, _ = setup_for(self.data, request.match_info["code"], self.clock())
+        if name is None:
+            return web.json_response({"error": "unknown or expired setup"}, status=404)
+        online = name in self.peers
+        return web.json_response({"machine": name, "online": online, "gateway": online and bool(self.info.get(name, {}).get("gateway"))})
+
+    async def remove(self, name):
+        """Revoke a machine's token and drop its link, so it's gone at once."""
+        if not remove_node(self.data, name) and name not in self.peers:
+            raise ValueError(f"No machine called {name}")
+        peer = self.peers.get(name)
+        if peer is not None:
+            await peer.ws.close()
+        self.info.pop(name, None)
+        if self.store is not None:
+            self.store.set_meta(f"mesh:seen:{name}", None)
+        await self.hub.broadcast({"kind": "machines.changed"})
+        return {"ok": True}
+
+    def machines(self):
+        nodes = load_nodes(self.data)
+        rows = []
+        for name in sorted(set(nodes) | set(self.peers)):
+            info = self.info.get(name, {})
+            online = name in self.peers
+            last = info.get("last_seen") or (self.store.meta(f"mesh:seen:{name}", None) if self.store else None)
+            rows.append(
+                {
+                    "name": name,
+                    "online": online,
+                    "gateway": bool(info.get("gateway")) if online else False,
+                    "os": info.get("os"),
+                    "hostname": info.get("hostname"),
+                    "connected_at": info.get("connected_at") if online else None,
+                    "last_seen": self.clock() if online else last,
+                    "working": sum(1 for s, v in self.status.items() if (parse(s) or ("",))[0] == name and v.get("status") == "working"),
+                    # Its Hermes: {version, date, channel, commit, line} from `hermes --version` there.
+                    "hermes": info.get("hermes"),
+                }
+            )
+        return rows
+
+    def me(self):
+        """The hub's own row, as the machine list shows it."""
+        return {
+            "name": self.name,
+            "hub": True,
+            "online": True,
+            "gateway": bool(self.hub.connected),
+            "os": f"{platform.system()} {platform.release()}".strip(),
+            "hostname": socket.gethostname(),
+            "last_seen": self.clock(),
+            "working": sum(1 for v in self.hub.status.values() if v == "working"),
+            "hermes": self.ops.info if self.ops is not None else None,
+        }
+
+    async def machine_op(self, machine, op, *args):
+        """Restart a machine's gateway, update its Hermes, or read how that's going. The machine's
+        portal server does it, so this works while the machine's gateway is down."""
+        if op not in MACHINE_OPS:
+            raise ValueError(f"no such machine op: {op}")
+        if machine == self.name:
+            raise ValueError("That's the hub itself; do that on the hub, not through the mesh")
+        self.machine_hub(machine)  # offline or unknown machines fail here, clearly
+        return await self.call(machine, op, *args)
+
+    async def _settle(self, machine):
+        """A machine's gateway went away: its turns and questions went with it."""
+        for session in [s for s in self.status if (parse(s) or ("",))[0] == machine]:
+            if self.status[session].get("status") in ("working", "needs you"):
+                del self.status[session]
+                await self.hub.broadcast({"kind": "status", "session": session, "status": None, "unread": False})
+        for rid in [r for r, m in self.requests.items() if m == machine]:
+            self.requests.pop(rid, None)
+
+    def target(self, session):
+        """The hub that holds a chat and its id there."""
+        found = parse(session)
+        if found is None:
+            return self.hub, session
+        machine, inner = found
+        if machine == self.name:
+            return self.hub, inner
+        if machine not in self.peers:
+            cached = self.attachments.view(session).get("opened")
+            if cached:
+                class Saved:
+                    async def open(self, *args):
+                        return {**cached, "running": False, "gateway": False, "requests": [], "status": None, "live": None}
+
+                    def __getattr__(self, name):
+                        async def offline(*args):
+                            raise ConnectionError(f"{machine} is offline")
+                        return offline
+                return Saved(), inner
+            raise ConnectionError(f"{machine} is offline")
+        return RemoteHub(self, machine), inner
+
+    def machine_hub(self, machine):
+        if machine == self.name:
+            return LocalHub(self.hub, self.name)
+        if machine not in self.peers:
+            if machine in load_nodes(self.data):
+                raise ConnectionError(f"{machine} is offline")
+            raise ValueError(f"No machine called {machine}")
+        return RemoteHub(self, machine)
+
+    async def threads(self, machine):
+        """Another machine's chats (or the hub's own), newest first."""
+        hub = self.hub if machine == self.name else self.machine_hub(machine)
+        # Listing rows carry the machine's own ids under `id`; thread_rows names them for the mesh.
+        listed = thread_rows(machine, await hub.sessions())
+        return sorted(listed, key=lambda r: r.get("started_at") or 0, reverse=True)
+
+    async def call(self, machine, method, *args):
+        peer = self.peers.get(machine)
+        if peer is None:
+            raise ConnectionError(f"{machine} is offline")
+        return await peer.call(method, *args)
+
+    async def sessions(self):
+        """Every connected machine's chats, for the sidebar. A machine that doesn't answer in time
+        is left out of this listing rather than holding it up."""
+
+        async def one(machine):
+            try:
+                rows = await asyncio.wait_for(self.call(machine, "sessions"), LIST_TIMEOUT)
+            except Exception as error:  # noqa: BLE001 - A remote backend failure must not hide other machines.
+                log.info("portal: %s didn't list its chats (%s)", machine, error)
+                return []
+            shown = []
+            for row in rows or []:
+                if row.get("notifications") or row.get("reviews"):
+                    continue
+                session = remote_id(machine, row["id"])
+                entry = self.status.get(session) or {}
+                shown.append({**row, "id": session, "machine": machine, "status": entry.get("status"), "finished": bool(entry.get("unread"))})
+            return shown
+
+        lists = await asyncio.gather(*(one(m) for m in list(self.peers)))
+        rows = [row for group in lists for row in group]
+        known = {row["id"] for row in rows}
+        nodes = load_nodes(self.data)
+        for opened in self.attachments.sessions():
+            sid = opened["session"]
+            machine, _ = parse(sid) or (None, None)
+            if machine in nodes and machine not in self.peers and sid not in known and not opened.get("archived"):
+                rows.append({"id": sid, "title": opened.get("title") or "untitled", "machine": machine, "source": "portal", "message_count": len(opened.get("messages") or []), "started_at": opened.get("last_active") or 0, "status": None})
+        return rows
+
+    def status_frames(self):
+        return [{"kind": "status", "session": s, **v} for s, v in self.status.items()]
+
+    async def read(self, session):
+        """The chat came up on screen here: its finished turn is seen."""
+        entry = self.status.get(session)
+        if entry and entry.get("unread"):
+            entry["unread"] = False
+            await self.hub.broadcast({"kind": "status", "session": session, **entry})
+
+    async def answer(self, request_id, result):
+        machine = self.requests.get(str(request_id))
+        if machine is None:
+            raise ValueError("That request is no longer open")
+        return await self.call(machine, "answer", request_id, result)
+
+    # A node's live view
+
+    async def _frame(self, machine, frame):
+        if not isinstance(frame, dict):
+            return
+        kind = frame.get("kind")
+        inner = frame.get("session")
+        session = remote_id(machine, inner) if isinstance(inner, str) and inner else None
+        if kind == "sessions.changed":
+            await self.hub.broadcast({"kind": "sessions.changed"})
+        elif kind == "status" and session:
+            entry = {"status": frame.get("status"), "unread": bool(frame.get("unread")) and not self.hub.seen(session)}
+            if entry["status"] is None:
+                self.status.pop(session, None)
+            else:
+                self.status[session] = entry
+            await self.hub.broadcast({"kind": "status", "session": session, **entry})
+            await self.hub.broadcast({"kind": "machines.changed"})
+        elif kind == "alert" and session:
+            self.hub.notify(session, f"{machine} · {frame.get('title') or 'Nako'}", str(frame.get("body") or ""))
+        elif session and kind in {"event", "request", "request.closed"}:
+            if kind == "request" and isinstance(frame.get("request"), dict):
+                self.requests[str(frame["request"].get("id"))] = machine
+            if kind == "request.closed":
+                self.requests.pop(str(frame.get("id")), None)
+            payload = {k: v for k, v in frame.items() if k != "session"}
+            await self.hub._publish(session, payload)
+        elif kind == "node.info" and machine in self.info:
+            self.info[machine]["hermes"] = frame.get("hermes") if isinstance(frame.get("hermes"), dict) else None
+            await self.hub.broadcast({"kind": "machines.changed"})
+        # hub.connected / hub.disconnected: the node's own gateway; kept in its info instead.
+        if kind in {"hub.connected", "hub.disconnected"} and machine in self.info:
+            self.info[machine]["gateway"] = kind == "hub.connected"
+            if kind == "hub.disconnected":
+                await self._settle(machine)
+            await self.hub.broadcast({"kind": "sessions.changed"})
+            await self.hub.broadcast({"kind": "machines.changed"})
+
+    def _methods(self, machine):
+        async def hello(info):
+            info = info if isinstance(info, dict) else {}
+            self.info[machine] = {
+                "os": str(info.get("os") or "")[:40] or None,
+                "hostname": str(info.get("hostname") or "")[:80] or None,
+                "gateway": bool(info.get("gateway")),
+                "connected_at": self.clock(),
+                "hermes": info.get("hermes") if isinstance(info.get("hermes"), dict) else None,
+            }
+            for frame in info.get("statuses") or []:
+                await self._frame(machine, frame)
+            await self.hub.broadcast({"kind": "machines.changed"})
+            return {"hub": socket.gethostname(), "attachments": 1}
+
+        async def frame(value):
+            await self._frame(machine, value)
+
+        async def skills_manifest():
+            if self.skills_dir is None:
+                return {}
+            return await asyncio.to_thread(skill_manifest, self.skills_dir, self.skills_exclude)
+
+        async def skill_files(paths):
+            if self.skills_dir is None:
+                return {}
+            return await asyncio.to_thread(read_skill_files, self.skills_dir, [str(p) for p in paths or []], self.skills_exclude)
+
+        async def machines():
+            """The mesh as this machine's agent sees it: the hub and every other machine."""
+            return [self.me()] + [row for row in self.machines() if row["name"] != machine]
+
+        async def machine_op(target, op, args):
+            """A restart, update or job check on another machine, for this machine's agent."""
+            if target == machine:
+                raise ValueError("That's this machine; do it here")
+            return await self.machine_op(target, op, *(args or []))
+
+        async def start(target, text, title=None, cwd=None, yolo=True):
+            """A new chat on another machine (or the hub), for this machine's agent."""
+            if target == machine:
+                raise ValueError("That's this machine; do it here")
+            return await self.machine_hub(target).create(str(text), [], title, cwd, bool(yolo))
+
+        async def threads(target):
+            if target == machine:
+                raise ValueError("Those are this machine's own chats")
+            return await self.threads(target)
+
+        async def attachment(session, opened=None, item=None):
+            # This socket's identity owns only this machine's namespace.
+            if not isinstance(session, str) or not re.fullmatch(r"[\w-][\w.-]{0,100}", session):
+                raise ValueError("Invalid attachment session")
+            sid = remote_id(machine, session)
+            if opened is not None:
+                if not isinstance(opened, dict) or opened.get("session") != session:
+                    raise ValueError("Invalid attachment transcript")
+                opened = _rewrite(opened, machine)
+            self.attachments.save(sid, opened=opened, item=item)
+            return {"ok": True}
+
+        async def relay(session, method, args):
+            """A call into a chat on another machine (or the hub), for this machine's agent."""
+            if method not in RELAYED:
+                raise ValueError(f"can't relay {method}")
+            found = parse(session)
+            if found is None:
+                raise ValueError("give a mesh chat id (mesh.<machine>.<id>)")
+            if found[0] == machine:
+                raise ValueError("That chat is on this machine")
+            hub, inner = self.target(session)
+            args = list(args or [])
+            if method == "send":
+                text = str(args[0] if args else "")
+                deliveries = args[1] if len(args) > 1 else []
+                if not isinstance(deliveries, list) or len(deliveries) > MAX_FILES:
+                    raise ValueError("Too many attachments")
+                offered = set(media_paths(FROM_THREAD.sub("", text, count=1)))
+                total = 0
+                for item in deliveries:
+                    if not isinstance(item, dict) or item.get("path") not in offered:
+                        raise ValueError("That file wasn't attached in this message")
+                    _, data = decode_attachment(item)
+                    total += len(data)
+                if total > MAX_FILE:
+                    raise ValueError("Attachments must total under 25 MiB")
+                if deliveries and hub is not self.hub:
+                    raise ValueError("Send file attachments to a hub chat")
+                if deliveries:
+                    self.attachments.save(inner, opened={"messages": [{"role": "assistant", "text": text}]})
+                    for item in deliveries:
+                        self.attachments.save(inner, item=item)
+                        raw = item["path"]
+                        saved = self.attachments.file(inner, raw)
+                        text = text.replace(raw, str(saved))
+                args = [text, []]
+            # answer(request id, result) names the request, not the chat.
+            call = getattr(hub, method)
+            result = await (call(*args) if method == "answer" else call(inner, *args))
+            return _rewrite(result, self.name) if hub is self.hub else result
+
+        return {
+            "hello": hello,
+            "frame": frame,
+            "skills_manifest": skills_manifest,
+            "skill_files": skill_files,
+            "machines": machines,
+            "start": start,
+            "relay": relay,
+            "threads": threads,
+            "machine_op": machine_op,
+            "attachment": attachment,
+        }
+
+    async def handle(self, request):
+        """GET /mesh: a node dialing in with `?name=` and its bearer token."""
+        name = str(request.query.get("name") or "")
+        auth = request.headers.get("Authorization", "")
+        token = auth[7:] if auth.startswith("Bearer ") else ""
+        known = load_nodes(self.data).get(name) if MACHINE.match(name) else None
+        if not known or not token or not secrets.compare_digest(_digest(token), str(known.get("token_sha256"))):
+            log.warning("portal: refused a mesh connection for %r", name)
+            return web.json_response({"error": "bad machine or token"}, status=401)
+        ws = web.WebSocketResponse(heartbeat=HEARTBEAT, max_msg_size=MAX_FRAME)
+        await ws.prepare(request)
+        async def authorized():
+            entry = (await asyncio.to_thread(load_nodes, self.data)).get(name)
+            return bool(entry and secrets.compare_digest(_digest(token), str(entry.get("token_sha256"))))
+
+        peer = Peer(ws, self._methods(name), authorize=authorized)
+
+        async def check_revocation():
+            while True:
+                await asyncio.sleep(HEARTBEAT)
+                await peer._authorized()
+
+        checking = asyncio.create_task(check_revocation())
+        old, self.peers[name] = self.peers.get(name), peer
+        if old is not None:
+            await old.ws.close()
+        log.info("portal: %s joined the mesh", name)
+        _joined(self.data, name)
+        await self.hub.broadcast({"kind": "machines.changed"})
+        try:
+            await peer.run()
+        except ConnectionError:
+            pass
+        finally:
+            checking.cancel()
+            if self.peers.get(name) is peer:
+                self.peers.pop(name, None)
+                seen = self.clock()
+                self.info.setdefault(name, {})["last_seen"] = seen
+                if self.store is not None:
+                    self.store.set_meta(f"mesh:seen:{name}", seen)
+
+                async def departed():
+                    await self._settle(name)
+                    log.info("portal: %s left the mesh", name)
+                    await self.hub.broadcast({"kind": "sessions.changed"})
+                    await self.hub.broadcast({"kind": "machines.changed"})
+
+                await asyncio.shield(departed())
+            await asyncio.gather(checking, return_exceptions=True)
+        return ws
+
+    def app(self):
+        app = web.Application(client_max_size=MAX_FRAME)
+        app.router.add_get(MESH_PATH, self.handle)
+        app.router.add_get(SETUP_PATH, self.setup)
+        app.router.add_get(SETUP_PATH + "/status", self.setup_status)
+        app.router.add_get(SETUP_PATH + "/{kind:sh|ps1}", self.script)
+        return app
+
+
+# A node's side
+
+
+class Node:
+    """This machine's portal, dialed into a hub: answers the hub's calls with the local hub and
+    passes up everything the local hub shows its own app."""
+
+    RETRY = 3.0
+
+    def __init__(self, url, name, token, hub, *, skills_into=None, ops=None):
+        self.url = url
+        self.name = name
+        self.token = token
+        self.hub = hub
+        self.skills_into = Path(skills_into) if skills_into else None
+        # This machine's Hermes (`machine_ops.MachineOps`): its version, restarts and updates.
+        self.ops = ops
+        self.peer = None
+        self.uploaded = {}
+        self.attachments_supported = False
+        self.upload_lock = asyncio.Lock()
+        self.connected_event = asyncio.Event()
+        hub.taps.add(self._tap)
+        if ops is not None:
+            ops.on_info = lambda info: self._tap({"kind": "node.info", "hermes": info})
+
+    def _tap(self, frame):
+        peer = self.peer
+        if peer is None:
+            return
+        task = asyncio.get_running_loop().create_task(self._forward(peer, frame))
+        task.add_done_callback(_quiet)
+
+    async def _upload(self, peer, opened):
+        if not self.attachments_supported:
+            return
+        async with self.upload_lock:
+            await self._upload_files(peer, opened)
+
+    async def _opened(self, session, results=False, cache=True):
+        opened = await self.hub.open(session, results, cache=cache)
+        try:
+            opened["archived"] = await asyncio.to_thread(self.hub.backend.is_archived, session)
+        except ConnectionError:
+            pass  # The gateway is down; keep the hub's last known archive flag.
+        return opened
+
+    async def _upload_files(self, peer, opened):
+        await peer.call("attachment", opened["session"], opened)
+        for raw in sorted(shown_files(opened.get("messages") or [])):
+            try:
+                info = Path(raw).expanduser().stat()
+                stamp = (info.st_mtime_ns, info.st_size, info.st_ino)
+                key = (opened["session"], raw)
+                if self.uploaded.get(key) == stamp:
+                    continue
+                item = await asyncio.to_thread(read_attachment, raw)
+                await peer.call("attachment", opened["session"], None, item)
+                self.uploaded[key] = stamp
+            except (OSError, ValueError) as error:
+                log.info("portal: attachment unavailable (%s)", error)
+
+    async def _forward(self, peer, frame):
+        session = frame.get("session")
+        try:
+            if session and frame.get("kind") == "event" and frame.get("type") == "gateway.message":
+                text = (frame.get("payload") or {}).get("text") or ""
+                if media_paths(text):
+                    opened = await self._opened(session)
+                    opened["messages"] = [*opened["messages"], {"role": "assistant", "text": text}]
+                    await self._upload(peer, opened)
+            if session and frame.get("kind") == "event" and frame.get("type") == "message.complete":
+                await self._upload(peer, await self._opened(session))
+        except Exception:
+            log.warning("portal: attachment upload failed; backfill will retry", exc_info=True)
+        await peer.call("frame", frame)
+
+    async def call(self, method, *args):
+        peer = self.peer
+        if peer is None:
+            raise ConnectionError("not connected to the mesh hub")
+        return await peer.call(method, *args)
+
+    def remote(self, session):
+        """A chat on another machine, through the hub, called like a local hub holding it.
+        `answer(request, result)` names no chat, like the hub's own, so the relay is bound to one."""
+        node = self
+
+        class Relay:
+            def __getattr__(self, name):
+                if name not in RELAYED:
+                    raise AttributeError(name)
+
+                async def call(*args):
+                    if name != "answer":
+                        args = args[1:]  # the chat, which this relay already holds
+                    if name == "send":
+                        text = str(args[0])
+                        paths = list(dict.fromkeys(media_paths(FROM_THREAD.sub("", text, count=1))))
+                        if len(paths) > MAX_FILES:
+                            raise ValueError("Too many attachments")
+                        if paths and not node.attachments_supported:
+                            raise ValueError("The hub needs an attachment-capable plugin before files can be sent")
+                        files, size = [], 0
+                        for raw in paths:
+                            try:
+                                item = await asyncio.to_thread(read_attachment, raw)
+                            except OSError as error:
+                                raise ValueError("An attached file is missing or unreadable") from error
+                            size += len(item["data"])
+                            if size > ((MAX_FILE + 2) // 3) * 4:
+                                raise ValueError("Attachments must total under 25 MiB")
+                            files.append(item)
+                        return await node.call("relay", session, name, [text, files])
+                    return await node.call("relay", session, name, list(args))
+
+                return call
+
+        return Relay()
+
+    def _methods(self):
+        methods = {name: getattr(self.hub, name) for name in NODE_CALLS}
+
+        async def send(session, text, files=(), *rest):
+            return await self.hub.send(session, text, decode_files(files or []), *rest)
+
+        async def create(text, files=(), *rest):
+            return await self.hub.create(text, decode_files(files or []), *rest)
+
+        async def opened(session, results=False):
+            result = await self._opened(session, results)
+            if self.peer is not None:
+                await self._upload(self.peer, result)
+            return result
+
+        methods.update(send=send, create=create, open=opened)
+        ops = self.ops
+        if ops is not None:
+
+            async def bounce():
+                return await ops.start("restart")
+
+            async def update_hermes(channel=None):
+                return await ops.start("update", channel)
+
+            async def job():
+                return ops.job()
+
+            methods.update({MACHINE_OPS[0]: bounce, "update_hermes": update_hermes, "job": job})
+        return methods
+
+    def _hello(self):
+        return {
+            "os": f"{platform.system()} {platform.release()}".strip(),
+            "hostname": socket.gethostname(),
+            "gateway": bool(self.hub.connected),
+            "statuses": self.hub.status_frames(),
+            "hermes": self.ops.info if self.ops is not None else None,
+        }
+
+    async def run(self, http):
+        while True:
+            try:
+                ws = await http.ws_connect(
+                    self.url,
+                    params={"name": self.name},
+                    headers={"Authorization": f"Bearer {self.token}"},
+                    heartbeat=HEARTBEAT,
+                    max_msg_size=MAX_FRAME,
+                )
+            except (ClientError, OSError, TimeoutError) as error:
+                log.info("portal: can't reach the mesh hub at %s (%s)", self.url, error)
+                await asyncio.sleep(self.RETRY)
+                continue
+            peer = Peer(ws, self._methods())
+            self.peer = peer
+            self.uploaded.clear()
+            running = asyncio.get_running_loop().create_task(peer.run())
+            syncing = None
+            uploading = None
+            try:
+                hello = await peer.call("hello", self._hello())
+                self.attachments_supported = bool((hello or {}).get("attachments"))
+                self.connected_event.set()
+                log.info("portal: joined the mesh at %s as %s", self.url, self.name)
+                if self.attachments_supported:
+                    uploading = asyncio.get_running_loop().create_task(self._sync_attachments(peer))
+                if self.skills_into is not None:
+                    syncing = asyncio.get_running_loop().create_task(self._sync_skills(peer))
+                await running
+            except Exception as error:  # noqa: BLE001 - Reconnect after any remote handshake or link failure.
+                log.warning("portal: mesh link dropped (%s)", error)
+            finally:
+                self.peer = None
+                self.connected_event.clear()
+                for task in (running, syncing, uploading):
+                    if task is not None:
+                        task.cancel()
+                await ws.close()
+            await asyncio.sleep(self.RETRY)
+
+    async def _sync_attachments(self, peer):
+        # Backfill existing chats and retry after a lost link. One file per RPC.
+        while True:
+            try:
+                for row in [*await self.hub.sessions(), *await self.hub.archived()]:
+                    try:
+                        # Bulk reads must not evict the transcripts currently open in the app.
+                        opened = await self._opened(row["id"], cache=False)
+                        if shown_files(opened.get("messages") or []):
+                            await self._upload(peer, opened)
+                    except (ValueError, OSError):
+                        log.info("portal: attachment backfill skipped an unavailable chat")
+            except asyncio.CancelledError:
+                raise
+            except Exception:
+                log.debug("portal: attachment sync will retry", exc_info=True)
+            await asyncio.sleep(60)
+
+    async def _sync_skills(self, peer):
+        while True:
+            try:
+                manifest = await peer.call("skills_manifest")
+                changed = await mirror_skills(self.skills_into, manifest or {}, lambda paths: peer.call("skill_files", paths))
+                if changed:
+                    log.info("portal: synced %d skill file(s) from the hub", changed)
+            except asyncio.CancelledError:
+                raise
+            except ConnectionError:
+                return
+            except Exception:
+                log.warning("portal: skill sync failed", exc_info=True)
+            await asyncio.sleep(SKILL_POLL)
+
+
+def _quiet(task):
+    if not task.cancelled() and task.exception() is not None and not isinstance(task.exception(), ConnectionError):
+        log.debug("portal: mesh frame failed: %s", task.exception())
+
+
+def main(argv=None):
+    """`python -m portal.mesh add|remove|list <name> --data <dir>`: manage the hub's machines."""
+    import argparse
+
+    parser = argparse.ArgumentParser(prog="nako-mesh")
+    parser.add_argument("action", choices=["add", "remove", "list"])
+    parser.add_argument("name", nargs="?")
+    parser.add_argument("--data", required=True)
+    args = parser.parse_args(argv)
+    if args.action == "list":
+        for name, entry in sorted(load_nodes(args.data).items()):
+            print(name, time.strftime("%Y-%m-%d", time.localtime(entry.get("added") or 0)))
+        return 0
+    if not args.name:
+        parser.error("name a machine")
+    if args.action == "add":
+        print(add_node(args.data, args.name))
+        return 0
+    return 0 if remove_node(args.data, args.name) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
