@@ -0,0 +1,156 @@
+"""The one-line setup scripts a new machine runs to join the mesh.
+
+`curl -fsSL <hub>/mesh/setup/<code>/sh | bash` on macOS and Linux, and
+`iex (irm <hub>/mesh/setup/<code>/ps1)` in PowerShell on Windows. Each script checks it can
+reach the hub, installs Hermes if it's missing, has the person sign in to a model provider if
+none is set up (the one step that needs them), then installs the portal plugin at the hub's own
+commit, joins the mesh, runs the gateway as a service and waits until the hub sees the machine
+and its gateway. On Windows the gateway is only ever started through its scheduled task, never
+in the script's own window, where closing it or Ctrl+C would stop it.
+Every value put into a script is checked against a strict pattern first, so none can break out
+of its quotes.
+"""
+
+from __future__ import annotations
+
+import re
+
+HERMES_SH = "https://hermes-agent.nousresearch.com/install.sh"
+HERMES_PS1 = "https://hermes-agent.nousresearch.com/install.ps1"
+SAFE = {
+    "hub": re.compile(r"^https?://[A-Za-z0-9.\-\[\]:]+$"),
+    "name": re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$"),
+    "token": re.compile(r"^[A-Za-z0-9_-]{20,100}$"),
+    "status": re.compile(r"^https?://[A-Za-z0-9.\-\[\]:/_-]+$"),
+    "source": re.compile(r"^(https://|git@|ssh://)[A-Za-z0-9.@:/_~-]+$"),
+    "agent": re.compile(r"^[a-z][a-z0-9_-]{0,31}$"),
+    "ref": re.compile(r"^([0-9a-f]{40})?$"),
+}
+
+
+def _checked(**values):
+    for key, value in values.items():
+        if not SAFE[key].match(value):
+            raise ValueError(f"unsafe {key} for a setup script: {value!r}")
+    return values
+
+
+def shell_script(*, hub, name, token, status, source, ref, agent="hermes"):
+    v = _checked(hub=hub, name=name, token=token, status=status, source=source, ref=ref or "", agent=agent)
+    ref_flag = f" --ref {v['ref']}" if v["ref"] else ""
+    return f"""#!/usr/bin/env bash
+# Joins this machine to a Nako mesh as "{v['name']}". Served once by the hub; safe to run again.
+set -eu
+HUB='{v['hub']}'
+NAME='{v['name']}'
+STATUS='{v['status']}'
+
+say() {{ printf '\\n\\033[1m==> %s\\033[0m\\n' "$*"; }}
+fail() {{ printf '\\n\\033[31mx %s\\033[0m\\n' "$*" >&2; exit 1; }}
+
+say "Checking that this machine can reach the hub at $HUB"
+curl -fsS --max-time 10 "$STATUS" >/dev/null 2>&1 || fail "Can't reach $HUB from this machine. Is it online, and is that address right?"
+
+export PATH="$HOME/.local/bin:$PATH"
+if ! command -v {v['agent']} >/dev/null 2>&1; then
+  say "Installing Hermes"
+  curl -fsSL {HERMES_SH} | bash -s -- --non-interactive || fail "The Hermes installer failed (see its log above)"
+  hash -r
+  command -v {v['agent']} >/dev/null 2>&1 || fail "Hermes installed, but '{v['agent']}' isn't on PATH. Open a new terminal and run this line again."
+fi
+
+if ! {v['agent']} config get model.provider >/dev/null 2>&1; then
+  say "Pick a model and sign in to its provider (this is the one step that needs you)"
+  [ -r /dev/tty ] || fail "No terminal to sign in from. Run this line in a terminal window."
+  {v['agent']} model </dev/tty || fail "Model setup didn't finish"
+  {v['agent']} config get model.provider >/dev/null 2>&1 || fail "No model is set up yet. Run '{v['agent']} model', then this line again."
+fi
+
+say "Installing the Nako Portal plugin"
+{v['agent']} plugins install {v['source']}{ref_flag} --enable --yes-deps --force || fail "Installing the plugin failed"
+
+say "Joining the mesh as $NAME"
+{v['agent']} mesh join "$HUB" '{v['token']}' --name "$NAME" || fail "Joining the mesh failed"
+
+say "Running the Hermes gateway as a background service"
+{v['agent']} gateway install --if-missing --start-on-login --no-start-now || fail "Installing the gateway service failed"
+{v['agent']} gateway restart || {v['agent']} gateway start || fail "Starting the gateway failed"
+
+say "Waiting for the hub to see this machine and its gateway"
+for _ in $(seq 1 36); do
+  if curl -fsS --max-time 10 "$STATUS" 2>/dev/null | grep -q '"gateway": true'; then
+    printf '\\n\\033[32m✓ %s joined the mesh.\\033[0m Run {v['agent']} to chat here, or hand it work from the hub.\\n' "$NAME"
+    exit 0
+  fi
+  sleep 5
+done
+fail "The hub hasn't seen $NAME after 3 minutes. Check ~/.{v['agent']}/logs/gateway.log and ~/.{v['agent']}/nako-portal/server.log"
+"""
+
+
+def powershell_script(*, hub, name, token, status, source, ref, agent="hermes"):
+    v = _checked(hub=hub, name=name, token=token, status=status, source=source, ref=ref or "", agent=agent)
+    ref_args = f" --ref {v['ref']}" if v["ref"] else ""
+    return f"""# Joins this machine to a Nako mesh as "{v['name']}". Served once by the hub; safe to run again.
+& {{
+$ErrorActionPreference = 'Stop'
+$Hub = '{v['hub']}'
+$Name = '{v['name']}'
+$Status = '{v['status']}'
+$Task = '{v['agent'].capitalize()}_Gateway'
+
+function Say($m) {{ Write-Host "`n==> $m" -ForegroundColor Cyan }}
+function Fail($m) {{ Write-Host "`nx $m" -ForegroundColor Red; throw $m }}
+function Refresh-Path {{ if ($env:OS -ne 'Windows_NT') {{ return }}; $env:Path = [Environment]::GetEnvironmentVariable('Path','User') + ';' + [Environment]::GetEnvironmentVariable('Path','Machine') }}
+
+Say "Checking that this machine can reach the hub at $Hub"
+try {{ Invoke-RestMethod -Uri $Status -TimeoutSec 10 | Out-Null }} catch {{ Fail "Can't reach $Hub from this machine. Is it online, and is that address right?" }}
+
+Refresh-Path
+if (-not (Get-Command {v['agent']} -ErrorAction SilentlyContinue)) {{
+  Say 'Installing Hermes'
+  & ([scriptblock]::Create((Invoke-RestMethod '{HERMES_PS1}'))) -NonInteractive
+  Refresh-Path
+  if (-not (Get-Command {v['agent']} -ErrorAction SilentlyContinue)) {{ Fail "Hermes installed, but '{v['agent']}' isn't on PATH. Open a new PowerShell window and run this line again." }}
+}}
+
+$ErrorActionPreference = 'Continue'
+{v['agent']} config get model.provider *> $null
+if ($LASTEXITCODE -ne 0) {{
+  Say 'Pick a model and sign in to its provider (this is the one step that needs you)'
+  {v['agent']} model
+  {v['agent']} config get model.provider *> $null
+  if ($LASTEXITCODE -ne 0) {{ Fail "No model is set up yet. Run '{v['agent']} model', then this line again." }}
+}}
+
+Say 'Installing the Nako Portal plugin'
+{v['agent']} plugins install {v['source']}{ref_args} --enable --yes-deps --force
+if ($LASTEXITCODE -ne 0) {{ Fail 'Installing the plugin failed' }}
+
+Say "Joining the mesh as $Name"
+{v['agent']} mesh join $Hub '{v['token']}' --name $Name
+if ($LASTEXITCODE -ne 0) {{ Fail 'Joining the mesh failed' }}
+
+Say 'Running the Hermes gateway as a background service'
+{v['agent']} gateway install --if-missing --start-on-login --no-start-now
+if ($LASTEXITCODE -ne 0) {{ Fail 'Installing the gateway service failed' }}
+# Only ever through the scheduled task: `{v['agent']} gateway start` can run it in this window, where
+# closing the window or Ctrl+C stops it.
+schtasks /Query /TN $Task *> $null
+if ($LASTEXITCODE -ne 0) {{ Fail "The $Task scheduled task isn't registered, so the gateway can't run in the background. Run '{v['agent']} gateway install', then this line again." }}
+{v['agent']} gateway stop *> $null
+schtasks /Run /TN $Task | Out-Null
+if ($LASTEXITCODE -ne 0) {{ Fail "Starting the $Task scheduled task failed" }}
+
+Say 'Waiting for the hub to see this machine and its gateway'
+for ($i = 0; $i -lt 36; $i++) {{
+  try {{
+    $seen = Invoke-RestMethod -Uri $Status -TimeoutSec 10
+    if ($seen.online -and $seen.gateway) {{ Write-Host "`n$([char]0x2713) $Name joined the mesh. Run {v['agent']} to chat here, or hand it work from the hub." -ForegroundColor Green; return }}
+  }} catch {{ }}
+  Start-Sleep -Seconds 5
+}}
+$state = (schtasks /Query /TN $Task /FO LIST /V | Select-String 'Status|Last Run|Last Result') -join '; '
+Fail "The hub hasn't seen $Name's gateway after 3 minutes ($Task task: $state). Check $env:USERPROFILE\\.{v['agent']}\\logs\\gateway.log and $env:USERPROFILE\\.{v['agent']}\\nako-portal\\server.log"
+}}
+"""
diff --git a/plugins/nako-portal/dashboard/portal/offline.py b/plugins/nako-portal/dashboard/portal/offline.py
new file mode 100644
index 0000000000000000000000000000000000000000..f8d18f9c882fa5d6e76ea4ad8b2b64a5f30ee966
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/offline.py
@@ -0,0 +1,301 @@
+"""A chat's transcript read straight from Hermes's session store, for when no gateway is connected.
+
+The gateway is what normally reads transcripts (`HermesBackend.thread`). When it's down (it
+crashed, an update stopped it, it was never started), the portal server still has to show what a
+chat did: the person reading it in the app, or another machine's agent following a task it handed
+over. So the server reads `state.db` itself.
+
+Hermes's own display projection is used when Hermes can be imported, in a short-lived child
+process (the server never imports Hermes, and a half-updated Hermes can't break it). If that
+fails, the rows are projected here from the table alone: prompts, replies and tool calls with
+their results, in the same shape.
+
+Run as `python offline.py <hermes home> <session>`: prints the transcript as JSON.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import sqlite3
+import subprocess
+import sys
+from contextlib import closing
+from pathlib import Path
+
+# A tool result kept with its call, for readers that ask for results (an agent following a task).
+RESULT_CHARS = 2000
+CONTEXT_CHARS = 80
+READ_TIMEOUT = 60
+
+
+def with_results(messages, history):
+    """Tool rows of a projected transcript, each with the start of its result from the raw history."""
+    results = {}
+    for row in history or []:
+        if isinstance(row, dict) and row.get("role") == "tool" and row.get("tool_call_id"):
+            content = row.get("content")
+            if not isinstance(content, str):
+                content = json.dumps(content, default=str)
+            results[row["tool_call_id"]] = content[:RESULT_CHARS]
+    out = []
+    for message in messages:
+        if message.get("role") == "tool" and message.get("tool_call_id") in results and "result" not in message:
+            message = {**message, "result": results[message["tool_call_id"]]}
+        out.append(message)
+    return out
+
+
+def original_user_messages(home, history):
+    """A model turn can join several user-role messages, including posts from different senders.
+    Show their original rows instead, but only if they account for the entire joined text."""
+    bundles = [(i, r) for i, r in enumerate(history) if r.get("role") == "user" and not r.get("display_kind")
+               and r.get("_absorbed_message_uids")]
+    if not bundles:
+        return history
+    positions = {r["message_uid"]: i for i, r in enumerate(history) if r.get("role") == "user" and r.get("message_uid")
+                 and not r.get("_absorbed_message_uids")}
+    slots = [[row] for row in history]
+    restored = set()
+    for index, bundle in bundles:
+        uids = [bundle.get("message_uid"), *bundle["_absorbed_message_uids"]]
+        parts = {u: history[positions[u]] for u in uids if u in positions}
+        missing = [u for u in uids if u not in parts]
+        if missing and bundle.get("_row_id"):
+            # Older generations keep the originals only as inactive rows. Only look up members
+            # named by this visible bundle, in its own session; never replay inactive history.
+            rows = _query(home, "SELECT m.message_uid, m.id, m.content, m.timestamp, m.display_kind, m.display_metadata "
+                          "FROM messages AS b JOIN messages AS m ON m.session_id=b.session_id WHERE b.id=? "
+                          "AND m.role='user' AND m.message_uid IN (SELECT value FROM json_each(?)) "
+                          "AND m.absorbed_message_uids IS NULL AND m.id<b.id AND (m.display_metadata IS NULL OR json_valid(m.display_metadata)) ORDER BY m.id",
+                          (bundle["_row_id"], json.dumps(missing)))
+            for uid, row_id, content, timestamp, kind, metadata in rows:
+                parts.setdefault(uid, {"role": "user", "content": content, "_row_id": row_id, "timestamp": timestamp,
+                                       "message_uid": uid, "display_kind": kind, "display_metadata": json.loads(metadata) if metadata else None})
+        if not all(isinstance(parts.get(u, {}).get("content"), str) for u in uids):
+            continue
+        if "\n\n".join(parts[u]["content"] for u in uids) != bundle["content"]:
+            continue
+        slots[index] = []
+        pending, anchor = [], None
+        for uid in uids:
+            if uid in positions:
+                anchor = positions[uid]
+                slots[anchor][:0] = pending
+                pending = []
+            elif parts[uid]["_row_id"] not in restored:
+                restored.add(parts[uid]["_row_id"])
+                pending.append(parts[uid])
+        slots[index if anchor is None else anchor].extend(pending)
+    return [row for slot in slots for row in slot]
+
+
+def _homes(home):
+    """The home and its profiles' homes: a chat may live in any profile the gateway served."""
+    home = Path(home)
+    profiles = home / "profiles"
+    found = [home]
+    if profiles.is_dir():
+        found += sorted(p for p in profiles.iterdir() if (p / "state.db").is_file())
+    return found
+
+
+def _query(home, sql, args=()):
+    state = Path(home) / "state.db"
+    if not state.is_file():
+        return []
+    with closing(sqlite3.connect(f"file:{state}?mode=ro", uri=True, timeout=10)) as db:
+        return db.execute(sql, args).fetchall()
+
+
+def _context(args):
+    """A one-line preview of a call's arguments, like the one the app shows beside the tool's name."""
+    if not isinstance(args, dict):
+        return ""
+    for key in ("command", "path", "query", "url", "code", "name", "action", "text"):
+        value = args.get(key)
+        if isinstance(value, str) and value.strip():
+            return value.strip().splitlines()[0][:CONTEXT_CHARS]
+    for value in args.values():
+        if isinstance(value, str) and value.strip():
+            return value.strip().splitlines()[0][:CONTEXT_CHARS]
+    return ""
+
+
+def _lineage(home, session):
+    """The session and the ones it continues (compaction starts a child), oldest first."""
+    chain, seen = [], set()
+    current = session
+    while current and current not in seen:
+        seen.add(current)
+        chain.append(current)
+        rows = _query(home, "SELECT parent_session_id FROM sessions WHERE id=?", (current,))
+        current = rows[0][0] if rows else None
+    return list(reversed(chain))
+
+
+def raw_thread(home, session):
+    """The transcript from the table alone, when Hermes can't be imported."""
+    columns = {row[1] for row in _query(home, "PRAGMA table_info(messages)")}
+    active = " AND COALESCE(active, 1)=1" if "active" in columns else ""
+    kind = ", display_kind" if "display_kind" in columns else ", NULL"
+    identity = ", message_uid, absorbed_message_uids" if {"message_uid", "absorbed_message_uids", "display_kind", "display_metadata"} <= columns else ", NULL, NULL"
+    history, messages, calls = [], [], {}
+    for sid in _lineage(home, session):
+        rows = _query(
+            home,
+            f"SELECT id, role, content, tool_call_id, tool_calls, tool_name, timestamp{kind}{identity} FROM messages WHERE session_id=?{active} ORDER BY id",
+            (sid,),
+        )
+        history.extend({"_row_id": row_id, "role": role, "content": content, "tool_call_id": call_id, "tool_calls": tool_calls,
+                        "tool_name": tool_name, "timestamp": timestamp, "display_kind": display_kind, "message_uid": uid,
+                        "_absorbed_message_uids": json.loads(absorbed) if absorbed else []}
+                       for row_id, role, content, call_id, tool_calls, tool_name, timestamp, display_kind, uid, absorbed in rows)
+    for row in original_user_messages(home, history):
+        row_id, role, content = row["_row_id"], row["role"], row["content"]
+        call_id, tool_calls, tool_name = row.get("tool_call_id"), row.get("tool_calls"), row.get("tool_name")
+        timestamp, display_kind = row["timestamp"], row.get("display_kind")
+        if display_kind == "hidden":
+            continue
+        if role == "assistant" and tool_calls:
+            try:
+                for call in json.loads(tool_calls) or []:
+                    function = call.get("function") or {}
+                    try:
+                        args = json.loads(function.get("arguments") or "{}")
+                    except (TypeError, ValueError):
+                        args = {}
+                    calls[call.get("id")] = (function.get("name"), args)
+            except (TypeError, ValueError, AttributeError):
+                pass
+        if role == "tool":
+            name, args = calls.get(call_id, (None, {}))
+            tool = {"role": "tool", "name": name or tool_name or "tool", "context": _context(args), "timestamp": timestamp}
+            if call_id:
+                tool["tool_call_id"] = call_id
+            if args:
+                tool["args"] = args
+            messages.append(tool)
+            continue
+        if role not in ("user", "assistant") or not isinstance(content, str) or not content.strip():
+            continue
+        messages.append({"role": role, "text": content, "row_id": row_id, "timestamp": timestamp,
+                         **({"display_kind": display_kind} if display_kind else {})})
+    title = _query(home, "SELECT title FROM sessions WHERE id=?", (session,))
+    return {"title": (title[0][0] or "") if title else "", "messages": with_results(messages, history)}
+
+
+def messages_from_store(home, session, store):
+    from persistence.conversation.messages import ConversationRequest, TranscriptView
+    from tui_gateway.server import _history_to_messages
+
+    request = ConversationRequest(view=TranscriptView.DISPLAY, include_lineage=True, include_row_ids=True)
+    history = [row.as_openai_message() for row in store.messages.read_conversation(session, request)]
+    messages = _history_to_messages(original_user_messages(home, history), profile_home=Path(home))
+    return with_results(messages, history)
+
+
+def hermes_thread(home, session, agent="hermes"):
+    """The transcript in the agent's own display projection, as the gateway would read it.
+    The agent reads its home from a variable named after itself."""
+    os.environ[f"{agent.upper()}_HOME"] = str(home)
+    from tui_gateway.server import _history_to_messages
+
+    try:
+        from persistence_assembly import open_persistence_reader
+    except ImportError:  # Hermes before the storage interface
+        from hermes_state import SessionDB
+
+        db = SessionDB(Path(home) / "state.db", read_only=True)
+        try:
+            try:
+                history = db.get_messages_as_conversation(session, include_ancestors=True, include_row_ids=True, include_compacted=True)
+            except TypeError:  # a Hermes from before display reads
+                history = db.get_messages_as_conversation(session, include_ancestors=True, include_row_ids=True)
+            title = db.get_session_title(session)
+        finally:
+            db.close()
+    else:
+        with open_persistence_reader(Path(home)) as store:
+            record = store.sessions.get(session)
+            return {"title": (record.title or "") if record is not None else "",
+                    "messages": messages_from_store(home, session, store)}
+    messages = _history_to_messages(original_user_messages(home, history), profile_home=Path(home))
+    return {"title": title or "", "messages": with_results(messages, history)}
+
+
+class Offline:
+    """The hub backend's read calls, answered from the session store while no gateway is there."""
+
+    def __init__(self, home, *, agent="hermes", python=None, projection=True):
+        self.home = Path(home)
+        self.agent = agent or "hermes"
+        self.python = python or sys.executable
+        # Off in tests that have no Hermes to import: the table projection alone.
+        self.projection = projection
+
+    def _home_of(self, session):
+        for home in _homes(self.home):
+            if _query(home, "SELECT 1 FROM sessions WHERE id=? AND source='portal'", (session,)):
+                return home
+        return None
+
+    def search_sessions(self, query):
+        from .search import search_sessions
+
+        found = {}
+        for home in _homes(self.home):
+            for row in search_sessions(home, query):
+                if row["id"] not in found or row["at"] > found[row["id"]]["at"]:
+                    found[row["id"]] = row
+        return sorted(found.values(), key=lambda row: (row["at"], row["id"]), reverse=True)[:20]
+
+    def chat_of(self, session):
+        home = self._home_of(session)
+        rows = _query(home, "SELECT chat_id FROM sessions WHERE id=?", (session,)) if home else []
+        return rows[0][0] if rows and rows[0][0] else None
+
+    def title_of(self, session):
+        for home in _homes(self.home):
+            rows = _query(home, "SELECT title FROM sessions WHERE id=?", (session,))
+            if rows:
+                return rows[0][0] or ""
+        return None
+
+    def thread(self, session, cache=True):
+        home = self._home_of(session)
+        if home is None:
+            return None
+        if self.projection:
+            try:
+                done = subprocess.run(
+                    [self.python, str(Path(__file__).resolve()), str(home), str(session), self.agent], check=False,
+                    capture_output=True,
+                    text=True,
+                    timeout=READ_TIMEOUT,
+                    stdin=subprocess.DEVNULL,
+                    creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
+                )
+                if done.returncode == 0:
+                    return json.loads(done.stdout)
+            except (OSError, subprocess.SubprocessError, ValueError):
+                pass
+        return raw_thread(home, session)
+
+
+def main(argv):
+    home, session = argv[1], argv[2]
+    agent = argv[3] if len(argv) > 3 else "hermes"
+    # This folder's modules (server, hub, link...) mustn't shadow Hermes's own on import.
+    here = Path(__file__).resolve().parent
+    sys.path[:] = [p for p in sys.path if Path(p or ".").resolve() != here]
+    try:
+        thread = hermes_thread(home, session, agent)
+    except Exception:  # noqa: BLE001 - The parent falls back to raw history on any projection failure.
+        return 1
+    sys.stdout.write(json.dumps(thread, default=str))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
diff --git a/plugins/nako-portal/dashboard/portal/push.py b/plugins/nako-portal/dashboard/portal/push.py
new file mode 100644
index 0000000000000000000000000000000000000000..7619ea4317b0d42313a4872e428d93d9c7e8e843
--- /dev/null
+++ b/plugins/nako-portal/dashboard/portal/push.py
@@ -0,0 +1,127 @@
+"""Web Push (RFC 8030) with VAPID (RFC 8292) and aes128gcm payload encryption (RFC 8291).
+
+Notifications carry only a title, a short line and the chat to open; the
+browser vendor's push service sees ciphertext, never the conversation.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import logging
+import os
+import struct
+import time
+from pathlib import Path
+from urllib.parse import urlparse
+
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import ec
+from cryptography.hazmat.primitives.asymmetric.utils import decode_dss_signature
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+from cryptography.hazmat.primitives.kdf.hkdf import HKDF
+
+log = logging.getLogger("hermes.portal")
+RECORD_SIZE = 4096
+
+
+def _b64(data: bytes) -> str:
+    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()
+
+
+def _unb64(text: str) -> bytes:
+    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))
+
+
+def _raw_public(key) -> bytes:
+    return key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
+
+
+def _hkdf(salt, ikm, info, length):
+    return HKDF(algorithm=hashes.SHA256(), length=length, salt=salt, info=info).derive(ikm)
+
+
+def encrypt(payload: bytes, p256dh: str, auth: str, *, sender=None, salt=None) -> bytes:
+    """The aes128gcm body for one subscription."""
+    receiver = ec.EllipticCurvePublicKey.from_encoded_point(ec.SECP256R1(), _unb64(p256dh))
+    sender = sender or ec.generate_private_key(ec.SECP256R1())
+    salt = salt or os.urandom(16)
+    shared = sender.exchange(ec.ECDH(), receiver)
+    ua_public, as_public = _raw_public(receiver), _raw_public(sender.public_key())
+    ikm = _hkdf(_unb64(auth), shared, b"WebPush: info\x00" + ua_public + as_public, 32)
+    cek = _hkdf(salt, ikm, b"Content-Encoding: aes128gcm\x00", 16)
+    nonce = _hkdf(salt, ikm, b"Content-Encoding: nonce\x00", 12)
+    record = AESGCM(cek).encrypt(nonce, payload + b"\x02", None)
+    header = salt + struct.pack(">I", RECORD_SIZE) + bytes([len(as_public)]) + as_public
+    return header + record
+
+
+class Vapid:
+    """The server's push identity: one P-256 key kept beside the portal database."""
+
+    def __init__(self, path: Path, subject: str):
+        self.subject = subject
+        path = Path(path)
+        if path.exists():
+            key = serialization.load_pem_private_key(path.read_bytes(), password=None)
+            if not isinstance(key, ec.EllipticCurvePrivateKey):
+                raise ValueError(f"{path} is not a P-256 key")
+            self.key = key
+        else:
+            self.key = ec.generate_private_key(ec.SECP256R1())
+            pem = self.key.private_bytes(
+                serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()
+            )
+            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+            with os.fdopen(fd, "wb") as out:
+                out.write(pem)
+
+    @property
+    def public_key(self) -> str:
+        return _b64(_raw_public(self.key.public_key()))
+
+    def header(self, endpoint: str) -> str:
+        audience = "{0.scheme}://{0.netloc}".format(urlparse(endpoint))
+        head = _b64(json.dumps({"typ": "JWT", "alg": "ES256"}).encode())
+        claims = _b64(json.dumps({"aud": audience, "exp": int(time.time()) + 12 * 3600, "sub": self.subject}).encode())
+        der = self.key.sign(f"{head}.{claims}".encode(), ec.ECDSA(hashes.SHA256()))
+        r, s = decode_dss_signature(der)
+        token = f"{head}.{claims}.{_b64(r.to_bytes(32, 'big') + s.to_bytes(32, 'big'))}"
+        return f"vapid t={token}, k={self.public_key}"
+
+
+class Pusher:
+    def __init__(self, http, store, vapid):
+        self.http = http
+        self.store = store
+        self.vapid = vapid
+
+    async def notify(self, title: str, body: str, session: str | None = None) -> int:
+        payload = json.dumps({"title": title, "body": body, "session": session}).encode()
+        delivered = 0
+        for subscription in self.store.pushes():
+            endpoint = subscription["endpoint"]
+            keys = subscription["keys"]
+            try:
+                body_bytes = encrypt(payload, keys["p256dh"], keys["auth"])
+                async with self.http.post(
+                    endpoint,
+                    data=body_bytes,
+                    headers={
+                        "Authorization": self.vapid.header(endpoint),
+                        "Content-Encoding": "aes128gcm",
+                        "Content-Type": "application/octet-stream",
+                        "TTL": "86400",
+                        "Urgency": "high",
+                    },
+                ) as response:
+                    if response.status in (404, 410):
+                        # The browser dropped this subscription.
+                        self.store.remove_push(endpoint)
+                    elif response.status < 300:
+                        delivered += 1
+                    else:
+                        log.warning("Nako portal push got %s from %s", response.status, urlparse(endpoint).netloc)
+            except Exception as error:  # noqa: BLE001 - An invalid subscription must not stop delivery to the others.
+                log.warning("Nako portal push failed: %s", type(error).__name__)
+        return delivered
