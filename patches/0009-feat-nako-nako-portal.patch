+        r.add_get("/api/mcp/oauth/callback/{name}", self.mcp_oauth_callback)
+        r.add_get("/api/file", self.file)
+        r.add_get("/api/inbox", self.inbox)
+        r.add_get("/api/mesh", self.machines)
+        r.add_post("/api/mesh/machines", self.add_machine)
