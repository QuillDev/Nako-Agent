#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Nako dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `nako` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-nako-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `nako pm
# install` and `nako update` keep that check.
# ============================================================================
_NAKO_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_nako_test_env="--test-environment"
_nako_expect_extras=""
for _nako_arg in "$@"; do
    if [ -n "$_nako_expect_extras" ]; then
        _nako_test_env="--test-environment=$_nako_arg"
        _nako_expect_extras=""
        continue
    fi
    case "$_nako_arg" in
        --) break ;;
        --test-extras) _nako_expect_extras=1 ;;
        --test-extras=*) _nako_test_env="--test-environment=${_nako_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_nako_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _nako_arg _nako_test_env _nako_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _nako_arg _nako_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_NAKO_REPO/scripts/_activation.sh"

if ! nako_sync "$_NAKO_REPO" "$_nako_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _nako_test_env
    return 1 2>/dev/null || exit 1
fi
unset _nako_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __NAKO_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_nako_script="$(nako_compose_env "$_NAKO_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _nako_script
    return 1 2>/dev/null || exit 1
}
_nako_keys="$(printf '%s\n' "$_nako_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __NAKO_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__NAKO_SAVED_PATH="$PATH"
for _nako_k in $_nako_keys; do
    eval "__NAKO_SAVED_$_nako_k=\"\${$_nako_k+set}\""
    eval "__NAKO_PRIOR_$_nako_k=\${$_nako_k-__NAKO_UNSET__}"
done
nako_apply_env "$_nako_script"

# This checkout, not whichever `nako` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__NAKO_WORKTREE="$_NAKO_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__NAKO_WORKTREE_NAME="$(git -C "$_NAKO_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__NAKO_WORKTREE_NAME" ] || [ "$__NAKO_WORKTREE_NAME" = HEAD ]; then
    __NAKO_WORKTREE_NAME="$(basename "$_NAKO_REPO")"
fi
__NAKO_SAVED_PS1="${PS1-__NAKO_UNSET__}"
__NAKO_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__NAKO_UNSET__}"

_nako_worktree_here() {
    _nako_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_nako_top" && pwd -P)" = "$(cd "$__NAKO_WORKTREE" && pwd -P)" ]
}

nako() {
    _nako_worktree_here || {
        printf '%s\n' "nako: $(pwd) is outside $__NAKO_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__NAKO_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" nako "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe nako "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python nako "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe nako "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python nako "$@"
        else
            exec python nako "$@"
        fi
    )
}

_nako_prompt() {
    if [ "$__NAKO_SAVED_PS1" = "__NAKO_UNSET__" ]; then
        _nako_base_ps1=""
    else
        _nako_base_ps1="$__NAKO_SAVED_PS1"
    fi
    if _nako_worktree_here; then
        PS1="($__NAKO_WORKTREE_NAME) $_nako_base_ps1"
    else
        PS1="$_nako_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_nako_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_nako_prompt
fi
_nako_prompt

deactivate() {
    export PATH="$__NAKO_SAVED_PATH"
    for _nako_k in $__NAKO_KEY_LIST; do
        eval "_nako_was=\"\$__NAKO_SAVED_$_nako_k\""
        eval "_nako_old=\"\$__NAKO_PRIOR_$_nako_k\""
        if [ "$_nako_was" != "set" ]; then
            unset "$_nako_k"
        else
            export "$_nako_k=$_nako_old"
        fi
        unset "__NAKO_SAVED_$_nako_k" "__NAKO_PRIOR_$_nako_k"
    done
    if [ "$__NAKO_SAVED_PS1" = "__NAKO_UNSET__" ]; then
        unset PS1
    else
        PS1="$__NAKO_SAVED_PS1"
    fi
    if [ "$__NAKO_SAVED_PROMPT_COMMAND" = "__NAKO_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__NAKO_SAVED_PROMPT_COMMAND"
    fi
    unset __NAKO_SAVED_PATH __NAKO_KEY_LIST __NAKO_ACTIVATED \
          __NAKO_WORKTREE __NAKO_WORKTREE_NAME \
          __NAKO_SAVED_PS1 __NAKO_SAVED_PROMPT_COMMAND
    unset -f deactivate nako _nako_worktree_here _nako_prompt
    unset _nako_k _nako_was _nako_old _nako_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__NAKO_KEY_LIST="$_nako_keys"

# The composition library is not part of the user's shell.
unset -f nako_sync nako_bootstrap_python nako_compose_env nako_apply_env \
         nako_activation_current nako_ensure_env
unset _NAKO_REPO _nako_script _nako_keys _nako_k _nako_top
